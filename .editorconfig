# EditorConfig for PersonalFinance: https://editorconfig.org
# Visual Studio, Rider and VS Code read this file; `dotnet build` enforces the C# rules
# (EnforceCodeStyleInBuild in PersonalFinance/Directory.Build.props).
# Severities: `warning` for conventions the codebase already follows everywhere,
# `suggestion` for preferences that existing code does not yet follow consistently.

root = true

[*]
charset = utf-8
# Line endings are normalized by .gitattributes (`* text=auto`), so they are not set here.
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml,bicep,bicepparam}]
indent_size = 2

[*.{csproj,props,targets,slnx,xml,config}]
indent_size = 4

[*.sln]
indent_style = tab

# JavaScript style is owned by ESLint (PersonalFinance/src/PersonalFinance.Web/wwwroot/.eslintrc.js).
[*.{js,css,cshtml}]
indent_size = 4

# Vendored libraries: never reformat.
[**/wwwroot/lib/**]
generated_code = true

[**/Migrations/**]
generated_code = true

[*.cs]

# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:suggestion

# `var` when the type is obvious
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Braces, expression bodies, modern syntax
csharp_prefer_braces = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_primary_constructors = false:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_readonly_field = true:suggestion

# Formatting (Allman braces, 4-space indent)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_keywords_in_control_flow_statements = true

# Naming: interfaces start with I
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

# Naming: types and non-field members are PascalCase
dotnet_naming_rule.types_pascal_case.severity = warning
dotnet_naming_rule.types_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_pascal_case.style = pascal_case
dotnet_naming_symbols.type_symbols.applicable_kinds = class, struct, enum, delegate
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.members_pascal_case.severity = suggestion
dotnet_naming_rule.members_pascal_case.symbols = member_symbols
dotnet_naming_rule.members_pascal_case.style = pascal_case
dotnet_naming_symbols.member_symbols.applicable_kinds = property, method, event

# Naming: private static readonly fields and constants are PascalCase (checked before the _camelCase rule)
dotnet_naming_rule.private_static_readonly_pascal.severity = warning
dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly_pascal.style = pascal_case
dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_fields.required_modifiers = static, readonly

# Naming: private instance fields are _camelCase
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_instance_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_instance_fields.required_modifiers = readonly
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Build severities for style preferences.
# The `:severity` suffix on the options above only affects the IDE; the build reads these lines.
# Opinion-only rewrites stay suggestions so real quality warnings (CA*) are not buried.
dotnet_diagnostic.IDE0017.severity = suggestion # object initializer
dotnet_diagnostic.IDE0028.severity = suggestion # collection initializer / expression
dotnet_diagnostic.IDE0042.severity = suggestion # deconstruct variable
dotnet_diagnostic.IDE0045.severity = suggestion # if -> conditional assignment
dotnet_diagnostic.IDE0046.severity = suggestion # if -> conditional return
dotnet_diagnostic.IDE0047.severity = suggestion # remove parentheses
dotnet_diagnostic.IDE0057.severity = suggestion # range operator
dotnet_diagnostic.IDE0061.severity = suggestion # expression-bodied local function
dotnet_diagnostic.IDE0063.severity = suggestion # simple using statement
dotnet_diagnostic.IDE0078.severity = suggestion # pattern matching
dotnet_diagnostic.IDE0090.severity = suggestion # target-typed new
dotnet_diagnostic.IDE0200.severity = suggestion # remove lambda
dotnet_diagnostic.IDE0290.severity = suggestion # primary constructor
dotnet_diagnostic.IDE0300.severity = suggestion # collection expression for array
dotnet_diagnostic.IDE0301.severity = suggestion # collection expression for empty
dotnet_diagnostic.IDE0305.severity = suggestion # collection expression for fluent
dotnet_diagnostic.IDE0330.severity = suggestion # System.Threading.Lock
dotnet_diagnostic.IDE0340.severity = suggestion # unbound generic in nameof

# Analyzer tuning
# CA1716 flags `Shared` as a reserved word in Visual Basic; this solution is C# only.
dotnet_diagnostic.CA1716.severity = none
# CA2007 (ConfigureAwait) does not apply to ASP.NET Core apps.
dotnet_diagnostic.CA2007.severity = none
# CA1848 (LoggerMessage delegates) is a perf optimisation; structured logging via ILogger is fine here.
dotnet_diagnostic.CA1848.severity = suggestion

# Aspire template convention: extension methods live in Microsoft.Extensions.Hosting.
[**/PersonalFinance.ServiceDefaults/Extensions.cs]
dotnet_diagnostic.IDE0130.severity = none

[**/tests/**/*.cs]
# xUnit test names use underscores: Method_Scenario_Expected.
dotnet_diagnostic.CA1707.severity = none

# Shared test helpers stay in the root PersonalFinance.Tests namespace so every feature folder sees them.
[**/tests/PersonalFinance.Tests/TestSupport/*.cs]
dotnet_diagnostic.IDE0130.severity = none
