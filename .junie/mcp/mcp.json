{
    "mcpServers": {
        "Playwright": {
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp@latest"
            ]
        },
        "azure": {
            "command": "npx",
            "args": [
                "-y",
                "@azure/mcp@latest",
                "server",
                "start"
            ]
        },
        "github": {
            "url": "https://github.github.com/mcp"
        },
        "microsoft-learn": {
            "url": "https://learn.microsoft.com/mcp"
        }
    }
}