# Copy to .env (gitignored) and fill in. Used by compose.yaml and the npm db:* scripts.
# The sa password must be at least 8 characters and contain three of: uppercase, lowercase, digit, symbol.
MSSQL_SA_PASSWORD=
# Host port for SQL Server. Change it if something else already uses 1433.
SQL_HOST_PORT=1433

# Azure AI Translator, read by `npm run i18n:translate` (docs/DEVELOPMENT.md, "Translations").
# Key and region are on the Translator resource's "Keys and Endpoint" page in the Azure portal.
# The endpoint is optional; it defaults to https://api.cognitive.microsofttranslator.com/.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=
