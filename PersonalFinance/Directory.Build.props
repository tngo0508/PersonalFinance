<Project>
  <!--
    Shared MSBuild settings for every project under PersonalFinance/.
    Project files only declare what is specific to them (SDK, references, UserSecretsId, ...).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Code-quality analyzers and .editorconfig style rules run during build. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      CI builds the solution with -p:EnforceWarningsAsErrors=true, so any new warning fails the
      deploy workflow. Local builds still report warnings without failing; run the same flag
      locally to reproduce the CI gate.
    -->
    <TreatWarningsAsErrors Condition="'$(EnforceWarningsAsErrors)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Thresholds for the CA1502 and CA1505 complexity ceiling (ADR 0007 rule 6). -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" Link="CodeMetricsConfig.txt" Visible="false" />
  </ItemGroup>
</Project>
