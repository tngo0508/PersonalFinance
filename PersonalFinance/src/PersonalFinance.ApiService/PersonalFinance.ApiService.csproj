<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
      <UserSecretsId>89ed9197-974f-49f0-86a4-e341c43fe214</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
        <!-- Project References -->
        <ProjectReference Include="..\PersonalFinance.ServiceDefaults\PersonalFinance.ServiceDefaults.csproj" />
        <ProjectReference Include="..\PersonalFinance.Shared\PersonalFinance.Shared.csproj" />
        <ProjectReference Include="..\PersonalFinance.Data\PersonalFinance.Data.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- OpenAPI & Scalar UI -->
        <PackageReference Include="FluentValidation" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Scalar.AspNetCore" />

        <!-- EF Core Tools for Migrations -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <!-- ASP.NET Core Identity for user management in API controllers -->
        <PackageReference Include="Microsoft.AspNetCore.Identity.UI" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.OpenApi" />

        <!-- OpenAI SDK for AI Assistant -->
        <PackageReference Include="OpenAI" />
        <PackageReference Include="Microsoft.Extensions.AI" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    </ItemGroup>

</Project>