{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "OpenAI": {
    "Model": "gpt-4o-mini",
    "MaxTokens": 400,
    "DailyMessageLimit": 30,
    "MonthlyBudgetUsd": 10,
    "BudgetWarningThreshold": 0.9
  },
  "Research": {
    "SectorsFirstYear": 2011,
    "SubmissionsPerRefresh": 2500,
    "Sec": {
      "UserAgent": "PersonalFinance research contact@example.com",
      "MaxRequestsPerSecond": 5
    }
  },
  "AllowedHosts": "*"
}
