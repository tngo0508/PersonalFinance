@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = L["Account.ResetPasswordConfirmation.Title"].Value;
    Func<object?, HelperResult> loginLink = @<a asp-page="./Login">@L["Account.ResetPasswordConfirmation.LoginLink"]</a>;
}

<h1>@ViewData["Title"]</h1>
<p>
    @L.NamedHtml("Account.ResetPasswordConfirmation.Message", null, ("loginLink", loginLink(null)))
</p>
