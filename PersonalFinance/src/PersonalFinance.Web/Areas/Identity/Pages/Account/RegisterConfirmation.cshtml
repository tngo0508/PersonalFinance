@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = L["Account.RegisterConfirmation.Title"].Value;
    Func<object?, HelperResult> docsLink = @<a href="https://aka.ms/aspaccountconf">@L["Account.RegisterConfirmation.DocsLink"]</a>;
    Func<object?, HelperResult> confirmLink = @<a id="confirm-link" href="@Model.EmailConfirmationUrl">@L["Account.RegisterConfirmation.ConfirmLink"]</a>;
}

<h1>@ViewData["Title"]</h1>
@{
    if (@Model.DisplayConfirmAccountLink)
    {
<p>
    @L.NamedHtml("Account.RegisterConfirmation.NoEmailSender", null, ("docsLink", docsLink(null)), ("confirmLink", confirmLink(null)))
</p>
    }
    else
    {
<p>
        @L["Account.RegisterConfirmation.CheckEmail"]
</p>
    }
}

