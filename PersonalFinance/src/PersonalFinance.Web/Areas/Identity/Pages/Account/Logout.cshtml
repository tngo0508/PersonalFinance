@page
@model LogoutModel
@{
    ViewData["Title"] = L["Account.Logout.Title"].Value;
}

<header>
    <h1>@ViewData["Title"]</h1>
    @{
        if (User.Identity!.IsAuthenticated)
        {
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button type="submit" class="nav-link btn btn-link text-body">@L["Account.Logout.Button"]</button>
            </form>
        }
        else
        {
            <p>@L["Account.Logout.LoggedOut"]</p>
        }
    }
</header>
