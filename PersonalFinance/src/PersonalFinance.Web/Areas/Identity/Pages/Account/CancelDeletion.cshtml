@page
@model CancelDeletionModel
@{
    ViewData["Title"] = L["Account.CancelDeletion.Title"].Value;
    Func<object?, Microsoft.AspNetCore.Mvc.Razor.HelperResult> contactLink = @<a asp-area="" asp-controller="Legal" asp-action="Contact">@L["Account.Common.ContactUsLink"]</a>;
}

<h1>@ViewData["Title"]</h1>

@if (Model.Cancelled)
{
    <div class="alert alert-success" role="status">
        @L["Account.CancelDeletion.Restored"]
    </div>
    <p><a class="btn btn-primary" asp-page="./Login">@L["Account.Common.SignIn"]</a></p>
}
else if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    <p>
        @L.NamedHtml("Account.Common.NeedHelpContact", null, ("contactLink", contactLink(null)))
    </p>
}
else
{
    <p>
        @L["Account.CancelDeletion.Scheduled"]
    </p>
    <form method="post">
        <input type="hidden" asp-for="Token"/>
        <button class="btn btn-primary" type="submit">@L["Account.CancelDeletion.Button"]</button>
    </form>
}
