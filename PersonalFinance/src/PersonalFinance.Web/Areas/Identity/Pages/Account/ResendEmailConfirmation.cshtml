@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = L["Account.ResendEmailConfirmation.Title"].Value;
}

<div class="auth-page__header mb-5">
    <h1 class="auth-page__title mb-2">@L["Account.ResendEmailConfirmation.Heading"]</h1>
    <p class="auth-page__subtitle mb-0">@L["Account.ResendEmailConfirmation.Subtitle"]</p>
</div>

<div class="auth-page__form">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-4">
            <label asp-for="Input.Email" class="form-label">@L["Identity.Field.Email"]</label>
            <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true"
                   placeholder="name@example.com"/>
            <span asp-validation-for="Input.Email" class="invalid-feedback"></span>
        </div>

        <button type="submit" class="w-100 btn btn-primary btn-lg">@L["Account.ResendEmailConfirmation.Submit"]</button>
    </form>

    <div class="text-center mt-4">
        <a asp-page="./Login" class="small text-decoration-none">@L["Account.Common.BackToSignIn"]</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
