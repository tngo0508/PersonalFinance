@page
@model LockoutModel
@{
    ViewData["Title"] = L["Account.Lockout.Title"].Value;
    Func<object?, Microsoft.AspNetCore.Mvc.Razor.HelperResult> contactLink = @<a asp-area="" asp-controller="Legal" asp-action="Contact">@L["Account.Common.ContactUsInlineLink"]</a>;
    Func<object?, Microsoft.AspNetCore.Mvc.Razor.HelperResult> cancelLink = @<strong>@L["Account.CancelDeletion.Button"]</strong>;
}

<h1>@ViewData["Title"]</h1>

<p>@L["Account.Lockout.CannotSignIn"]</p>
<p>
    @L.NamedHtml("Account.Lockout.Deletion", null, ("cancelLink", cancelLink(null)))
</p>
<p>
    @L.NamedHtml("Account.Lockout.Otherwise", null, ("contactLink", contactLink(null)))
</p>
