@page
@model LanguageModel
@{
    ViewData["Title"] = L["Account.Language.Title"].Value;
    ViewData["ActivePage"] = ManageNavPages.Language;
}

<h3>@ViewData["Title"]</h3>
@if (Model.Saved)
{
    <div class="alert alert-success alert-dismissible" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Common.Close"]"></button>
        @L["Account.Language.Saved"]
    </div>
}
<div class="row">
    <div class="col-xl-6">
        <form id="language-form" method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <p class="text-muted">@L["Account.Language.Intro"]</p>
            <p class="text-muted">@L["Account.Language.Formats"]</p>
            <fieldset class="mb-3">
                <legend class="visually-hidden">@L["Account.Language.Title"]</legend>
                @foreach (var language in AppLanguages.All)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="Language" id="language-@language.Code"
                               value="@language.Code" checked="@(language.Code == Model.Language)"/>
                        <label class="form-check-label" for="language-@language.Code" lang="@language.Code">
                            @language.NativeName
                        </label>
                    </div>
                }
            </fieldset>
            <button id="save-language" type="submit" class="w-100 btn btn-lg btn-primary">@L["Account.Language.Save"]</button>
        </form>
    </div>
</div>
