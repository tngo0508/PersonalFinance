@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = L["Account.TwoFactor.Title"].Value;
    Func<object?, Microsoft.AspNetCore.Mvc.Razor.HelperResult> generateLink = @<a asp-page="./GenerateRecoveryCodes">@L["Account.TwoFactor.GenerateLink"]</a>;
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
@{
    var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
    @if (consentFeature?.CanTrack ?? true)
    {
        @if (Model.Is2faEnabled)
        {
            if (Model.RecoveryCodesLeft == 0)
            {
                <div class="alert alert-danger">
                    <strong>@L["Account.TwoFactor.NoCodesLeft"]</strong>
                    <p>@L.NamedHtml("Account.TwoFactor.NoCodesLeftHelp", null, ("generateLink", generateLink(null)))</p>
                </div>
            }
            else if (Model.RecoveryCodesLeft == 1)
            {
                <div class="alert alert-danger">
                    <strong>@L["Account.TwoFactor.OneCodeLeft"]</strong>
                    <p>@L.NamedHtml("Account.TwoFactor.OneCodeLeftHelp", null, ("generateLink", generateLink(null)))</p>
                </div>
            }
            else if (Model.RecoveryCodesLeft <= 3)
            {
                <div class="alert alert-warning">
                    <strong>@L.Named("Account.TwoFactor.FewCodesLeft", ("count", Model.RecoveryCodesLeft))</strong>
                    <p>@L.NamedHtml("Account.TwoFactor.FewCodesLeftHelp", null, ("generateLink", generateLink(null)))</p>
                </div>
            }

            if (Model.IsMachineRemembered)
            {
                <form method="post" style="display: inline-block">
                    <button type="submit" class="btn btn-primary">@L["Account.TwoFactor.ForgetBrowser"]</button>
                </form>
            }
            <a asp-page="./Disable2fa" class="btn btn-primary">@L["Account.TwoFactor.Disable"]</a>
            <a asp-page="./GenerateRecoveryCodes" class="btn btn-primary">@L["Account.TwoFactor.ResetRecoveryCodes"]</a>
        }

        <h4>@L["Account.TwoFactor.AuthenticatorApp"]</h4>
        @if (!Model.HasAuthenticator)
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">@L["Account.TwoFactor.AddApp"]</a>
        }
        else
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">@L["Account.TwoFactor.SetUpApp"]</a>
            <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-primary">@L["Account.TwoFactor.ResetApp"]</a>
        }
    }
    else
    {
        <div class="alert alert-danger">
            <strong>@L["Account.TwoFactor.PolicyNotAccepted"]</strong>
            <p>@L["Account.TwoFactor.PolicyHelp"]</p>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
