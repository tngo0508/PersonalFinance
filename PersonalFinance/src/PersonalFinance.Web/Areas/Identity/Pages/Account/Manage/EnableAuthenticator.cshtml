@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = L["Account.EnableAuthenticator.Title"].Value;
    // Store and product names stay as written in every language.
    Func<(string Url, string Store), HelperResult> storeLink = @<a href="@item.Url">@item.Store</a>;
    Func<object?, HelperResult> sharedKey = @<kbd>@Model.SharedKey</kbd>;
    Func<object?, HelperResult> qrLink = @<a href="https://go.microsoft.com/fwlink/?Linkid=852423">@L["Account.EnableAuthenticator.QrLink"]</a>;
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div>
    <p>@L["Account.EnableAuthenticator.Steps"]</p>
    <ol class="list">
        <li>
            <p>
                @L.NamedHtml("Account.EnableAuthenticator.Download", null,
                    ("microsoftAndroid", storeLink(("https://go.microsoft.com/fwlink/?Linkid=825072", "Android"))),
                    ("microsoftIos", storeLink(("https://go.microsoft.com/fwlink/?Linkid=825073", "iOS"))),
                    ("googleAndroid", storeLink(("https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&hl=en", "Android"))),
                    ("googleIos", storeLink(("https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8", "iOS"))))
            </p>
        </li>
        <li>
            <p>@L.NamedHtml("Account.EnableAuthenticator.Scan", null, ("key", sharedKey(null)))</p>
            <div class="alert alert-info">@L.NamedHtml("Account.EnableAuthenticator.QrHelp", null, ("qrLink", qrLink(null)))</div>
            <div id="qrCode"></div>
            <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
        </li>
        <li>
            <p>
                @L["Account.EnableAuthenticator.EnterCode"]
            </p>
            <div class="row">
                <div class="col-xl-6">
                    <form id="send-code" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="@L["Account.EnableAuthenticator.CodePlaceholder"]"/>
                            <label asp-for="Input.Code" class="control-label form-label">@L["Identity.Field.VerificationCode"]</label>
                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                        </div>
                        <button type="submit" class="w-100 btn btn-lg btn-primary">@L["Account.EnableAuthenticator.Submit"]</button>
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    </form>
                </div>
            </div>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
