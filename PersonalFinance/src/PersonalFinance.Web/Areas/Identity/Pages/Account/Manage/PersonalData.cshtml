@page
@model PersonalDataModel
@{
    Layout = "_Layout"; // the account-settings shell in this folder, not Account/_ViewStart's sign-in layout
    ViewData["Title"] = L["Account.PersonalData.Title"].Value;
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>

<h4>@L["Account.PersonalData.DownloadHeading"]</h4>
<p>
    @L["Account.PersonalData.DownloadIntro"]
</p>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<form id="download-data" method="post" asp-page-handler="Download">
    <button class="btn btn-primary" type="submit">@L["Account.PersonalData.DownloadButton"]</button>
</form>

<h4>@L["Account.PersonalData.DeleteHeading"]</h4>
<p>
    @L["Account.PersonalData.DeleteIntro"]
</p>
<a id="delete" class="btn btn-outline-danger" asp-page="./DeletePersonalData">@L["Account.PersonalData.DeleteButton"]</a>
