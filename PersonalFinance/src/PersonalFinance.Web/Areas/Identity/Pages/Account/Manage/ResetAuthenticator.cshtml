@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = L["Account.ResetAuthenticator.Title"].Value;
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>@L["Account.ResetAuthenticator.WarningTitle"]</strong>
    </p>
    <p>
        @L["Account.ResetAuthenticator.Warning"]
    </p>
</div>
<div>
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">@L["Account.ResetAuthenticator.Submit"]</button>
    </form>
</div>
