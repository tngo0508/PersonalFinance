@*
    Shell for the Account settings pages (Profile, Email, Password, ...), so they keep the app's sidebar
    layout and use the ledger theme.
*@
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true"/>
}

<div class="account-page">
    <header class="account-page__header">
        <h1 class="account-page__title">@L["Account.Settings.Title"]</h1>
        <p class="account-page__subtitle">@L["Account.Settings.Subtitle"]</p>
    </header>

    <div class="account-page__body">
        <nav class="account-page__nav" aria-label="@L["Account.Settings.Title"]">
            <partial name="_ManageNav"/>
        </nav>
        <div class="account-page__content">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
