@page
@model DeletePersonalDataModel
@{
    Layout = "_Layout"; // the account-settings shell in this folder, not Account/_ViewStart's sign-in layout
    ViewData["Title"] = L["Account.DeleteAccount.Title"].Value;
    Func<object?, Microsoft.AspNetCore.Mvc.Razor.HelperResult> downloadLink = @<a asp-page="./PersonalData">@L["Account.DeleteAccount.DownloadLink"]</a>;
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>

<p>@L["Account.DeleteAccount.WhenYouConfirm"]</p>
<ul>
    <li>@L["Account.DeleteAccount.HiddenNow"]</li>
    <li>@L["Account.DeleteAccount.CancelEmail"]</li>
    <li>@L["Account.DeleteAccount.AfterThirtyDays"]</li>
</ul>
<p>
    @L.NamedHtml("Account.DeleteAccount.CopyFirst", null, ("downloadLink", downloadLink(null)))
</p>

<form id="delete-user" method="post">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    }
    @if (Model.RequirePassword)
    {
        <div class="form-floating mb-3">
            <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password"
                   required placeholder="@L["Account.DeleteAccount.Password"]"/>
            <label asp-for="Input.Password" class="form-label">@L["Account.DeleteAccount.Password"]</label>
        </div>
    }
    else
    {
        <div class="form-floating mb-3">
            <input asp-for="Input.Confirmation" class="form-control" autocomplete="off" required
                   placeholder="@DeletePersonalDataModel.ConfirmationWord"/>
            <label asp-for="Input.Confirmation" class="form-label">
                @L.Named("Account.DeleteAccount.TypeToConfirm", ("word", DeletePersonalDataModel.ConfirmationWord))
            </label>
        </div>
    }
    <button class="btn btn-danger" type="submit">@L["Account.DeleteAccount.Submit"]</button>
</form>
