@page
@model Disable2faModel
@{
    ViewData["Title"] = L["Account.Disable2fa.Title"].Value;
    Func<object?, Microsoft.AspNetCore.Mvc.Razor.HelperResult> resetLink = @<a asp-page="./ResetAuthenticator">@L["Account.Common.ResetAuthenticatorKeysLink"]</a>;
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>@L["Account.Disable2fa.WarningTitle"]</strong>
    </p>
    <p>
        @L.NamedHtml("Account.Disable2fa.Warning", null, ("resetLink", resetLink(null)))
    </p>
</div>

<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">@L["Account.TwoFactor.Disable"]</button>
    </form>
</div>
