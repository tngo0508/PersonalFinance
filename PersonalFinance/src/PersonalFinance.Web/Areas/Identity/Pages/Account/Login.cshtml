@page
@model LoginModel

@{
    ViewData["Title"] = L["Account.Login.Title"].Value;
}

<div class="auth-page__header mb-5">
    <h1 class="auth-page__title mb-2">@L["Account.Login.Title"]</h1>
    <p class="auth-page__subtitle mb-0">@L["Account.Login.Subtitle"]</p>
</div>

<div class="auth-page__form">
    <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl">
        @if (Model.IdleSignOutMessage is not null)
        {
            <div class="alert alert-info" role="status" data-test-id="idle-sign-out-message">@Model.IdleSignOutMessage</div>
        }
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-4">
            <label asp-for="Input.Email" class="form-label">@L["Identity.Field.Email"]</label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true"
                   placeholder="name@example.com"/>
            <span asp-validation-for="Input.Email" class="invalid-feedback"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Input.Password" class="form-label">@L["Identity.Field.Password"]</label>
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password"
                   aria-required="true" placeholder="@L["Account.Common.PasswordPlaceholder"]"/>
            <span asp-validation-for="Input.Password" class="invalid-feedback"></span>
        </div>

        <div class="d-flex justify-content-end align-items-center mb-4">
            < id="forgot-password" asp-page="./ForgotPassword" class="small text-decoration-none">@L["Account.Login.ForgotPassword"]</a>
        </div>

        <button id="login-submit" data-test-id="login-submit" type="submit" class="w-100 btn btn-primary btn-lg">
            @L["Account.Common.SignIn"]
        </button>
    </form>

    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
    {
        <div class="text-center my-4">
            <span class="text-muted small">@L["Account.Login.OrContinueWith"]</span>
        </div>
        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div class="d-grid gap-2">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit"
                            class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2 py-2"
                            name="provider" value="@provider.Name"
                            title="@L.Named("Account.Login.ProviderTitle", ("provider", provider.DisplayName))"
                            aria-label="@L.Named("Account.Login.ProviderLabel", ("provider", provider.DisplayName))">
                        @if (provider.Name.Equals("Google", StringComparison.OrdinalIgnoreCase))
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                                <path fill="#EA4335"
                                      d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                <path fill="#4285F4"
                                      d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                                <path fill="#FBBC05"
                                      d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                                <path fill="#34A853"
                                      d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                                <path fill="none" d="M0 0h48v48H0z"/>
                            </svg>
                        }
                        <span>@L.Named("Account.Login.ContinueWith", ("provider", provider.DisplayName))</span>
                    </button>
                }
            </div>
        </form>
    }

    <div class="text-center mt-4">
        <span class="text-muted small">@L["Account.Login.NoAccount"]</span>
        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="small text-decoration-none ms-1">@L["Account.Login.CreateAccount"]</a>
    </div>

    <div class="text-center mt-2">
        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation"
           class="text-muted small text-decoration-none">
            @L["Account.Login.ResendConfirmation"]
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
