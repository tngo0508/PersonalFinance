@page
@model DeletionRequestedModel
@{
    ViewData["Title"] = L["Account.DeletionRequested.Title"].Value;
    Func<object?, HelperResult> contactLink = @<a asp-area="" asp-controller="Legal" asp-action="Contact">@L["Account.Common.ContactUsInlineLink"]</a>;
    Func<object?, HelperResult> cancelLink = @<strong>@L["Account.CancelDeletion.Button"]</strong>;
}

<h1>@ViewData["Title"]</h1>

<p>
    @L["Account.DeletionRequested.SignedOut"]
    @if (Model.PurgeAfter is { } purgeAfter)
    {
        Func<object?, HelperResult> date = @<strong>@purgeAfter.ToString("MMMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</strong>;
        @L.NamedHtml("Account.DeletionRequested.PurgeOn", null, ("date", date(null)))
    }
    else
    {
        @L["Account.DeletionRequested.PurgeIn30Days"]
    }
</p>

@if (Model.EmailSent)
{
    <p>@L.NamedHtml("Account.DeletionRequested.ChangedMind", null, ("cancelLink", cancelLink(null)))</p>
}
else
{
    <div class="alert alert-warning" role="alert">
        @L.NamedHtml("Account.DeletionRequested.EmailFailed", null, ("contactLink", contactLink(null)))
    </div>
}
