<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <UserSecretsId>f2df30ee-ab0b-4237-9e63-7d63849a082b</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <!-- Lets the tests use a Feature's internal types (ADR 0007) -->
        <InternalsVisibleTo Include="PersonalFinance.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- Project References -->
        <ProjectReference Include="..\PersonalFinance.ServiceDefaults\PersonalFinance.ServiceDefaults.csproj" />
        <ProjectReference Include="..\PersonalFinance.Shared\PersonalFinance.Shared.csproj" />
        <ProjectReference Include="..\PersonalFinance.Data\PersonalFinance.Data.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Refit HTTP Client with HttpClientFactory integration -->
        <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" />
        <PackageReference Include="Refit.HttpClientFactory" />

        <!-- HTTP Client Resilience Pipeline (Retries, Circuit Breaker, Rate Limiter) -->
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />

        <!-- LibMan Client-Side Library Manager Build Tool -->
        <PackageReference Include="Microsoft.Web.LibraryManager.Build" />
    </ItemGroup>

    <ItemGroup>
        <!-- ASP.NET Core Identity UI, External Authentication & Data Protection -->
        <PackageReference Include="Microsoft.AspNetCore.Identity.UI" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
        <PackageReference Include="NuGet.Packaging" />
        <PackageReference Include="NuGet.Protocol" />
    </ItemGroup>

    <ItemGroup>
      <None Include="Views\Networth\Index.cshtml" />
    </ItemGroup>

    <!--
      Minified assets (Release only). tools/minify.js writes a minified copy of each file under wwwroot/js and
      wwwroot/css to wwwroot/dist. The target runs before ResolveProjectStaticWebAssets, the step that turns
      @(Content) under wwwroot into static web assets, so MapStaticAssets compresses (br/gz) and lists the dist
      files. AssetUrlTagHelper points pages at them outside Development. Debug builds need no Node.
    -->
    <PropertyGroup>
        <!-- dist is generated: only the Release target adds it, so a stale copy never reaches a Debug build -->
        <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\dist\**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <!-- The minify tooling's manifest is not app content: keep it out of the build and publish output -->
        <Content Remove="package.json;package-lock.json" />
        <None Include="package.json;package-lock.json;tools\**" />
    </ItemGroup>

    <!--
      Release serves only wwwroot/dist (spec #286), so the unminified sources and the web root's lint tooling leave
      @(Content). Removing them here, not with CopyToPublishDirectory="Never", keeps them out of the static web
      assets manifest as well as the publish folder, so Production cannot serve them. minify.js reads the sources
      from disk, and Debug builds still serve /js and /css. tools/check-publish.js guards this in CI.
    -->
    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <Content Remove="wwwroot\js\**;wwwroot\css\**;wwwroot\package.json;wwwroot\package-lock.json;wwwroot\.eslintrc.js;wwwroot\.eslintignore" />
    </ItemGroup>

    <Target Name="MinifyWebAssets" BeforeTargets="ResolveProjectStaticWebAssets" Condition="'$(Configuration)' == 'Release'">
        <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="!Exists('$(MSBuildProjectDirectory)\node_modules\esbuild')" />
        <Exec Command="npm run minify" WorkingDirectory="$(MSBuildProjectDirectory)" />

        <ItemGroup>
            <_MinifiedWebAsset Include="wwwroot\dist\**" />
            <Content Remove="@(_MinifiedWebAsset)" />
            <Content Include="@(_MinifiedWebAsset)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
        </ItemGroup>
    </Target>

</Project>