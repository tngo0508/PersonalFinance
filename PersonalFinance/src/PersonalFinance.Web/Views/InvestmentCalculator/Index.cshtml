@{
    ViewData["Title"] = L["InvestmentCalculator.Title"].Value;
}

@functions {
    // calculator.js rewrites these on load; the server renders the same starting values so nothing jumps.
    private static string Money(decimal amount)
    {
        return MoneyFormatter.FormatWhole(amount, SupportedCurrencies.Default.Code);
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/investment-calculator.css" asp-append-version="true"/>
}

<div class="calculator-page">
    <!-- Page Header -->
    <div class="calculator-header mb-4">
        <div class="calculator-header__content">
            <div>
                <h1 class="calculator-title">
                    <span class="calculator-title__icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path
                                    d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                    </span>
                    @L["InvestmentCalculator.Header.Title"]
                </h1>
                <p class="calculator-subtitle">@L["InvestmentCalculator.Header.Subtitle"]</p>
            </div>
        </div>
    </div>

    <!-- Two-Column Layout: Inputs + Results -->
    <div class="row g-3">
        <!-- Left Column: Input Parameters -->
        <div class="col-lg-4">
            <!-- Investment Amount Card -->
            <div class="card calculator-card mb-3">
                <div class="calculator-card__header">
                    <div class="calculator-card__header-left">
                        <div class="calculator-card__icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M12 1v22"/>
                                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                            </svg>
                        </div>
                        <h2 class="calculator-card__title">@L["InvestmentCalculator.Amount.Title"]</h2>
                    </div>
                </div>
                <div class="calculator-card__body">
                    <div class="calculator-input-group">
                        <label for="calcInitial" class="form-label">@L["InvestmentCalculator.Field.Initial"]</label>
                        <div class="calculator-value-display" id="calcInitialValue">@Money(10_000m)</div>
                        <input type="range" class="form-range" id="calcInitialRange" min="0" max="500000" step="1000"
                               value="10000"
                               aria-label="@L["InvestmentCalculator.Field.InitialAria"]"/>
                        <input type="number" class="form-control" id="calcInitial" value="10000" min="0" step="1000"
                               aria-label="@L["InvestmentCalculator.Field.InitialAria"]"/>
                    </div>

                    <div class="calculator-input-group">
                        <label for="calcMonthly" class="form-label">@L["InvestmentCalculator.Field.Monthly"]</label>
                        <div class="calculator-value-display" id="calcMonthlyValue">@Money(500m)</div>
                        <input type="range" class="form-range" id="calcMonthlyRange" min="0" max="10000" step="50"
                               value="500"
                               aria-label="@L["InvestmentCalculator.Field.MonthlyAria"]"/>
                        <input type="number" class="form-control" id="calcMonthly" value="500" min="0" step="50"
                               aria-label="@L["InvestmentCalculator.Field.MonthlyAria"]"/>
                    </div>
                </div>
            </div>

            <!-- Growth Parameters Card -->
            <div class="card calculator-card">
                <div class="calculator-card__header">
                    <div class="calculator-card__header-left">
                        <div class="calculator-card__icon calculator-card__icon--orange">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="m22 12-3.5-3.5"/>
                                <path d="M4 16V10a2 2 0 0 1 2-2h3.5"/>
                                <path d="M20 8V4a2 2 0 0 0-2-2h-3.5"/>
                                <path d="M2 18v-4a2 2 0 0 1 2-2h3.5"/>
                                <path d="M16 14v4a2 2 0 0 1-2 2h-3.5"/>
                            </svg>
                        </div>
                        <h2 class="calculator-card__title">@L["InvestmentCalculator.Growth.Title"]</h2>
                    </div>
                </div>
                <div class="calculator-card__body">
                    <div class="calculator-input-group">
                        <label for="calcRate" class="form-label">@L["InvestmentCalculator.Field.Rate"]</label>
                        <div class="calculator-value-display" id="calcRateValue">7%</div>
                        <input type="range" class="form-range" id="calcRateRange" min="1" max="15" step="0.5" value="7"
                               aria-label="@L["InvestmentCalculator.Field.RateAria"]"/>
                        <input type="number" class="form-control" id="calcRate" value="7" min="1" max="15" step="0.5"
                               aria-label="@L["InvestmentCalculator.Field.RateAria"]"/>
                    </div>

                    <div class="calculator-input-group">
                        <label for="calcYears" class="form-label">@L["InvestmentCalculator.Field.Years"]</label>
                        <div class="calculator-value-display" id="calcYearsValue">@L.Plural("InvestmentCalculator.Js.Years", 20)</div>
                        <input type="range" class="form-range" id="calcYearsRange" min="1" max="50" step="1" value="20"
                               aria-label="@L["InvestmentCalculator.Field.YearsAria"]"/>
                        <input type="number" class="form-control" id="calcYears" value="20" min="1" max="50" step="1"
                               aria-label="@L["InvestmentCalculator.Field.YearsAria"]"/>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Results -->
        <div class="col-lg-8">
            <!-- Metric Cards -->
            <div class="row g-3 mb-3">
                <div class="col-sm-6 col-md-4">
                    <div class="card calculator-result-card">
                        <div class="card-body">
                            <div class="calculator-result-card__icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M3 3v18h18"/>
                                    <path d="m19 9-5 5-4-4-3 3"/>
                                </svg>
                            </div>
                            <div class="calculator-result-label">@L["InvestmentCalculator.Result.FutureValue"]</div>
                            <div class="calculator-result-value" id="calcFutureValue">@Money(0m)</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-4">
                    <div class="card calculator-result-card">
                        <div class="card-body">
                            <div class="calculator-result-card__icon calculator-result-card__icon--blue">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M12 1v22"/>
                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                                </svg>
                            </div>
                            <div class="calculator-result-label">@L["InvestmentCalculator.Result.TotalContributions"]</div>
                            <div class="calculator-result-value" id="calcTotalContributions">@Money(0m)</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-4">
                    <div class="card calculator-result-card">
                        <div class="card-body">
                            <div class="calculator-result-card__icon calculator-result-card__icon--green">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
                                    <polyline points="16 7 22 7 22 13"/>
                                </svg>
                            </div>
                            <div class="calculator-result-label">@L["InvestmentCalculator.Result.InterestEarned"]</div>
                            <div class="calculator-result-value" id="calcTotalInterest">@Money(0m)</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chart -->
            <div class="card calculator-card calculator-card--chart">
                <div class="calculator-card__header">
                    <div class="calculator-card__header-left">
                        <div class="calculator-card__icon calculator-card__icon--green">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M3 3v18h18"/>
                                <path d="m19 9-5 5-4-4-3 3"/>
                            </svg>
                        </div>
                        <h2 class="calculator-card__title">@L["InvestmentCalculator.Chart.Title"]</h2>
                    </div>
                </div>
                <div class="calculator-card__body">
                    <div class="calculator-chart-container">
                        <canvas id="calcChart" aria-label="@L["InvestmentCalculator.Chart.Aria"]" role="img"></canvas>
                    </div>
                    <div class="calculator-chart-legend">
                        <div class="calculator-chart-legend__item">
                            <span class="calculator-chart-legend__dot calculator-chart-legend__dot--value"></span>
                            <span class="calculator-chart-legend__label">@L["InvestmentCalculator.Legend.TotalValue"]</span>
                            <span class="calculator-chart-legend__value" id="calcLegendValue">@Money(0m)</span>
                        </div>
                        <div class="calculator-chart-legend__item">
                            <span class="calculator-chart-legend__dot calculator-chart-legend__dot--contrib"></span>
                            <span class="calculator-chart-legend__label">@L["InvestmentCalculator.Legend.Contributions"]</span>
                            <span class="calculator-chart-legend__value" id="calcLegendContrib">@Money(0m)</span>
                        </div>
                        <div class="calculator-chart-legend__item">
                            <span class="calculator-chart-legend__dot calculator-chart-legend__dot--interest"></span>
                            <span class="calculator-chart-legend__label">@L["InvestmentCalculator.Result.InterestEarned"]</span>
                            <span class="calculator-chart-legend__value" id="calcLegendInterest">@Money(0m)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<js-strings prefix="InvestmentCalculator.Js." />

@section Scripts {
    <script src="~/js/investment-calculator/calculator.js" asp-append-version="true"></script>
}
