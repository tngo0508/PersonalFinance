@model NewsViewModel
@using System.Globalization
@using Microsoft.AspNetCore.Html

@{
    ViewData["Title"] = L["News.Title"].Value;
    CultureInfo culture = CultureInfo.CurrentCulture;
    // "12/31/2025 at 2:05 PM" in English: the request culture's short date and time.
    string DateAndTime(DateTime value) =>
        L.Named("News.DateAndTime", ("date", value.ToString("d", culture)), ("time", value.ToString("t", culture)));

    // The river groups articles by age rather than calendar day, so the groups need no time zone.
    DateTime now = Model.LastRefreshed ?? DateTime.UtcNow;
    string AgeGroup(DateTime published) => (now - published).TotalHours switch
    {
        < 24 => "News.Group.Day",
        < 24 * 7 => "News.Group.Week",
        _ => "News.Group.Older",
    };

    bool filtered = !string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.SelectedCategory)
        || !string.IsNullOrEmpty(Model.SelectedSource);
    string? FilterUrl(string? category, string? source) =>
        Url.Action("Index", "News", new { category, source, search = Model.SearchQuery });
}

@section Styles {
    <link rel="stylesheet" href="~/css/news.css" asp-append-version="true"/>
}

<div class="news-page">
    <header class="news-head">
        <div>
            <h1 class="news-title">@L["News.Title"]</h1>
            <p class="news-subtitle">@L["News.Subtitle"]</p>
        </div>
        @if (Model.LastRefreshed.HasValue)
        {
            <div class="news-refresh">
                @* <!time> opts out of TimeAgoTagHelper, which replaces the whole element text with a relative time; this line shows the refresh date and time. *@
                <!time datetime="@Model.LastRefreshed.Value.ToString("o")">
                    @L.Named("News.LastUpdated", ("time", DateAndTime(Model.LastRefreshed.Value)))
                </!time>
                <a class="news-icon-btn" href="@Context.Request.Path@Context.Request.QueryString" aria-label="@L["News.Refresh.Title"]" title="@L["News.Refresh.Title"]">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/>
                    </svg>
                </a>
            </div>
        }
    </header>

    @if (string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="news-toolbar">
            <form method="get" class="news-search" role="search" id="newsFilterForm">
                @if (!string.IsNullOrEmpty(Model.SelectedCategory))
                {
                    <input type="hidden" name="category" value="@Model.SelectedCategory"/>
                }
                @if (!string.IsNullOrEmpty(Model.SelectedSource))
                {
                    <input type="hidden" name="source" value="@Model.SelectedSource"/>
                }
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                </svg>
                <input type="search" name="search" class="news-search-input" value="@Model.SearchQuery"
                       placeholder="@L["News.Filter.SearchPlaceholder"]" aria-label="@L["News.Filter.SearchLabel"]" autocomplete="off"/>
                <button type="submit" class="btn btn-primary news-search-btn">@L["News.Filter.Search"]</button>
            </form>
            <nav class="news-chips" aria-label="@L["News.Filter.Topic"]">
                <a class="news-chip" href="@FilterUrl(null, Model.SelectedSource)" aria-current="@(string.IsNullOrEmpty(Model.SelectedCategory) ? "page" : null)">@L["News.Filter.AllTopics"]</a>
                @foreach (string topic in Model.Topics)
                {
                    <a class="news-chip" href="@FilterUrl(topic, Model.SelectedSource)" data-topic="@topic"
                       aria-current="@(Model.SelectedCategory == topic ? "page" : null)">@topic</a>
                }
            </nav>
        </div>
    }

    <div class="news-layout">
        <main class="news-river" aria-labelledby="news-river-title">
            <h2 id="news-river-title" class="visually-hidden">@L["News.River.Title"]</h2>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="news-state news-state-error" role="alert">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/>
                    </svg>
                    <h3>@L["News.Message.LoadFailedTitle"]</h3>
                    <p>@Model.ErrorMessage</p>
                    <a class="btn btn-primary" href="@Url.Action("Index", "News")">@L["News.Refresh.Button"]</a>
                </div>
            }
            else if (Model.Articles.Count == 0)
            {
                <div class="news-state">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                    </svg>
                    <h3>@L["News.Empty.Title"]</h3>
                    <p>@L["News.Empty.Text"]</p>
                    <a href="@Url.Action("Index", "News")" class="btn btn-outline-secondary">@L["News.Empty.ViewAll"]</a>
                </div>
            }
            else
            {
                <p class="news-count">
                    <span>@L.NamedHtml("News.ArticleCount." + LocalizerExtensions.PluralCategory(CultureInfo.CurrentUICulture, Model.Articles.Count), null,
                        ("count", new HtmlString($"<strong>{Model.Articles.Count.ToString("N0", culture)}</strong>")))</span>
                    @if (filtered)
                    {
                        <a class="news-clear" href="@Url.Action("Index", "News")">@L["News.Filter.Clear"]</a>
                    }
                </p>
                bool lead = true;
                foreach (var group in Model.Articles.GroupBy(a => AgeGroup(a.PublishedAt)))
                {
                    <section class="news-group" aria-label="@L[group.Key]">
                        <h3 class="news-group-title">@L[group.Key]</h3>
                        <ol class="news-list">
                            @foreach (var article in group)
                            {
                                bool hasImage = !string.IsNullOrEmpty(article.ImageUrl);
                                string summaryId = "summary-" + article.Url.GetHashCode().ToString("x", CultureInfo.InvariantCulture);
                                <li class="news-item@(lead ? " is-lead" : "")@(hasImage ? " has-img" : "")" data-article-url="@article.Url">
                                    <div class="news-item-text">
                                        <p class="news-meta">
                                            <span class="news-source">@article.Source</span>
                                            <span class="news-topic" data-topic="@article.Category">@article.Category</span>
                                            <time datetime="@article.PublishedAt.ToString("o")" title="@DateAndTime(article.PublishedAt)"></time>
                                        </p>
                                        <h4 class="news-headline">
                                            <a href="@article.Url" target="_blank" rel="noopener noreferrer">@article.Title<span class="visually-hidden"> @L["News.OpensInNewTab"]</span></a>
                                        </h4>
                                        @if (!string.IsNullOrEmpty(article.Description))
                                        {
                                            <p class="news-desc">@article.Description</p>
                                        }
                                        <div class="news-actions">
                                            <button type="button" class="news-action news-save-btn" aria-pressed="false"
                                                    data-title="@article.Title" data-url="@article.Url" data-source="@article.Source"
                                                    data-category="@article.Category" data-image-url="@article.ImageUrl"
                                                    title="@L["News.Js.Save.Title"]" aria-label="@L["News.Js.Save.Label"]">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                                                <span class="news-save-label">@L["News.Js.Save.Button"]</span>
                                            </button>
                                            <button type="button" class="news-action news-summarize-btn" aria-expanded="false" aria-controls="@summaryId"
                                                    data-article-url="@article.Url" data-article-title="@article.Title" data-article-description="@article.Description"
                                                    title="@L["News.Js.Summary.Title"]" aria-label="@L["News.Summary.Label"]">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                                <span class="news-summarize-label">@L["News.Js.Summary.Button"]</span>
                                            </button>
                                        </div>
                                        <div class="news-summary" id="@summaryId" aria-live="polite" hidden>
                                            <div class="news-summary-content"></div>
                                            <p class="news-summary-disclosure">@L["News.Summary.Disclosure"]</p>
                                        </div>
                                    </div>
                                    @if (hasImage)
                                    {
                                        <div class="news-thumb"><img src="@article.ImageUrl" alt="" loading="lazy"/></div>
                                    }
                                </li>
                                lead = false;
                            }
                        </ol>
                    </section>
                }
            }
        </main>

        <aside class="news-rail" aria-label="@L["News.Rail.Label"]">
            <details class="news-rail-card" open data-news-rail>
                <summary>
                    <h2>@L["News.Watchlist.Title"]</h2>
                    <span class="news-pill" id="watchlistCount" hidden></span>
                </summary>
                <ul class="news-watchlist" id="watchlistList" aria-live="polite"></ul>
                <p class="news-rail-note" id="watchlistMessage">@L["News.Js.Watchlist.Loading"]</p>
            </details>

            @if (Model.Sources.Count > 0 && string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <details class="news-rail-card" open data-news-rail>
                    <summary><h2>@L["News.Sources.Title"]</h2></summary>
                    <nav aria-label="@L["News.Filter.Source"]">
                        <ul class="news-sources">
                            <li>
                                <a href="@FilterUrl(Model.SelectedCategory, null)" aria-current="@(string.IsNullOrEmpty(Model.SelectedSource) ? "page" : null)">
                                    <span class="news-source-name">@L["News.Filter.AllSources"]</span>
                                </a>
                            </li>
                            @foreach (var source in Model.Sources)
                            {
                                <li>
                                    <a href="@FilterUrl(Model.SelectedCategory, source.Name)" aria-current="@(Model.SelectedSource == source.Name ? "page" : null)">
                                        <span class="news-source-name">@source.Name</span>
                                        <span class="news-topic" data-topic="@source.Category">@source.Category</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </details>
            }
        </aside>
    </div>
</div>

@section Scripts {
    <js-strings prefix="News.Js." />
    <script src="~/js/news/news.js" asp-append-version="true"></script>
    <script src="~/js/news/news-summary.js" asp-append-version="true"></script>
}
