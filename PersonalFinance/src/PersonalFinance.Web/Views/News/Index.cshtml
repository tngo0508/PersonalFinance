@using PersonalFinance.Web.Features.Watchlist
@model NewsViewModel

@{
    ViewData["Title"] = "Finance News";
}

@section Styles {
    <link rel="stylesheet" href="~/css/news.css" asp-append-version="true"/>
}

<div class="finance-hub">
    <!-- Page Header -->
    <div class="finance-hub-header">
        <div class="finance-hub-header-content">
            <div class="finance-hub-icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2.5a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4Z"/>
                </svg>
            </div>
            <div>
                <h1 class="finance-hub-title">Finance News</h1>
                <p class="finance-hub-subtitle">Stay informed with the latest personal finance news and articles.</p>
            </div>
        </div>
    </div>

    <!-- Tab Navigation -->
    <ul class="finance-hub-tabs" role="tablist" aria-label="Finance news sections">
        <li class="finance-hub-tab" role="presentation">
            <button class="finance-hub-tab-btn active" id="tab-news" role="tab" aria-controls="panel-news" aria-selected="true" data-tab="news">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2.5a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4Z"/></svg>
                News
            </button>
        </li>
        <li class="finance-hub-tab" role="presentation">
            <button class="finance-hub-tab-btn" id="tab-watchlist" role="tab" aria-controls="panel-watchlist" aria-selected="false" data-tab="watchlist">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                Watchlist
            </button>
        </li>
    </ul>

    <!-- Error Message -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="finance-hub-alert alert-danger" role="alert">
            <strong>Unable to load data</strong>
            <p>@Model.ErrorMessage</p>
        </div>
    }

    <!-- ==================== NEWS PANEL ==================== -->
    <div class="finance-hub-panel active" id="panel-news" role="tabpanel" aria-labelledby="tab-news">
        <!-- Search and Filters -->
        <div class="finance-hub-filters card">
            <form method="get" class="finance-hub-filter-form" id="newsFilterForm">
                <div class="finance-hub-search-box">
                    <svg class="finance-hub-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                    </svg>
                    <input type="text" name="search" class="form-control finance-hub-search-input"
                           value="@Model.SearchQuery" placeholder="Search articles..." aria-label="Search news articles"/>
                </div>

                <!-- Personal Finance Category Filter -->
                <div class="finance-hub-filter-group">
                    <select name="category" id="categoryFilter" class="form-select finance-hub-filter-select" onchange="this.form.submit()" aria-label="Filter by topic">
                        <option value="">All Topics</option>
                        @foreach (var cat in Model.PersonalFinanceCategories)
                        {
                            <option value="@cat" selected="@(Model.SelectedCategory == cat)">@cat</option>
                        }
                    </select>
                </div>

                <!-- Source Filter -->
                @if (Model.Sources.Count > 0)
                {
                    <div class="finance-hub-filter-group">
                        <select name="source" id="sourceFilter" class="form-select finance-hub-filter-select" onchange="this.form.submit()" aria-label="Filter by source">
                            <option value="">All Sources</option>
                            @foreach (var src in Model.Sources)
                            {
                                <option value="@src.Name" selected="@(Model.SelectedSource == src.Name)">@src.Name</option>
                            }
                        </select>
                    </div>
                }

                <div class="finance-hub-filter-actions">
                    <button type="submit" class="btn btn-primary finance-hub-search-btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                        </svg>
                        Search
                    </button>
                    @if (!string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.SelectedCategory) || !string.IsNullOrEmpty(Model.SelectedSource))
                    {
                        <a href="@Url.Action("Index", "News")" class="btn finance-hub-clear-btn">Clear</a>
                    }
                </div>
            </form>
        </div>

        @if (Model.LastRefreshed.HasValue)
        {
            <div class="finance-hub-refresh-bar">
                <time class="finance-hub-refresh-time" datetime="@Model.LastRefreshed.Value.ToString("o")">
                    Last updated: @Model.LastRefreshed.Value.ToString("MMM dd, yyyy 'at' hh:mm tt")
                </time>
                <button type="button" class="btn finance-hub-refresh-btn" id="refreshBtn" title="Refresh news">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/>
                        <path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/>
                    </svg>
                    Refresh
                </button>
            </div>
        }

        @if (Model.IsLoading)
        {
            <div class="finance-hub-loading">
                <div class="finance-hub-spinner"></div>
                <p>Loading articles...</p>
            </div>
        }
        else if (Model?.Articles?.Any() == true)
        {
            <div class="finance-hub-results-info">
                <span><strong>@Model.Articles.Count</strong> @(Model.Articles.Count == 1 ? "article" : "articles")</span>
            </div>
            <div class="finance-hub-grid" id="newsGrid">
                @foreach (var article in Model.Articles)
                {
                    <article class="finance-hub-card" data-article-url="@article.Url">
                        @if (!string.IsNullOrEmpty(article.ImageUrl))
                        {
                            <a href="@article.Url" class="finance-hub-card-img-link" target="_blank" rel="noopener noreferrer">
                                <div class="finance-hub-card-img">
                                    <img src="@article.ImageUrl" alt="" loading="lazy" onerror="this.parentElement.parentElement.style.display='none'"/>
                                </div>
                            </a>
                        }
                        <div class="finance-hub-card-body">
                            <div class="finance-hub-card-meta">
                                <span class="finance-hub-badge source-badge" title="@article.Source">@article.Source</span>
                                <span class="finance-hub-badge category-badge">@article.Category</span>
                            </div>
                            <h3 class="finance-hub-card-title">
                                <a href="@article.Url" target="_blank" rel="noopener noreferrer">@article.Title</a>
                            </h3>
                            @if (!string.IsNullOrEmpty(article.Description))
                            {
                                <p class="finance-hub-card-desc">@article.Description</p>
                            }
                            <div class="finance-hub-card-summary" id="summary-@article.Url.GetHashCode()"
                                 data-article-url="@article.Url" data-article-title="@article.Title"
                                 data-article-description="@article.Description" hidden>
                                <div class="finance-hub-summary-content"></div>
                                <div class="finance-hub-summary-disclosure">
                                    <small>AI-generated summary · Source may be limited</small>
                                </div>
                            </div>
                            <div class="finance-hub-card-footer">
                                <time class="finance-hub-card-time" datetime="@article.PublishedAt.ToString("o")" title="@article.PublishedAt.ToString("MMM dd, yyyy 'at' hh:mm tt")">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                                    </svg>
                                    <span class="article-time-label"></span>
                                </time>
                                <div class="finance-hub-card-actions">
                                    <button type="button" class="btn btn-sm finance-hub-save-btn"
                                            data-title="@article.Title"
                                            data-url="@article.Url"
                                            data-source="@article.Source"
                                            data-category="@article.Category"
                                            data-image-url="@article.ImageUrl"
                                            title="Save to watchlist" aria-label="Save article to watchlist">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                                        </svg>
                                        Save
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline finance-hub-summarize-btn"
                                            data-article-url="@article.Url"
                                            data-article-title="@article.Title"
                                            data-article-description="@article.Description"
                                            title="Summarize with AI" aria-label="Summarize article with AI">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2">
                                            <path d="M12 20h9"/>
                                            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                                        </svg>
                                        Summarize
                                    </button>
                                    <a href="@article.Url" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline finance-hub-read-more">
                                        Read
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="finance-hub-empty">
                <div class="finance-hub-empty-icon" aria-hidden="true">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Z"/>
                    </svg>
                </div>
                <h3>No articles found</h3>
                <p>Try adjusting your search or filter criteria.</p>
                <a href="@Url.Action("Index", "News")" class="btn btn-primary">View All News</a>
            </div>
        }
    </div>

    <!-- ==================== WATCHLIST PANEL ==================== -->
    <div class="finance-hub-panel" id="panel-watchlist" role="tabpanel" aria-labelledby="tab-watchlist">
        <div class="watchlist-section">
            <div class="watchlist-header">
                <h2>My Watchlist</h2>
                <p>Articles you've saved for later reading.</p>
            </div>
            <div id="watchlistGrid" class="watchlist-grid">
                <!-- Loaded via JS -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/news/news.js" asp-append-version="true"></script>
    <script src="~/js/news/news-summary.js" asp-append-version="true"></script>
}
