@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using PersonalFinance.Shared.Constants
@inject SignInManager<IdentityUser> SignInManager
@inject IAuthorizationService AuthorizationService

@if (SignInManager.IsSignedIn(User))
{
    var profilePictureUrl = User.FindFirst("urn:google:picture")?.Value
                         ?? User.FindFirst("profile_picture")?.Value;
    var email = User.FindFirst(ClaimTypes.Email)?.Value ?? User.Identity?.Name ?? string.Empty;
    var displayName = User.FindFirst(ClaimTypes.GivenName)?.Value
                   ?? (email.Contains('@') ? email[..email.IndexOf('@')] : email);
    var initial = string.IsNullOrEmpty(displayName) ? "?" : displayName[..1].ToUpperInvariant();
    var isAdmin = (await AuthorizationService.AuthorizeAsync(User, AppPolicies.RequireAdmin)).Succeeded;

    <partial name="_ThemeSwitcher"/>
    <ul class="navbar-nav align-items-md-center">
        <li class="nav-item dropdown">
            <button type="button" class="btn app-user-toggle dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@L.Named("Shell.Account.MenuFor", ("name", displayName))">
                @if (!string.IsNullOrEmpty(profilePictureUrl))
                {
                    <img src="@profilePictureUrl" alt="" class="app-avatar" width="32" height="32" referrerpolicy="no-referrer" />
                }
                else
                {
                    <span class="app-avatar app-avatar--initial" aria-hidden="true">@initial</span>
                }
                <span class="app-user-name">@displayName</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm app-user-menu">
                <li class="px-3 py-2">
                    <div class="fw-semibold text-truncate">@displayName</div>
                    <div class="small text-muted text-truncate">@email</div>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">@L["Shell.Account.Settings"]</a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <partial name="_LanguageSwitcher" model="@("menu")"/>
                @if (isAdmin)
                {
                    <li>
                        <a class="dropdown-item" asp-area="" asp-controller="Admin" asp-action="Index">@L["Shell.Account.Admin"]</a>
                    </li>
                }
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form asp-area="Identity" asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="dropdown-item">@L["Shell.Account.SignOut"]</button>
                    </form>
                </li>
            </ul>
        </li>
    </ul>
}
else
{
    <div class="topbar-auth">
        <partial name="_LanguageSwitcher" model="@("inline")"/>
        <partial name="_ThemeSwitcher"/>
        <a class="btn btn-sm btn-outline-primary" asp-area="Identity" asp-page="/Account/Login">@L["Shell.Account.SignIn"]</a>
        <a class="btn btn-sm btn-primary" asp-area="Identity" asp-page="/Account/Register">@L["Shell.Account.CreateAccount"]</a>
    </div>
}
