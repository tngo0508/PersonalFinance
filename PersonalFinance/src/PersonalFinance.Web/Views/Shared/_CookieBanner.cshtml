<div id="cookieBanner" class="cookie-banner" role="region" aria-label="Cookie consent" hidden>
    <div class="cookie-banner__content">
        <p class="cookie-banner__text">
            We use essential cookies to keep your account secure. We also load fonts and icons from third-party services.
            <a asp-area="" asp-controller="Legal" asp-action="Cookies">Learn more</a>.
        </p>
        <div class="cookie-banner__actions">
            <button id="cookieAcceptAll" class="btn btn-primary btn-sm" type="button">Accept All</button>
            <button id="cookieAcceptEssential" class="btn btn-outline-secondary btn-sm" type="button">Essential Only</button>
        </div>
    </div>
</div>
