@using Microsoft.AspNetCore.Antiforgery
@using PersonalFinance.Shared.Constants
<!DOCTYPE html>
@inject IAntiforgery Antiforgery
@{
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var currentController = ViewContext.RouteData.Values["controller"] as string;
    var pageTitle = ViewData["Title"] as string;
    var tokens = Antiforgery.GetAndStoreTokens(Context);
}
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="theme-color" content="#ffffff"/>
    <meta name="__RequestVerificationToken" content="@tokens.RequestToken" />
    <title>@(string.IsNullOrEmpty(pageTitle) ? AppVersion.ApplicationName : $"{pageTitle} · {AppVersion.ApplicationName}")</title>
    <link rel="icon" href="~/favicon.ico"/>
    <!-- Third-party resources (Google Fonts, Lucide) are loaded after cookie consent -->
    <script>
        (function () {
            try {
                if (localStorage.getItem('sidebar-collapsed') === 'true') {
                    document.documentElement.classList.add('sidebar-collapsed');
                }
            } catch (e) {}
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/ai-chat-widget.css" asp-append-version="true"/>
</head>
<body class="app-body @(isSignedIn ? "has-sidebar" : "no-sidebar")">
<a class="visually-hidden-focusable app-skip-link" href="#main-content">Skip to main content</a>

@if (isSignedIn)
{
    <!-- Sidebar Overlay (mobile) -->
    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="sidebar" aria-label="Main navigation">
        <div class="sidebar-header">
            <a class="sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="sidebar-brand-icon">
                    <i data-lucide="trending-up"></i>
                </span>
                <span class="sidebar-brand-name">@AppVersion.ApplicationName</span>
            </a>
            <button id="sidebarToggle" class="sidebar-toggle" aria-label="Toggle sidebar" aria-expanded="true">
                <i data-lucide="panel-left" style="width:20px;height:20px"></i>
            </button>
        </div>

        <nav class="sidebar-nav">
            <!-- Overview -->
            <div class="sidebar-group">
                <div class="sidebar-group-label">Overview</div>
                <a class="sidebar-link @(currentController == "Dashboard" ? "active" : "")"
                   asp-area="" asp-controller="Dashboard" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="layout-dashboard"></i></span>
                    <span class="sidebar-link-text">Dashboard</span>
                </a>
            </div>

            <!-- My Finances -->
            <div class="sidebar-group">
                <div class="sidebar-group-label">My Finances</div>
                <a class="sidebar-link @(currentController == "Networth" ? "active" : "")"
                   asp-area="" asp-controller="Networth" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="dollar-sign"></i></span>
                    <span class="sidebar-link-text">Net Worth</span>
                </a>
                <a class="sidebar-link @(currentController == "BudgetTracker" ? "active" : "")"
                   asp-area="" asp-controller="BudgetTracker" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="receipt"></i></span>
                    <span class="sidebar-link-text">Budget Tracker</span>
                </a>
                <a class="sidebar-link @(currentController == "Budget" ? "active" : "")"
                   asp-area="" asp-controller="Budget" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="pie-chart"></i></span>
                    <span class="sidebar-link-text">Budget Planner</span>
                </a>
                <a class="sidebar-link @(currentController == "SavingsGoals" ? "active" : "")"
                   asp-area="" asp-controller="SavingsGoals" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="target"></i></span>
                    <span class="sidebar-link-text">Savings Goals</span>
                </a>
                <a class="sidebar-link @(currentController == "Analysis" ? "active" : "")"
                   asp-area="" asp-controller="Analysis" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="bar-chart-3"></i></span>
                    <span class="sidebar-link-text">Analysis</span>
                </a>
            </div>

            <!-- Resources -->
            <div class="sidebar-group">
                <div class="sidebar-group-label">Resources</div>
                <a class="sidebar-link @(currentController == "InvestmentCalculator" ? "active" : "")"
                   asp-area="" asp-controller="InvestmentCalculator" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="calculator"></i></span>
                    <span class="sidebar-link-text">Investment Calculator</span>
                </a>
                <a class="sidebar-link @(currentController == "News" ? "active" : "")"
                   asp-area="" asp-controller="News" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="newspaper"></i></span>
                    <span class="sidebar-link-text">Finance News</span>
                </a>
                <a class="sidebar-link @(currentController == "Community" ? "active" : "")"
                   asp-area="" asp-controller="Community" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="users"></i></span>
                    <span class="sidebar-link-text">Community</span>
                </a>
                <a class="sidebar-link @(currentController == "GoogleDrive" ? "active" : "")"
                   asp-area="" asp-controller="GoogleDrive" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="folder-open"></i></span>
                    <span class="sidebar-link-text">Google Drive</span>
                </a>
            </div>
        </nav>
    </aside>
}

<!-- Main Content Area -->
<div class="app-content">
    <!-- Top Bar -->
    <header class="topbar">
        @if (isSignedIn)
        {
            <button id="mobileMenuToggle" class="topbar-btn d-md-none" aria-label="Open menu" aria-expanded="false" aria-controls="sidebar">
                <i data-lucide="menu"></i>
            </button>

            <!-- Search -->
            <div class="topbar-search">
                <span class="topbar-search-icon">
                    <i data-lucide="search"></i>
                </span>
                <input type="text" id="topbarSearchInput" class="topbar-search-input"
                       placeholder="Search transactions, budgets, goals..." aria-label="Search">
                <div id="searchResultsDropdown" class="search-results-dropdown"></div>
            </div>

            <!-- Actions -->
            <div class="topbar-actions">
                <!-- Notification Bell -->
                <button id="notificationBell" class="topbar-btn" aria-label="Notifications">
                    <i data-lucide="bell"></i>
                    <span id="notificationBadge" class="topbar-badge hidden">0</span>
                </button>
                <div id="notificationDropdown" class="notification-dropdown"></div>

                <!-- User Profile -->
                <partial name="_LoginPartial"/>
            </div>
        }
        else
        {
            <a class="sidebar-brand text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index" style="color: #24292f;">
                <span class="sidebar-brand-icon" style="color: var(--app-brand);">
                    <i data-lucide="trending-up"></i>
                </span>
                <span class="sidebar-brand-name" style="color: #24292f;">@AppVersion.ApplicationName</span>
            </a>
            <div class="topbar-actions ms-auto">
                <partial name="_LoginPartial"/>
            </div>
        }
    </header>

    <!-- Main Content -->
    <main id="main-content" class="app-main" role="main" tabindex="-1">
        <div class="container-xl">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="app-footer">
        <div class="container-xl">
            <div class="row align-items-center">
                <div class="col-12 col-md-6 text-center text-md-start mb-2 mb-md-0">
                    <span>&copy; @DateTime.Now.Year @AppVersion.ApplicationName — Version @AppVersion.Current</span>
                </div>
                <div class="col-12 col-md-6 text-center text-md-end">
                    <ul class="app-footer__links justify-content-center justify-content-md-end">
                        <li><a asp-area="" asp-controller="Legal" asp-action="Privacy">Privacy Policy</a></li>
                        <li><a asp-area="" asp-controller="Legal" asp-action="Terms">Terms of Service</a></li>
                        <li><a asp-area="" asp-controller="Legal" asp-action="Disclaimer">Disclaimer</a></li>
                        <li><a asp-area="" asp-controller="Legal" asp-action="Cookies">Cookies</a></li>
                        <li><a asp-area="" asp-controller="Legal" asp-action="Contact">Contact</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>
</div>

<!-- Cookie Consent Banner -->
<partial name="_CookieBanner" />

<!-- Mobile Bottom Navigation -->
@if (isSignedIn)
{
    <nav class="bottom-nav" aria-label="Mobile navigation">
        <a class="bottom-nav-item @(currentController == "Dashboard" ? "active" : "")"
           asp-area="" asp-controller="Dashboard" asp-action="Index">
            <i data-lucide="layout-dashboard"></i>
            <span>Home</span>
        </a>
        <a class="bottom-nav-item @(currentController == "Networth" || currentController == "Budget" || currentController == "SavingsGoals" || currentController == "Analysis" ? "active" : "")"
           asp-area="" asp-controller="Networth" asp-action="Index">
            <i data-lucide="dollar-sign"></i>
            <span>Finances</span>
        </a>
        <a class="bottom-nav-item @(currentController == "InvestmentCalculator" || currentController == "News" || currentController == "GoogleDrive" ? "active" : "")"
           asp-area="" asp-controller="InvestmentCalculator" asp-action="Index">
            <i data-lucide="calculator"></i>
            <span>Tools</span>
        </a>
        <a class="bottom-nav-item @(currentController == "Community" ? "active" : "")"
           asp-area="" asp-controller="Community" asp-action="Index">
            <i data-lucide="users"></i>
            <span>Community</span>
        </a>
        <a class="bottom-nav-item" asp-area="Identity" asp-page="/Account/Manage/Index" aria-label="Profile">
            <i data-lucide="user"></i>
            <span>Profile</span>
        </a>
    </nav>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/marked/marked.min.js"></script>
<script src="~/js/core/utils.js" asp-append-version="true"></script>
<script src="~/js/core/site.js" asp-append-version="true"></script>
<script src="~/js/core/cookie-consent.js" asp-append-version="true"></script>
@if (isSignedIn)
{
    <script src="~/js/core/sidebar.js" asp-append-version="true"></script>
    <script src="~/js/core/search.js" asp-append-version="true"></script>
    <script src="~/js/core/notifications.js" asp-append-version="true"></script>
    <script src="~/js/core/ai-chat-widget.js" asp-append-version="true"></script>
    <script src="~/js/core/data-source-toggle.js" asp-append-version="true"></script>
}
@await RenderSectionAsync("Scripts", required: false)
<script>
    // Initialize Lucide icons (only if loaded via cookie consent)
    if (typeof lucide !== 'undefined' && lucide.createIcons) {
        lucide.createIcons();
    }
</script>
</body>
</html>
