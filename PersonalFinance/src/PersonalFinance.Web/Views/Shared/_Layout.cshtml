@using Microsoft.AspNetCore.Antiforgery
@using PersonalFinance.Shared.Constants
<!DOCTYPE html>
@inject IAntiforgery Antiforgery
@{
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var currentController = ViewContext.RouteData.Values["controller"] as string;
    var pageTitle = ViewData["Title"] as string;
    var tokens = Antiforgery.GetAndStoreTokens(Context);
}
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="theme-color" content="#ffffff"/>
    <meta name="__RequestVerificationToken" content="@tokens.RequestToken" />
    <title>@(string.IsNullOrEmpty(pageTitle) ? AppVersion.ApplicationName : $"{pageTitle} · {AppVersion.ApplicationName}")</title>
    <link rel="icon" href="~/favicon.ico"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/ai-chat-widget.css" asp-append-version="true"/>
</head>
<body class="app-body">
<a class="visually-hidden-focusable app-skip-link" href="#main-content">Skip to main content</a>

<header class="app-header">
    <nav class="navbar navbar-expand-md" aria-label="Main navigation">
        <div class="container-xl">
            <a class="navbar-brand app-brand" asp-area="" asp-controller="GoogleDrive" asp-action="Index">
                <span class="app-brand-mark" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
                        <path d="M1 13.5a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 0-1H2V2.5a.5.5 0 0 0-1 0v11z"/>
                        <path d="M4.5 11a.5.5 0 0 1-.354-.854l3-3a.5.5 0 0 1 .708 0L9.5 8.793l3.646-3.647a.5.5 0 0 1 .708.708l-4 4a.5.5 0 0 1-.708 0L7.5 8.207l-2.646 2.647A.5.5 0 0 1 4.5 11z"/>
                    </svg>
                </span>
                <span class="app-brand-name">@AppVersion.ApplicationName</span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#appNavbar"
                    aria-controls="appNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="appNavbar">
                @if (isSignedIn)
                {
                    <ul class="navbar-nav me-auto app-nav">
                        <li class="nav-item">
                            @{ var isDriveActive = currentController == "GoogleDrive"; }
                            <a class="nav-link @(isDriveActive ? "active" : "")" aria-current="@(isDriveActive ? "page" : null)"
                               asp-area="" asp-controller="GoogleDrive" asp-action="Index">
                                Google Drive
                            </a>
                        </li>
                        <li class="nav-item">
                            @{ var isAnalysisActive = currentController == "Analysis"; }
                            <a class="nav-link @(isAnalysisActive ? "active" : "")"
                               aria-current="@(isAnalysisActive ? "page" : null)"
                               asp-area="" asp-controller="Analysis" asp-action="Index">
                                Analysis
                            </a>
                        </li>
                        <li class="nav-item">
                            @{ var isNetworthActive = currentController == "Networth"; }
                            <a class="nav-link @(isNetworthActive ? "active" : "")" aria-current="@(isNetworthActive ? "page" : null)"
                               asp-area="" asp-controller="Networth" asp-action="Index">
                                Net Worth
                            </a>
                        </li>
                        <li class="nav-item">
                            @{ var isNewsActive = currentController == "News"; }
                            <a class="nav-link @(isNewsActive ? "active" : "")" aria-current="@(isNewsActive ? "page" : null)"
                               asp-area="" asp-controller="News" asp-action="Index">
                                Finance News
                            </a>
                        </li>
                        <li class="nav-item">
                            @{ var isBudgetActive = currentController == "Budget"; }
                            <a class="nav-link @(isBudgetActive ? "active" : "")"
                               aria-current="@(isBudgetActive ? "page" : null)"
                               asp-area="" asp-controller="Budget" asp-action="Index">
                                Budget Planner
                            </a>
                        </li>
                        <li class="nav-item">
                            @{ var isSavingsActive = currentController == "SavingsGoals"; }
                            <a class="nav-link @(isSavingsActive ? "active" : "")"
                               aria-current="@(isSavingsActive ? "page" : null)"
                               asp-area="" asp-controller="SavingsGoals" asp-action="Index">
                                Savings Goals
                            </a>
                        </li>
                        <li class="nav-item">
                            @{ var isCalculatorActive = currentController == "InvestmentCalculator"; }
                            <a class="nav-link @(isCalculatorActive ? "active" : "")"
                               aria-current="@(isCalculatorActive ? "page" : null)"
                               asp-area="" asp-controller="InvestmentCalculator" asp-action="Index">
                                Investment Calculator
                            </a>
                        </li>
                        <li class="nav-item">
                            @{ var isCommunityActive = currentController == "Community"; }
                            <a class="nav-link @(isCommunityActive ? "active" : "")" aria-current="@(isCommunityActive ? "page" : null)"
                               asp-area="" asp-controller="Community" asp-action="Index">
                                Community
                            </a>
                        </li>
                    </ul>
                }
                else
                {
                    <div class="me-auto"></div>
                }
                <partial name="_LoginPartial"/>
            </div>
        </div>
    </nav>
</header>

<main id="main-content" class="app-main" role="main" tabindex="-1">
    <div class="container-xl">
        @RenderBody()
    </div>
</main>

<footer class="app-footer">
    <div class="container-xl d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>&copy; @DateTime.Now.Year @AppVersion.ApplicationName</span>
        <span>Version @AppVersion.Current</span>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/marked/marked.min.js"></script>
    <script src="~/js/core/utils.js" asp-append-version="true"></script>
    <script src="~/js/core/site.js" asp-append-version="true"></script>
    @if (isSignedIn)
    {
        <script src="~/js/core/ai-chat-widget.js" asp-append-version="true"></script>
    }
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
