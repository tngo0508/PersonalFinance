@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Authorization
@using PersonalFinance.Shared.Constants
@using PersonalFinance.Web.Infrastructure
<!DOCTYPE html>
@inject IAntiforgery Antiforgery
@inject IAuthorizationService AuthorizationService
@{
    var isAdmin = User.Identity?.IsAuthenticated == true
                  && (await AuthorizationService.AuthorizeAsync(User, AppPolicies.RequireAdmin)).Succeeded;
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var currentController = ViewContext.RouteData.Values["controller"] as string;
    var pageTitle = ViewData["Title"] as string;
    // A view sets DocumentTitle to replace the whole tab title (the landing page's tagline); otherwise "<Page> · PersonalFinance".
    var documentTitle = ViewData["DocumentTitle"] as string
                        ?? (string.IsNullOrEmpty(pageTitle) ? AppVersion.ApplicationName : $"{pageTitle} · {AppVersion.ApplicationName}");
    var tokens = Antiforgery.GetAndStoreTokens(Context);
}
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="theme-color" content="#ffffff"/>
    <meta name="__RequestVerificationToken" content="@tokens.RequestToken" />
    <title>@documentTitle</title>
    <link rel="icon" href="~/favicon.ico" sizes="32x32"/>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml"/>
    <link rel="icon" href="~/favicon-32x32.png" type="image/png" sizes="32x32"/>
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png"/>
    <!-- Third-party resources (Google Fonts, Lucide) are loaded after cookie consent -->
    <script>
        (function () {
            try {
                if (localStorage.getItem('sidebar-collapsed') === 'true') {
                    document.documentElement.classList.add('sidebar-collapsed');
                }
            } catch (e) {}
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/ledger.css" asp-append-version="true"/>
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/ai-chat-widget.css" asp-append-version="true"/>
</head>
<body class="app-body @(isSignedIn ? "has-sidebar" : "no-sidebar")">
<a class="visually-hidden-focusable app-skip-link" href="#main-content">@L["Shell.SkipToContent"]</a>

@if (isSignedIn)
{
    <!-- Sidebar Overlay (mobile) -->
    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="sidebar" aria-label="@L["Shell.Nav.Label"]">
        <div class="sidebar-header">
            <a class="sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="sidebar-brand-icon">
                    <i data-lucide="trending-up"></i>
                </span>
                <span class="sidebar-brand-name">@AppVersion.ApplicationName</span>
            </a>
            <button id="sidebarToggle" class="sidebar-toggle" aria-label="@L["Shell.Nav.ToggleSidebar"]" aria-expanded="true">
                <i data-lucide="panel-left" style="width:20px;height:20px"></i>
            </button>
        </div>

        <nav class="sidebar-nav">
            <!-- Overview -->
            <div class="sidebar-group">
                <div class="sidebar-group-label">@L["Shell.Nav.Overview"]</div>
                <a class="sidebar-link @(currentController == "Dashboard" ? "active" : "")"
                   asp-area="" asp-controller="Dashboard" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="layout-dashboard"></i></span>
                    <span class="sidebar-link-text">@L["Shell.Nav.Dashboard"]</span>
                </a>
            </div>

            <!-- My Finances -->
            <div class="sidebar-group">
                <div class="sidebar-group-label">@L["Shell.Nav.MyFinances"]</div>
                <a class="sidebar-link @(currentController == "Networth" ? "active" : "")"
                   asp-area="" asp-controller="Networth" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="dollar-sign"></i></span>
                    <span class="sidebar-link-text">@L["Shell.Nav.NetWorth"]</span>
                </a>
                <a class="sidebar-link @(currentController == "BudgetTracker" ? "active" : "")"
                   asp-area="" asp-controller="BudgetTracker" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="receipt"></i></span>
                    <span class="sidebar-link-text">@L["Shell.Nav.BudgetTracker"]</span>
                </a>
                <a class="sidebar-link @(currentController == "Budget" ? "active" : "")"
                   asp-area="" asp-controller="Budget" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="pie-chart"></i></span>
                    <span class="sidebar-link-text">@L["Shell.Nav.BudgetPlanner"]</span>
                </a>
                <a class="sidebar-link @(currentController == "SavingsGoals" ? "active" : "")"
                   asp-area="" asp-controller="SavingsGoals" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="target"></i></span>
                    <span class="sidebar-link-text">@L["Shell.Nav.SavingsGoals"]</span>
                </a>
                <a class="sidebar-link @(currentController == "MoneyPriorities" ? "active" : "")"
                   asp-area="" asp-controller="MoneyPriorities" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="signpost"></i></span>
                    <span class="sidebar-link-text">@L["Shell.Nav.MoneyPriorities"]</span>
                </a>
                <a class="sidebar-link @(currentController == "Analysis" ? "active" : "")"
                   asp-area="" asp-controller="Analysis" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="bar-chart-3"></i></span>
                    <span class="sidebar-link-text">@L["Shell.Nav.Analysis"]</span>
                </a>
            </div>

            <!-- Resources -->
            <div class="sidebar-group">
                <div class="sidebar-group-label">@L["Shell.Nav.Resources"]</div>
                <a class="sidebar-link @(currentController == "InvestmentCalculator" ? "active" : "")"
                   asp-area="" asp-controller="InvestmentCalculator" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="calculator"></i></span>
                    <span class="sidebar-link-text">@L["Shell.Nav.InvestmentCalculator"]</span>
                </a>
                <a class="sidebar-link @(currentController == "Research" ? "active" : "")"
                   asp-area="" asp-controller="Research" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="globe"></i></span>
                    <span class="sidebar-link-text">@L["Shell.Nav.Research"]</span>
                </a>
                <a class="sidebar-link @(currentController == "News" ? "active" : "")"
                   asp-area="" asp-controller="News" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="newspaper"></i></span>
                    <span class="sidebar-link-text">@L["Shell.Nav.FinanceNews"]</span>
                </a>
                <a class="sidebar-link @(currentController == "Community" ? "active" : "")"
                   asp-area="" asp-controller="Community" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="users"></i></span>
                    <span class="sidebar-link-text">@L["Shell.Nav.Community"]</span>
                </a>
                <a class="sidebar-link @(currentController == "GoogleDrive" ? "active" : "")"
                   asp-area="" asp-controller="GoogleDrive" asp-action="Index">
                    <span class="sidebar-link-icon"><i data-lucide="folder-open"></i></span>
                    <span class="sidebar-link-text">Google Drive</span>
                </a>
                <a class="sidebar-link @(currentController == "Feedback" ? "active" : "")"
                   asp-area="" asp-controller="Feedback" asp-action="Index" asp-route-from="@FeedbackSourcePage.From(Context.Request)">
                    <span class="sidebar-link-icon"><i data-lucide="message-square"></i></span>
                    <span class="sidebar-link-text">@L["Shell.Nav.SendFeedback"]</span>
                </a>
            </div>

            @if (isAdmin)
            {
                <!-- Admin -->
                <div class="sidebar-group">
                    <div class="sidebar-group-label">@L["Shell.Nav.Admin"]</div>
                    <a class="sidebar-link @(currentController == "Admin" ? "active" : "")"
                       asp-area="" asp-controller="Admin" asp-action="Index">
                        <span class="sidebar-link-icon"><i data-lucide="shield-check"></i></span>
                        <span class="sidebar-link-text">@L["Shell.Nav.AdminDashboard"]</span>
                    </a>
                </div>
            }
        </nav>
    </aside>
}

<!-- Main Content Area -->
<div class="app-content">
    <!-- Top Bar -->
    <header class="topbar">
        @if (isSignedIn)
        {
            <button id="mobileMenuToggle" class="topbar-btn d-md-none" aria-label="@L["Shell.Topbar.OpenMenu"]" aria-expanded="false" aria-controls="sidebar">
                <i data-lucide="menu"></i>
            </button>

            <!-- Search -->
            <div class="topbar-search">
                <span class="topbar-search-icon">
                    <i data-lucide="search"></i>
                </span>
                <input type="text" id="topbarSearchInput" class="topbar-search-input"
                       placeholder="@L["Shell.Search.Placeholder"]" aria-label="@L["Shell.Search.Label"]"
                       role="combobox" aria-autocomplete="list" aria-expanded="false"
                       aria-controls="searchResultsList" autocomplete="off">
                <div id="searchResultsDropdown" class="search-results-dropdown" hidden>
                    <div id="searchResultsList" role="listbox" aria-label="@L["Shell.Search.ResultsLabel"]"></div>
                    <div id="searchMessage" class="search-empty" hidden>
                        <p id="searchMessageText" class="search-message-text"></p>
                        <button type="button" id="searchRetryButton" class="btn btn-sm btn-outline-secondary" hidden>@L["Shell.Search.TryAgain"]</button>
                    </div>
                </div>
                <div id="searchStatus" class="visually-hidden" role="status" aria-live="polite"></div>
            </div>

            <!-- Actions -->
            <div class="topbar-actions">
                <!-- Notification Bell -->
                <button id="notificationBell" class="topbar-btn" aria-label="@L["Shell.Topbar.Notifications"]">
                    <i data-lucide="bell"></i>
                    <span id="notificationBadge" class="topbar-badge hidden">0</span>
                </button>
                <div id="notificationDropdown" class="notification-dropdown"></div>

                <!-- User Profile -->
                <partial name="_LoginPartial"/>
            </div>
        }
        else
        {
            <a class="sidebar-brand topbar-brand text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="sidebar-brand-icon">
                    <i data-lucide="trending-up"></i>
                </span>
                <span class="sidebar-brand-name">@AppVersion.ApplicationName</span>
            </a>
            <div class="topbar-actions ms-auto">
                <partial name="_LoginPartial"/>
            </div>
        }
    </header>

    <!-- Main Content -->
    <main id="main-content" class="app-main" role="main" tabindex="-1">
        <div class="container-xl">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="app-footer">
        <div class="container-xl">
            <div class="row align-items-center">
                <div class="col-12 col-md-6 text-center text-md-start mb-2 mb-md-0">
                    <span>@L.Named("Shell.Footer.Copyright", ("year", DateTime.Now.Year), ("appName", AppVersion.ApplicationName), ("version", AppVersion.Current))</span>
                </div>
                <div class="col-12 col-md-6 text-center text-md-end">
                    <ul class="app-footer__links justify-content-center justify-content-md-end">
                        <li><a asp-area="" asp-controller="Home" asp-action="About">@L["Shell.Footer.About"]</a></li>
                        <li><a asp-area="" asp-controller="Legal" asp-action="Privacy">@L["Shell.Footer.Privacy"]</a></li>
                        <li><a asp-area="" asp-controller="Legal" asp-action="Terms">@L["Shell.Footer.Terms"]</a></li>
                        <li><a asp-area="" asp-controller="Legal" asp-action="Disclaimer">@L["Shell.Footer.Disclaimer"]</a></li>
                        <li><a asp-area="" asp-controller="Legal" asp-action="Cookies">@L["Shell.Footer.Cookies"]</a></li>
                        <li><a asp-area="" asp-controller="Legal" asp-action="Contact">@L["Shell.Footer.Contact"]</a></li>
                        @if (isSignedIn)
                        {
                            <li><a asp-area="" asp-controller="Feedback" asp-action="Index" asp-route-from="@FeedbackSourcePage.From(Context.Request)">@L["Shell.Nav.SendFeedback"]</a></li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </footer>
</div>

<!-- Cookie Consent Banner -->
<partial name="_CookieBanner" />

<!-- Mobile Bottom Navigation -->
@if (isSignedIn)
{
    <nav class="bottom-nav" aria-label="@L["Shell.BottomNav.Label"]">
        <a class="bottom-nav-item @(currentController == "Dashboard" ? "active" : "")"
           asp-area="" asp-controller="Dashboard" asp-action="Index">
            <i data-lucide="layout-dashboard"></i>
            <span>@L["Shell.BottomNav.Home"]</span>
        </a>
        <a class="bottom-nav-item @(currentController == "Networth" || currentController == "Budget" || currentController == "SavingsGoals" || currentController == "MoneyPriorities" || currentController == "Analysis" ? "active" : "")"
           asp-area="" asp-controller="Networth" asp-action="Index">
            <i data-lucide="dollar-sign"></i>
            <span>@L["Shell.BottomNav.Finances"]</span>
        </a>
        <a class="bottom-nav-item @(currentController == "InvestmentCalculator" || currentController == "Research" || currentController == "News" || currentController == "GoogleDrive" ? "active" : "")"
           asp-area="" asp-controller="InvestmentCalculator" asp-action="Index">
            <i data-lucide="calculator"></i>
            <span>@L["Shell.BottomNav.Tools"]</span>
        </a>
        <a class="bottom-nav-item @(currentController == "Community" ? "active" : "")"
           asp-area="" asp-controller="Community" asp-action="Index">
            <i data-lucide="users"></i>
            <span>@L["Shell.Nav.Community"]</span>
        </a>
        <a class="bottom-nav-item" asp-area="Identity" asp-page="/Account/Manage/Index" aria-label="@L["Shell.BottomNav.Profile"]">
            <i data-lucide="user"></i>
            <span>@L["Shell.BottomNav.Profile"]</span>
        </a>
    </nav>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/marked/marked.min.js"></script>
<script src="~/js/core/utils.js" asp-append-version="true"></script>
<script src="~/js/core/i18n.js" asp-append-version="true"></script>
<script src="~/js/core/site.js" asp-append-version="true"></script>
<script src="~/js/core/cookie-consent.js" asp-append-version="true"></script>
@if (isSignedIn)
{
    <js-strings prefix="Shell.Js." />
    <script src="~/js/core/sidebar.js" asp-append-version="true"></script>
    <script src="~/js/core/search.js" asp-append-version="true"></script>
    <script src="~/js/core/notifications.js" asp-append-version="true"></script>
    <script src="~/js/core/ai-chat-widget.js" asp-append-version="true"></script>
    <script src="~/js/core/data-source-toggle.js" asp-append-version="true"></script>
}
@await RenderSectionAsync("Scripts", required: false)
<script>
    // Initialize Lucide icons (only if loaded via cookie consent)
    if (typeof lucide !== 'undefined' && lucide.createIcons) {
        lucide.createIcons();
    }
</script>
</body>
</html>
