@using PersonalFinance.Web.Infrastructure
@model PersonalFinance.Web.Models.UnavailableStateViewModel
@* Unavailable State panel: the data could not be loaded. Retry is a plain GET of the page, no JS. *@
<section class="unavailable-state" role="status" aria-labelledby="unavailable-state-title">
    <span class="unavailable-state__icon" aria-hidden="true"><i data-lucide="cloud-off"></i></span>
    <div class="unavailable-state__body">
        <h2 id="unavailable-state-title" class="unavailable-state__title">@Model.Heading</h2>
        <p class="unavailable-state__text">Your data is safe. @JsonApiErrorsFilter.UnavailableMessage</p>
    </div>
    <a asp-controller="@Model.RetryController" asp-action="@Model.RetryAction" class="btn btn-primary btn-sm">Retry</a>
</section>
