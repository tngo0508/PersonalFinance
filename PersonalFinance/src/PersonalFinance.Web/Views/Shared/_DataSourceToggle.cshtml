@using PersonalFinance.Shared.Enums
@model PersonalFinance.Shared.Enums.BudgetDataSource

<style>
    .data-source-error {
        margin-top: 0.25rem;
        font-size: 0.875rem;
        color: #dc3545;
    }
</style>

<div class="data-source-toggle d-inline-flex align-items-center flex-column align-items-start"
     data-active-source="@Model">
    @Html.AntiForgeryToken()
    <div class="d-inline-flex align-items-center">
        <span class="data-source-toggle__label me-2 text-muted small fw-medium">@L["Shell.DataSource.Label"]</span>
        <div class="btn-group btn-group-sm" role="group" aria-label="@L["Shell.DataSource.GroupLabel"]">
            <button type="button"
                    class="btn @(Model == BudgetDataSource.GoogleSheet ? "btn-primary active" : "btn-outline-secondary") data-source-btn"
                    data-source="@((int)BudgetDataSource.GoogleSheet)"
                    aria-pressed="@(Model == BudgetDataSource.GoogleSheet ? "true" : "false")">
                Google Sheet
            </button>
            <button type="button"
                    class="btn @(Model == BudgetDataSource.BudgetTracker ? "btn-primary active" : "btn-outline-secondary") data-source-btn"
                    data-source="@((int)BudgetDataSource.BudgetTracker)"
                    aria-pressed="@(Model == BudgetDataSource.BudgetTracker ? "true" : "false")">
                @L["Shell.Nav.BudgetTracker"]
            </button>
        </div>
    </div>
</div>
