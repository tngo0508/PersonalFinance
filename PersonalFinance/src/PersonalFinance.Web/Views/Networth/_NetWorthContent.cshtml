@model NetWorthViewModel
@using System.Text.Json
@using PersonalFinance.Shared.DTOs.NetWorth
@using PersonalFinance.Web.Services
@using Microsoft.AspNetCore.Html

@{
    var projection = Model.Projection!;
    // The inputs are in the chosen currency; the results in the projection's: the Reporting Currency, or the inputs'
    // own when no rate exists (ADR 0016). Each amount input carries its bound (data-max) and each slider its range,
    // scaled to that currency; the selector rescales them from the option's data-bound-scale (#444).
    var inputCurrency = SupportedCurrencies.CodeOrDefault(Model.CurrencyCode);
    var inputSymbol = SupportedCurrencies.Find(inputCurrency)!.Symbol;
}

@functions {
    // Whole units in the request culture; networth-ui.js rewrites the figures after the first recalculation, which
    // runs as soon as the page loads.
    private string FormatCurrency(decimal value)
    {
        return MoneyFormatter.FormatWhole(value, SupportedCurrencies.CodeOrDefault(Model.Projection?.CurrencyCode ?? Model.CurrencyCode));
    }

    private string ScenarioName(string name)
    {
        return L[$"NetWorth.Js.Scenario.{name}"];
    }

    private static IHtmlContent Strong(string text)
    {
        return new HtmlContentBuilder().AppendHtml("<strong>").Append(text).AppendHtml("</strong>");
    }

    private static IHtmlContent Plain(string text)
    {
        return new HtmlContentBuilder().Append(text);
    }

    // The presets networth-presets.js applies by key, as chips under the story or in the More menu.
    private static readonly (string Key, string Id, string LabelKey)[] Presets =
    [
        ("fire", "nwPresetFire", "NetWorth.Presets.Fire"),
        ("coast", "nwPresetCoast", "NetWorth.Presets.Coast"),
        ("traditional", "nwPresetTraditional", "NetWorth.Presets.Traditional"),
        ("ultra", "nwPresetUltra", "NetWorth.Presets.Ultra"),
        ("conservative", "nwPresetConservative", "NetWorth.Presets.Safe")
    ];

    /// <summary>
    /// One number in the story sentence: a text input the tuner's slider of the same id + "Range" adjusts. Money
    /// fields carry the currency symbol and their bound (data-max, #444).
    /// </summary>
    private IHtmlContent StoryField(string id, string name, string labelKey, string kind, long? dollarMax = null)
    {
        var html = new HtmlContentBuilder();
        string currency = SupportedCurrencies.CodeOrDefault(Model.CurrencyCode);
        html.AppendHtml("<span class=\"nw-story__field\">");
        if (kind == "money")
        {
            html.AppendHtml("<span class=\"nw-story__symbol\" data-nw-currency-symbol aria-hidden=\"true\">")
                .Append(SupportedCurrencies.Find(currency)!.Symbol).AppendHtml("</span>");
        }

        html.AppendHtml($"<input type=\"text\" class=\"nw-story__input\" id=\"{id}\" name=\"{name}\" required ")
            .AppendHtml(kind == "money" ? "inputmode=\"numeric\" " : "inputmode=\"numeric\" size=\"3\" ")
            .AppendHtml("aria-label=\"").Append(L[labelKey].Value).AppendHtml("\" ")
            .AppendHtml($"aria-controls=\"{id}Range\" data-nw-story ");
        if (dollarMax is long max)
        {
            html.AppendHtml($"data-max-usd=\"{max}\" data-max=\"{MoneyBounds.MaxInvariant(max, currency)}\" ");
        }

        html.AppendHtml("/></span>");
        return html;
    }
}

<header class="nw-header">
    <div class="nw-header__content">
        <div>
            <h1 class="nw-title">@L["NetWorth.Header.Title"]</h1>
            <p class="nw-subtitle">@L["NetWorth.Header.Subtitle"]</p>
        </div>
        <button type="button" class="nw-help-btn" data-bs-toggle="modal" data-bs-target="#nwHelpModal">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            @L["NetWorth.Header.HowItWorks"]
        </button>
    </div>
</header>

@if (!string.IsNullOrEmpty(TempData["SaveSuccess"] as string))
{
    <div class="alert alert-success alert-dismissible fade show nw-alert" role="alert">
        @TempData["SaveSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Common.Close"]"></button>
    </div>
}
@if (!string.IsNullOrEmpty(TempData["SaveError"] as string))
{
    <div class="alert alert-danger alert-dismissible fade show nw-alert" role="alert">
        @TempData["SaveError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Common.Close"]"></button>
    </div>
}

@* The answer first: when the money could support you, in a sentence networth-ui.js writes from the projection. *@
<section class="nw-hero" aria-labelledby="nwHeadline">
    <h2 class="nw-hero__lede" id="nwHeadline" aria-live="polite"></h2>
    <p class="nw-hero__sub" id="nwHeadlineSub"></p>
    <div class="nw-hero__bar">
        <div class="nw-view" role="group" aria-label="@L["NetWorth.View.Label"]">
            <button type="button" class="nw-view__btn" data-nw-view="projected" aria-pressed="true">@L["NetWorth.View.Projected"]</button>
            <button type="button" class="nw-view__btn" data-nw-view="real" aria-pressed="false">@L["NetWorth.View.TodaysMoney"]</button>
        </div>
        <p class="nw-hero__caption" id="nwViewCaption" hidden></p>
    </div>
</section>

<section class="nw-runway" aria-labelledby="nwRunwayTitle">
    <h2 class="visually-hidden" id="nwRunwayTitle">@L["NetWorth.Chart.Title"]</h2>
    @* networth-runway.js draws the chart with D3; arrows move the marker along the ages when it has focus. *@
    <div class="nw-runway__plot" id="nwRunway" tabindex="0" role="img" aria-label="@L["NetWorth.Chart.Description"]"></div>
    <div class="nw-runway__foot">
        <ul class="nw-runway__legend">
            <li><span class="nw-key nw-key--base" aria-hidden="true"></span><span id="nwLegendBase">@L.Named("NetWorth.Js.Legend.Scenario", ("name", ScenarioName("Base")), ("rate", projection.Base.RoiPercent.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture)))</span></li>
            <li><span class="nw-key nw-key--range" aria-hidden="true"></span>@L["NetWorth.Chart.LegendRange"]</li>
            <li><span class="nw-key nw-key--fi" aria-hidden="true"></span><span id="nwLegendFi">@L.NamedHtml("NetWorth.Js.Chart.FiTarget", null, ("amount", new HtmlString($"<span class=\"nw-fi-target-value\">{System.Net.WebUtility.HtmlEncode(FormatCurrency(projection.FiTarget))}</span>")))</span></li>
        </ul>
        <p class="nw-runway__readout" id="nwReadout" aria-live="polite"></p>
    </div>
    @* Which rate converted the inputs into the Reporting Currency; networth-ui.js rewrites it on each recalculation. *@
    <div class="nw-conversion-caption" data-nw-conversion-caption><partial name="_ConversionCaption" model="projection.Conversion"/></div>
    <details class="nw-math">
        <summary>@L["NetWorth.Math.Show"]</summary>
        <partial name="_FiBreakdown" model="FiBreakdownBuilder.Build(projection, L)" />
    </details>
</section>

<div class="nw-workbench">
    <section class="nw-story" aria-labelledby="nwStoryTitle">
        <h2 class="nw-section-title" id="nwStoryTitle">@L["NetWorth.Story.Title"]</h2>
        <p class="nw-story__sentence">@L.NamedHtml("NetWorth.Story.Sentence", null,
            ("age", StoryField("nwCurrentAge", "CurrentAge", "NetWorth.Field.CurrentAge", "age")),
            ("balance", StoryField("nwStartingBalance", "StartingBalance", "NetWorth.Field.StartingBalance", "money", NetWorthLimits.StartingBalanceMax)),
            ("income", StoryField("nwAnnualIncome", "AnnualIncome", "NetWorth.Field.AnnualIncome", "money", NetWorthLimits.AnnualIncomeMax)),
            ("savings", StoryField("nwAnnualSavings", "AnnualSavings", "NetWorth.Field.AnnualSavings", "money", NetWorthLimits.AnnualSavingsMax)),
            ("spending", StoryField("nwAnnualSpending", "AnnualSpending", "NetWorth.Field.AnnualSpending", "money", NetWorthLimits.AnnualSpendingMax)),
            ("retirementAge", StoryField("nwRetirementAge", "RetirementAge", "NetWorth.Field.RetirementAge", "age")))</p>

        @* One slider per number; networth-sliders.js shows the one whose number was picked last. *@
        <div class="nw-tuner" id="nwTuner">
            <div class="nw-tuner__row" data-nw-tune="nwStartingBalance" hidden>
                <label class="nw-tuner__label" for="nwStartingBalanceRange">@L["NetWorth.Field.StartingBalance"]</label>
                <input type="range" class="nw-range" id="nwStartingBalanceRange" min="0" max="@MoneyBounds.MaxInvariant(1000000, inputCurrency)" step="@MoneyBounds.MaxInvariant(1000, inputCurrency)" data-max-usd="1000000" data-step-usd="1000" value="@Model.StartingBalance.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
            </div>
            <div class="nw-tuner__row" data-nw-tune="nwAnnualSavings">
                <label class="nw-tuner__label" for="nwAnnualSavingsRange">@L["NetWorth.Field.AnnualSavings"]</label>
                <input type="range" class="nw-range" id="nwAnnualSavingsRange" min="0" max="@MoneyBounds.MaxInvariant(200000, inputCurrency)" step="@MoneyBounds.MaxInvariant(1000, inputCurrency)" data-max-usd="200000" data-step-usd="1000" value="@Model.AnnualSavings.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
            </div>
            <div class="nw-tuner__row" data-nw-tune="nwAnnualIncome" hidden>
                <label class="nw-tuner__label" for="nwAnnualIncomeRange">@L["NetWorth.Field.AnnualIncome"]</label>
                <input type="range" class="nw-range" id="nwAnnualIncomeRange" min="0" max="@MoneyBounds.MaxInvariant(500000, inputCurrency)" step="@MoneyBounds.MaxInvariant(1000, inputCurrency)" data-max-usd="500000" data-step-usd="1000" value="@Model.AnnualIncome.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
            </div>
            <div class="nw-tuner__row" data-nw-tune="nwAnnualSpending" hidden>
                <label class="nw-tuner__label" for="nwAnnualSpendingRange">@L["NetWorth.Field.AnnualSpending"]</label>
                <input type="range" class="nw-range" id="nwAnnualSpendingRange" min="0" max="@MoneyBounds.MaxInvariant(200000, inputCurrency)" step="@MoneyBounds.MaxInvariant(1000, inputCurrency)" data-max-usd="200000" data-step-usd="1000" value="@Model.AnnualSpending.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
            </div>
            <div class="nw-tuner__row" data-nw-tune="nwCurrentAge" hidden>
                <label class="nw-tuner__label" for="nwCurrentAgeRange">@L["NetWorth.Field.CurrentAge"]</label>
                <input type="range" class="nw-range" id="nwCurrentAgeRange" min="18" max="80" step="1" value="@Model.CurrentAge.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
            </div>
            <div class="nw-tuner__row" data-nw-tune="nwRetirementAge" hidden>
                <label class="nw-tuner__label" for="nwRetirementAgeRange">@L["NetWorth.Field.RetirementAge"]</label>
                <input type="range" class="nw-range" id="nwRetirementAgeRange" min="30" max="100" step="1" value="@Model.RetirementAge.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
            </div>
        </div>

        <div class="nw-savings-indicator" id="nwSavingsIndicator">
            <span>@L["NetWorth.Field.SavingsRate"]</span>
            <div class="nw-savings-indicator__bar" aria-hidden="true">
                <div class="nw-savings-indicator__fill" id="nwSavingsRateFill" style="width: @Math.Clamp(Model.SavingsRatePercent, 0m, 100m).ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
            <span class="nw-savings-indicator__value" id="nwSavingsRateValue">@($"{Model.SavingsRatePercent:F1}%")</span>
        </div>

        <details class="nw-assumptions">
            <summary>@L["NetWorth.Assumptions.Title"]</summary>
            <div class="nw-assumptions__grid">
                <div class="nw-field nw-field--wide">
                    <label class="nw-label" for="nwCurrency">@L["NetWorth.Field.Currency"]</label>
                    <select class="form-select form-select-sm" id="nwCurrency" name="CurrencyCode" data-currency-selector
                            data-currency-symbols="[data-nw-currency-symbol]" data-currency-bounds="[data-max-usd]">
                        @foreach (var currency in SupportedCurrencies.All)
                        {
                            <option value="@currency.Code" data-bound-scale="@currency.BoundScale" selected="@(currency.Code == inputCurrency)">@currency.Code · @currency.DisplayName</option>
                        }
                    </select>
                    <p class="nw-field__hint">@L["NetWorth.Field.CurrencyHint"]</p>
                </div>
                @foreach (var (id, labelKey, hintKey, value) in new[]
                {
                    ("nwBaseRoi", "NetWorth.Field.BaseRoi", "NetWorth.Field.BaseRoiHint", Model.BaseRoi),
                    ("nwConservativeRoi", "NetWorth.Field.ConservativeRoi", "NetWorth.Field.ConservativeRoiHint", Model.ConservativeRoi),
                    ("nwAggressiveRoi", "NetWorth.Field.AggressiveRoi", "NetWorth.Field.AggressiveRoiHint", Model.AggressiveRoi),
                    ("nwInflation", "NetWorth.Field.Inflation", "NetWorth.Field.InflationHint", Model.InflationPercent)
                })
                {
                    <div class="nw-field">
                        <label class="nw-label" for="@id">@L[labelKey]</label>
                        <div class="nw-field__input">
                            <input type="text" inputmode="decimal" required class="form-control form-control-sm" id="@id" aria-describedby="@(id)Hint" />
                            <span class="nw-field__suffix" aria-hidden="true">%</span>
                        </div>
                        <input type="range" class="nw-range" id="@(id)Range" min="0" max="@(id == "nwInflation" ? 10 : 20)" step="0.1" value="@value.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="@L[labelKey]" />
                        <p class="nw-field__hint" id="@(id)Hint">@L[hintKey]</p>
                    </div>
                }
                <div class="nw-field">
                    <label class="nw-label" for="nwAggressiveSavings">@L["NetWorth.Field.AggressiveSavings"]</label>
                    <div class="nw-field__input">
                        <span class="nw-field__prefix" data-nw-currency-symbol aria-hidden="true">@inputSymbol</span>
                        <input type="text" inputmode="numeric" required class="form-control form-control-sm" id="nwAggressiveSavings" aria-describedby="nwAggressiveSavingsHint"
                               data-max-usd="@NetWorthLimits.AggressiveSavingsMax" data-max="@MoneyBounds.MaxInvariant(NetWorthLimits.AggressiveSavingsMax, inputCurrency)" />
                    </div>
                    <input type="range" class="nw-range" id="nwAggressiveSavingsRange" min="0" max="@MoneyBounds.MaxInvariant(200000, inputCurrency)" step="@MoneyBounds.MaxInvariant(1000, inputCurrency)" data-max-usd="200000" data-step-usd="1000" value="@Model.AggressiveSavings.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="@L["NetWorth.Field.AggressiveSavings"]" />
                    <p class="nw-field__hint" id="nwAggressiveSavingsHint">@L["NetWorth.Field.AggressiveSavingsHint"]</p>
                </div>
            </div>
        </details>

        @if (!Model.HasSavedParameters)
        {
            <div class="nw-paths" role="group" aria-labelledby="nwPathsLabel">
                <span class="nw-paths__label" id="nwPathsLabel">@L["NetWorth.Presets.Title"]</span>
                @foreach (var preset in Presets)
                {
                    <button type="button" class="nw-path" data-preset="@preset.Key" id="@preset.Id">@L[preset.LabelKey]</button>
                }
            </div>
        }

        <div class="nw-form__actions">
            <form asp-action="SaveParameters" method="post" class="d-inline" id="nwSaveForm">
                <input type="hidden" asp-for="StartingBalance" id="nwSaveStartingBalance" />
                <input type="hidden" asp-for="AnnualSavings" id="nwSaveAnnualSavings" />
                <input type="hidden" asp-for="AnnualIncome" id="nwSaveAnnualIncome" />
                <input type="hidden" asp-for="AnnualSpending" id="nwSaveAnnualSpending" />
                <input type="hidden" asp-for="CurrentAge" id="nwSaveCurrentAge" />
                <input type="hidden" asp-for="RetirementAge" id="nwSaveRetirementAge" />
                <input type="hidden" asp-for="BaseRoi" id="nwSaveBaseRoi" />
                <input type="hidden" asp-for="ConservativeRoi" id="nwSaveConservativeRoi" />
                <input type="hidden" asp-for="AggressiveRoi" id="nwSaveAggressiveRoi" />
                <input type="hidden" asp-for="AggressiveSavings" id="nwSaveAggressiveSavings" />
                <input type="hidden" asp-for="CurrencyCode" id="nwSaveCurrencyCode" />
                <button type="submit" class="btn nw-btn-save">@L["NetWorth.Actions.Save"]</button>
            </form>
            <div class="btn-group" role="group">
                <button type="button" class="btn nw-btn-reset" id="nwResetBtn">@L["NetWorth.Actions.Reset"]</button>
                <button type="button" class="btn nw-btn-reset dropdown-toggle dropdown-toggle-split" id="nwResetDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="visually-hidden">@L["NetWorth.Actions.ResetOptions"]</span>
                </button>
                <ul class="dropdown-menu" aria-labelledby="nwResetDropdownBtn">
                    <li><button type="button" class="dropdown-item" id="nwResetToSaved">@L["NetWorth.Actions.ResetToSaved"]</button></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><button type="button" class="dropdown-item text-danger" id="nwClearSaved">@L["NetWorth.Actions.ClearSaved"]</button></li>
                </ul>
            </div>
            @* More (⋯): the rarely used actions. Bootstrap's dropdown keeps aria-expanded current, moves focus with the
               arrow keys and closes on Escape. *@
            <div class="dropdown">
                <button type="button" class="btn nw-btn-reset" id="nwMoreBtn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@L["NetWorth.Actions.More"]">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/></svg>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="nwMoreBtn">
                    <li><button type="button" class="dropdown-item" id="nwRandomBtn">@L["NetWorth.Actions.Randomize"]</button></li>
                    <li><a class="dropdown-item" asp-controller="Research" asp-action="Index">@L["NetWorth.Header.ExploreResearch"]</a></li>
                    @if (Model.HasSavedParameters)
                    {
                        <li><hr class="dropdown-divider" /></li>
                        <li><h6 class="dropdown-header">@L["NetWorth.Presets.Title"]</h6></li>
                        @foreach (var preset in Presets)
                        {
                            <li><button type="button" class="dropdown-item" data-preset="@preset.Key">@L[preset.LabelKey]</button></li>
                        }
                    }
                </ul>
            </div>
            <form asp-action="DeleteParameters" method="post" class="d-none" id="nwClearForm">
                @Html.AntiForgeryToken()
            </form>
        </div>
    </section>

    <section class="nw-levers" aria-labelledby="nwLeversTitle">
        <h2 class="nw-section-title" id="nwLeversTitle">@L["NetWorth.Levers.Title"]</h2>
        <p class="nw-levers__note">@L["NetWorth.Levers.Note"]</p>
        @* networth-ui.js fills the levers from the projection's Levers. *@
        <div class="nw-levers__list" id="nwLevers"></div>
    </section>
</div>

<section class="nw-years" aria-labelledby="nwYearsTitle">
    <div class="nw-years__head">
        <div>
            <h2 class="nw-section-title" id="nwYearsTitle">@L["NetWorth.Table.Title"]</h2>
            <p class="nw-years__sub">@L["NetWorth.Table.Subtitle"]</p>
        </div>
        <div class="nw-view" role="group" aria-label="@L["NetWorth.Years.Density"]">
            <button type="button" class="nw-view__btn" data-nw-density="five" aria-pressed="true">@L["NetWorth.Years.EveryFive"]</button>
            <button type="button" class="nw-view__btn" data-nw-density="all" aria-pressed="false">@L["NetWorth.Years.EveryYear"]</button>
        </div>
    </div>
    <ol class="nw-milestones" id="nwMilestones" aria-label="@L["NetWorth.Years.Milestones"]"></ol>
    <div class="table-responsive nw-table-wrap">
        <table class="nw-table" id="nwProjectionTable">
            <caption class="visually-hidden">@L["NetWorth.Table.Caption"]</caption>
            <thead>
                <tr>
                    <th scope="col">@L["NetWorth.Table.Age"]</th>
                    <th scope="col" class="nw-num" data-nw-col="Conservative">@ScenarioName("Conservative")</th>
                    <th scope="col" class="nw-num nw-table__base" data-nw-col="Base">@ScenarioName("Base")</th>
                    <th scope="col" class="nw-num" data-nw-col="Aggressive">@ScenarioName("Aggressive")</th>
                    <th scope="col" class="nw-table__mix">@L["NetWorth.Table.Composition"]</th>
                </tr>
            </thead>
            @* Rows are rendered by networth-ui.js (updateTable) from window.nwProjectionData. *@
            <tbody id="nwTableBody"></tbody>
        </table>
    </div>
    <ul class="nw-years__legend">
        <li><span class="nw-key nw-key--put" aria-hidden="true"></span>@L["NetWorth.Table.PutIn"]</li>
        <li><span class="nw-key nw-key--grown" aria-hidden="true"></span>@L["NetWorth.Table.Growth"]</li>
        <li><span class="nw-fi-dot" aria-hidden="true"></span>@L["NetWorth.Table.LegendFi"]</li>
    </ul>
</section>

<js-strings prefix="NetWorth.Js." />

<div class="modal fade nw-modal" id="nwHelpModal" tabindex="-1" aria-labelledby="nwHelpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content nw-modal-content">
            <div class="modal-header nw-modal-header">
                <h2 class="modal-title" id="nwHelpModalLabel">@L["NetWorth.Help.Title"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
            </div>
            <div class="modal-body nw-modal-body">
                <div class="nw-help-section">
                    <h3>@L["NetWorth.Help.FiTitle"]</h3>
                    <p class="nw-text">@L.NamedHtml("NetWorth.Help.FiText", null, ("rule", Strong(L["NetWorth.Help.FourPercentRule"])), ("spending", Plain(FormatCurrency(50_000m))), ("target", Plain(FormatCurrency(1_250_000m))))</p>
                    <div class="nw-help-note">
                        <p class="nw-help-note__title">@L["NetWorth.Help.RuleTitle"]</p>
                        <p class="nw-text">@L.NamedHtml("NetWorth.Help.RuleText", null, ("rule", Strong(L["NetWorth.Help.FourPercentRule"])))</p>
                        <p class="nw-text">@L.NamedHtml("NetWorth.Help.RuleFormula", null, ("fiTarget", Strong(L["NetWorth.Js.FiTarget"])), ("formula", Strong(L["NetWorth.Help.FormulaText"])))</p>
                    </div>
                </div>
                <div class="nw-help-section">
                    <h3>@L["NetWorth.Help.ScenariosTitle"]</h3>
                    <p class="nw-text">@L.NamedHtml("NetWorth.Help.ScenariosText", null, ("base", Strong(ScenarioName("Base"))), ("conservative", Strong(ScenarioName("Conservative"))), ("aggressive", Strong(ScenarioName("Aggressive"))))</p>
                </div>
                <div class="nw-help-section">
                    <h3>@L["NetWorth.Help.ChartsTitle"]</h3>
                    <p class="nw-text">@L["NetWorth.Help.RunwayText"]</p>
                </div>
                <div class="nw-help-section">
                    <h3>@L["NetWorth.Help.TodaysMoneyTitle"]</h3>
                    <p class="nw-text">@L["NetWorth.Help.TodaysMoneyText"]</p>
                </div>
                <div class="nw-help-section">
                    <h3>@L["NetWorth.Help.HighlightsTitle"]</h3>
                    <p class="nw-text">@L["NetWorth.Help.YearsText"]</p>
                </div>
            </div>
            <div class="modal-footer nw-modal-footer">
