@model PersonalFinance.Web.Models.GoogleDriveViewModel
@using PersonalFinance.Shared.DTOs
@using PersonalFinance.Shared.Helpers

@{
    ViewData["Title"] = "Google Drive";
    var response = Model.Response;
    var files = response?.Files ?? new List<GoogleDriveFileDto>();
    var folderCount = files.Count(f => f.IsFolder);

    // Counts for the type filter tabs
    var spreadsheetCount = files.Count(f => f.FileType == "Spreadsheet");
    var documentCount = files.Count(f => f.FileType == "Document");
    var pdfCount = files.Count(f => f.FileType == "PDF Document");
    var imageCount = files.Count(f => f.FileType == "Image");
    var presentationCount = files.Count(f => f.FileType == "Presentation");
    var otherCount = files.Count(f => !f.IsFolder && f.FileType != "Spreadsheet" && f.FileType != "Document" && f.FileType != "PDF Document" && f.FileType != "Image" && f.FileType != "Presentation");

    const int featuredSheetLimit = 6;
    var spreadsheets = files.Where(IsSpreadsheet).OrderByDescending(f => f.ModifiedTime).ToList();

    var currentConn = Model.SelectedConnection;
    var isNeedsReauth = currentConn != null && (!currentConn.IsValid || currentConn.SyncStatus == "NeedsReauth");
    var showConnectForm = Model.ShowConnectForm || !Model.Connections.Any();
}

@functions {
    private static bool IsMonthlyBudget(GoogleDriveFileDto file) =>
        GoogleDriveHelper.IsMonthlyBudgetSpreadsheet(file.Name, file.FileType, file.MimeType);

    private static bool IsSpreadsheet(GoogleDriveFileDto file) =>
        IsMonthlyBudget(file) || (!file.IsFolder && file.FileType == "Spreadsheet");

    private static bool NeedsAttention(GoogleDriveConnectionDto conn) =>
        !conn.IsValid || conn.SyncStatus == "NeedsReauth";

    private static string TimeAgo(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} min ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} hr ago";
        if (span.TotalDays < 2) return "yesterday";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays} days ago";
        return utc.ToString("MMM d, yyyy");
    }

    private void RenderFileIcon(GoogleDriveFileDto file, int size)
    {
        if (file.IsFolder)
        {
            <svg width="@size" height="@size" fill="#fbbc04" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31L.54 3.87A2 2 0 0 1 2.5 3h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3z"/>
            </svg>
        }
        else if (file.FileType == "Spreadsheet")
        {
            <svg width="@size" height="@size" fill="#0f9d58" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h10v2H3zm0 1h10v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-1z"/>
            </svg>
        }
        else if (file.FileType == "PDF Document")
        {
            <svg width="@size" height="@size" fill="#ea4335" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/>
            </svg>
        }
        else if (file.FileType == "Image")
        {
            <svg width="@size" height="@size" fill="#9334e6" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
                <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-12zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1h12z"/>
            </svg>
        }
        else
        {
            <svg width="@size" height="@size" fill="#4285f4" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/>
            </svg>
        }
    }

    // Visible buttons for a spreadsheet's finance views (used by the featured cards and grid cards)
    private void RenderSheetButtons(GoogleDriveFileDto file)
    {
        if (IsMonthlyBudget(file))
        {
            <button type="button" class="btn btn-sm btn-success btn-budget-report"
                    data-file-id="@file.Id" data-file-name="@file.Name"
                    data-bs-toggle="modal" data-bs-target="#monthlyBudgetModal">
                Budget report
            </button>
        }
        <button type="button" class="btn btn-sm btn-outline-secondary btn-sheet-transactions"
                data-file-id="@file.Id" data-file-name="@file.Name"
                data-bs-toggle="modal" data-bs-target="#transactionsModal">
            Transactions
        </button>
    }

    private void RenderOpenLink(GoogleDriveFileDto file)
    {
        if (!string.IsNullOrEmpty(file.WebViewLink))
        {
            <a href="@file.WebViewLink" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-light gd-icon-btn"
               title="Open in Google Drive" aria-label="Open @file.Name in Google Drive">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path fill-rule="evenodd" d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5z"/>
                    <path fill-rule="evenodd" d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0v-5z"/>
                </svg>
            </a>
        }
    }
}

<div class="gd-page"
     data-status-message="@Model.StatusMessage">
    <!-- Page header -->
    <header class="d-flex justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h4 fw-bold mb-0">Google Drive</h1>
            <p class="text-muted small mb-0">Browse your shared folders and analyze your budget spreadsheets.</p>
        </div>
        <button type="button" class="btn btn-sm btn-light border d-flex align-items-center gap-1 text-nowrap" data-bs-toggle="modal" data-bs-target="#apiKeyGuideModal">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                <path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286zm1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94z"/>
            </svg>
            Help &amp; setup
        </button>
    </header>

    <div class="row g-4">
        @if (Model.Connections.Any())
        {
            <!-- Drive navigation -->
            <aside class="col-lg-3">
                <nav class="gd-sidebar d-none d-lg-block" aria-label="Your drives">
                    <div class="gd-sidebar-title">Your drives</div>
                    <ul class="list-unstyled mb-3">
                        @foreach (var conn in Model.Connections)
                        {
                            var isActive = !showConnectForm && conn.Id == Model.SelectedConnectionId;
                            <li>
                                <a asp-action="Index" asp-route-connectionId="@conn.Id"
                                   class="gd-drive-link @(isActive ? "active" : "")"
                                   aria-current="@(isActive ? "page" : null)">
                                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="flex-shrink-0" aria-hidden="true">
                                        <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31z"/>
                                    </svg>
                                    <span class="text-truncate flex-grow-1" title="@conn.Name">@conn.Name</span>
                                    @if (NeedsAttention(conn))
                                    {
                                        <span class="gd-status-dot gd-status-dot--warning" title="Needs attention"></span>
                                        <span class="visually-hidden">(needs attention)</span>
                                    }
                                    <span class="gd-drive-count">@conn.CachedFilesCount</span>
                                </a>
                            </li>
                        }
                    </ul>
                    <a asp-action="Index" asp-route-addNew="true" class="btn btn-sm btn-outline-primary w-100 @(Model.ShowConnectForm ? "active" : "")">
                        + Connect a drive
                    </a>
                </nav>

                <!-- Compact drive picker on small screens -->
                <div class="dropdown d-lg-none">
                    <button class="btn btn-light border w-100 d-flex justify-content-between align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="text-truncate">
                            <span class="text-muted small me-1">Drive:</span>
                            <strong>@(showConnectForm ? "Connect a drive" : currentConn?.Name ?? "Choose a drive")</strong>
                        </span>
                        <span class="dropdown-toggle"></span>
                    </button>
                    <ul class="dropdown-menu w-100 shadow-sm">
                        @foreach (var conn in Model.Connections)
                        {
                            <li>
                                <a asp-action="Index" asp-route-connectionId="@conn.Id"
                                   class="dropdown-item d-flex justify-content-between align-items-center @(conn.Id == Model.SelectedConnectionId && !showConnectForm ? "active" : "")">
                                    <span class="text-truncate">@conn.Name</span>
                                    <span class="small opacity-75">@conn.CachedFilesCount items</span>
                                </a>
                            </li>
                        }
                        <li><hr class="dropdown-divider"></li>
                        <li><a asp-action="Index" asp-route-addNew="true" class="dropdown-item text-primary">+ Connect a drive</a></li>
                    </ul>
                </div>
            </aside>
        }

        <section class="@(Model.Connections.Any() ? "col-lg-9" : "col-12")">
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 d-flex align-items-start gap-2" role="alert">
                    <span aria-hidden="true">&#9888;</span>
                    <div class="flex-grow-1">@Model.ErrorMessage</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (showConnectForm)
            {
                <!-- Connect a drive -->
                <div class="gdrive-card gd-connect p-4 p-md-5 mx-auto">
                    <h2 class="h4 fw-bold mb-1">
                        @(Model.Connections.Any() ? "Connect another folder" : "Connect your Google Drive")
                    </h2>
                    <p class="text-muted mb-4">
                        Link a shared folder once and it's saved here, so your files and budget reports load right away next time.
                    </p>

                    <ol class="gd-steps mb-4">
                        <li>
                            <strong>Share the folder.</strong>
                            <span class="text-muted">In Google Drive, open <em>Share</em> and set General access to <em>Anyone with the link</em> (Viewer).</span>
                        </li>
                        <li>
                            <strong>Paste the folder link below.</strong>
                        </li>
                    </ol>

                    <form asp-action="Index" method="post" id="driveExplorerForm">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="FolderUrl" class="form-label fw-semibold small">Folder link or ID</label>
                            <div class="input-group gdrive-omnibox">
                                <span class="input-group-text bg-white border-0 text-primary ps-3 pe-2" aria-hidden="true">
                                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31z"/>
                                    </svg>
                                </span>
                                <input asp-for="FolderUrl" id="folderUrlInput" class="form-control border-0 ps-1"
                                       placeholder="https://drive.google.com/drive/folders/..." required />
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <span asp-validation-for="FolderUrl" class="text-danger small"></span>
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none ms-auto" id="btnPasteSample">Use a sample folder</button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConnectionName" class="form-label fw-semibold small">Name <span class="text-muted fw-normal">(optional)</span></label>
                            <input asp-for="ConnectionName" class="form-control" placeholder="e.g. Household budget" />
                        </div>

                        <button class="btn btn-link btn-sm text-decoration-none text-muted p-0 mb-3" type="button" data-bs-toggle="collapse" data-bs-target="#advancedSettingsCollapse" aria-expanded="false" aria-controls="advancedSettingsCollapse">
                            Advanced: use my own Google API key
                        </button>
                        <div class="collapse" id="advancedSettingsCollapse">
                            <div class="p-3 bg-light rounded-3 border mb-3">
                                <label asp-for="ApiKey" class="form-label fw-semibold small">Google Cloud API key</label>
                                <input asp-for="ApiKey" class="form-control form-control-sm font-monospace" placeholder="AIzaSy..." />
                                <div class="form-text">
                                    Only needed if the folder doesn't load without it. The key is stored encrypted.
                                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-bs-toggle="modal" data-bs-target="#apiKeyGuideModal">How do I get one?</button>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-2">
                            <button type="submit" class="btn btn-primary px-4 fw-semibold d-flex align-items-center gap-2" id="btnSubmitExplore">
                                <span id="submitSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                <span id="submitText">Connect folder</span>
                            </button>
                            @if (Model.Connections.Any())
                            {
                                <a asp-action="Index" class="btn btn-light border">Cancel</a>
                            }
                        </div>
                    </form>
                </div>
            }
            else if (response != null && response.Success)
            {
                <!-- Drive header -->
                <div class="gdrive-card p-3 p-md-4 mb-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                        <div class="gd-min-w-0">
                            <h2 class="h5 fw-bold mb-1 text-truncate">@(response.FolderName ?? currentConn?.Name ?? "Google Drive folder")</h2>
                            <div class="small text-muted gd-meta">
                                <span>@response.TotalFilesCount @(response.TotalFilesCount == 1 ? "item" : "items")</span>
                                <span>@response.TotalSizeFormatted</span>
                                @if (currentConn?.LastSyncedAtUtc != null)
                                {
                                    <span title="@currentConn.LastSyncedAtUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC">Synced @TimeAgo(currentConn.LastSyncedAtUtc.Value)</span>
                                }
                            </div>
                        </div>

                        @if (currentConn != null)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <form asp-action="Sync" method="post" id="syncForm">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@currentConn.Id" />
                                    <button type="submit" class="btn btn-sm btn-primary d-flex align-items-center gap-1" id="btnSyncDrive" title="Get the latest files from Google Drive">
                                        <span id="syncSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                        <svg id="syncIcon" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                                            <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                                        </svg>
                                        <span>Sync now</span>
                                    </button>
                                </form>
                                @if (!string.IsNullOrEmpty(response.FolderId))
                                {
                                    <a href="https://drive.google.com/drive/folders/@response.FolderId" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-light border text-nowrap">
                                        Open in Drive
                                    </a>
                                }
                                <div class="dropdown">
                                    <button type="button" class="btn btn-sm btn-light border gd-icon-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More options for this drive">
                                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M3 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/>
                                        </svg>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <button type="button" class="dropdown-item btn-copy-id" data-id="@response.FolderId">Copy folder ID</button>
                                        </li>
                                        <li>
                                            <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#reauthModal">
                                                @(currentConn.HasApiKey ? "Change API key" : "Add API key")
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteDriveModal">Remove drive&hellip;</button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        }
                    </div>

                    @if (isNeedsReauth)
                    {
                        <div class="gd-notice gd-notice--warning mt-3" role="alert">
                            <div>
                                <strong>This drive needs a new API key.</strong>
                                <div class="small">@(currentConn?.ErrorMessage ?? "Your Google credentials have expired or are invalid, so files can't be synced.")</div>
                            </div>
                            <button type="button" class="btn btn-sm btn-warning text-nowrap" data-bs-toggle="modal" data-bs-target="#reauthModal">Update key</button>
                        </div>
                    }
                    else if (response.IsDemoData)
                    {
                        <div class="gd-notice mt-3" role="status">
                            <div>
                                <strong>You're looking at sample files.</strong>
                                <div class="small">@(response.WarningMessage ?? "Add a Google API key to see the real files in this folder.")</div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" data-bs-toggle="modal" data-bs-target="#reauthModal">Add API key</button>
                        </div>
                    }
                </div>

                @if (spreadsheets.Any())
                {
                    <!-- Featured spreadsheets: the finance views live here -->
                    <section class="mb-4" aria-labelledby="sheetsHeading">
                        <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-2">
                            <h3 id="sheetsHeading" class="h6 fw-bold mb-0">Spreadsheets</h3>
                            <span class="small text-muted">See a budget report or browse the transactions in a sheet</span>
                        </div>
                        <div class="row g-3">
                            @foreach (var sheet in spreadsheets.Take(featuredSheetLimit))
                            {
                                <div class="col-sm-6 col-xl-4">
                                    <div class="gd-sheet-card h-100">
                                        <div class="d-flex align-items-start gap-2 mb-3">
                                            @{ RenderFileIcon(sheet, 22); }
                                            <div class="gd-min-w-0">
                                                <div class="fw-semibold text-truncate" title="@sheet.Name">@sheet.Name</div>
                                                <div class="small text-muted">Edited @(sheet.ModifiedTime?.ToString("MMM d, yyyy") ?? "—")</div>
                                            </div>
                                        </div>
                                        <div class="d-flex flex-wrap align-items-center gap-2 mt-auto">
                                            @{ RenderSheetButtons(sheet); }
                                            <span class="ms-auto">@{ RenderOpenLink(sheet); }</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        @if (spreadsheets.Count > featuredSheetLimit)
                        {
                            <button type="button" class="btn btn-link btn-sm px-0 mt-2 text-decoration-none js-show-filter" data-filter="Spreadsheet">
                                Show all @spreadsheets.Count spreadsheets &darr;
                            </button>
                        }
                    </section>
                }

                <!-- All files -->
                <section class="gdrive-card p-3 p-md-4" aria-labelledby="filesHeading" id="allFilesSection">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h3 id="filesHeading" class="h6 fw-bold mb-0">All files</h3>
                        <div class="d-flex align-items-center gap-2 flex-grow-1 flex-sm-grow-0">
                            <div class="gd-search flex-grow-1">
                                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                                </svg>
                                <input type="search" id="fileSearch" class="form-control form-control-sm" placeholder="Search files" aria-label="Search files" />
                            </div>
                            <div class="btn-group btn-group-sm" role="group" aria-label="Layout">
                                <button type="button" class="btn btn-light border gd-icon-btn active" id="btnViewTable" aria-pressed="true" title="List view" aria-label="List view">
                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
                                    </svg>
                                </button>
                                <button type="button" class="btn btn-light border gd-icon-btn" id="btnViewGrid" aria-pressed="false" title="Grid view" aria-label="Grid view">
                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3z"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Type filter -->
                    <div class="gd-chip-row mb-3" id="filterChipsContainer" role="group" aria-label="Filter by type">
                        <button type="button" class="gdrive-filter-chip active" data-filter="all" aria-pressed="true">All <span class="chip-count">@response.TotalFilesCount</span></button>
                        @if (folderCount > 0)
                        {
                            <button type="button" class="gdrive-filter-chip" data-filter="Folder" aria-pressed="false">Folders <span class="chip-count">@folderCount</span></button>
                        }
                        @if (spreadsheetCount > 0)
                        {
                            <button type="button" class="gdrive-filter-chip" data-filter="Spreadsheet" aria-pressed="false">Sheets <span class="chip-count">@spreadsheetCount</span></button>
                        }
                        @if (documentCount > 0)
                        {
                            <button type="button" class="gdrive-filter-chip" data-filter="Document" aria-pressed="false">Docs <span class="chip-count">@documentCount</span></button>
                        }
                        @if (pdfCount > 0)
                        {
                            <button type="button" class="gdrive-filter-chip" data-filter="PDF Document" aria-pressed="false">PDFs <span class="chip-count">@pdfCount</span></button>
                        }
                        @if (imageCount > 0)
                        {
                            <button type="button" class="gdrive-filter-chip" data-filter="Image" aria-pressed="false">Images <span class="chip-count">@imageCount</span></button>
                        }
                        @if (presentationCount > 0)
                        {
                            <button type="button" class="gdrive-filter-chip" data-filter="Presentation" aria-pressed="false">Slides <span class="chip-count">@presentationCount</span></button>
                        }
                        @if (otherCount > 0)
                        {
                            <button type="button" class="gdrive-filter-chip" data-filter="other" aria-pressed="false">Other <span class="chip-count">@otherCount</span></button>
                        }
                    </div>

                    <!-- List view -->
                    <div id="tableViewSection" class="table-responsive">
                        <table id="googleDriveDataTable" class="table table-hover align-middle gdrive-table w-100 mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Name</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">Modified</th>
                                    <th scope="col">Size</th>
                                    <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var file in files)
                                {
                                    var isSheet = IsSpreadsheet(file);
                                    <tr>
                                        <td data-order="@(file.IsFolder ? "0" : "1")@file.Name">
                                            <div class="d-flex align-items-center gap-2">
                                                @{ RenderFileIcon(file, 20); }
                                                <div class="gd-min-w-0">
                                                    <div class="fw-semibold text-truncate gd-file-name" title="@file.Name">@file.Name</div>
                                                    <div class="small text-muted d-md-none">@file.FileType</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="small text-muted">@file.FileType</td>
                                        <td data-order="@(file.ModifiedTime?.ToString("yyyy-MM-ddTHH:mm:ss") ?? "0001-01-01T00:00:00")" class="text-nowrap small">
                                            @(file.ModifiedTime?.ToString("MMM d, yyyy") ?? "—")
                                        </td>
                                        <td data-order="@(file.Size ?? -1)" class="text-nowrap small text-muted">
                                            @(file.IsFolder || !file.Size.HasValue ? "—" : file.SizeFormatted)
                                        </td>
                                        <td class="text-end text-nowrap">
                                            @if (isSheet)
                                            {
                                                <div class="dropdown d-inline-block">
                                                    <button type="button" class="btn btn-sm btn-light border dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"
                                                            data-bs-popper-config='{"strategy":"fixed"}'>
                                                        View
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                        @if (IsMonthlyBudget(file))
                                                        {
                                                            <li>
                                                                <button type="button" class="dropdown-item btn-budget-report" data-file-id="@file.Id" data-file-name="@file.Name"
                                                                        data-bs-toggle="modal" data-bs-target="#monthlyBudgetModal">Budget report</button>
                                                            </li>
                                                        }
                                                        <li>
                                                            <button type="button" class="dropdown-item btn-sheet-transactions" data-file-id="@file.Id" data-file-name="@file.Name"
                                                                    data-bs-toggle="modal" data-bs-target="#transactionsModal">Transactions</button>
                                                        </li>
                                                        @if (!string.IsNullOrEmpty(file.WebViewLink))
                                                        {
                                                            <li><hr class="dropdown-divider"></li>
                                                            <li><a class="dropdown-item" href="@file.WebViewLink" target="_blank" rel="noopener noreferrer">Open in Google Drive</a></li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                            else
                                            {
                                                RenderOpenLink(file);
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Grid view -->
                    <div id="gridViewSection" class="d-none">
                        <div class="row g-3">
                            @foreach (var file in files)
                            {
                                <div class="col-12 col-sm-6 col-md-4 grid-item-card" data-file-type="@file.FileType" data-file-name="@file.Name.ToLowerInvariant()">
                                    <div class="gdrive-grid-card">
                                        <div class="gdrive-grid-preview">
                                            @if (!string.IsNullOrEmpty(file.ThumbnailLink))
                                            {
                                                <img src="@file.ThumbnailLink" alt="" loading="lazy" />
                                            }
                                            else
                                            {
                                                RenderFileIcon(file, 36);
                                            }
                                        </div>
                                        <div class="fw-semibold text-truncate" title="@file.Name">@file.Name</div>
                                        <div class="small text-muted mb-2">
                                            @file.FileType · @(file.ModifiedTime?.ToString("MMM d, yyyy") ?? "—")
                                        </div>
                                        <div class="d-flex flex-wrap align-items-center gap-2 mt-auto">
                                            @if (IsSpreadsheet(file))
                                            {
                                                RenderSheetButtons(file);
                                            }
                                            <span class="ms-auto">@{ RenderOpenLink(file); }</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <p class="text-muted text-center small py-4 mb-0 d-none" id="gridEmptyState">No files match your filters.</p>
                    </div>
                </section>
            }
            else if (currentConn != null)
            {
                <!-- Drive selected but its files couldn't be loaded -->
                <div class="gdrive-card p-5 text-center">
                    <h2 class="h5 fw-bold mb-2">We couldn't load the files in @currentConn.Name</h2>
                    <p class="text-muted mb-4">Check that the folder is still shared with "Anyone with the link", then try syncing again.</p>
                    <div class="d-flex justify-content-center gap-2">
                        <form asp-action="Sync" method="post" id="syncForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@currentConn.Id" />
                            <button type="submit" class="btn btn-primary d-flex align-items-center gap-2" id="btnSyncDrive">
                                <span id="syncSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                Try again
                            </button>
                        </form>
                        <button type="button" class="btn btn-light border" data-bs-toggle="modal" data-bs-target="#reauthModal">Update API key</button>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

<!-- Monthly Budget Summary Report & Chart Modal -->
<div class="modal fade" id="monthlyBudgetModal" tabindex="-1" aria-labelledby="monthlyBudgetModalLabel" aria-hidden="true"
     data-report-url="@Url.Action("MonthlyBudgetReport", "GoogleDrive")"
     data-connection-id="@(currentConn?.Id ?? 0)">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 bgt-root">
            <div class="modal-header border-bottom py-3 justify-content-between">
                <div class="d-flex align-items-center gap-3 overflow-hidden">
                    <div class="bgt-header-icon flex-shrink-0">
                        <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M4 11H2v3h2v-3zm5-4H7v7h2V7zm5-5h-2v12h2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1h-2zM7 6a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H7zm-5 4a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1H2z"/>
                        </svg>
                    </div>
                    <div class="overflow-hidden">
                        <h5 class="modal-title fw-bold mb-0" id="monthlyBudgetModalLabel">Monthly Budget Summary &amp; Analytics</h5>
                        <div class="d-flex align-items-center gap-2 small text-muted overflow-hidden" id="budgetModalFileHeader">
                            <span class="text-truncate" id="budgetModalFileName" title="">-</span>
                            <span class="flex-shrink-0" id="budgetModalDataSource"></span>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-shrink-0 ms-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-flex align-items-center gap-1" id="btnPrintBudgetReport" title="Print this report" disabled>
                        <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z"/>
                            <path d="M5 1a2 2 0 0 0-2 2v2H2a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1V3a2 2 0 0 0-2-2H5zM4 3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2H4V3zm1 5a2 2 0 0 0-2 2v1H2a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v-1a2 2 0 0 0-2-2H5zm7 2v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1z"/>
                        </svg>
                        <span>Print</span>
                    </button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>

            <div class="modal-body p-3 p-md-4 bgt-body" id="budgetReportPrintArea">
                <!-- Loading state -->
                <div class="bgt-state" id="budgetLoadingState" role="status">
                    <div class="spinner-border text-secondary mb-3" aria-hidden="true"></div>
                    <div class="fw-semibold">Reading your spreadsheet&hellip;</div>
                    <div class="small text-muted">Pulling the latest numbers from Google Drive. This usually takes a few seconds.</div>
                </div>

                <!-- Error state -->
                <div class="bgt-state d-none" id="budgetErrorState" role="alert">
                    <div class="bgt-state-icon mb-3" aria-hidden="true">!</div>
                    <div class="fw-semibold">We couldn't build a report from this spreadsheet</div>
                    <div class="small text-muted mb-3" id="budgetErrorMessage">Check that the file is a monthly budget sheet and that the drive is still shared, then try again.</div>
                    <button type="button" class="btn btn-sm btn-dark rounded-pill px-4" id="btnBudgetRetry">Try again</button>
                </div>

                <!-- Report -->
                <div class="d-none" id="budgetReportContent">
                    <!-- Period selector: scopes everything below -->
                    <div class="bgt-toolbar mb-3">
                        <button type="button" class="bgt-nav-btn" id="btnBudgetPrev" aria-label="Previous period">&lsaquo;</button>
                        <div class="bgt-period-scroll" id="budgetMonthButtonGroup" role="tablist" aria-label="Choose a period">
                            <!-- Populated dynamically via JS -->
                        </div>
                        <button type="button" class="bgt-nav-btn" id="btnBudgetNext" aria-label="Next period">&rsaquo;</button>
                    </div>

                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-1 mb-3">
                        <div>
                            <h4 class="fw-bold mb-0 bgt-ink" id="budgetPeriodTitle">-</h4>
                            <div class="small bgt-ink-2" id="budgetPeriodSubtitle"></div>
                        </div>
                        <div class="small text-muted d-none d-md-block" id="budgetKeyboardHint">Tip: use the &larr; &rarr; keys to switch periods</div>
                    </div>

                    <!-- Plain-language summary -->
                    <div class="bgt-insight mb-4" id="budgetInsight"></div>

                    <!-- KPI tiles -->
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label"><span class="bgt-swatch bgt-swatch--income" aria-hidden="true"></span>Income</div>
                                <div class="bgt-tile-value" id="kpiTotalIncome">$0.00</div>
                                <div class="bgt-tile-sub" id="kpiIncomeSubtext"></div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label"><span class="bgt-swatch bgt-swatch--spend" aria-hidden="true"></span>Spending</div>
                                <div class="bgt-tile-value" id="kpiTotalExpenses">$0.00</div>
                                <div class="bgt-tile-sub" id="kpiExpensesSubtext"></div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label">Net saved</div>
                                <div class="bgt-tile-value" id="kpiNetSavings">$0.00</div>
                                <div class="bgt-tile-sub" id="kpiSavingsSubtext"></div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label">Savings rate</div>
                                <div class="bgt-tile-value" id="kpiSavingsRate">0%</div>
                                <div class="bgt-tile-sub" id="kpiStatusBadge"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Year overview charts (hidden in month view) -->
                    <div class="row g-3 mb-4" id="budgetYearCharts">
                        <div class="col-12 col-lg-8">
                            <div class="bgt-card h-100">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                    <div>
                                        <h6 class="bgt-card-title mb-0">Income vs. spending by month</h6>
                                        <div class="bgt-card-sub">Click a month to see its details</div>
                                    </div>
                                    <div class="bgt-legend" aria-hidden="true">
                                        <span><span class="bgt-swatch bgt-swatch--income"></span>Income</span>
                                        <span><span class="bgt-swatch bgt-swatch--spend"></span>Spending</span>
                                    </div>
                                </div>
                                <div class="bgt-chart-box">
                                    <canvas id="budgetMainChart" role="img" aria-label="Column chart of income and spending for each month. The same values are in the month-by-month table below."></canvas>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="bgt-card h-100">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                    <div>
                                        <h6 class="bgt-card-title mb-0">Net saved each month</h6>
                                        <div class="bgt-card-sub">Above the line you saved, below you overspent</div>
                                    </div>
                                    <div class="bgt-legend" aria-hidden="true">
                                        <span><span class="bgt-swatch bgt-swatch--income"></span>Saved</span>
                                        <span><span class="bgt-swatch bgt-swatch--neg"></span>Overspent</span>
                                    </div>
                                </div>
                                <div class="bgt-chart-box">
                                    <canvas id="budgetNetChart" role="img" aria-label="Column chart of net savings for each month. The same values are in the month-by-month table below."></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Category breakdown -->
                    <div class="bgt-card mb-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                            <div>
                                <h6 class="bgt-card-title mb-0" id="budgetCategoryTitle">Spending by category</h6>
                                <div class="bgt-card-sub" id="budgetCategorySubtitle">Largest first. Bars show how much of each budget is used.</div>
                            </div>
                            <div class="bgt-legend" aria-hidden="true">
                                <span><span class="bgt-swatch bgt-swatch--ok"></span>Within budget</span>
                                <span><span class="bgt-swatch bgt-swatch--warning"></span>Near limit</span>
                                <span><span class="bgt-swatch bgt-swatch--critical"></span>Over budget</span>
                            </div>
                        </div>
                        <div class="bgt-cat-grid" id="budgetCategoryList">
                            <!-- Populated by JS -->
                        </div>
                    </div>

                    <!-- Table view -->
                    <div class="bgt-card">
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <h6 class="bgt-card-title mb-0" id="tableSectionTitle">Details</h6>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" id="btnToggleBudgetTable" aria-expanded="false" aria-controls="budgetReportTableContainer">Show table</button>
                        </div>
                        <div class="table-responsive mt-3 d-none" id="budgetReportTableContainer">
                            <!-- Populated by JS -->
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top justify-content-between">
                <div class="small text-muted">"Planned" is what you budgeted in the sheet; "spent" is what you recorded.</div>
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Spreadsheet Transactions Modal -->
<div class="modal fade" id="transactionsModal" tabindex="-1" aria-labelledby="transactionsModalLabel" aria-hidden="true"
     data-transactions-url="@Url.Action("SpreadsheetTransactions", "GoogleDrive")"
     data-connection-id="@(currentConn?.Id ?? 0)">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 bgt-root">
            <div class="modal-header border-bottom py-3">
                <div class="d-flex align-items-center gap-3 overflow-hidden">
                    <div class="bgt-header-icon flex-shrink-0">
                        <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2zm15 2h-4v3h4V4zm0 4h-4v3h4V8zm0 4h-4v3h3a1 1 0 0 0 1-1v-2zm-5 3v-3H6v3h4zm-5 0v-3H1v2a1 1 0 0 0 1 1h3zm-4-4h4V8H1v3zm0-4h4V4H1v3zm5-3v3h4V4H6zm4 4H6v3h4V8z"/>
                        </svg>
                    </div>
                    <div class="overflow-hidden">
                        <h5 class="modal-title fw-bold mb-0" id="transactionsModalLabel">Transactions</h5>
                        <div class="d-flex align-items-center gap-2 small text-muted overflow-hidden">
                            <span class="text-truncate" id="txModalFileName" title="">-</span>
                            <span class="flex-shrink-0" id="txModalDataSource"></span>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close ms-3" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-3 p-md-4 bgt-body">
                <!-- Loading state -->
                <div class="bgt-state" id="txLoadingState" role="status">
                    <div class="spinner-border text-secondary mb-3" aria-hidden="true"></div>
                    <div class="fw-semibold">Reading your transactions&hellip;</div>
                    <div class="small text-muted">Pulling the Transactions sheet from Google Drive. This usually takes a few seconds.</div>
                </div>

                <!-- Error state -->
                <div class="bgt-state d-none" id="txErrorState" role="alert">
                    <div class="bgt-state-icon mb-3" aria-hidden="true">!</div>
                    <div class="fw-semibold">We couldn't find any transactions in this spreadsheet</div>
                    <div class="small text-muted mb-3" id="txErrorMessage"></div>
                    <button type="button" class="btn btn-sm btn-dark rounded-pill px-4" id="btnTxRetry">Try again</button>
                </div>

                <!-- Transactions -->
                <div class="d-none" id="txContent">
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label">Transactions</div>
                                <div class="bgt-tile-value" id="txKpiCount">0</div>
                                <div class="bgt-tile-sub" id="txKpiRange"></div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label"><span class="bgt-swatch bgt-swatch--spend" aria-hidden="true"></span>Spending</div>
                                <div class="bgt-tile-value" id="txKpiExpenses">$0.00</div>
                                <div class="bgt-tile-sub" id="txKpiExpensesSub"></div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label"><span class="bgt-swatch bgt-swatch--income" aria-hidden="true"></span>Income</div>
                                <div class="bgt-tile-value" id="txKpiIncome">$0.00</div>
                                <div class="bgt-tile-sub" id="txKpiIncomeSub"></div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label">Net</div>
                                <div class="bgt-tile-value" id="txKpiNet">$0.00</div>
                                <div class="bgt-tile-sub">Income minus spending</div>
                            </div>
                        </div>
                    </div>

                    <div class="bgt-card">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <div class="btn-group btn-group-sm" role="group" aria-label="Filter by type">
                                <button type="button" class="btn btn-outline-secondary active tx-type-filter" data-type="" aria-pressed="true">All</button>
                                <button type="button" class="btn btn-outline-secondary tx-type-filter" data-type="Expense" aria-pressed="false">Spending</button>
                                <button type="button" class="btn btn-outline-secondary tx-type-filter" data-type="Income" aria-pressed="false">Income</button>
                            </div>
                            <select class="form-select form-select-sm w-auto" id="txCategoryFilter" aria-label="Filter by category">
                                <option value="">All categories</option>
                            </select>
                        </div>
                        <div class="table-responsive">
                            <table id="txTable" class="table table-hover align-middle w-100 mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">Date</th>
                                        <th scope="col">Description</th>
                                        <th scope="col">Category</th>
                                        <th scope="col">Type</th>
                                        <th scope="col" class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top justify-content-between">
                <div class="small text-muted" id="txSheetName"></div>
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- API Key Modal -->
<div class="modal fade" id="reauthModal" tabindex="-1" aria-labelledby="reauthModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="reauthModalLabel">API key for @(currentConn?.Name ?? "this drive")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Reauth" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@(currentConn?.Id ?? 0)" />
                <div class="modal-body">
                    @if (currentConn?.HasApiKey == true)
                    {
                        <p class="small text-muted">Current key: <code>@currentConn.MaskedApiKey</code></p>
                    }
                    <label for="reauthApiKey" class="form-label fw-semibold small">Google Cloud API key</label>
                    <input type="text" id="reauthApiKey" name="apiKey" class="form-control font-monospace" placeholder="AIzaSy..." />
                    <div class="form-text">
                        The key needs the Google Drive API enabled. It's stored encrypted and used to sync this folder.
                        <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-bs-toggle="modal" data-bs-target="#apiKeyGuideModal">How do I get one?</button>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-semibold">Save and sync</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Remove Drive Confirmation Modal -->
@if (currentConn != null)
{
    <div class="modal fade" id="deleteDriveModal" tabindex="-1" aria-labelledby="deleteDriveModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" id="deleteDriveModalLabel">Remove @currentConn.Name?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        This disconnects the folder and clears its @currentConn.CachedFilesCount saved items from this app.
                        Nothing is deleted from your Google Drive, and you can reconnect it anytime.
                    </p>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="Delete" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@currentConn.Id" />
                        <button type="submit" class="btn btn-danger fw-semibold">Remove drive</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- Help & Setup Modal -->
<div class="modal fade" id="apiKeyGuideModal" tabindex="-1" aria-labelledby="apiKeyGuideModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="apiKeyGuideModalLabel">Help &amp; setup</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <h6 class="fw-bold mb-2">1. Share your folder</h6>
                <p class="text-muted small">
                    In Google Drive, right-click the folder, choose <strong>Share</strong>, and set General access to
                    <strong>Anyone with the link</strong> (Viewer). Private folders can't be read and show up as "not found".
                </p>

                <h6 class="fw-bold mb-2 mt-4">2. Name your budget spreadsheets</h6>
                <p class="text-muted small">
                    Spreadsheets whose name starts with <strong>Monthly budget</strong> get a budget report.
                    Any spreadsheet with a sheet that has <strong>Date</strong> and <strong>Amount</strong> columns can show its transactions.
                </p>

                <h6 class="fw-bold mb-2 mt-4">3. Optional: add a Google API key</h6>
                <ol class="text-muted small ps-3">
                    <li class="mb-1">Open the <a href="https://console.cloud.google.com/" target="_blank" rel="noopener noreferrer">Google Cloud Console</a> and create or pick a project.</li>
                    <li class="mb-1">Enable the <strong>Google Drive API</strong> under APIs &amp; Services &gt; Library.</li>
                    <li class="mb-1">Under <strong>APIs &amp; Services &gt; Credentials</strong>, choose <strong>Create credentials &gt; API key</strong>.</li>
                    <li>Paste the key when connecting a folder, or from the drive's <strong>&#8943;</strong> menu.</li>
                </ol>

                <h6 class="fw-bold mb-2 mt-4">How syncing works</h6>
                <p class="text-muted small mb-0">
                    The file list is saved after each sync, so the page loads quickly without contacting Google.
                    Use <strong>Sync now</strong> to pick up changes. The first load after a quiet period can take a few extra seconds.
                </p>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Got it</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Feedback -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
    <div id="pageToast" class="toast align-items-center text-white bg-dark border-0 rounded-3" role="status" aria-live="polite" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body small" id="pageToastMessage"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables-bs5/dataTables.bootstrap5.min.css"/>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/datatables/dataTables.min.js"></script>
    <script src="~/lib/datatables-bs5/dataTables.bootstrap5.min.js"></script>
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/google-drive/explorer.js" asp-append-version="true"></script>
    <script src="~/js/google-drive/budget-report.js" asp-append-version="true"></script>
    <script src="~/js/google-drive/transactions.js" asp-append-version="true"></script>
}
