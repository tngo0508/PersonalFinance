@model PersonalFinance.Web.Models.GoogleDriveViewModel

@{
    ViewData["Title"] = "Google Drive Manager & Explorer";
    var response = Model.Response;
    var files = response?.Files ?? new List<PersonalFinance.Shared.DTOs.GoogleDriveFileDto>();
    var folderCount = files.Count(f => f.IsFolder);
    var docCount = files.Count(f => !f.IsFolder);

    // Grouping file categories for quick filter chips
    var spreadsheetCount = files.Count(f => f.FileType == "Spreadsheet");
    var documentCount = files.Count(f => f.FileType == "Document");
    var pdfCount = files.Count(f => f.FileType == "PDF Document");
    var imageCount = files.Count(f => f.FileType == "Image");
    var presentationCount = files.Count(f => f.FileType == "Presentation");
    var otherCount = files.Count(f => !f.IsFolder && f.FileType != "Spreadsheet" && f.FileType != "Document" && f.FileType != "PDF Document" && f.FileType != "Image" && f.FileType != "Presentation");

    var currentConn = Model.SelectedConnection;
    var hasMultipleDrives = Model.Connections.Count > 1;
    var isNeedsReauth = currentConn != null && (!currentConn.IsValid || currentConn.SyncStatus == "NeedsReauth");
}

<div class="container py-3">
    <!-- Top Header & Brand Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 pb-3 mb-3 border-bottom">
        <div class="d-flex align-items-center gap-3">
            <div class="p-2 bg-light rounded-3 border d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                <svg width="32" height="32" viewBox="0 0 87.3 78" xmlns="http://www.w3.org/2000/svg">
                    <path d="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z" fill="#0066da"/>
                    <path d="m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44c-.8 1.4-1.2 2.95-1.2 4.5h27.5z" fill="#00ac47"/>
                    <path d="m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.502l5.852 11.5z" fill="#ea4335"/>
                    <path d="m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z" fill="#00832d"/>
                    <path d="m59.8 53h-32.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z" fill="#2684fc"/>
                    <path d="m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3l-13.75 23.8 16.15 28h27.45c0-1.55-.4-3.1-1.2-4.5z" fill="#ffba00"/>
                </svg>
            </div>
            <div>
                <h3 class="fw-bold mb-0 text-dark">Google Drive Manager</h3>
                <p class="text-muted small mb-0">Persistent Azure SQL storage, multi-drive management, and cached file synchronization</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (Model.Connections.Any())
            {
                <a asp-action="Index" asp-route-addNew="true" class="btn btn-sm btn-primary rounded-pill px-3 d-flex align-items-center gap-1 shadow-sm">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                    </svg>
                    Add another Drive
                </a>
            }
            <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#apiKeyGuideModal">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                </svg>
                API &amp; Sharing Guide
            </button>
        </div>
    </div>

    <!-- Feedback Alerts (Success & Error) -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 border-0 d-flex align-items-center" role="alert">
            <span class="fs-5 me-2">&#10003;</span>
            <div class="flex-grow-1">
                @Model.StatusMessage
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 border-0 d-flex align-items-center" role="alert">
            <span class="fs-5 me-2">&#9888;</span>
            <div class="flex-grow-1">
                <strong>Error:</strong> @Model.ErrorMessage
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Re-authentication Alert if Credentials Expired/Invalid -->
    @if (isNeedsReauth)
    {
        <div class="alert alert-warning border-warning shadow-sm rounded-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4 text-warning">&#9888;</span>
                <div>
                    <strong class="text-dark">Authentication Required</strong>
                    <div class="small text-muted">
                        @(currentConn?.ErrorMessage ?? "Your Google Drive credentials have expired or are invalid. Please update your API key or re-authenticate to synchronize files.")
                    </div>
                </div>
            </div>
            <button type="button" class="btn btn-warning btn-sm rounded-pill px-3 fw-semibold text-nowrap" data-bs-toggle="modal" data-bs-target="#reauthModal">
                Update Key / Re-authenticate &rarr;
            </button>
        </div>
    }

    <!-- Multi-Drive Connection Switcher Toolbar (When user has saved connections) -->
    @if (Model.Connections.Any())
    {
        <div class="gdrive-card p-3 mb-4 bg-light">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">
                <!-- Connection Switcher Dropdown / Tabs -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="small fw-bold text-muted text-uppercase me-1">Connected Drives:</span>
                    <div class="btn-group">
                        @foreach (var conn in Model.Connections)
                        {
                            var isActive = conn.Id == Model.SelectedConnectionId;
                            <a asp-action="Index" asp-route-connectionId="@conn.Id"
                               class="btn btn-sm @(isActive ? "btn-primary fw-bold" : "btn-outline-secondary bg-white") rounded-pill px-3 me-1 mb-1 d-flex align-items-center gap-2">
                                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31z"/>
                                </svg>
                                <span>@conn.Name</span>
                                <span class="badge @(isActive ? "bg-white text-primary" : "bg-light text-secondary border") rounded-pill">
                                    @conn.CachedFilesCount
                                </span>
                            </a>
                        }
                    </div>
                </div>

                <!-- Active Connection Controls (Sync, Reauth, Delete) -->
                @if (currentConn != null)
                {
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <!-- Incremental / Force Sync Button -->
                        <form asp-action="Sync" method="post" class="d-inline" id="syncForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@currentConn.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3 d-flex align-items-center gap-1 shadow-sm" id="btnSyncDrive" title="Incrementally sync changes from Google Drive API to the Azure SQL cache">
                                <span id="syncSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                <svg id="syncIcon" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                                    <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                                </svg>
                                <span>Sync / Refresh</span>
                            </button>
                        </form>

                        <!-- Re-authenticate Key Modal Button -->
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#reauthModal" title="Update API credentials for this connection">
                            <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                            </svg>
                            <span>@(currentConn.HasApiKey ? "Update Key" : "Add Key")</span>
                        </button>

                        <!-- Delete / Disconnect Drive Button -->
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#deleteDriveModal" title="Remove connection and clear cached files">
                            <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                            </svg>
                            <span>Remove</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Connect / Add Another Drive Omnibox Form (Shown on first setup or explicit Add New Drive) -->
    @if (Model.ShowConnectForm || !Model.Connections.Any())
    {
        <div class="gdrive-card p-3 p-md-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark">
                    @(Model.Connections.Any() ? "Connect Another Google Drive Folder" : "Connect Your Google Drive")
                </h5>
                @if (Model.Connections.Any())
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                        Cancel
                    </a>
                }
            </div>

            <form asp-action="Index" method="post" id="driveExplorerForm">
                @Html.AntiForgeryToken()

                <div class="row g-2 mb-2">
                    <div class="col-md-8">
                        <label asp-for="FolderUrl" class="form-label fw-semibold small text-dark mb-1">Google Drive Folder Link or Folder ID:</label>
                        <div class="input-group gdrive-omnibox">
                            <span class="input-group-text bg-white border-0 text-muted ps-3 pe-2">
                                <svg width="20" height="20" fill="currentColor" class="text-primary" viewBox="0 0 16 16">
                                    <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31zM2.19 4a1 1 0 0 0-.996 1.09l.637 7a1 1 0 0 0 .995.91h10.348a1 1 0 0 0 .995-.91l.637-7A1 1 0 0 0 13.81 4H2.19zm4.69-1.707A1 1 0 0 0 6.172 2H2.5a1 1 0 0 0-1 .981l.006.139C1.72 3.042 1.95 3 2.19 3h11.62c.24 0 .47.042.684.12l.006-.139a1 1 0 0 0-1-.981h-3.982a1 1 0 0 0-.707-.293l-.828-.828A1 1 0 0 0 7.172 1H6.88z"/>
                                </svg>
                            </span>
                            <input asp-for="FolderUrl" id="folderUrlInput" class="form-control border-0 ps-1 font-monospace"
                                   placeholder="Paste folder link or ID (e.g. https://drive.google.com/drive/folders/...)" required />
                            <button type="button" class="btn btn-light border-start text-secondary px-3" id="btnPasteSample" title="Insert a working public sample folder URL">
                                Paste Sample
                            </button>
                        </div>
                        <span asp-validation-for="FolderUrl" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ConnectionName" class="form-label fw-semibold small text-dark mb-1">Friendly Label (Optional):</label>
                        <input asp-for="ConnectionName" class="form-control" placeholder="e.g. Tax Documents, Personal" />
                    </div>
                </div>

                <!-- Bottom Row: Help Tip & Collapsible API Key Option & Connect Submit -->
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 pt-2">
                    <div class="text-muted small d-flex align-items-center gap-1">
                        <svg width="14" height="14" fill="#0d6efd" viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                            <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                        </svg>
                        <span><strong>Access Requirement:</strong> Folder must be set to <em>"Anyone with the link"</em> (Viewer) in Google Drive.</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-link text-decoration-none text-muted p-0" type="button" data-bs-toggle="collapse" data-bs-target="#advancedSettingsCollapse" aria-expanded="false" aria-controls="advancedSettingsCollapse">
                            <small>&#9881; Optional: API Key &darr;</small>
                        </button>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold d-flex align-items-center gap-2" id="btnSubmitExplore">
                            <span id="submitSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                            <span id="submitText">Connect &amp; Cache</span>
                        </button>
                    </div>
                </div>

                <!-- Collapsible Advanced API Key Panel -->
                <div class="collapse mt-3" id="advancedSettingsCollapse">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="ApiKey" class="form-label fw-semibold small mb-0 text-dark">Google Cloud API Key (Optional for Live Queries):</label>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 small" data-bs-toggle="modal" data-bs-target="#apiKeyGuideModal">
                                How to get a free API Key?
                            </button>
                        </div>
                        <input asp-for="ApiKey" class="form-control form-control-sm font-monospace" placeholder="AIzaSy... (leave blank to use preview mode or configured key)" />
                        <small class="text-muted">Encrypted securely and stored in Azure SQL Database. Only needed if querying non-public Google Drive configurations.</small>
                    </div>
                </div>
            </form>
        </div>
    }

    <!-- Results Section (Files from Azure SQL Cache or Live Google Drive) -->
    @if (response != null && response.Success)
    {
        @if (response.IsDemoData)
        {
            <div class="alert alert-secondary border-warning border-2 shadow-sm rounded-3 mb-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4 text-warning">&#9888;</span>
                    <div>
                        <strong class="text-dark">Preview Demo Mode Active</strong>
                        <div class="small text-muted">
                            @(response.WarningMessage ?? "Displaying sample data for demonstration. To query live Google Drive files, provide a Google Cloud API Key.")
                        </div>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill text-nowrap" data-bs-toggle="modal" data-bs-target="#reauthModal">
                    Setup Live API Key &rarr;
                </button>
            </div>
        }

        <!-- Active Folder Header & Metrics Bar -->
        <div class="gdrive-card p-3 p-md-4 mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 pb-3 border-bottom mb-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3">
                        <svg width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31L.54 3.87A2 2 0 0 1 2.5 3h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h4 class="fw-bold mb-0 text-dark">@(response.FolderName ?? currentConn?.Name ?? "Google Drive Folder")</h4>
                            <span class="badge bg-light text-secondary border font-monospace small" title="Folder ID: @response.FolderId">
                                ID: @response.FolderId
                            </span>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-secondary btn-copy-id" data-id="@response.FolderId" title="Copy Folder ID">
                                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/>
                                    <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/>
                                </svg>
                            </button>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap small text-muted mt-1">
                            @if (currentConn?.LastSyncedAtUtc != null)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2">
                                    &#9889; Cached in Azure SQL: @currentConn.LastSyncedAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC
                                </span>
                            }
                            @if (currentConn != null)
                            {
                                <span class="badge @(currentConn.HasApiKey ? "bg-info text-dark" : "bg-light text-muted border") rounded-pill px-2">
                                    @(currentConn.HasApiKey ? $"API Key: {currentConn.MaskedApiKey}" : "No Custom Key")
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(response.FolderId))
                    {
                        <a href="https://drive.google.com/drive/folders/@response.FolderId" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary d-flex align-items-center gap-2">
                            <span>Open in Drive</span>
                            <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5z"/>
                                <path fill-rule="evenodd" d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0v-5z"/>
                            </svg>
                        </a>
                    }
                </div>
            </div>

            <!-- Stats Bar -->
            <div class="row g-2">
                <div class="col-6 col-md-3">
                    <div class="gdrive-stat-pill">
                        <div class="fs-4 text-primary fw-bold">@response.TotalFilesCount</div>
                        <div>
                            <div class="small fw-semibold text-dark">Total Items</div>
                            <div class="small text-muted" style="font-size: 0.75rem;">@docCount files, @folderCount folders</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="gdrive-stat-pill">
                        <div class="fs-4 text-success fw-bold">@response.TotalSizeFormatted</div>
                        <div>
                            <div class="small fw-semibold text-dark">Total Storage</div>
                            <div class="small text-muted" style="font-size: 0.75rem;">Calculated size</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="gdrive-stat-pill">
                        <div class="fs-4 text-warning fw-bold">@folderCount</div>
                        <div>
                            <div class="small fw-semibold text-dark">Subfolders</div>
                            <div class="small text-muted" style="font-size: 0.75rem;">Directories</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="gdrive-stat-pill">
                        <div class="fs-4 text-info fw-bold">@docCount</div>
                        <div>
                            <div class="small fw-semibold text-dark">Documents</div>
                            <div class="small text-muted" style="font-size: 0.75rem;">Files &amp; Media</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Chips & View Mode Switcher -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3">
            <!-- Category Filter Chips -->
            <div class="d-flex align-items-center gap-2 flex-wrap" id="filterChipsContainer">
                <button type="button" class="gdrive-filter-chip active" data-filter="all">
                    <span>All Items</span>
                    <span class="chip-count">@response.TotalFilesCount</span>
                </button>
                @if (folderCount > 0)
                {
                    <button type="button" class="gdrive-filter-chip" data-filter="Folder">
                        <span>Folders</span>
                        <span class="chip-count">@folderCount</span>
                    </button>
                }
                @if (spreadsheetCount > 0)
                {
                    <button type="button" class="gdrive-filter-chip" data-filter="Spreadsheet">
                        <span>Sheets</span>
                        <span class="chip-count">@spreadsheetCount</span>
                    </button>
                }
                @if (documentCount > 0)
                {
                    <button type="button" class="gdrive-filter-chip" data-filter="Document">
                        <span>Docs</span>
                        <span class="chip-count">@documentCount</span>
                    </button>
                }
                @if (pdfCount > 0)
                {
                    <button type="button" class="gdrive-filter-chip" data-filter="PDF Document">
                        <span>PDFs</span>
                        <span class="chip-count">@pdfCount</span>
                    </button>
                }
                @if (imageCount > 0)
                {
                    <button type="button" class="gdrive-filter-chip" data-filter="Image">
                        <span>Images</span>
                        <span class="chip-count">@imageCount</span>
                    </button>
                }
                @if (presentationCount > 0)
                {
                    <button type="button" class="gdrive-filter-chip" data-filter="Presentation">
                        <span>Slides</span>
                        <span class="chip-count">@presentationCount</span>
                    </button>
                }
                @if (otherCount > 0)
                {
                    <button type="button" class="gdrive-filter-chip" data-filter="other">
                        <span>Other</span>
                        <span class="chip-count">@otherCount</span>
                    </button>
                }
            </div>

            <!-- Table / Grid Layout Switcher -->
            <div class="btn-group p-1 bg-light rounded-pill border" role="group" aria-label="View switch">
                <button type="button" class="btn btn-sm btn-white rounded-pill active px-3 shadow-sm" id="btnViewTable" title="Table View">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="me-1">
                        <path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2zm15 2h-4v3h4V4zm0 4h-4v3h4V8zm0 4h-4v3h3a1 1 0 0 0 1-1v-2zm-5 3v-3H6v3h4zm-5 0v-3H1v2a1 1 0 0 0 1 1h3zm-4-4h4V8H1v3zm0-4h4V4H1v3zm5-3v3h4V4H6zm4 4H6v3h4V8z"/>
                    </svg>
                    List
                </button>
                <button type="button" class="btn btn-sm text-secondary rounded-pill px-3" id="btnViewGrid" title="Grid View">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="me-1">
                        <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3z"/>
                    </svg>
                    Grid
                </button>
            </div>
        </div>

        <!-- View Mode 1: Interactive DataTables View -->
        <div id="tableViewSection" class="gdrive-card p-3 p-md-4 mb-4">
            <div class="table-responsive">
                <table id="googleDriveDataTable" class="table table-hover align-middle gdrive-table w-100 mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40px;" class="text-center">Type</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Size</th>
                            <th>Created</th>
                            <th>Last Modified</th>
                            <th style="width: 150px;" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var file in files)
                        {
                            var badgeClass = file.FileType switch
                            {
                                "Folder" => "gdrive-badge-folder",
                                "Spreadsheet" => "gdrive-badge-sheet",
                                "Document" => "gdrive-badge-doc",
                                "Presentation" => "gdrive-badge-slide",
                                "PDF Document" => "gdrive-badge-pdf",
                                "Image" => "gdrive-badge-image",
                                "Video" => "gdrive-badge-video",
                                "Archive" => "gdrive-badge-archive",
                                _ => "gdrive-badge-generic"
                            };

                            var rawSortDate = file.ModifiedTime?.ToString("yyyy-MM-ddTHH:mm:ss") ?? "0001-01-01T00:00:00";
                            var rawCreatedDate = file.CreatedTime?.ToString("yyyy-MM-ddTHH:mm:ss") ?? "0001-01-01T00:00:00";
                            var rawSortSize = file.Size.HasValue ? file.Size.Value.ToString() : "-1";
                            var isMonthlyBudget = PersonalFinance.Shared.Helpers.GoogleDriveHelper.IsMonthlyBudgetSpreadsheet(file.Name, file.FileType, file.MimeType);

                            <tr data-file-type="@file.FileType" data-is-folder="@file.IsFolder.ToString().ToLower()">
                                <td class="text-center">
                                    @if (file.IsFolder)
                                    {
                                        <svg width="22" height="22" fill="#fbbc04" viewBox="0 0 16 16">
                                            <path d="M9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31L.54 3.87A2 2 0 0 1 2.5 3h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3z"/>
                                        </svg>
                                    }
                                    else if (file.FileType == "Spreadsheet")
                                    {
                                        <svg width="20" height="20" fill="#0f9d58" viewBox="0 0 16 16">
                                            <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h10v2H3zm0 1h10v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-1z"/>
                                        </svg>
                                    }
                                    else if (file.FileType == "PDF Document")
                                    {
                                        <svg width="20" height="20" fill="#ea4335" viewBox="0 0 16 16">
                                            <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/>
                                        </svg>
                                    }
                                    else if (file.FileType == "Image")
                                    {
                                        <svg width="20" height="20" fill="#9334e6" viewBox="0 0 16 16">
                                            <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
                                            <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-12zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1h12z"/>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg width="20" height="20" fill="#4285f4" viewBox="0 0 16 16">
                                            <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/>
                                        </svg>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark text-truncate" style="max-width: 320px;" title="@file.Name">
                                        @file.Name
                                    </div>
                                    <div class="text-muted font-monospace" style="font-size: 0.72rem;">
                                        ID: @file.Id
                                    </div>
                                </td>
                                <td data-search="@file.FileType" data-filter="@file.FileType">
                                    <span class="gdrive-badge-soft @badgeClass">@file.FileType</span>
                                </td>
                                <td data-order="@rawSortSize">
                                    <span class="small @(file.IsFolder ? "text-muted" : "fw-semibold text-dark")">
                                        @file.SizeFormatted
                                    </span>
                                </td>
                                <td data-order="@rawCreatedDate">
                                    <span class="small text-muted">
                                        @(file.CreatedTime?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                                    </span>
                                </td>
                                <td data-order="@rawSortDate">
                                    <span class="small text-dark fw-medium">
                                        @(file.ModifiedTime?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                                    </span>
                                </td>
                                <td class="text-end text-nowrap">
                                    @if (isMonthlyBudget)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-2 py-1 me-1 btn-budget-report shadow-sm"
                                                data-file-id="@file.Id"
                                                data-file-name="@file.Name"
                                                data-bs-toggle="modal"
                                                data-bs-target="#monthlyBudgetModal"
                                                title="Generate Monthly Budget Summary Report &amp; Chart">
                                            <svg width="13" height="13" fill="currentColor" viewBox="0 0 16 16" class="me-1">
                                                <path d="M4 11H2v3h2v-3zm5-4H7v7h2V7zm5-5h-2v12h2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1h-2zM7 6a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H7zm-5 4a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1H2z"/>
                                            </svg>
                                            <span>Budget Report</span>
                                        </button>
                                    }
                                    @if (!string.IsNullOrEmpty(file.WebViewLink))
                                    {
                                        <a href="@file.WebViewLink" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1" title="Open in Google Drive">
                                            Open &rarr;
                                        </a>
                                    }
                                    else if (!isMonthlyBudget)
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- View Mode 2: Modern Google Drive Card Grid View -->
        <div id="gridViewSection" class="row g-3 mb-4 d-none">
            @foreach (var file in files)
            {
                var badgeClass = file.FileType switch
                {
                    "Folder" => "gdrive-badge-folder",
                    "Spreadsheet" => "gdrive-badge-sheet",
                    "Document" => "gdrive-badge-doc",
                    "Presentation" => "gdrive-badge-slide",
                    "PDF Document" => "gdrive-badge-pdf",
                    "Image" => "gdrive-badge-image",
                    "Video" => "gdrive-badge-video",
                    "Archive" => "gdrive-badge-archive",
                    _ => "gdrive-badge-generic"
                };
                var isMonthlyBudget = PersonalFinance.Shared.Helpers.GoogleDriveHelper.IsMonthlyBudgetSpreadsheet(file.Name, file.FileType, file.MimeType);

                <div class="col-12 col-sm-6 col-md-4 col-lg-3 grid-item-card" data-file-type="@file.FileType" data-is-folder="@file.IsFolder.ToString().ToLower()">
                    <div class="gdrive-grid-card">
                        <!-- Preview Thumbnail / Icon Box -->
                        <div class="gdrive-grid-preview">
                            @if (!string.IsNullOrEmpty(file.ThumbnailLink))
                            {
                                <img src="@file.ThumbnailLink" alt="@file.Name" loading="lazy" />
                            }
                            else if (file.IsFolder)
                            {
                                <svg width="44" height="44" fill="#fbbc04" viewBox="0 0 16 16">
                                    <path d="M9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31L.54 3.87A2 2 0 0 1 2.5 3h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3z"/>
                                </svg>
                            }
                            else if (file.FileType == "Spreadsheet")
                            {
                                <svg width="38" height="38" fill="#0f9d58" viewBox="0 0 16 16">
                                    <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h10v2H3zm0 1h10v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-1z"/>
                                </svg>
                            }
                            else if (file.FileType == "PDF Document")
                            {
                                <svg width="38" height="38" fill="#ea4335" viewBox="0 0 16 16">
                                    <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/>
                                </svg>
                            }
                            else
                            {
                                <svg width="38" height="38" fill="#4285f4" viewBox="0 0 16 16">
                                    <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/>
                                </svg>
                            }
                        </div>

                        <!-- Card Body Details -->
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                <span class="gdrive-badge-soft @badgeClass" style="font-size: 0.7rem;">
                                    @file.FileType
                                </span>
                                <span class="small text-muted" style="font-size: 0.75rem;">
                                    @file.SizeFormatted
                                </span>
                            </div>
                            <h6 class="fw-semibold text-dark text-truncate mb-1" title="@file.Name">
                                @file.Name
                            </h6>
                            <div class="small text-muted mb-2" style="font-size: 0.75rem;">
                                Modified: @(file.ModifiedTime?.ToString("yyyy-MM-dd") ?? "-")
                            </div>
                        </div>

                        <!-- Card Action Footer -->
                        <div class="pt-2 border-top d-flex justify-content-between align-items-center">
                            <small class="text-muted font-monospace" style="font-size: 0.7rem;">
                                @(file.Id.Length > 10 ? file.Id[..8] + "..." : file.Id)
                            </small>
                            <div class="d-flex align-items-center gap-1">
                                @if (isMonthlyBudget)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-2 py-0 btn-budget-report shadow-sm"
                                            data-file-id="@file.Id"
                                            data-file-name="@file.Name"
                                            data-bs-toggle="modal"
                                            data-bs-target="#monthlyBudgetModal"
                                            style="font-size: 0.75rem;"
                                            title="Generate Monthly Budget Summary Report &amp; Chart">
                                        📊 Report
                                    </button>
                                }
                                @if (!string.IsNullOrEmpty(file.WebViewLink))
                                {
                                    <a href="@file.WebViewLink" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-link text-primary text-decoration-none p-0 fw-semibold">
                                        Open &rarr;
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!Model.ShowConnectForm && !Model.Connections.Any())
    {
        <!-- First-Time Welcoming Hero State -->
        <div class="gdrive-card p-5 text-center mb-4">
            <div class="mb-3 text-primary">
                <svg width="64" height="64" fill="currentColor" viewBox="0 0 16 16" class="opacity-75">
                    <path d="M9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31L.54 3.87A2 2 0 0 1 2.5 3h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3z"/>
                </svg>
            </div>
            <h4 class="fw-bold text-dark mb-2">No Google Drive Connected</h4>
            <p class="text-muted mx-auto mb-4" style="max-width: 500px;">
                Connect a shared Google Drive folder once to explore, sort, and cache its files in Azure SQL Database. On subsequent visits, your saved drives and cached files will load automatically.
            </p>
            <a asp-action="Index" asp-route-addNew="true" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm">
                Connect a Google Drive Folder &rarr;
            </a>
        </div>
    }
</div>

<!-- Monthly Budget Summary Report & Chart Modal -->
<div class="modal fade" id="monthlyBudgetModal" tabindex="-1" aria-labelledby="monthlyBudgetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 bgt-root">
            <div class="modal-header border-bottom py-3 justify-content-between">
                <div class="d-flex align-items-center gap-3 overflow-hidden">
                    <div class="bgt-header-icon flex-shrink-0">
                        <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M4 11H2v3h2v-3zm5-4H7v7h2V7zm5-5h-2v12h2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1h-2zM7 6a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H7zm-5 4a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1H2z"/>
                        </svg>
                    </div>
                    <div class="overflow-hidden">
                        <h5 class="modal-title fw-bold mb-0" id="monthlyBudgetModalLabel">Monthly Budget Summary &amp; Analytics</h5>
                        <div class="d-flex align-items-center gap-2 small text-muted overflow-hidden" id="budgetModalFileHeader">
                            <span class="text-truncate" id="budgetModalFileName" title="">-</span>
                            <span class="flex-shrink-0" id="budgetModalDataSource"></span>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-shrink-0 ms-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-flex align-items-center gap-1" id="btnPrintBudgetReport" title="Print this report" disabled>
                        <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z"/>
                            <path d="M5 1a2 2 0 0 0-2 2v2H2a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1V3a2 2 0 0 0-2-2H5zM4 3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2H4V3zm1 5a2 2 0 0 0-2 2v1H2a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v-1a2 2 0 0 0-2-2H5zm7 2v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1z"/>
                        </svg>
                        <span>Print</span>
                    </button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>

            <div class="modal-body p-3 p-md-4 bgt-body" id="budgetReportPrintArea">
                <!-- Loading state -->
                <div class="bgt-state" id="budgetLoadingState" role="status">
                    <div class="spinner-border text-secondary mb-3" aria-hidden="true"></div>
                    <div class="fw-semibold">Reading your spreadsheet&hellip;</div>
                    <div class="small text-muted">Pulling the latest numbers from Google Drive. This usually takes a few seconds.</div>
                </div>

                <!-- Error state -->
                <div class="bgt-state d-none" id="budgetErrorState" role="alert">
                    <div class="bgt-state-icon mb-3" aria-hidden="true">!</div>
                    <div class="fw-semibold">We couldn't build a report from this spreadsheet</div>
                    <div class="small text-muted mb-3" id="budgetErrorMessage">Check that the file is a monthly budget sheet and that the drive is still shared, then try again.</div>
                    <button type="button" class="btn btn-sm btn-dark rounded-pill px-4" id="btnBudgetRetry">Try again</button>
                </div>

                <!-- Report -->
                <div class="d-none" id="budgetReportContent">
                    <!-- Period selector: scopes everything below -->
                    <div class="bgt-toolbar mb-3">
                        <button type="button" class="bgt-nav-btn" id="btnBudgetPrev" aria-label="Previous period">&lsaquo;</button>
                        <div class="bgt-period-scroll" id="budgetMonthButtonGroup" role="tablist" aria-label="Choose a period">
                            <!-- Populated dynamically via JS -->
                        </div>
                        <button type="button" class="bgt-nav-btn" id="btnBudgetNext" aria-label="Next period">&rsaquo;</button>
                    </div>

                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-1 mb-3">
                        <div>
                            <h4 class="fw-bold mb-0 bgt-ink" id="budgetPeriodTitle">-</h4>
                            <div class="small bgt-ink-2" id="budgetPeriodSubtitle"></div>
                        </div>
                        <div class="small text-muted d-none d-md-block" id="budgetKeyboardHint">Tip: use the &larr; &rarr; keys to switch periods</div>
                    </div>

                    <!-- Plain-language summary -->
                    <div class="bgt-insight mb-4" id="budgetInsight"></div>

                    <!-- KPI tiles -->
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label"><span class="bgt-swatch bgt-swatch--income" aria-hidden="true"></span>Income</div>
                                <div class="bgt-tile-value" id="kpiTotalIncome">$0.00</div>
                                <div class="bgt-tile-sub" id="kpiIncomeSubtext"></div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label"><span class="bgt-swatch bgt-swatch--spend" aria-hidden="true"></span>Spending</div>
                                <div class="bgt-tile-value" id="kpiTotalExpenses">$0.00</div>
                                <div class="bgt-tile-sub" id="kpiExpensesSubtext"></div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label">Net saved</div>
                                <div class="bgt-tile-value" id="kpiNetSavings">$0.00</div>
                                <div class="bgt-tile-sub" id="kpiSavingsSubtext"></div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label">Savings rate</div>
                                <div class="bgt-tile-value" id="kpiSavingsRate">0%</div>
                                <div class="bgt-tile-sub" id="kpiStatusBadge"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Year overview charts (hidden in month view) -->
                    <div class="row g-3 mb-4" id="budgetYearCharts">
                        <div class="col-12 col-lg-8">
                            <div class="bgt-card h-100">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                    <div>
                                        <h6 class="bgt-card-title mb-0">Income vs. spending by month</h6>
                                        <div class="bgt-card-sub">Click a month to see its details</div>
                                    </div>
                                    <div class="bgt-legend" aria-hidden="true">
                                        <span><span class="bgt-swatch bgt-swatch--income"></span>Income</span>
                                        <span><span class="bgt-swatch bgt-swatch--spend"></span>Spending</span>
                                    </div>
                                </div>
                                <div class="bgt-chart-box">
                                    <canvas id="budgetMainChart" role="img" aria-label="Column chart of income and spending for each month. The same values are in the month-by-month table below."></canvas>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="bgt-card h-100">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                    <div>
                                        <h6 class="bgt-card-title mb-0">Net saved each month</h6>
                                        <div class="bgt-card-sub">Above the line you saved, below you overspent</div>
                                    </div>
                                    <div class="bgt-legend" aria-hidden="true">
                                        <span><span class="bgt-swatch bgt-swatch--income"></span>Saved</span>
                                        <span><span class="bgt-swatch bgt-swatch--neg"></span>Overspent</span>
                                    </div>
                                </div>
                                <div class="bgt-chart-box">
                                    <canvas id="budgetNetChart" role="img" aria-label="Column chart of net savings for each month. The same values are in the month-by-month table below."></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Category breakdown -->
                    <div class="bgt-card mb-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                            <div>
                                <h6 class="bgt-card-title mb-0" id="budgetCategoryTitle">Spending by category</h6>
                                <div class="bgt-card-sub" id="budgetCategorySubtitle">Largest first. Bars show how much of each budget is used.</div>
                            </div>
                            <div class="bgt-legend" aria-hidden="true">
                                <span><span class="bgt-swatch bgt-swatch--ok"></span>Within budget</span>
                                <span><span class="bgt-swatch bgt-swatch--warning"></span>Near limit</span>
                                <span><span class="bgt-swatch bgt-swatch--critical"></span>Over budget</span>
                            </div>
                        </div>
                        <div class="bgt-cat-grid" id="budgetCategoryList">
                            <!-- Populated by JS -->
                        </div>
                    </div>

                    <!-- Table view -->
                    <div class="bgt-card">
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <h6 class="bgt-card-title mb-0" id="tableSectionTitle">Details</h6>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" id="btnToggleBudgetTable" aria-expanded="false" aria-controls="budgetReportTableContainer">Show table</button>
                        </div>
                        <div class="table-responsive mt-3 d-none" id="budgetReportTableContainer">
                            <!-- Populated by JS -->
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top justify-content-between">
                <div class="small text-muted">"Planned" is what you budgeted in the sheet; "spent" is what you recorded.</div>
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Re-authentication / Update API Key Modal -->
<div class="modal fade" id="reauthModal" tabindex="-1" aria-labelledby="reauthModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom pb-3">
                <h5 class="modal-title fw-bold text-dark" id="reauthModalLabel">
                    <span class="text-primary me-1">&#9881;</span> Google Drive API Credentials
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Reauth" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@(currentConn?.Id ?? 0)" />
                <div class="modal-body">
                    <p class="text-muted small">
                        Update or provide a Google Cloud API Key with <em>Google Drive API</em> enabled for <strong>@(currentConn?.Name ?? "this connection")</strong>.
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Google Cloud API Key:</label>
                        <input type="text" name="apiKey" class="form-control font-monospace" placeholder="AIzaSy..." />
                        <small class="text-muted">Encrypted, stored securely in Azure SQL Database, and used to synchronize folder metadata.</small>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">Save &amp; Re-sync</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Remove / Delete Connection Confirmation Modal -->
@if (currentConn != null)
{
    <div class="modal fade" id="deleteDriveModal" tabindex="-1" aria-labelledby="deleteDriveModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <div class="modal-header border-bottom pb-3">
                    <h5 class="modal-title fw-bold text-danger" id="deleteDriveModalLabel">
                        <span>&#9888;</span> Remove Google Drive Connection
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-dark mb-2">
                        Are you sure you want to remove <strong>@currentConn.Name</strong> (Folder ID: <code>@currentConn.FolderId</code>)?
                    </p>
                    <div class="alert alert-warning small mb-0">
                        This will remove the connection configuration and purge all <strong>@currentConn.CachedFilesCount cached items</strong> from the database. You can reconnect it anytime.
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="Delete" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@currentConn.Id" />
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">Remove Drive</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- API & Sharing Guide Modal -->
<div class="modal fade" id="apiKeyGuideModal" tabindex="-1" aria-labelledby="apiKeyGuideModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom pb-3">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="apiKeyGuideModalLabel">
                    <span class="p-1 bg-primary text-white rounded">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                        </svg>
                    </span>
                    Google Drive Access &amp; API Key Guide
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-primary d-flex align-items-center gap-2 mb-4" role="alert">
                    <span class="fs-4">&#128161;</span>
                    <div>
                        <strong>Azure SQL Persistent Caching Active:</strong> When connected, folder metadata is stored in Azure SQL Database (Serverless) by the API service and served from there on subsequent visits, so Google Drive is only queried when you sync. The first request after the database auto-pauses may take a few extra seconds while it resumes.
                    </div>
                </div>

                <h6 class="fw-bold text-dark mb-2">1. Sharing Permissions ("Anyone with the link")</h6>
                <p class="text-muted small">
                    For Google Drive to allow file exploration via API, your folder access must be public or shared. Open Google Drive, right-click the folder, click <strong>Share</strong>, and set General access to <strong>"Anyone with the link"</strong> (Viewer).
                </p>

                <h6 class="fw-bold text-dark mb-2 mt-4">2. Optional: Getting a Google Cloud API Key</h6>
                <ol class="text-muted small ps-3 mb-0">
                    <li class="mb-2">Go to the <a href="https://console.cloud.google.com/" target="_blank" rel="noopener noreferrer">Google Cloud Console</a> and create or select a project.</li>
                    <li class="mb-2">Enable the <strong>Google Drive API</strong> in APIs &amp; Services &gt; Library.</li>
                    <li class="mb-2">Go to <strong>APIs &amp; Services &gt; Credentials</strong> and click <strong>Create Credentials &gt; API Key</strong>.</li>
                    <li>Copy your API key and paste it into the connection or re-auth dialog.</li>
                </ol>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-dismiss="modal">Got it!</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Feedback Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
    <div id="copyToast" class="toast align-items-center text-white bg-dark border-0 rounded-3" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body small" id="copyToastMessage">
                Folder ID copied to clipboard!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Paste Sample Handler
            $('#btnPasteSample').on('click', function () {
                $('#folderUrlInput').val('https://drive.google.com/drive/folders/127ViLEHTWIEsAN0x8gbRGTJiwOpbH3g_?usp=drive_link');
            });

            // Form Submit Spinner
            $('#driveExplorerForm').on('submit', function () {
                if ($(this).valid()) {
                    $('#submitSpinner').removeClass('d-none');
                    $('#submitText').text('Connecting...');
                    $('#btnSubmitExplore').prop('disabled', true);
                }
            });

            // Sync Form Spinner
            $('#syncForm').on('submit', function () {
                $('#syncSpinner').removeClass('d-none');
                $('#syncIcon').addClass('d-none');
                $('#btnSyncDrive').prop('disabled', true);
            });

            // Copy Folder ID Toast
            $('.btn-copy-id').on('click', function () {
                var folderId = $(this).data('id');
                if (navigator.clipboard && folderId) {
                    navigator.clipboard.writeText(folderId).then(function () {
                        var toastEl = document.getElementById('copyToast');
                        if (toastEl) {
                            var toast = new bootstrap.Toast(toastEl, { delay: 2500 });
                            $('#copyToastMessage').text('Folder ID copied to clipboard: ' + folderId);
                            toast.show();
                        }
                    });
                }
            });

            // Initialize DataTables with sorting by modifiedTime desc (column 5)
            var dataTable = null;
            if ($('#googleDriveDataTable').length > 0) {
                dataTable = $('#googleDriveDataTable').DataTable({
                    responsive: true,
                    pageLength: 25,
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                    order: [[5, 'desc']], // Default ordering: Column 5 (Last Modified) descending
                    language: {
                        search: "",
                        searchPlaceholder: "Filter files in table...",
                        emptyTable: "No files found in this Google Drive folder."
                    },
                    dom: "<'row mb-2'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                         "<'row'<'col-sm-12'tr>>" +
                         "<'row mt-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
                });
            }

            // View Mode Switcher (Table vs Grid)
            $('#btnViewTable').on('click', function () {
                $('#btnViewTable').addClass('active btn-white shadow-sm').removeClass('text-secondary');
                $('#btnViewGrid').removeClass('active btn-white shadow-sm').addClass('text-secondary');
                $('#tableViewSection').removeClass('d-none');
                $('#gridViewSection').addClass('d-none');
            });

            $('#btnViewGrid').on('click', function () {
                $('#btnViewGrid').addClass('active btn-white shadow-sm').removeClass('text-secondary');
                $('#btnViewTable').removeClass('active btn-white shadow-sm').addClass('text-secondary');
                $('#gridViewSection').removeClass('d-none');
                $('#tableViewSection').addClass('d-none');
            });

            // Category Filter Chips Sync
            $('.gdrive-filter-chip').on('click', function () {
                $('.gdrive-filter-chip').removeClass('active');
                $(this).addClass('active');

                var category = $(this).data('filter');

                // 1. Filter DataTables
                if (dataTable) {
                    if (category === 'all') {
                        dataTable.column(2).search('').draw();
                    } else if (category === 'other') {
                        dataTable.column(2).search('^(?!\\s*(Folder|Spreadsheet|Document|PDF Document|Image|Presentation)\\s*$).*$', true, false).draw();
                    } else {
                        var escapedCat = category.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                        dataTable.column(2).search('^\\s*' + escapedCat + '\\s*$', true, false).draw();
                    }
                }

                // 2. Filter Grid Cards
                if (category === 'all') {
                    $('.grid-item-card').show();
                } else if (category === 'other') {
                    $('.grid-item-card').each(function () {
                        var itemType = $(this).data('file-type');
                        if (itemType !== 'Folder' && itemType !== 'Spreadsheet' && itemType !== 'Document' && itemType !== 'PDF Document' && itemType !== 'Image' && itemType !== 'Presentation') {
                            $(this).show();
                        } else {
                            $(this).hide();
                        }
                    });
                } else {
                    $('.grid-item-card').each(function () {
                        var itemType = $(this).data('file-type');
                        if (itemType === category) {
                            $(this).show();
                        } else {
                            $(this).hide();
                        }
                    });
                }
            });

            // ==========================================
            // Monthly Budget Summary Report & Charts Logic
            // ==========================================
            var BUDGET_COLORS = {
                income: '#2a78d6',
                spend: '#eb6834',
                negative: '#e34948',
                grid: '#e1e0d9',
                axis: '#c3c2b7',
                muted: '#898781'
            };
            var budgetMainChartInstance = null;
            var budgetNetChartInstance = null;
            var currentBudgetData = null;
            var currentSelectedMonth = 0;
            var budgetPeriods = [];
            var lastBudgetRequest = null;
            var budgetRequestSeq = 0;
            var budgetTableUserToggled = false;

            function formatCurrency(num) {
                if (num === null || num === undefined || isNaN(num)) return '$0.00';
                var n = Number(num);
                var formatted = '$' + Math.abs(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                return n < 0 ? '-' + formatted : formatted;
            }

            // Whole-dollar format for prose and tiles where cents are noise
            function formatMoney(num) {
                var n = Number(num) || 0;
                var formatted = '$' + Math.abs(n).toLocaleString('en-US', { maximumFractionDigits: 0 });
                return n < 0 ? '-' + formatted : formatted;
            }

            function formatCompactCurrency(val) {
                var abs = Math.abs(val);
                var sign = val < 0 ? '-' : '';
                if (abs >= 1000000) return sign + '$' + (abs / 1000000).toFixed(1).replace(/\.0$/, '') + 'M';
                if (abs >= 1000) return sign + '$' + (abs / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
                return sign + '$' + abs.toLocaleString('en-US');
            }

            function escapeHtml(value) {
                return String(value === null || value === undefined ? '' : value)
                    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
            }

            function hasValue(v) {
                return v !== null && v !== undefined;
            }

            // Status always ships as icon + label, never color alone
            function statusPill(tone, label) {
                var icon = tone === 'good' ? '&#10003;' : (tone === 'warning' ? '!' : '&#10005;');
                return '<span class="bgt-status bgt-status--' + tone + '"><span class="bgt-status-icon" aria-hidden="true">' + icon + '</span>' + escapeHtml(label) + '</span>';
            }

            function monthStatusTone(status) {
                if (status === 'Under Budget') return 'good';
                if (status === 'On Track') return 'warning';
                return 'critical';
            }

            function monthStatusLabel(status) {
                if (status === 'Under Budget') return 'Under budget';
                if (status === 'On Track') return 'On track (up to 5% over)';
                return 'Over budget';
            }

            function yearStatus(data) {
                var planned = data.totalAnnualBudgetedExpenses;
                if (planned > 0) {
                    if (data.totalAnnualExpenses <= planned) return 'Under Budget';
                    if (data.totalAnnualExpenses <= planned * 1.05) return 'On Track';
                    return 'Over Budget';
                }
                return data.totalAnnualSavings >= 0 ? 'Under Budget' : 'Over Budget';
            }

            function categoryTone(c) {
                if (!(c.budgetedAmount > 0)) return 'none';
                if (c.actualAmount <= c.budgetedAmount * 0.9) return 'good';
                if (c.actualAmount <= c.budgetedAmount) return 'warning';
                return 'critical';
            }

            function categoryStatusLabel(tone) {
                if (tone === 'good') return 'Within budget';
                if (tone === 'warning') return 'Near limit';
                if (tone === 'critical') return 'Over budget';
                return 'No budget set';
            }

            function balanceText(start, end) {
                if (!hasValue(start) || !hasValue(end)) return '';
                var change = end - start;
                return 'Balance ' + formatMoney(start) + ' &rarr; ' + formatMoney(end) +
                    ' (' + (change >= 0 ? '+' : '') + formatMoney(change) + ')';
            }

            function planDeltaText(actual, planned, aboveWord, belowWord) {
                if (!(planned > 0)) return '';
                var diff = actual - planned;
                if (Math.abs(diff) < 0.005) return 'Exactly on plan (' + formatMoney(planned) + ')';
                return formatMoney(Math.abs(diff)) + ' ' + (diff > 0 ? aboveWord : belowWord) + ' plan of ' + formatMoney(planned);
            }

            function aggregateCategories(months) {
                var map = {};
                var order = [];
                months.forEach(function (m) {
                    (m.categories || []).forEach(function (c) {
                        if (!map[c.categoryName]) {
                            map[c.categoryName] = { categoryName: c.categoryName, budgetedAmount: 0, actualAmount: 0 };
                            order.push(c.categoryName);
                        }
                        map[c.categoryName].budgetedAmount += c.budgetedAmount || 0;
                        map[c.categoryName].actualAmount += c.actualAmount || 0;
                    });
                });
                return order.map(function (k) { return map[k]; });
            }

            function setPeriodChips() {
                var html = '';
                budgetPeriods.forEach(function (p) {
                    var isActive = p.month === currentSelectedMonth;
                    html += '<button type="button" role="tab" class="bgt-period-btn budget-month-btn' + (p.month === 0 ? ' bgt-period-btn--year' : '') + (isActive ? ' active' : '') + '"' +
                        ' data-month="' + p.month + '" aria-selected="' + isActive + '" title="' + escapeHtml(p.title) + '">' + escapeHtml(p.label) + '</button>';
                });
                $('#budgetMonthButtonGroup').html(html);

                var idx = budgetPeriods.findIndex(function (p) { return p.month === currentSelectedMonth; });
                $('#btnBudgetPrev').prop('disabled', idx <= 0);
                $('#btnBudgetNext').prop('disabled', idx === -1 || idx >= budgetPeriods.length - 1);
                $('#btnBudgetPrev, #btnBudgetNext').toggle(budgetPeriods.length > 1);
                $('#budgetKeyboardHint').toggleClass('d-md-block', budgetPeriods.length > 1);

                var activeEl = $('#budgetMonthButtonGroup .active')[0];
                if (activeEl && activeEl.scrollIntoView) activeEl.scrollIntoView({ block: 'nearest', inline: 'nearest' });
            }

            function setTableVisible(visible) {
                $('#budgetReportTableContainer').toggleClass('d-none', !visible);
                $('#btnToggleBudgetTable').text(visible ? 'Hide table' : 'Show table').attr('aria-expanded', visible);
            }

            function renderInsight(tone, sentences) {
                $('#budgetInsight')
                    .attr('data-tone', tone)
                    .html(sentences.filter(Boolean).join(' '));
            }

            function renderCategoryList(categories) {
                var items = categories.filter(function (c) { return (c.actualAmount || 0) !== 0 || (c.budgetedAmount || 0) !== 0; });
                if (items.length === 0) {
                    $('#budgetCategoryList').html('<div class="text-muted small">No category spending was found for this period.</div>');
                    return;
                }
                items.sort(function (a, b) { return b.actualAmount - a.actualAmount; });
                var maxActual = Math.max.apply(null, items.map(function (c) { return c.actualAmount; }).concat([1]));

                var html = '';
                items.forEach(function (c) {
                    var tone = categoryTone(c);
                    var hasBudget = tone !== 'none';
                    var pct = hasBudget ? (c.actualAmount / c.budgetedAmount) * 100 : 0;
                    var width = hasBudget ? Math.min(pct, 100) : Math.max(0, (c.actualAmount / maxActual) * 100);
                    var remaining = c.budgetedAmount - c.actualAmount;
                    var footLeft = hasBudget
                        ? (remaining >= 0 ? formatMoney(remaining) + ' left' : formatMoney(-remaining) + ' over')
                        : 'No budget set';
                    var footRight = hasBudget ? Math.round(pct) + '% used' : '';
                    var statusHtml = (tone === 'warning' || tone === 'critical') ? ' ' + statusPill(tone, categoryStatusLabel(tone)) : '';

                    html += '<div class="bgt-cat-row">' +
                        '<div class="bgt-cat-head">' +
                            '<span class="bgt-cat-name" title="' + escapeHtml(c.categoryName) + '">' + escapeHtml(c.categoryName) + '</span>' +
                            '<span class="bgt-cat-amount">' + formatMoney(c.actualAmount) + (hasBudget ? ' <small>of ' + formatMoney(c.budgetedAmount) + '</small>' : '') + '</span>' +
                        '</div>' +
                        '<div class="bgt-meter' + (hasBudget ? '' : ' bgt-meter--nobudget') + '" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="' + Math.round(width) + '"' +
                            ' aria-label="' + escapeHtml(c.categoryName) + ': ' + (hasBudget ? Math.round(pct) + '% of budget used' : 'no budget set') + '">' +
                            '<div class="bgt-meter-fill bgt-meter-fill--' + tone + '" style="width: ' + width.toFixed(1) + '%;"></div>' +
                        '</div>' +
                        '<div class="bgt-cat-foot"><span>' + footLeft + statusHtml + '</span><span>' + footRight + '</span></div>' +
                    '</div>';
                });
                $('#budgetCategoryList').html(html);
            }

            function destroyYearCharts() {
                if (budgetMainChartInstance) { budgetMainChartInstance.destroy(); budgetMainChartInstance = null; }
                if (budgetNetChartInstance) { budgetNetChartInstance.destroy(); budgetNetChartInstance = null; }
            }

            function baseChartOptions(months) {
                return {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    onClick: function (evt, elements, chart) {
                        var points = chart.getElementsAtEventForMode(evt, 'index', { intersect: false }, false);
                        if (points.length && months[points[0].index]) {
                            renderBudgetMonth(months[points[0].index].monthNumber);
                        }
                    },
                    onHover: function (evt, elements) {
                        if (evt.native && evt.native.target) evt.native.target.style.cursor = elements.length ? 'pointer' : 'default';
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0b0b0b',
                            padding: 10,
                            cornerRadius: 8,
                            boxPadding: 4,
                            callbacks: {
                                title: function (items) { return items.length ? months[items[0].dataIndex].monthName : ''; },
                                footer: function () { return 'Click to open this month'; }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            border: { color: BUDGET_COLORS.axis },
                            ticks: { color: BUDGET_COLORS.muted }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: BUDGET_COLORS.grid },
                            border: { display: false },
                            ticks: { color: BUDGET_COLORS.muted, maxTicksLimit: 6, callback: function (val) { return formatCompactCurrency(val); } }
                        }
                    }
                };
            }

            function renderYearCharts(months) {
                destroyYearCharts();
                var labels = months.map(function (m) { return m.monthName.substring(0, 3); });
                var barStyle = { borderRadius: 4, borderSkipped: 'start', maxBarThickness: 24, categoryPercentage: 0.7, barPercentage: 0.9 };

                var mainOptions = baseChartOptions(months);
                mainOptions.plugins.tooltip.callbacks.label = function (ctx) { return ' ' + ctx.dataset.label + ': ' + formatCurrency(ctx.parsed.y); };
                mainOptions.plugins.tooltip.callbacks.afterBody = function (items) {
                    var m = items.length ? months[items[0].dataIndex] : null;
                    return m ? ' Net: ' + formatCurrency(m.netSavings) : '';
                };
                budgetMainChartInstance = new Chart(document.getElementById('budgetMainChart').getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            $.extend({ label: 'Income', data: months.map(function (m) { return m.actualIncome; }), backgroundColor: BUDGET_COLORS.income }, barStyle),
                            $.extend({ label: 'Spending', data: months.map(function (m) { return m.actualExpenses; }), backgroundColor: BUDGET_COLORS.spend }, barStyle)
                        ]
                    },
                    options: mainOptions
                });

                var netOptions = baseChartOptions(months);
                netOptions.plugins.tooltip.callbacks.label = function (ctx) {
                    var v = ctx.parsed.y;
                    return v >= 0 ? ' Saved ' + formatCurrency(v) : ' Overspent ' + formatCurrency(-v);
                };
                netOptions.scales.y.beginAtZero = true;
                netOptions.scales.x.ticks.maxRotation = 0;
                netOptions.scales.x.ticks.autoSkipPadding = 6;
                netOptions.scales.y.grid.color = function (ctx) { return ctx.tick && ctx.tick.value === 0 ? BUDGET_COLORS.axis : BUDGET_COLORS.grid; };
                var netValues = months.map(function (m) { return m.netSavings; });
                budgetNetChartInstance = new Chart(document.getElementById('budgetNetChart').getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [$.extend({
                            label: 'Net saved',
                            data: netValues,
                            backgroundColor: netValues.map(function (v) { return v >= 0 ? BUDGET_COLORS.income : BUDGET_COLORS.negative; })
                        }, barStyle, { categoryPercentage: 0.6, barPercentage: 1 })]
                    },
                    options: netOptions
                });
            }

            function renderYearView(data) {
                var months = data.months;
                var status = yearStatus(data);
                var underCount = months.filter(function (m) { return m.status === 'Under Budget'; }).length;

                $('#budgetPeriodTitle').text(data.year + ' · Full year');
                $('#budgetPeriodSubtitle').html(balanceText(data.startingBalance, data.endingBalance) || (months.length + ' months of data'));

                // KPI tiles
                $('#kpiTotalIncome').text(formatMoney(data.totalAnnualIncome));
                $('#kpiIncomeSubtext').text(planDeltaText(data.totalAnnualIncome, data.totalAnnualBudgetedIncome, 'above', 'below') ||
                    ('Avg ' + formatMoney(data.totalAnnualIncome / months.length) + ' / month'));
                $('#kpiTotalExpenses').text(formatMoney(data.totalAnnualExpenses));
                $('#kpiExpensesSubtext').text(planDeltaText(data.totalAnnualExpenses, data.totalAnnualBudgetedExpenses, 'over', 'under') ||
                    ('Avg ' + formatMoney(data.totalAnnualExpenses / months.length) + ' / month'));
                $('#kpiNetSavings').text(formatMoney(data.totalAnnualSavings));
                $('#kpiSavingsSubtext').text(data.totalAnnualSavings >= 0 ? 'Income minus spending' : 'Spent more than you earned');
                $('#kpiSavingsRate').text(data.averageSavingsRate.toFixed(1) + '%');
                $('#kpiStatusBadge').html(statusPill(monthStatusTone(status), monthStatusLabel(status)));

                // Plain-language summary
                var best = months.reduce(function (a, b) { return b.netSavings > a.netSavings ? b : a; });
                var worst = months.reduce(function (a, b) { return b.netSavings < a.netSavings ? b : a; });
                var categories = aggregateCategories(months);
                var top = categories.slice().sort(function (a, b) { return b.actualAmount - a.actualAmount; })[0];
                var sentences = [
                    data.totalAnnualSavings >= 0
                        ? 'In ' + data.year + ' you saved <strong>' + formatMoney(data.totalAnnualSavings) + '</strong>, <strong>' + data.averageSavingsRate.toFixed(0) + '%</strong> of your income.'
                        : 'In ' + data.year + ' you spent <strong>' + formatMoney(-data.totalAnnualSavings) + ' more</strong> than you earned.',
                    '<strong>' + underCount + ' of ' + months.length + '</strong> months came in under budget.',
                    months.length > 1 && best.netSavings > 0 ? 'Best month: ' + escapeHtml(best.monthName) + ' (saved ' + formatMoney(best.netSavings) + ').' : '',
                    months.length > 1 && worst.netSavings < 0 ? 'Toughest month: ' + escapeHtml(worst.monthName) + ' (overspent ' + formatMoney(-worst.netSavings) + ').' : '',
                    top && top.actualAmount > 0 && data.totalAnnualExpenses > 0
                        ? 'Biggest expense: ' + escapeHtml(top.categoryName) + ' (' + formatMoney(top.actualAmount) + ', ' + Math.round(top.actualAmount / data.totalAnnualExpenses * 100) + '% of spending).'
                        : ''
                ];
                renderInsight(monthStatusTone(status), sentences);

                // Charts
                $('#budgetYearCharts').removeClass('d-none');
                renderYearCharts(months);

                // Categories
                $('#budgetCategoryTitle').text('Spending by category in ' + data.year);
                $('#budgetCategorySubtitle').text('Totals across all months, largest first. Bars show how much of each yearly budget is used.');
                renderCategoryList(categories);

                // Month-by-month table (also the keyboard-accessible way to drill into a month)
                $('#tableSectionTitle').text('Month-by-month details');
                var tableHtml = '<table class="table table-hover align-middle mb-0 bgt-table">' +
                    '<thead><tr>' +
                    '<th scope="col">Month</th>' +
                    '<th scope="col" class="text-end">Income</th>' +
                    '<th scope="col" class="text-end">Planned spending</th>' +
                    '<th scope="col" class="text-end">Spent</th>' +
                    '<th scope="col" class="text-end">Net saved</th>' +
                    '<th scope="col" class="text-end">Savings rate</th>' +
                    '<th scope="col">Status</th>' +
                    '<th scope="col" class="text-end"><span class="visually-hidden">Open</span></th>' +
                    '</tr></thead><tbody>';
                months.forEach(function (m) {
                    tableHtml += '<tr class="bgt-row-link btn-drill-month" data-month="' + m.monthNumber + '">' +
                        '<td class="fw-semibold">' + escapeHtml(m.monthName) + '</td>' +
                        '<td class="text-end">' + formatCurrency(m.actualIncome) + '</td>' +
                        '<td class="text-end text-muted">' + (m.budgetedExpenses > 0 ? formatCurrency(m.budgetedExpenses) : '&mdash;') + '</td>' +
                        '<td class="text-end">' + formatCurrency(m.actualExpenses) + '</td>' +
                        '<td class="text-end fw-semibold">' + formatCurrency(m.netSavings) + '</td>' +
                        '<td class="text-end">' + m.savingsRate.toFixed(1) + '%</td>' +
                        '<td>' + statusPill(monthStatusTone(m.status), monthStatusLabel(m.status)) + '</td>' +
                        '<td class="text-end"><button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-0 btn-drill-month" data-month="' + m.monthNumber + '">Open &rarr;</button></td>' +
                        '</tr>';
                });
                tableHtml += '</tbody></table>';
                $('#budgetReportTableContainer').html(tableHtml);
                if (!budgetTableUserToggled) setTableVisible(true);
            }

            function renderMonthView(data, monthData) {
                var tone = monthStatusTone(monthData.status);
                var single = data.months.length === 1;

                $('#budgetPeriodTitle').text(monthData.monthName + ' ' + data.year);
                $('#budgetPeriodSubtitle').html(balanceText(monthData.startingBalance, monthData.endingBalance));

                // KPI tiles
                $('#kpiTotalIncome').text(formatMoney(monthData.actualIncome));
                $('#kpiIncomeSubtext').text(planDeltaText(monthData.actualIncome, monthData.budgetedIncome, 'above', 'below') || 'No income plan set');
                $('#kpiTotalExpenses').text(formatMoney(monthData.actualExpenses));
                $('#kpiExpensesSubtext').text(planDeltaText(monthData.actualExpenses, monthData.budgetedExpenses, 'over', 'under') || 'No spending plan set');
                $('#kpiNetSavings').text(formatMoney(monthData.netSavings));
                $('#kpiSavingsSubtext').text(
                    (monthData.budgetedIncome > 0 || monthData.budgetedExpenses > 0)
                        ? 'Planned: ' + formatMoney(monthData.budgetedNetSavings !== undefined ? monthData.budgetedNetSavings : monthData.budgetedIncome - monthData.budgetedExpenses)
                        : (monthData.netSavings >= 0 ? 'Income minus spending' : 'Spent more than you earned'));
                $('#kpiSavingsRate').text(monthData.savingsRate.toFixed(1) + '%');
                $('#kpiStatusBadge').html(statusPill(tone, monthStatusLabel(monthData.status)));

                // Plain-language summary
                var categories = monthData.categories || [];
                var overList = categories
                    .filter(function (c) { return categoryTone(c) === 'critical'; })
                    .sort(function (a, b) { return (b.actualAmount - b.budgetedAmount) - (a.actualAmount - a.budgetedAmount); });
                var budgetedCount = categories.filter(function (c) { return c.budgetedAmount > 0; }).length;
                var overText = '';
                if (overList.length > 0) {
                    overText = '<strong>' + overList.length + (overList.length === 1 ? ' category' : ' categories') + ' went over budget:</strong> ' +
                        overList.slice(0, 3).map(function (c) { return escapeHtml(c.categoryName) + ' (+' + formatMoney(c.actualAmount - c.budgetedAmount) + ')'; }).join(', ') +
                        (overList.length > 3 ? ', and ' + (overList.length - 3) + ' more' : '') + '.';
                } else if (budgetedCount > 0) {
                    overText = 'Every budgeted category stayed within its limit.';
                }
                var planDiff = monthData.budgetedExpenses - monthData.actualExpenses;
                renderInsight(tone, [
                    monthData.netSavings >= 0
                        ? 'You saved <strong>' + formatMoney(monthData.netSavings) + '</strong> in ' + escapeHtml(monthData.monthName) + ', <strong>' + monthData.savingsRate.toFixed(0) + '%</strong> of your income.'
                        : 'You spent <strong>' + formatMoney(-monthData.netSavings) + ' more</strong> than you earned in ' + escapeHtml(monthData.monthName) + '.',
                    monthData.budgetedExpenses > 0
                        ? 'Spending came in <strong>' + formatMoney(Math.abs(planDiff)) + (planDiff >= 0 ? ' under' : ' over') + '</strong> your ' + formatMoney(monthData.budgetedExpenses) + ' plan.'
                        : '',
                    overText
                ]);

                // No year charts in month view
                destroyYearCharts();
                $('#budgetYearCharts').addClass('d-none');

                // Categories
                $('#budgetCategoryTitle').text('Spending by category');
                $('#budgetCategorySubtitle').text('Largest first. Bars show how much of each budget is used.');
                renderCategoryList(categories);

                // Category table
                $('#tableSectionTitle').text(monthData.monthName + ' category details');
                var tableHtml = '<table class="table table-hover align-middle mb-0 bgt-table">' +
                    '<thead><tr>' +
                    '<th scope="col">Category</th>' +
                    '<th scope="col" class="text-end">Planned</th>' +
                    '<th scope="col" class="text-end">Spent</th>' +
                    '<th scope="col" class="text-end">Left / over</th>' +
                    '<th scope="col" class="text-end">% used</th>' +
                    '<th scope="col">Status</th>' +
                    '</tr></thead><tbody>';
                categories.slice().sort(function (a, b) { return b.actualAmount - a.actualAmount; }).forEach(function (c) {
                    var cTone = categoryTone(c);
                    var hasBudget = cTone !== 'none';
                    tableHtml += '<tr>' +
                        '<td class="fw-semibold">' + escapeHtml(c.categoryName) + '</td>' +
                        '<td class="text-end text-muted">' + (hasBudget ? formatCurrency(c.budgetedAmount) : '&mdash;') + '</td>' +
                        '<td class="text-end">' + formatCurrency(c.actualAmount) + '</td>' +
                        '<td class="text-end">' + (hasBudget ? (c.variance >= 0 ? formatCurrency(c.variance) + ' left' : formatCurrency(-c.variance) + ' over') : '&mdash;') + '</td>' +
                        '<td class="text-end">' + (hasBudget ? c.percentageUsed.toFixed(0) + '%' : '&mdash;') + '</td>' +
                        '<td>' + (hasBudget ? statusPill(cTone, categoryStatusLabel(cTone)) : '<span class="text-muted small">No budget set</span>') + '</td>' +
                        '</tr>';
                });
                tableHtml += '</tbody></table>';
                $('#budgetReportTableContainer').html(tableHtml);
                if (!budgetTableUserToggled) setTableVisible(single);
            }

            function renderBudgetMonth(monthNum) {
                if (!currentBudgetData || !currentBudgetData.months || currentBudgetData.months.length === 0) return;
                var isSingleMonth = currentBudgetData.months.length === 1;

                if (monthNum === 0 && !isSingleMonth) {
                    currentSelectedMonth = 0;
                    setPeriodChips();
                    renderYearView(currentBudgetData);
                } else {
                    var monthData = currentBudgetData.months.find(function (m) { return m.monthNumber === monthNum; }) || currentBudgetData.months[0];
                    currentSelectedMonth = monthData.monthNumber;
                    setPeriodChips();
                    renderMonthView(currentBudgetData, monthData);
                }
            }

            function stepBudgetPeriod(direction) {
                var idx = budgetPeriods.findIndex(function (p) { return p.month === currentSelectedMonth; });
                var next = budgetPeriods[idx + direction];
                if (next) {
                    renderBudgetMonth(next.month);
                    $('#budgetMonthButtonGroup .active').trigger('focus');
                }
            }

            function showBudgetState(state) {
                $('#budgetLoadingState').toggleClass('d-none', state !== 'loading');
                $('#budgetErrorState').toggleClass('d-none', state !== 'error');
                $('#budgetReportContent').toggleClass('d-none', state !== 'report');
                $('#btnPrintBudgetReport').prop('disabled', state !== 'report');
            }

            function loadBudgetReport(request) {
                lastBudgetRequest = request;
                var seq = ++budgetRequestSeq;
                currentBudgetData = null;
                budgetTableUserToggled = false;
                destroyYearCharts();

                $('#budgetModalFileName').text(request.fileName).attr('title', request.fileName);
                $('#budgetModalDataSource').empty();
                showBudgetState('loading');

                $.ajax({
                    url: '@Url.Action("MonthlyBudgetReport", "GoogleDrive")',
                    method: 'GET',
                    data: request,
                    success: function (data) {
                        if (seq !== budgetRequestSeq) return; // a newer request superseded this one

                        if (!data || !data.months || data.months.length === 0) {
                            $('#budgetErrorMessage').text('No monthly budget data was found in this spreadsheet. Make sure it has income, expense, or transaction rows.');
                            showBudgetState('error');
                            return;
                        }

                        currentBudgetData = data;
                        var rowsText = data.parsedRowCount > 0 ? ' · ' + data.parsedRowCount + ' rows read' : '';
                        var sourceClass = data.isLiveSpreadsheetData ? 'bgt-source--live' : 'bgt-source--sample';
                        $('#budgetModalDataSource').html('<span class="bgt-source ' + sourceClass + '">' + escapeHtml(data.dataSource || 'Google Spreadsheet') + escapeHtml(rowsText) + '</span>');

                        budgetPeriods = [];
                        if (data.months.length > 1) {
                            budgetPeriods.push({ month: 0, label: 'Full year', title: data.year + ' overview' });
                        }
                        data.months.forEach(function (m) {
                            budgetPeriods.push({
                                month: m.monthNumber,
                                label: data.months.length > 1 ? m.monthName.substring(0, 3) : m.monthName + ' ' + data.year,
                                title: m.monthName + ' ' + data.year
                            });
                        });

                        showBudgetState('report');
                        renderBudgetMonth(data.months.length > 1 ? 0 : data.months[0].monthNumber);
                    },
                    error: function () {
                        if (seq !== budgetRequestSeq) return;
                        $('#budgetErrorMessage').text('Check that the file is a monthly budget sheet and that the drive is still shared, then try again.');
                        showBudgetState('error');
                    }
                });
            }

            // Click Handler for "Budget Report" button on DataTables & Grid
            $(document).on('click', '.btn-budget-report', function () {
                loadBudgetReport({
                    fileName: $(this).data('file-name'),
                    fileId: $(this).data('file-id'),
                    connectionId: '@(currentConn?.Id ?? 0)'
                });
            });

            $('#btnBudgetRetry').on('click', function () {
                if (lastBudgetRequest) loadBudgetReport(lastBudgetRequest);
            });

            // Period selector, prev/next and keyboard navigation
            $(document).on('click', '.budget-month-btn', function () {
                renderBudgetMonth(parseInt($(this).data('month'), 10));
            });
            $('#btnBudgetPrev').on('click', function () { stepBudgetPeriod(-1); });
            $('#btnBudgetNext').on('click', function () { stepBudgetPeriod(1); });
            $('#monthlyBudgetModal').on('keydown', function (e) {
                if (!currentBudgetData || $(e.target).is('input, select, textarea')) return;
                if (e.key === 'ArrowLeft') { e.preventDefault(); stepBudgetPeriod(-1); }
                if (e.key === 'ArrowRight') { e.preventDefault(); stepBudgetPeriod(1); }
            });

            // Table Month Drill-down Click Handler (whole row or its button)
            $(document).on('click', '.btn-drill-month', function (e) {
                e.stopPropagation();
                renderBudgetMonth(parseInt($(this).data('month'), 10));
                $('#monthlyBudgetModal .modal-body').scrollTop(0);
            });

            $('#btnToggleBudgetTable').on('click', function () {
                budgetTableUserToggled = true;
                setTableVisible($('#budgetReportTableContainer').hasClass('d-none'));
            });

            // Charts rendered during the open animation can measure a zero-size canvas; re-measure once visible
            $('#monthlyBudgetModal').on('shown.bs.modal', function () {
                if (budgetMainChartInstance) budgetMainChartInstance.resize();
                if (budgetNetChartInstance) budgetNetChartInstance.resize();
            });

            $('#monthlyBudgetModal').on('hidden.bs.modal', function () {
                budgetRequestSeq++;
                destroyYearCharts();
            });

            // Print Budget Report Handler: print only the report, with the table expanded
            $('#btnPrintBudgetReport').on('click', function () {
                $('body').addClass('bgt-printing');
                window.print();
            });
            window.addEventListener('afterprint', function () {
                $('body').removeClass('bgt-printing');
            });
        });
    </script>
}
