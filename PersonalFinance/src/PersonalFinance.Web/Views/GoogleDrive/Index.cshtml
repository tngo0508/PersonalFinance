<!-- New Monthly Budget Sheet Instructions Modal -->
<div class="modal fade" id="newBudgetSheetModal" tabindex="-1" aria-labelledby="newBudgetSheetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="newBudgetSheetModalLabel">@L["GoogleDrive.NewSheet.Title"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small">@L.Named("GoogleDrive.NewSheet.Intro", ("name", monthlyBudget))</p>

                <h6 class="fw-bold mb-1">@L["GoogleDrive.NewSheet.Step1Title"]</h6>
                <p class="text-muted small">
                    @L.NamedHtml("GoogleDrive.NewSheet.Step1Text", null,
                        ("sheets", googleSheetsLink), ("folder", Strong(connectedFolderName)),
                        ("gallery", Strong(L["GoogleDrive.Ui.TemplateGallery"])), ("name", Strong(monthlyBudget)))
                </p>

                <h6 class="fw-bold mb-1 mt-3">@L.Named("GoogleDrive.NewSheet.Step2Title", ("name", monthlyBudget))</h6>
                <p class="text-muted small">
                    @L.NamedHtml("GoogleDrive.NewSheet.Step2Text", null,
                        ("name", Em(monthlyBudget)),
                        ("example", Em($"{monthlyBudget} - {DateTime.UtcNow.ToString("Y", System.Globalization.CultureInfo.CurrentCulture)}")))
                </p>

                <h6 class="fw-bold mb-1 mt-3">@L["GoogleDrive.NewSheet.Step3Title"]</h6>
                <p class="text-muted small">
                    @L.NamedHtml("GoogleDrive.NewSheet.Step3Text", null,
                        ("summary", Strong("Summary")), ("transactions", Strong("Transactions")))
                </p>

                <h6 class="fw-bold mb-1 mt-3">@L["GoogleDrive.NewSheet.Step4Title"]</h6>
                <p class="text-muted small">
                    @L.NamedHtml("GoogleDrive.NewSheet.Step4Text", null,
                        ("move", Em(L["GoogleDrive.Ui.FileMove"])),
                        ("folder", !string.IsNullOrWhiteSpace(currentConn?.FolderUrl)
                            ? Link(currentConn.FolderUrl, currentConn.Name, strong: true)
                            : Strong(connectedFolderName)))
                </p>

                <h6 class="fw-bold mb-1 mt-3">@L["GoogleDrive.NewSheet.Step5Title"]</h6>
                <p class="text-muted small mb-0">
                    @L.NamedHtml("GoogleDrive.NewSheet.Step5Text", null,
                        ("sync", syncLabel), ("spreadsheets", Strong(L["GoogleDrive.Sheets.Title"])),
                        ("name", Strong(monthlyBudget)), ("anyone", anyoneLabel))
                </p>
            </div>
            <div class="modal-footer border-top">
                <a href="https://docs.google.com/spreadsheets/" target="_blank" rel="noopener noreferrer" class="btn btn-success">@L["GoogleDrive.NewSheet.OpenSheets"]</a>
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">@L["Common.Close"]</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Feedback -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
