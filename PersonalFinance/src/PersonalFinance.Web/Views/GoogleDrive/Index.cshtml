@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Html
@using PersonalFinance.Shared.DTOs.GoogleDrive
@using PersonalFinance.Shared.Enums
@using PersonalFinance.Shared.Helpers
@model GoogleDriveViewModel

@{
    ViewData["Title"] = L["GoogleDrive.Title"].Value;
    var response = Model.Response;
    var files = response?.Files ?? new List<GoogleDriveFileDto>();
    var folderCount = files.Count(f => f.IsFolder);

    // Counts for the type filter tabs
    var spreadsheetCount = files.Count(f => f.FileType == "Spreadsheet");
    var documentCount = files.Count(f => f.FileType == "Document");
    var pdfCount = files.Count(f => f.FileType == "PDF Document");
    var imageCount = files.Count(f => f.FileType == "Image");
    var presentationCount = files.Count(f => f.FileType == "Presentation");
    var otherCount = files.Count(f => !f.IsFolder && f.FileType != "Spreadsheet" && f.FileType != "Document" && f.FileType != "PDF Document" && f.FileType != "Image" && f.FileType != "Presentation");

    const int featuredSheetLimit = 6;
    var spreadsheets = files.Where(IsSpreadsheet).OrderByDescending(f => f.ModifiedTime).ToList();

    var currentConn = Model.SelectedConnection;
    var isNeedsReauth = currentConn != null && (!currentConn.IsValid || currentConn.SyncStatus == "NeedsReauth");
    var showConnectForm = Model.ShowConnectForm || !Model.Connections.Any();

    // Names the app matches or that Google shows untranslated stay as written (spec §1): the "Monthly budget" file
    // name prefix, the template's tab and column names, and product names.
    const string monthlyBudget = "Monthly budget";
    var googleSheetsLink = Link("https://docs.google.com/spreadsheets/", "Google Sheets");
    var shareLabel = Strong(L["GoogleDrive.Ui.Share"]);
    var anyoneLabel = Strong(L["GoogleDrive.Ui.AnyoneWithLink"]);
    var syncLabel = Strong(L["GoogleDrive.Drive.Sync"]);
    var connectedFolderName = currentConn?.Name ?? L["GoogleDrive.NewSheet.YourFolder"].Value;
}

@functions {
    private static IHtmlContent Strong(string text) =>
        new HtmlString($"<strong>{HtmlEncoder.Default.Encode(text)}</strong>");

    private static IHtmlContent Em(string text) => new HtmlString($"<em>{HtmlEncoder.Default.Encode(text)}</em>");

    private static IHtmlContent Link(string href, string text, bool strong = false)
    {
        string inner = strong ? $"<strong>{HtmlEncoder.Default.Encode(text)}</strong>" : HtmlEncoder.Default.Encode(text);
        return new HtmlString(
            $"<a href=\"{HtmlEncoder.Default.Encode(href)}\" target=\"_blank\" rel=\"noopener noreferrer\">{inner}</a>");
    }

    private static bool IsMonthlyBudget(GoogleDriveFileDto file) => file.IsMonthlyBudgetSpreadsheet;

    private static bool IsSpreadsheet(GoogleDriveFileDto file) =>
        IsMonthlyBudget(file) || (!file.IsFolder && file.FileType == "Spreadsheet");

    private static bool NeedsAttention(GoogleDriveConnectionDto conn) =>
        !conn.IsValid || conn.SyncStatus == "NeedsReauth";

    private void RenderFileIcon(GoogleDriveFileDto file, int size)
    {
        if (file.IsFolder)
        {
            <svg width="@size" height="@size" fill="#fbbc04" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31L.54 3.87A2 2 0 0 1 2.5 3h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3z"/>
            </svg>
        }
        else if (file.FileType == "Spreadsheet")
        {
            <svg width="@size" height="@size" fill="#0f9d58" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h10v2H3zm0 1h10v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-1z"/>
            </svg>
        }
        else if (file.FileType == "PDF Document")
        {
            <svg width="@size" height="@size" fill="#ea4335" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/>
            </svg>
        }
        else if (file.FileType == "Image")
        {
            <svg width="@size" height="@size" fill="#9334e6" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
                <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-12zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1h12z"/>
            </svg>
        }
        else
        {
            <svg width="@size" height="@size" fill="#4285f4" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/>
            </svg>
        }
    }

    // Visible buttons for a spreadsheet's finance views (used by the featured cards and grid cards)
    private async Task RenderSheetButtons(GoogleDriveFileDto file, int? connectionId = null)
    {
        if (IsMonthlyBudget(file))
        {
            <button type="button" class="btn btn-sm btn-success btn-budget-report"
                    data-file-id="@file.Id" data-file-name="@file.Name"
                    data-bs-toggle="modal" data-bs-target="#monthlyBudgetModal">
                <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M4 11H2v3h2v-3zm5-4H7v7h2V7zm5-5h-2v12h2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1h-2zM7 6a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H7zm-5 4a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1H2z"/>
                </svg>
                @L["GoogleDrive.Sheet.BudgetReport"]
            </button>
        }
        <button type="button" class="btn btn-sm btn-outline-secondary btn-sheet-transactions"
                data-file-id="@file.Id" data-file-name="@file.Name" data-is-budget="@(IsMonthlyBudget(file) ? "true" : "false")"
                data-bs-toggle="modal" data-bs-target="#transactionsModal">
            <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2zm15 2h-4v3h4V4zm0 4h-4v3h4V8zm0 4h-4v3h3a1 1 0 0 0 1-1v-2zm-5 3v-3H6v3h4zm-5 0v-3H1v2a1 1 0 0 0 1 1h3zm-4-4h4V8H1v3zm0-4h4V4H1v3zm5-3v3h4V4H6zm4 4H6v3h4V8z"/>
            </svg>
            @L["GoogleDrive.Sheet.Transactions"]
        </button>
        @if (connectionId.HasValue)
        {
            <form asp-controller="Analysis" asp-action="Sync" method="post" class="d-inline"
                  id="syncAnalysisForm_@file.Id">
                @Html.AntiForgeryToken()
                <input type="hidden" name="connectionId" value="@connectionId.Value"/>
                <input type="hidden" name="fileId" value="@file.Id"/>
                <input type="hidden" name="fileName" value="@file.Name"/>
                <button type="submit" class="btn btn-sm btn-outline-primary" title="@L["GoogleDrive.Sheet.SyncForAnalysisTitle"]">
                    <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                        <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                    </svg>
                    @L["GoogleDrive.Sheet.SyncForAnalysis"]
                </button>
            </form>
        }
    }

    private void RenderOpenLink(GoogleDriveFileDto file)
    {
        if (!string.IsNullOrEmpty(file.WebViewLink))
        {
            <a href="@file.WebViewLink" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-light gd-icon-btn"
               title="@L["GoogleDrive.File.OpenInDrive"]" aria-label="@L.Named("GoogleDrive.File.OpenInDriveAria", ("name", file.Name))">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path fill-rule="evenodd" d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5z"/>
                    <path fill-rule="evenodd" d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0v-5z"/>
                </svg>
            </a>
        }
    }
}

<div class="gd-page"
     data-status-message="@Model.StatusMessage">
    <!-- Page header -->
    <header class="gd-page-header mb-4">
        <div class="gd-page-header__content">
            <div class="gd-page-header__text">
                <h1 class="gd-page-header__title">
                    <span class="gd-page-header__icon" aria-hidden="true">
                        <svg width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31z"/>
                        </svg>
                    </span>
                    @L["GoogleDrive.Title"]
                </h1>
                <p class="gd-page-header__subtitle">@L["GoogleDrive.Header.Subtitle"]</p>
            </div>
            <button type="button" class="gd-page-header__help-btn" data-bs-toggle="modal" data-bs-target="#apiKeyGuideModal">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                    <path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286zm1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94z"/>
                </svg>
                <span>@L["GoogleDrive.Header.Help"]</span>
            </button>
        </div>
    </header>

    <div class="row g-4">
        @if (Model.Connections.Any())
        {
            <!-- Drive navigation -->
            <aside class="col-lg-3">
                <nav class="gd-sidebar d-none d-lg-block" aria-label="@L["GoogleDrive.Sidebar.YourDrives"]">
                    <div class="gd-sidebar-card">
                        <div class="gd-sidebar-title">@L["GoogleDrive.Sidebar.YourDrives"]</div>
                        <ul class="list-unstyled mb-0">
                            @foreach (var conn in Model.Connections)
                            {
                                var isActive = !showConnectForm && conn.Id == Model.SelectedConnectionId;
                                <li>
                                    <a asp-action="Index" asp-route-connectionId="@conn.Id"
                                       class="gd-drive-link @(isActive ? "active" : "")"
                                       aria-current="@(isActive ? "page" : null)">
                                        <span class="gd-drive-link__icon" aria-hidden="true">
                                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                                <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31z"/>
                                            </svg>
                                        </span>
                                        <span class="gd-drive-link__name text-truncate" title="@conn.Name">@conn.Name</span>
                                        @if (NeedsAttention(conn))
                                        {
                                            <span class="gd-status-dot gd-status-dot--warning" title="@L["GoogleDrive.Sidebar.NeedsAttention"]"></span>
                                            <span class="visually-hidden">@L["GoogleDrive.Sidebar.NeedsAttentionHidden"]</span>
                                        }
                                        <span class="gd-drive-count" aria-label="@L.Plural("GoogleDrive.Sidebar.FileCount", conn.CachedFilesCount)">@conn.CachedFilesCount</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                    <a asp-action="Index" asp-route-addNew="true" class="gd-connect-drive-btn @(Model.ShowConnectForm ? "active" : "")">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2z"/>
                        </svg>
                        @L["GoogleDrive.Sidebar.ConnectDrive"]
                    </a>
                </nav>

                <!-- Compact drive picker on small screens -->
                <div class="gd-mobile-picker dropdown d-lg-none">
                    <button class="gd-mobile-picker__btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31z"/>
                        </svg>
                        <span class="text-truncate">@(showConnectForm ? L["GoogleDrive.Sidebar.ConnectDrive"].Value : currentConn?.Name ?? L["GoogleDrive.Sidebar.ChooseDrive"].Value)</span>
                        <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                        </svg>
                    </button>
                    <ul class="dropdown-menu w-100 shadow-sm">
                        @foreach (var conn in Model.Connections)
                        {
                            <li>
                                <a asp-action="Index" asp-route-connectionId="@conn.Id"
                                   class="dropdown-item d-flex justify-content-between align-items-center @(conn.Id == Model.SelectedConnectionId && !showConnectForm ? "active" : "")">
                                    <span class="text-truncate">@conn.Name</span>
                                    <span class="small opacity-75">@conn.CachedFilesCount</span>
                                </a>
                            </li>
                        }
                        <li><hr class="dropdown-divider"></li>
                        <li><a asp-action="Index" asp-route-addNew="true" class="dropdown-item text-primary fw-semibold">+ @L["GoogleDrive.Sidebar.ConnectDrive"]</a></li>
                    </ul>
                </div>
            </aside>
        }

        <section class="@(Model.Connections.Any() ? "col-lg-9" : "col-12")">
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="gd-alert gd-alert--danger alert-dismissible fade show rounded-3 d-flex align-items-start gap-3" role="alert">
                    <span class="gd-alert__icon flex-shrink-0" aria-hidden="true">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c1.089 0 1.638-.989 1.181-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                        </svg>
                    </span>
                    <div class="flex-grow-1">@Model.ErrorMessage</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Common.Close"]"></button>
                </div>
            }

            @if (showConnectForm)
            {
                <!-- Connect a drive -->
                <div class="gd-connect-card mx-auto">
                    <div class="gd-connect-card__header">
                        <div class="gd-connect-card__icon" aria-hidden="true">
                            <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31z"/>
                            </svg>
                        </div>
                        <div>
                            <h2 class="gd-connect-card__title">
                                @(Model.Connections.Any() ? L["GoogleDrive.Connect.TitleAnother"] : L["GoogleDrive.Connect.TitleFirst"])
                            </h2>
                            <p class="gd-connect-card__subtitle">
                                @L["GoogleDrive.Connect.Subtitle"]
                            </p>
                        </div>
                    </div>

                    <ol class="gd-steps mb-4">
                        <li>
                            <strong>@L["GoogleDrive.Connect.Step1Title"]</strong>
                            <span class="text-muted">@L.NamedHtml("GoogleDrive.Connect.Step1Text", null,
                                ("share", Em(L["GoogleDrive.Ui.Share"])), ("anyone", Em(L["GoogleDrive.Ui.AnyoneWithLink"])))</span>
                        </li>
                        <li>
                            <strong>@L["GoogleDrive.Connect.Step2Title"]</strong>
                        </li>
                    </ol>

                    <form asp-action="Index" method="post" id="driveExplorerForm">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="FolderUrl" class="form-label fw-semibold small">
                                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="me-1" style="vertical-align: -0.125em;">
                                    <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31z"/>
                                </svg>
                                @L["GoogleDrive.Connect.FolderLabel"]
                            </label>
                            <div class="input-group gdrive-omnibox">
                                <span class="input-group-text bg-body border-0 text-primary ps-3 pe-2" aria-hidden="true">
                                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31z"/>
                                    </svg>
                                </span>
                                <input asp-for="FolderUrl" id="folderUrlInput" class="form-control border-0 ps-1"
                                       placeholder="https://drive.google.com/drive/folders/..." required />
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-1 flex-wrap gap-1">
                                <span asp-validation-for="FolderUrl" class="text-danger small"></span>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="gd-url-hint small text-muted d-none d-sm-inline">
                                        <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16" class="me-1" style="vertical-align: -0.125em;">
                                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                            <path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286zm1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94z"/>
                                        </svg>
                                        @L["GoogleDrive.Connect.FolderHint"]
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConnectionName" class="form-label fw-semibold small">
                                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="me-1" style="vertical-align: -0.125em;">
                                    <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h10v2H3zm0 1h10v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-1z"/>
                                </svg>
                                @L["GoogleDrive.Connect.NameLabel"] <span class="text-muted fw-normal">@L["GoogleDrive.Connect.Optional"]</span>
                            </label>
                            <input asp-for="ConnectionName" class="form-control" placeholder="@L["GoogleDrive.Connect.NamePlaceholder"]" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="CurrencyCode" class="form-label fw-semibold small">@L["GoogleDrive.Connect.CurrencyLabel"]</label>
                            <select asp-for="CurrencyCode" class="form-select">
                                @foreach (var currency in SupportedCurrencies.All)
                                {
                                    <option value="@currency.Code">@currency.Code · @currency.DisplayName</option>
                                }
                            </select>
                            <div class="form-text">@L["GoogleDrive.Connect.CurrencyHelp"]</div>
                        </div>

                        <button class="gd-advanced-toggle btn btn-link btn-sm text-decoration-none text-muted p-0 mb-3" type="button" data-bs-toggle="collapse" data-bs-target="#advancedSettingsCollapse" aria-expanded="false" aria-controls="advancedSettingsCollapse">
                            <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 8V8a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h1.374a1 1 0 0 1 .707.293l.854.854a1 1 0 0 0 .707.293h3.346a1 1 0 0 0 .707-.293l.854-.854A1 1 0 0 1 11.626 8z"/>
                            </svg>
                            @L["GoogleDrive.Connect.AdvancedToggle"]
                        </button>
                        <div class="collapse" id="advancedSettingsCollapse">
                            <div class="gd-advanced-panel">
                                <label asp-for="ApiKey" class="form-label fw-semibold small">@L["GoogleDrive.ApiKey.Label"]</label>
                                <input asp-for="ApiKey" class="form-control form-control-sm font-monospace" placeholder="AIzaSy..." />
                                <div class="form-text">
                                    @L["GoogleDrive.Connect.ApiKeyHelp"]
                                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-bs-toggle="modal" data-bs-target="#apiKeyGuideModal">@L["GoogleDrive.ApiKey.HowToGet"]</button>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-2 flex-wrap">
                            <button type="submit" class="btn btn-primary px-4 fw-semibold d-flex align-items-center gap-2" id="btnSubmitExplore">
                                <span id="submitSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                <span id="submitText">@L["GoogleDrive.Connect.Submit"]</span>
                            </button>
                            @if (Model.Connections.Any())
                            {
                                <a asp-action="Index" class="btn btn-light border">@L["Common.Cancel"]</a>
                            }
                        </div>
                        <p class="small text-muted mt-3 mb-0 text-center">
                            <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16" class="me-1" style="vertical-align: -0.125em;">
                                <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 8V8a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h1.374a1 1 0 0 1 .707.293l.854.854a1 1 0 0 0 .707.293h3.346a1 1 0 0 0 .707-.293l.854-.854A1 1 0 0 1 11.626 8z"/>
                            </svg>
                            @L["GoogleDrive.Connect.Privacy"]
                        </p>
                    </form>
                </div>
            }
            else if (response != null && response.Success)
            {
                <!-- Drive header -->
                <div class="gd-drive-header mb-4">
                    <div class="gd-drive-header__top">
                        <div class="gd-min-w-0">
                            <h2 class="gd-drive-header__title text-truncate">@(response.FolderName ?? currentConn?.Name ?? L["GoogleDrive.Drive.FallbackName"].Value)</h2>
                            <div class="gd-drive-header__meta">
                                <span class="gd-meta-badge" title="@L["GoogleDrive.Drive.TotalItems"]">
                                    <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31z"/>
                                    </svg>
                                    @L.Plural("GoogleDrive.Drive.Items", response.TotalFilesCount)
                                </span>
                                <span class="gd-meta-badge" title="@L["GoogleDrive.Drive.TotalSize"]">
                                    <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H4zm0 1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"/>
                                    </svg>
                                    @response.TotalSizeFormatted
                                </span>
                                @if (currentConn?.LastSyncedAtUtc != null)
                                {
                                    var syncSpan = DateTime.UtcNow - currentConn.LastSyncedAtUtc.Value;
                                    var syncStatusClass = syncSpan.TotalHours < 1 ? "gd-meta-badge--fresh" : syncSpan.TotalHours < 24 ? "" : "gd-meta-badge--stale";
                                    <span class="gd-meta-badge @syncStatusClass" title="@currentConn.LastSyncedAtUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC">
                                        <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                                            <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                                        </svg>
                                        @L.Named("GoogleDrive.Drive.Synced", ("ago", GoogleDriveText.TimeAgo(L, currentConn.LastSyncedAtUtc.Value, DateTime.UtcNow)))
                                    </span>
                                }
                            </div>
                        </div>

                        @if (currentConn != null)
                        {
                            <div class="gd-drive-header__actions">
                                <button type="button"
                                        class="btn btn-sm btn-outline-success d-flex align-items-center gap-1 text-nowrap"
                                        data-bs-toggle="modal"
                                        data-bs-target="#newBudgetSheetModal"
                                        title="@L["GoogleDrive.Drive.NewBudgetTitle"]">
                                    <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2z"/>
                                    </svg>
                                    <span>@L["GoogleDrive.Drive.NewBudget"]</span>
                                </button>
                                <form asp-action="Sync" method="post" id="syncForm">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@currentConn.Id" />
                                    <button type="submit" class="btn btn-sm btn-primary d-flex align-items-center gap-1" id="btnSyncDrive" title="@L["GoogleDrive.Drive.SyncTitle"]">
                                        <span id="syncSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                        <svg id="syncIcon" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                                            <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                                        </svg>
                                        <span>@L["GoogleDrive.Drive.Sync"]</span>
                                    </button>
                                </form>
                                @if (!string.IsNullOrEmpty(response.FolderId))
                                {
                                    <a href="https://drive.google.com/drive/folders/@response.FolderId" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-light border text-nowrap">
                                        @L["GoogleDrive.Drive.OpenInDrive"]
                                        <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path fill-rule="evenodd" d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5z"/>
                                            <path fill-rule="evenodd" d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0v-5z"/>
                                        </svg>
                                    </a>
                                }
                                <div class="dropdown">
                                    <button type="button" class="btn btn-sm btn-light border gd-icon-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@L["GoogleDrive.Drive.MoreOptions"]">
                                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M3 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/>
                                        </svg>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <button type="button" class="dropdown-item btn-copy-id" data-id="@response.FolderId">@L["GoogleDrive.Drive.CopyFolderId"]</button>
                                        </li>
                                        <li>
                                            <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#reauthModal">
                                                @(currentConn.HasApiKey ? L["GoogleDrive.ApiKey.Change"] : L["GoogleDrive.ApiKey.Add"])
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteDriveModal">@L["GoogleDrive.Drive.RemoveMenu"]</button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        }
                    </div>

                    @if (isNeedsReauth)
                    {
                        <div class="gd-notice gd-notice--warning mt-3" role="alert">
                            <div>
                                <strong>@L["GoogleDrive.Notice.NeedsKeyTitle"]</strong>
                                <div class="small">@(currentConn?.ErrorMessage ?? L["GoogleDrive.Notice.NeedsKeyText"].Value)</div>
                            </div>
                            <button type="button" class="btn btn-sm btn-warning text-nowrap" data-bs-toggle="modal" data-bs-target="#reauthModal">@L["GoogleDrive.Notice.UpdateKey"]</button>
                        </div>
                    }
                    else if (response.IsDemoData)
                    {
                        <div class="gd-notice mt-3" role="status">
                            <div>
                                <strong>@L["GoogleDrive.Notice.SampleTitle"]</strong>
                                <div class="small">@(response.WarningMessage ?? L["GoogleDrive.Notice.SampleText"].Value)</div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" data-bs-toggle="modal" data-bs-target="#reauthModal">@L["GoogleDrive.ApiKey.Add"]</button>
                        </div>
                    }
                </div>

                @if (spreadsheets.Any())
                {
                    <!-- Featured spreadsheets: the finance views live here -->
                    <section class="mb-4" aria-labelledby="sheetsHeading">
                        <div class="gd-section-header mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="gd-section-header__icon" aria-hidden="true">
                                    <svg width="16" height="16" fill="#0f9d58" viewBox="0 0 16 16">
                                        <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h10v2H3zm0 1h10v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-1z"/>
                                    </svg>
                                </span>
                                <h3 id="sheetsHeading" class="gd-section-header__title mb-0">@L["GoogleDrive.Sheets.Title"]</h3>
                                <span class="gd-section-header__badge">@spreadsheets.Count</span>
                            </div>
                            <span class="gd-section-header__subtitle">@L["GoogleDrive.Sheets.Subtitle"]</span>
                        </div>
                        <div class="row g-3">
                            @foreach (var sheet in spreadsheets.Take(featuredSheetLimit))
                            {
                                <div class="col-sm-6 col-xl-4">
                                    <div class="gd-sheet-card h-100">
                                        <div class="gd-sheet-card__header">
                                            @{ RenderFileIcon(sheet, 22); }
                                            <div class="gd-min-w-0">
                                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                                    <div class="gd-sheet-card__name text-truncate" title="@sheet.Name">@sheet.Name</div>
                                                    @if (IsMonthlyBudget(sheet))
                                                    {
                                                        <span class="gd-budget-badge" title="@L["GoogleDrive.Sheets.BudgetBadgeTitle"]">
                                                            <svg width="10" height="10" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                                <path d="M4 11H2v3h2v-3zm5-4H7v7h2V7zm5-5h-2v12h2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1h-2zM7 6a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H7zm-5 4a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1H2z"/>
                                                            </svg>
                                                            @L["GoogleDrive.Sheets.BudgetBadge"]
                                                        </span>
                                                    }
                                                </div>
                                                <div class="gd-sheet-card__meta">@L.Named("GoogleDrive.Sheets.Edited", ("date", sheet.ModifiedTime is { } edited ? GoogleDriveText.ShortDate(edited) : "—"))</div>
                                            </div>
                                        </div>
                                        <div class="gd-sheet-card__actions">
                                            @{ await RenderSheetButtons(sheet, currentConn?.Id); }
                                            <span class="ms-auto">@{ RenderOpenLink(sheet); }</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        @if (spreadsheets.Count > featuredSheetLimit)
                        {
                            <button type="button" class="gd-show-all-btn mt-2 js-show-filter" data-filter="Spreadsheet">
                                @L.Named("GoogleDrive.Sheets.ShowAll", ("count", spreadsheets.Count))
                                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                                </svg>
                            </button>
                        }
                    </section>
                }

                <!-- All files -->
                <section class="gd-files-section" aria-labelledby="filesHeading" id="allFilesSection">
                    <div class="gd-files-section__header">
                        <div class="d-flex align-items-center gap-2">
                            <span class="gd-files-section__icon" aria-hidden="true">
                                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/>
                                </svg>
                            </span>
                            <h3 id="filesHeading" class="gd-files-section__title mb-0">@L["GoogleDrive.Files.Title"]</h3>
                            <span class="gd-files-section__count">@response.TotalFilesCount</span>
                        </div>
                        <div class="gd-files-section__toolbar">
                            <div class="gd-search">
                                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                                </svg>
                                <input type="search" id="fileSearch" class="form-control form-control-sm" placeholder="@L["GoogleDrive.Files.SearchPlaceholder"]" aria-label="@L["GoogleDrive.Files.SearchLabel"]" />
                            </div>
                            <span id="fileResultsCount" class="gd-results-count text-muted small d-none" aria-live="polite"></span>
                            <div class="gd-view-toggle btn-group btn-group-sm" role="group" aria-label="@L["GoogleDrive.Files.Layout"]">
                                <button type="button" class="btn btn-light border gd-icon-btn active" id="btnViewTable" aria-pressed="true" title="@L["GoogleDrive.Files.ListView"]" aria-label="@L["GoogleDrive.Files.ListView"]">
                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
                                    </svg>
                                </button>
                                <button type="button" class="btn btn-light border gd-icon-btn" id="btnViewGrid" aria-pressed="false" title="@L["GoogleDrive.Files.GridView"]" aria-label="@L["GoogleDrive.Files.GridView"]">
                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3z"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Type filter -->
                    <div class="gd-chip-row" id="filterChipsContainer" role="group" aria-label="@L["GoogleDrive.Files.FilterByType"]">
                        <button type="button" class="gdrive-filter-chip active" data-filter="all" aria-pressed="true">
                            <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M0 1.5A1.5 1.5 0 0 1 1.5 0h13A1.5 1.5 0 0 1 16 1.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 14.5v-13zM1.5 1a.5.5 0 0 0-.5.5v13a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-13a.5.5 0 0 0-.5-.5h-13z"/>
                            </svg>
                            @L["GoogleDrive.Filter.All"] <span class="chip-count">@response.TotalFilesCount</span>
                        </button>
                        @if (folderCount > 0)
                        {
                            <button type="button" class="gdrive-filter-chip" data-filter="Folder" aria-pressed="false">
                                <svg width="12" height="12" fill="#fbbc04" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31L.54 3.87A2 2 0 0 1 2.5 3h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3z"/>
                                </svg>
                                @L["GoogleDrive.Filter.Folders"] <span class="chip-count">@folderCount</span>
                            </button>
                        }
                        @if (spreadsheetCount > 0)
                        {
                            <button type="button" class="gdrive-filter-chip" data-filter="Spreadsheet" aria-pressed="false">
                                <svg width="12" height="12" fill="#0f9d58" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h10v2H3zm0 1h10v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-1z"/>
                                </svg>
                                @L["GoogleDrive.Filter.Sheets"] <span class="chip-count">@spreadsheetCount</span>
                            </button>
                        }
                        @if (documentCount > 0)
                        {
                            <button type="button" class="gdrive-filter-chip" data-filter="Document" aria-pressed="false">
                                <svg width="12" height="12" fill="#4285f4" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H4zm0 1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"/>
                                </svg>
                                @L["GoogleDrive.Filter.Docs"] <span class="chip-count">@documentCount</span>
                            </button>
                        }
                        @if (pdfCount > 0)
                        {
                            <button type="button" class="gdrive-filter-chip" data-filter="PDF Document" aria-pressed="false">
                                <svg width="12" height="12" fill="#ea4335" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/>
                                </svg>
                                @L["GoogleDrive.Filter.Pdfs"] <span class="chip-count">@pdfCount</span>
                            </button>
                        }
                        @if (imageCount > 0)
                        {
                            <button type="button" class="gdrive-filter-chip" data-filter="Image" aria-pressed="false">
                                <svg width="12" height="12" fill="#9334e6" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
                                    <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-12zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1h12z"/>
                                </svg>
                                @L["GoogleDrive.Filter.Images"] <span class="chip-count">@imageCount</span>
                            </button>
                        }
                        @if (presentationCount > 0)
                        {
                            <button type="button" class="gdrive-filter-chip" data-filter="Presentation" aria-pressed="false">
                                <svg width="12" height="12" fill="#f4b400" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/>
                                </svg>
                                @L["GoogleDrive.Filter.Slides"] <span class="chip-count">@presentationCount</span>
                            </button>
                        }
                        @if (otherCount > 0)
                        {
                            <button type="button" class="gdrive-filter-chip" data-filter="other" aria-pressed="false">
                                <svg width="12" height="12" fill="#475569" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/>
                                </svg>
                                @L["GoogleDrive.Filter.Other"] <span class="chip-count">@otherCount</span>
                            </button>
                        }
                    </div>

                    <!-- List view -->
                    <div id="tableViewSection" class="table-responsive">
                        <table id="googleDriveDataTable" class="table table-hover align-middle gdrive-table w-100 mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">@L["GoogleDrive.Files.Name"]</th>
                                    <th scope="col">@L["GoogleDrive.Files.Type"]</th>
                                    <th scope="col">@L["GoogleDrive.Files.Modified"]</th>
                                    <th scope="col">@L["GoogleDrive.Files.Size"]</th>
                                    <th scope="col" class="text-end"><span class="visually-hidden">@L["GoogleDrive.Files.Actions"]</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var file in files)
                                {
                                    var isSheet = IsSpreadsheet(file);
                                    <tr>
                                        <td data-order="@(file.IsFolder ? "0" : "1")@file.Name">
                                            <div class="d-flex align-items-center gap-2">
                                                @{ RenderFileIcon(file, 20); }
                                                <div class="gd-min-w-0">
                                                    <div class="fw-semibold text-truncate gd-file-name" title="@file.Name">@file.Name</div>
                                                    <div class="small text-muted d-md-none">@GoogleDriveText.FileType(L, file.FileType)</div>
                                                </div>
                                            </div>
                                        </td>
                                        @* The type filter searches this column by the English type, so data-search keeps it. *@
                                        <td class="small text-muted" data-search="@file.FileType">@GoogleDriveText.FileType(L, file.FileType)</td>
                                        <td data-order="@(file.ModifiedTime?.ToString("yyyy-MM-ddTHH:mm:ss") ?? "0001-01-01T00:00:00")" class="text-nowrap small">
                                            @(file.ModifiedTime is { } modified ? GoogleDriveText.ShortDate(modified) : "—")
                                        </td>
                                        <td data-order="@(file.Size ?? -1)" class="text-nowrap small text-muted">
                                            @(file.IsFolder || !file.Size.HasValue ? "—" : file.SizeFormatted)
                                        </td>
                                        <td class="text-end text-nowrap">
                                            @if (isSheet)
                                            {
                                                <div class="dropdown d-inline-block">
                                                    <button type="button" class="btn btn-sm btn-light border dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"
                                                            data-bs-popper-config='{"strategy":"fixed"}'>
                                                        @L["GoogleDrive.Files.View"]
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                        @if (IsMonthlyBudget(file))
                                                        {
                                                            <li>
                                                                <button type="button" class="dropdown-item btn-budget-report" data-file-id="@file.Id" data-file-name="@file.Name"
                                                                        data-bs-toggle="modal" data-bs-target="#monthlyBudgetModal">@L["GoogleDrive.Sheet.BudgetReport"]</button>
                                                            </li>
                                                        }
                                                        <li>
                                                            <button type="button" class="dropdown-item btn-sheet-transactions" data-file-id="@file.Id" data-file-name="@file.Name" data-is-budget="@(IsMonthlyBudget(file) ? "true" : "false")"
                                                                    data-bs-toggle="modal" data-bs-target="#transactionsModal">@L["GoogleDrive.Sheet.Transactions"]</button>
                                                        </li>
                                                        @if (!string.IsNullOrEmpty(file.WebViewLink))
                                                        {
                                                            <li><hr class="dropdown-divider"></li>
                                                            <li><a class="dropdown-item" href="@file.WebViewLink" target="_blank" rel="noopener noreferrer">@L["GoogleDrive.File.OpenInDrive"]</a></li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                            else
                                            {
                                                RenderOpenLink(file);
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Grid view -->
                    <div id="gridViewSection" class="d-none">
                        <div class="row g-3">
                            @foreach (var file in files)
                            {
                                <div class="col-12 col-sm-6 col-md-4 grid-item-card" data-file-type="@file.FileType" data-file-name="@file.Name.ToLowerInvariant()">
                                    <div class="gdrive-grid-card">
                                        <div class="gdrive-grid-preview">
                                            @if (!string.IsNullOrEmpty(file.ThumbnailLink))
                                            {
                                                <img src="@file.ThumbnailLink" alt="" loading="lazy" />
                                            }
                                            else
                                            {
                                                RenderFileIcon(file, 36);
                                            }
                                        </div>
                                        <div class="fw-semibold text-truncate" title="@file.Name">@file.Name</div>
                                        <div class="small text-muted mb-2">
                                            @GoogleDriveText.FileType(L, file.FileType) · @(file.ModifiedTime is { } gridModified ? GoogleDriveText.ShortDate(gridModified) : "—")
                                        </div>
                                        <div class="d-flex flex-wrap align-items-center gap-2 mt-auto">
                                            @if (IsSpreadsheet(file))
                                            {
                                                await RenderSheetButtons(file, currentConn?.Id);
                                            }
                                            <span class="ms-auto">@{ RenderOpenLink(file); }</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <p class="text-muted text-center small py-4 mb-0 d-none" id="gridEmptyState">@L["GoogleDrive.Files.NoMatches"]</p>
                    </div>
                </section>
            }
            else if (currentConn != null)
            {
                <!-- Drive selected but its files couldn't be loaded -->
                <div class="gd-empty-state">
                    <div class="gd-empty-state__icon" aria-hidden="true">
                        <svg width="48" height="48" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c1.089 0 1.638-.989 1.181-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                        </svg>
                    </div>
                    <h2 class="gd-empty-state__title">@L.Named("GoogleDrive.LoadError.Title", ("name", currentConn.Name))</h2>
                    <p class="gd-empty-state__text">@L["GoogleDrive.LoadError.Text"]</p>
                    <ul class="gd-empty-state__troubleshoot text-start mb-4">
                        <li>@L.NamedHtml("GoogleDrive.LoadError.CheckSharing", null, ("share", shareLabel), ("anyone", anyoneLabel))</li>
                        <li>@L["GoogleDrive.LoadError.CheckKey"]</li>
                        <li>@L["GoogleDrive.LoadError.CheckExists"]</li>
                    </ul>
                    <div class="gd-empty-state__actions">
                        <form asp-action="Sync" method="post" id="syncFormFallback">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@currentConn.Id" />
                            <button type="submit" class="btn btn-primary d-flex align-items-center gap-2" id="btnSyncDriveFallback">
                                <span id="syncSpinnerFallback" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                @L["GoogleDrive.Common.TryAgain"]
                            </button>
                        </form>
                        <button type="button" class="btn btn-light border" data-bs-toggle="modal" data-bs-target="#reauthModal">@L["GoogleDrive.ApiKey.Update"]</button>
                        <button type="button" class="btn btn-light border" data-bs-toggle="modal" data-bs-target="#apiKeyGuideModal">@L["GoogleDrive.Header.Help"]</button>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

<!-- Budget Report Modal -->
<div class="modal fade" id="monthlyBudgetModal" tabindex="-1" aria-labelledby="monthlyBudgetModalLabel" aria-hidden="true"
     data-report-url="@Url.Action("MonthlyBudgetReport", "GoogleDrive")"
     data-connection-id="@(currentConn?.Id ?? 0)">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 bgt-root">
            <div class="modal-header bgt-modal-header">
                <div class="d-flex align-items-center gap-3 overflow-hidden">
                    <div class="bgt-header-icon flex-shrink-0" aria-hidden="true">
                        <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M4 11H2v3h2v-3zm5-4H7v7h2V7zm5-5h-2v12h2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1h-2zM7 6a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H7zm-5 4a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1H2z"/>
                        </svg>
                    </div>
                    <div class="overflow-hidden">
                        <h5 class="modal-title bgt-modal-title" id="monthlyBudgetModalLabel">@L["GoogleDrive.Sheet.BudgetReport"]</h5>
                        <div class="bgt-file-line">
                            <span class="text-truncate" id="budgetModalFileName" title="">-</span>
                            <span class="flex-shrink-0 d-none d-sm-inline" id="budgetModalDataSource"></span>
                        </div>
                    </div>
                </div>
                <div class="bgt-header-actions">
                    <button type="button" class="btn btn-sm btn-light border btn-sheet-transactions" id="btnBudgetToTransactions"
                            data-bs-toggle="modal" data-bs-target="#transactionsModal" disabled>
                        @L["GoogleDrive.Sheet.Transactions"]
                    </button>
                    <button type="button" class="btn btn-sm btn-light border d-none d-sm-inline-block" id="btnExportBudget" disabled>@L["GoogleDrive.Report.ExportCsv"]</button>
                    <button type="button" class="btn btn-sm btn-light border d-none d-sm-inline-block" id="btnPrintBudgetReport" disabled>@L["GoogleDrive.Report.Print"]</button>
                    <button type="button" class="btn-close ms-1" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
                </div>
            </div>

            <div class="modal-body p-3 p-md-4 bgt-body" id="budgetReportPrintArea">
                <!-- Loading state -->
                <div class="bgt-state" id="budgetLoadingState" role="status">
                    <div class="spinner-border text-secondary mb-3" aria-hidden="true"></div>
                    <div class="fw-semibold">@L["GoogleDrive.Report.Loading"]</div>
                    <div class="small text-muted">@L["GoogleDrive.Report.LoadingText"]</div>
                </div>

                <!-- Error state -->
                <div class="bgt-state d-none" id="budgetErrorState" role="alert">
                    <div class="bgt-state-icon mb-3" aria-hidden="true">!</div>
                    <div class="fw-semibold">@L["GoogleDrive.Report.ErrorTitle"]</div>
                    <div class="small text-muted mb-3" id="budgetErrorMessage">@L["GoogleDrive.Js.Report.ErrorText"]</div>
                    <button type="button" class="btn btn-sm btn-dark rounded-pill px-4" id="btnBudgetRetry">@L["GoogleDrive.Common.TryAgain"]</button>
                </div>

                <!-- Report -->
                <div class="d-none" id="budgetReportContent">
                    <!-- Period selector: scopes everything below -->
                    <div class="bgt-toolbar mb-3">
                        <button type="button" class="bgt-nav-btn" id="btnBudgetPrev" aria-label="@L["GoogleDrive.Report.PreviousPeriod"]">&lsaquo;</button>
                        <div class="bgt-period-scroll" id="budgetMonthButtonGroup" role="tablist" aria-label="@L["GoogleDrive.Report.ChoosePeriod"]"></div>
                        <button type="button" class="bgt-nav-btn" id="btnBudgetNext" aria-label="@L["GoogleDrive.Report.NextPeriod"]">&rsaquo;</button>
                    </div>

                    <!-- Summary -->
                    <section class="bgt-hero mb-3" id="budgetHero" data-tone="good" aria-labelledby="budgetPeriodTitle">
                        <div class="bgt-hero-main">
                            <div class="bgt-hero-eyebrow" id="budgetPeriodSubtitle"></div>
                            <h4 class="bgt-hero-title" id="budgetPeriodTitle">-</h4>
                            <p class="bgt-hero-text mb-0" id="budgetInsight"></p>
                        </div>
                        <div class="bgt-hero-status" id="budgetHeroStatus"></div>
                    </section>

                    <!-- KPI tiles -->
                    <div class="row g-3 mb-3">
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label"><span class="bgt-swatch bgt-swatch--income" aria-hidden="true"></span>@L["GoogleDrive.Report.Income"]</div>
                                <div class="bgt-tile-value" id="kpiTotalIncome">@MoneyFormatter.FormatWhole(0m, SupportedCurrencies.Default.Code)</div>
                                <div class="bgt-tile-meter" id="kpiIncomeMeter"></div>
                                <div class="bgt-tile-sub" id="kpiIncomeSubtext"></div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label"><span class="bgt-swatch bgt-swatch--spend" aria-hidden="true"></span>@L["GoogleDrive.Report.Spending"]</div>
                                <div class="bgt-tile-value" id="kpiTotalExpenses">@MoneyFormatter.FormatWhole(0m, SupportedCurrencies.Default.Code)</div>
                                <div class="bgt-tile-meter" id="kpiExpensesMeter"></div>
                                <div class="bgt-tile-sub" id="kpiExpensesSubtext"></div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label">@L["GoogleDrive.Report.NetSaved"]</div>
                                <div class="bgt-tile-value" id="kpiNetSavings">@MoneyFormatter.FormatWhole(0m, SupportedCurrencies.Default.Code)</div>
                                <div class="bgt-tile-sub" id="kpiSavingsSubtext"></div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label">@L["GoogleDrive.Report.SavingsRate"]</div>
                                <div class="bgt-tile-value" id="kpiSavingsRate">0%</div>
                                <div class="bgt-tile-meter" id="kpiSavingsMeter"></div>
                                <div class="bgt-tile-sub" id="kpiSavingsRateSub"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Where income went -->
                    <div class="bgt-card mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                            <div>
                                <h6 class="bgt-card-title mb-0">@L["GoogleDrive.Report.WhereIncomeWent"]</h6>
                                <div class="bgt-card-sub" id="budgetAllocationSub"></div>
                            </div>
                            <div class="bgt-legend" id="budgetAllocationLegend"></div>
                        </div>
                        <div id="budgetAllocation"></div>
                    </div>

                    <!-- Year overview charts (hidden in month view) -->
                    <div class="row g-3 mb-3" id="budgetYearCharts">
                        <div class="col-12 col-lg-8">
                            <div class="bgt-card h-100">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                    <div>
                                        <h6 class="bgt-card-title mb-0">@L["GoogleDrive.Report.IncomeVsSpending"]</h6>
                                        <div class="bgt-card-sub">@L["GoogleDrive.Report.ClickMonth"]</div>
                                    </div>
                                    <div class="bgt-legend" aria-hidden="true">
                                        <span><span class="bgt-swatch bgt-swatch--income"></span>@L["GoogleDrive.Report.Income"]</span>
                                        <span><span class="bgt-swatch bgt-swatch--spend"></span>@L["GoogleDrive.Report.Spending"]</span>
                                    </div>
                                </div>
                                <div class="bgt-chart-box">
                                    <canvas id="budgetMainChart" role="img" aria-label="@L["GoogleDrive.Report.MainChartAria"]"></canvas>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="bgt-card h-100">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                    <div>
                                        <h6 class="bgt-card-title mb-0">@L["GoogleDrive.Report.NetSavedEachMonth"]</h6>
                                        <div class="bgt-card-sub">@L["GoogleDrive.Report.NetSavedHint"]</div>
                                    </div>
                                    <div class="bgt-legend" aria-hidden="true">
                                        <span><span class="bgt-swatch bgt-swatch--income"></span>@L["GoogleDrive.Report.Saved"]</span>
                                        <span><span class="bgt-swatch bgt-swatch--neg"></span>@L["GoogleDrive.Report.Overspent"]</span>
                                    </div>
                                </div>
                                <div class="bgt-chart-box">
                                    <canvas id="budgetNetChart" role="img" aria-label="@L["GoogleDrive.Report.NetChartAria"]"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Category breakdown -->
                    <div class="bgt-card mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h6 class="bgt-card-title mb-0" id="budgetCategoryTitle">@L["GoogleDrive.Js.Report.CategoryTitle"]</h6>
                                <div class="bgt-card-sub" id="budgetCategorySubtitle">@L["GoogleDrive.Js.Report.CategorySubtitle"]</div>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <div class="form-check form-switch mb-0 small">
                                    <input class="form-check-input" type="checkbox" role="switch" id="budgetOverOnly">
                                    <label class="form-check-label" for="budgetOverOnly">@L["GoogleDrive.Report.OnlyOverBudget"]</label>
                                </div>
                                <select class="form-select form-select-sm w-auto" id="budgetCategorySort" aria-label="@L["GoogleDrive.Report.SortCategories"]">
                                    <option value="amount">@L["GoogleDrive.Report.SortLargest"]</option>
                                    <option value="over">@L["GoogleDrive.Report.SortMostOver"]</option>
                                    <option value="name">@L["GoogleDrive.Report.SortName"]</option>
                                </select>
                            </div>
                        </div>
                        <div class="bgt-legend mb-3" aria-hidden="true">
                            <span><span class="bgt-swatch bgt-swatch--ok"></span>@L["GoogleDrive.Js.Report.WithinBudget"]</span>
                            <span><span class="bgt-swatch bgt-swatch--warning"></span>@L["GoogleDrive.Report.NearLimitLegend"]</span>
                            <span><span class="bgt-swatch bgt-swatch--critical"></span>@L["GoogleDrive.Js.Report.OverBudget"]</span>
                        </div>
                        <div class="bgt-cat-grid" id="budgetCategoryList"></div>
                    </div>

                    <!-- Table view -->
                    <div class="bgt-card">
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <h6 class="bgt-card-title mb-0" id="tableSectionTitle">@L["GoogleDrive.Report.Details"]</h6>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" id="btnToggleBudgetTable" aria-expanded="false" aria-controls="budgetReportTableContainer">@L["GoogleDrive.Js.Report.ShowTable"]</button>
                        </div>
                        <div class="table-responsive mt-3 d-none" id="budgetReportTableContainer"></div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top justify-content-between">
                <div class="small text-muted d-none d-md-block" id="budgetKeyboardHint">@L["GoogleDrive.Report.KeyboardHint"]</div>
                <button type="button" class="btn btn-light border px-4 ms-auto" data-bs-dismiss="modal">@L["Common.Close"]</button>
            </div>
        </div>
    </div>
</div>

<!-- Spreadsheet Transactions Modal -->
<div class="modal fade" id="transactionsModal" tabindex="-1" aria-labelledby="transactionsModalLabel" aria-hidden="true"
     data-transactions-url="@Url.Action("SpreadsheetTransactions", "GoogleDrive")"
     data-connection-id="@(currentConn?.Id ?? 0)">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 bgt-root">
            <div class="modal-header bgt-modal-header">
                <div class="d-flex align-items-center gap-3 overflow-hidden">
                    <div class="bgt-header-icon flex-shrink-0" aria-hidden="true">
                        <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2zm15 2h-4v3h4V4zm0 4h-4v3h4V8zm0 4h-4v3h3a1 1 0 0 0 1-1v-2zm-5 3v-3H6v3h4zm-5 0v-3H1v2a1 1 0 0 0 1 1h3zm-4-4h4V8H1v3zm0-4h4V4H1v3zm5-3v3h4V4H6zm4 4H6v3h4V8z"/>
                        </svg>
                    </div>
                    <div class="overflow-hidden">
                        <h5 class="modal-title bgt-modal-title" id="transactionsModalLabel">@L["GoogleDrive.Sheet.Transactions"]</h5>
                        <div class="bgt-file-line">
                            <span class="text-truncate" id="txModalFileName" title="">-</span>
                            <span class="flex-shrink-0 d-none d-sm-inline" id="txModalDataSource"></span>
                        </div>
                    </div>
                </div>
                <div class="bgt-header-actions">
                    <button type="button" class="btn btn-sm btn-light border btn-budget-report d-none" id="btnTxToBudget"
                            data-bs-toggle="modal" data-bs-target="#monthlyBudgetModal">
                        @L["GoogleDrive.Sheet.BudgetReport"]
                    </button>
                    <button type="button" class="btn btn-sm btn-light border d-none d-sm-inline-block" id="btnExportTx" disabled>@L["GoogleDrive.Report.ExportCsv"]</button>
                    <button type="button" class="btn-close ms-1" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
                </div>
            </div>

            <div class="modal-body p-3 p-md-4 bgt-body">
                <!-- Loading state -->
                <div class="bgt-state" id="txLoadingState" role="status">
                    <div class="spinner-border text-secondary mb-3" aria-hidden="true"></div>
                    <div class="fw-semibold">@L["GoogleDrive.Tx.Loading"]</div>
                    <div class="small text-muted">@L.Named("GoogleDrive.Tx.LoadingText", ("sheet", "Transactions"))</div>
                </div>

                <!-- Error state -->
                <div class="bgt-state d-none" id="txErrorState" role="alert">
                    <div class="bgt-state-icon mb-3" aria-hidden="true">!</div>
                    <div class="fw-semibold">@L["GoogleDrive.Tx.ErrorTitle"]</div>
                    <div class="small text-muted mb-3" id="txErrorMessage"></div>
                    <button type="button" class="btn btn-sm btn-dark rounded-pill px-4" id="btnTxRetry">@L["GoogleDrive.Common.TryAgain"]</button>
                </div>

                <!-- Transactions -->
                <div class="d-none" id="txContent">
                    <div class="row g-3 mb-3">
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label"><span class="bgt-swatch bgt-swatch--spend" aria-hidden="true"></span>@L["GoogleDrive.Report.Spending"]</div>
                                <div class="bgt-tile-value" id="txKpiExpenses">@MoneyFormatter.FormatWhole(0m, SupportedCurrencies.Default.Code)</div>
                                <div class="bgt-tile-sub" id="txKpiExpensesSub"></div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label"><span class="bgt-swatch bgt-swatch--income" aria-hidden="true"></span>@L["GoogleDrive.Report.Income"]</div>
                                <div class="bgt-tile-value" id="txKpiIncome">@MoneyFormatter.FormatWhole(0m, SupportedCurrencies.Default.Code)</div>
                                <div class="bgt-tile-sub" id="txKpiIncomeSub"></div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label">@L["GoogleDrive.Tx.Net"]</div>
                                <div class="bgt-tile-value" id="txKpiNet">@MoneyFormatter.FormatWhole(0m, SupportedCurrencies.Default.Code)</div>
                                <div class="bgt-tile-sub" id="txKpiNetSub">@L["GoogleDrive.Js.IncomeMinusSpending"]</div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="bgt-tile h-100">
                                <div class="bgt-tile-label">@L["GoogleDrive.Sheet.Transactions"]</div>
                                <div class="bgt-tile-value" id="txKpiCount">0</div>
                                <div class="bgt-tile-sub" id="txKpiRange"></div>
                            </div>
                        </div>
                    </div>

                    <ul class="bgt-facts mb-3" id="txInsights" aria-label="@L["GoogleDrive.Tx.Highlights"]"></ul>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-lg-7">
                            <div class="bgt-card h-100">
                                <div class="mb-2">
                                    <h6 class="bgt-card-title mb-0">@L["GoogleDrive.Tx.SpendingOverTime"]</h6>
                                    <div class="bgt-card-sub" id="txTimelineSub"></div>
                                </div>
                                <div class="bgt-chart-box bgt-chart-box--short">
                                    <canvas id="txTimelineChart" role="img" aria-label="@L["GoogleDrive.Tx.TimelineAria"]"></canvas>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-5">
                            <div class="bgt-card h-100">
                                <div class="mb-3">
                                    <h6 class="bgt-card-title mb-0">@L["GoogleDrive.Tx.TopCategories"]</h6>
                                    <div class="bgt-card-sub">@L["GoogleDrive.Tx.TopCategoriesHint"]</div>
                                </div>
                                <div class="bgt-rank" id="txCategoryBars"></div>
                            </div>
                        </div>
                    </div>

                    <div class="bgt-card">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                            <div class="gd-search flex-grow-1">
                                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                                </svg>
                                <input type="search" id="txSearch" class="form-control form-control-sm" placeholder="@L["GoogleDrive.Tx.SearchPlaceholder"]" aria-label="@L["GoogleDrive.Tx.SearchLabel"]" />
                            </div>
                            <div class="btn-group btn-group-sm" role="group" aria-label="@L["GoogleDrive.Files.FilterByType"]">
                                <button type="button" class="btn btn-light border active tx-type-filter" data-type="" aria-pressed="true">@L["GoogleDrive.Filter.All"]</button>
                                <button type="button" class="btn btn-light border tx-type-filter" data-type="Expense" aria-pressed="false">@L["GoogleDrive.Report.Spending"]</button>
                                <button type="button" class="btn btn-light border tx-type-filter" data-type="Income" aria-pressed="false">@L["GoogleDrive.Report.Income"]</button>
                            </div>
                            <select class="form-select form-select-sm w-auto" id="txCategoryFilter" aria-label="@L["GoogleDrive.Tx.FilterByCategory"]">
                                <option value="">@L["GoogleDrive.Js.Tx.AllCategories"]</option>
                            </select>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none d-none" id="txClearFilters">@L["GoogleDrive.Tx.ClearFilters"]</button>
                        </div>
                        <div class="table-responsive">
                            <table id="txTable" class="table table-hover align-middle w-100 mb-0 bgt-table">
                                <thead>
                                    <tr>
                                        <th scope="col">@L["GoogleDrive.Tx.Date"]</th>
                                        <th scope="col">@L["GoogleDrive.Tx.Description"]</th>
                                        <th scope="col">@L["GoogleDrive.Tx.Category"]</th>
                                        <th scope="col">@L["GoogleDrive.Files.Type"]</th>
                                        <th scope="col" class="text-end">@L["GoogleDrive.Tx.Amount"]</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        <div class="bgt-filter-summary" id="txFilterSummary" aria-live="polite"></div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top justify-content-between">
                <div class="small text-muted" id="txSheetName"></div>
                <button type="button" class="btn btn-light border px-4 ms-auto" data-bs-dismiss="modal">@L["Common.Close"]</button>
            </div>
        </div>
    </div>
</div>

<!-- API Key Modal -->
<div class="modal fade" id="reauthModal" tabindex="-1" aria-labelledby="reauthModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="reauthModalLabel">@L.Named("GoogleDrive.ApiKey.ModalTitle", ("name", currentConn?.Name ?? L["GoogleDrive.ApiKey.ThisDrive"].Value))</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
            </div>
            <form asp-action="Reauth" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@(currentConn?.Id ?? 0)" />
                <div class="modal-body">
                    @if (currentConn?.HasApiKey == true)
                    {
                        <p class="small text-muted">@L.NamedHtml("GoogleDrive.ApiKey.Current", null,
                            ("key", new HtmlString($"<code>{HtmlEncoder.Default.Encode(currentConn.MaskedApiKey ?? string.Empty)}</code>")))</p>
                    }
                    <label for="reauthApiKey" class="form-label fw-semibold small">@L["GoogleDrive.ApiKey.Label"]</label>
                    <input type="text" id="reauthApiKey" name="apiKey" class="form-control font-monospace" placeholder="AIzaSy..." />
                    <div class="form-text">
                        @L["GoogleDrive.ApiKey.Help"]
                        <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-bs-toggle="modal" data-bs-target="#apiKeyGuideModal">@L["GoogleDrive.ApiKey.HowToGet"]</button>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">@L["Common.Cancel"]</button>
                    <button type="submit" class="btn btn-primary fw-semibold">@L["GoogleDrive.ApiKey.Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Remove Drive Confirmation Modal -->
@if (currentConn != null)
{
    <div class="modal fade" id="deleteDriveModal" tabindex="-1" aria-labelledby="deleteDriveModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" id="deleteDriveModalLabel">@L.Named("GoogleDrive.Remove.Title", ("name", currentConn.Name))</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        @L.Plural("GoogleDrive.Remove.Text", currentConn.CachedFilesCount)
                    </p>
                    <p class="small text-muted mt-2 mb-0">
                        @L.NamedHtml("GoogleDrive.Remove.AnalysisNote", null,
                            ("link", new HtmlString($"<a href=\"{HtmlEncoder.Default.Encode(Url.Action("RemoveSource", "Analysis", new { source = BudgetDataSource.GoogleSheet }) ?? string.Empty)}\">{HtmlEncoder.Default.Encode(L.Named("Analysis.RemoveSource.Submit", ("source", AnalysisText.SourceName(L, BudgetDataSource.GoogleSheet))))}</a>")))
                    </p>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">@L["Common.Cancel"]</button>
                    <form asp-action="Delete" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@currentConn.Id" />
                        <button type="submit" class="btn btn-danger fw-semibold">@L["GoogleDrive.Remove.Submit"]</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- Help & Setup Modal -->
