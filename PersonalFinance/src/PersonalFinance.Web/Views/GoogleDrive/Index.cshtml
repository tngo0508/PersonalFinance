@model PersonalFinance.Web.Models.GoogleDriveViewModel

@{
    ViewData["Title"] = "Google Drive Folder Explorer";
    var response = Model.Response;
    var files = response?.Files ?? new List<PersonalFinance.Shared.DTOs.GoogleDriveFileDto>();
    var folderCount = files.Count(f => f.IsFolder);
    var docCount = files.Count(f => !f.IsFolder);

    // Grouping file categories for quick filter chips
    var spreadsheetCount = files.Count(f => f.FileType == "Spreadsheet");
    var documentCount = files.Count(f => f.FileType == "Document");
    var pdfCount = files.Count(f => f.FileType == "PDF Document");
    var imageCount = files.Count(f => f.FileType == "Image");
    var presentationCount = files.Count(f => f.FileType == "Presentation");
    var otherCount = files.Count(f => !f.IsFolder && f.FileType != "Spreadsheet" && f.FileType != "Document" && f.FileType != "PDF Document" && f.FileType != "Image" && f.FileType != "Presentation");
}

<div class="container py-3">
    <!-- Top Header & Brand Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 pb-3 mb-4 border-bottom">
        <div class="d-flex align-items-center gap-3">
            <div class="p-2 bg-light rounded-3 border d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                <svg width="32" height="32" viewBox="0 0 87.3 78" xmlns="http://www.w3.org/2000/svg">
                    <path d="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z" fill="#0066da"/>
                    <path d="m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44c-.8 1.4-1.2 2.95-1.2 4.5h27.5z" fill="#00ac47"/>
                    <path d="m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.502l5.852 11.5z" fill="#ea4335"/>
                    <path d="m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z" fill="#00832d"/>
                    <path d="m59.8 53h-32.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z" fill="#2684fc"/>
                    <path d="m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3l-13.75 23.8 16.15 28h27.45c0-1.55-.4-3.1-1.2-4.5z" fill="#ffba00"/>
                </svg>
            </div>
            <div>
                <h3 class="fw-bold mb-0 text-dark">Google Drive Explorer</h3>
                <p class="text-muted small mb-0">Browse, search, and manage files in any shared Google Drive folder</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (response != null && response.Success)
            {
                <span class="badge @(response.IsDemoData ? "bg-warning text-dark" : "bg-success") py-2 px-3 rounded-pill fw-semibold">
                    @(response.IsDemoData ? "Preview Demo Mode" : "Live Google API")
                </span>
            }
            <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#apiKeyGuideModal">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="me-1">
                    <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                </svg>
                API &amp; Sharing Guide
            </button>
        </div>
    </div>

    <!-- Global Error Message Alert -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 border-0 d-flex align-items-center" role="alert">
            <span class="fs-5 me-2">&#9888;</span>
            <div class="flex-grow-1">
                <strong>Error:</strong> @Model.ErrorMessage
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search Omnibox / Toolbar Card -->
    <div class="gdrive-card p-3 p-md-4 mb-4">
        <form asp-action="Index" method="post" id="driveExplorerForm">
            @Html.AntiForgeryToken()

            <label asp-for="FolderUrl" class="form-label fw-bold text-dark mb-2">Google Drive Folder Link or Folder ID:</label>
            <div class="input-group input-group-lg gdrive-omnibox mb-2">
                <span class="input-group-text bg-white border-0 text-muted ps-3 pe-2">
                    <svg width="20" height="20" fill="currentColor" class="text-primary" viewBox="0 0 16 16">
                        <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31zM2.19 4a1 1 0 0 0-.996 1.09l.637 7a1 1 0 0 0 .995.91h10.348a1 1 0 0 0 .995-.91l.637-7A1 1 0 0 0 13.81 4H2.19zm4.69-1.707A1 1 0 0 0 6.172 2H2.5a1 1 0 0 0-1 .981l.006.139C1.72 3.042 1.95 3 2.19 3h11.62c.24 0 .47.042.684.12l.006-.139a1 1 0 0 0-1-.981h-3.982a1 1 0 0 0-.707-.293l-.828-.828A1 1 0 0 0 7.172 1H6.88z"/>
                    </svg>
                </span>
                <input asp-for="FolderUrl" id="folderUrlInput" class="form-control border-0 ps-1 font-monospace"
                       placeholder="Paste Google Drive folder URL or ID (e.g. https://drive.google.com/drive/folders/...)" required />
                <button type="button" class="btn btn-light border-start text-secondary px-3" id="btnPasteSample" title="Insert a working public sample folder URL">
                    Paste Sample
                </button>
                <button type="submit" class="btn btn-primary px-4 fw-semibold d-flex align-items-center gap-2" id="btnSubmitExplore">
                    <span id="submitSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    <span id="submitText">Explore</span>
                </button>
            </div>
            <span asp-validation-for="FolderUrl" class="text-danger small"></span>

            <!-- Bottom Row: Help Tip & Collapsible API Key Option -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 pt-2">
                <div class="text-muted small d-flex align-items-center gap-1">
                    <svg width="14" height="14" fill="#0d6efd" viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                        <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                    </svg>
                    <span><strong>Access Requirement:</strong> Folder must be set to <em>"Anyone with the link"</em> (Viewer) in Google Drive.</span>
                </div>
                <div>
                    <button class="btn btn-sm btn-link text-decoration-none text-muted p-0" type="button" data-bs-toggle="collapse" data-bs-target="#advancedSettingsCollapse" aria-expanded="false" aria-controls="advancedSettingsCollapse">
                        <small>&#9881; Optional: Custom API Key &darr;</small>
                    </button>
                </div>
            </div>

            <!-- Collapsible Advanced API Key Panel -->
            <div class="collapse mt-3" id="advancedSettingsCollapse">
                <div class="p-3 bg-light rounded-3 border">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="ApiKey" class="form-label fw-semibold small mb-0 text-dark">Google Cloud API Key (Optional for Live Queries):</label>
                        <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 small" data-bs-toggle="modal" data-bs-target="#apiKeyGuideModal">
                            How to get a free API Key?
                        </button>
                    </div>
                    <input asp-for="ApiKey" class="form-control form-control-sm font-monospace" placeholder="AIzaSy... (leave blank to use preview mode or configured key)" />
                    <small class="text-muted">A standard Google Cloud API key with Google Drive API enabled queries live files from public folders.</small>
                </div>
            </div>
        </form>
    </div>

    <!-- Results Section -->
    @if (Model.HasQueried && response != null && response.Success)
    {
        @if (response.IsDemoData)
        {
            <div class="alert alert-secondary border-warning border-2 shadow-sm rounded-3 mb-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4 text-warning">&#9888;</span>
                    <div>
                        <strong class="text-dark">Preview Demo Mode Active</strong>
                        <div class="small text-muted">
                            @(response.WarningMessage ?? "Displaying sample data for demonstration. To query live Google Drive files, provide a Google Cloud API Key.")
                        </div>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill text-nowrap" data-bs-toggle="modal" data-bs-target="#apiKeyGuideModal">
                    Setup Live API Key &rarr;
                </button>
            </div>
        }

        <!-- Active Folder Header & Metrics Bar -->
        <div class="gdrive-card p-3 p-md-4 mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 pb-3 border-bottom mb-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3">
                        <svg width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31L.54 3.87A2 2 0 0 1 2.5 3h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h4 class="fw-bold mb-0 text-dark">@(response.FolderName ?? "Google Drive Folder")</h4>
                            <span class="badge bg-light text-secondary border font-monospace small" title="Folder ID: @response.FolderId">
                                ID: @response.FolderId
                            </span>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-secondary btn-copy-id" data-id="@response.FolderId" title="Copy Folder ID">
                                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/>
                                    <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/>
                                </svg>
                            </button>
                        </div>
                        <small class="text-muted">Viewing files from public Google Drive directory</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(response.FolderId))
                    {
                        <a href="https://drive.google.com/drive/folders/@response.FolderId" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary d-flex align-items-center gap-2">
                            <span>Open in Drive</span>
                            <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5z"/>
                                <path fill-rule="evenodd" d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0v-5z"/>
                            </svg>
                        </a>
                    }
                </div>
            </div>

            <!-- Compact Stat Badges -->
            <div class="row g-2">
                <div class="col-6 col-md-3">
                    <div class="gdrive-stat-pill">
                        <div class="fs-5 text-primary">&#128193;</div>
                        <div>
                            <div class="text-muted small">Total Items</div>
                            <div class="fw-bold text-dark">@response.TotalFilesCount <small class="text-muted fw-normal">(@docCount files, @folderCount folders)</small></div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="gdrive-stat-pill">
                        <div class="fs-5 text-success">&#128190;</div>
                        <div>
                            <div class="text-muted small">Total Size</div>
                            <div class="fw-bold text-dark">@response.TotalSizeFormatted</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="gdrive-stat-pill">
                        <div class="fs-5 text-info">&#128279;</div>
                        <div>
                            <div class="text-muted small">Folder ID</div>
                            <div class="fw-bold text-dark font-monospace small text-truncate" style="max-width: 140px;" title="@response.FolderId">@response.FolderId</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="gdrive-stat-pill">
                        <div class="fs-5 @(response.IsDemoData ? "text-warning" : "text-success")">&#9889;</div>
                        <div>
                            <div class="text-muted small">Data Source</div>
                            <div class="fw-bold @(response.IsDemoData ? "text-warning" : "text-success")">@(response.IsDemoData ? "Preview Demo" : "Live Google API")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Files Browser Container (Filter Bar + View Switcher + Table/Grid) -->
        <div class="gdrive-card mb-4">
            <!-- Filter & Toolbar Header -->
            <div class="p-3 border-bottom d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">
                <!-- Category Filter Chips -->
                <div class="d-flex flex-wrap gap-2 align-items-center" id="categoryFilterContainer">
                    <button type="button" class="gdrive-filter-chip active" data-filter="">
                        <span>All</span>
                        <span class="chip-count">@response.TotalFilesCount</span>
                    </button>
                    @if (folderCount > 0)
                    {
                        <button type="button" class="gdrive-filter-chip" data-filter="Folder">
                            <span>Folders</span>
                            <span class="chip-count">@folderCount</span>
                        </button>
                    }
                    @if (spreadsheetCount > 0)
                    {
                        <button type="button" class="gdrive-filter-chip" data-filter="Spreadsheet">
                            <span>Spreadsheets</span>
                            <span class="chip-count">@spreadsheetCount</span>
                        </button>
                    }
                    @if (documentCount > 0)
                    {
                        <button type="button" class="gdrive-filter-chip" data-filter="Document">
                            <span>Documents</span>
                            <span class="chip-count">@documentCount</span>
                        </button>
                    }
                    @if (pdfCount > 0)
                    {
                        <button type="button" class="gdrive-filter-chip" data-filter="PDF Document">
                            <span>PDFs</span>
                            <span class="chip-count">@pdfCount</span>
                        </button>
                    }
                    @if (imageCount > 0)
                    {
                        <button type="button" class="gdrive-filter-chip" data-filter="Image">
                            <span>Images</span>
                            <span class="chip-count">@imageCount</span>
                        </button>
                    }
                    @if (presentationCount > 0)
                    {
                        <button type="button" class="gdrive-filter-chip" data-filter="Presentation">
                            <span>Slides</span>
                            <span class="chip-count">@presentationCount</span>
                        </button>
                    }
                    @if (otherCount > 0)
                    {
                        <button type="button" class="gdrive-filter-chip" data-filter="Other">
                            <span>Other</span>
                            <span class="chip-count">@otherCount</span>
                        </button>
                    }
                </div>

                <!-- View Switcher (Table vs Grid) -->
                <div class="btn-group btn-group-sm" role="group" aria-label="View toggle">
                    <button type="button" class="btn btn-outline-secondary active" id="viewTableBtn" title="Table View">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2zm15 2h-4v3h4V4zm0 4h-4v3h4V8zm0 4h-4v3h3a1 1 0 0 0 1-1v-2zm-5 3v-3H6v3h4zm-5 0v-3H1v2a1 1 0 0 0 1 1h3zm-4-4h4V8H1v3zm0-4h4V4H1v3zm5-3v3h4V4H6zm4 4H6v3h4V8z"/>
                        </svg>
                        <span class="ms-1 d-none d-sm-inline">Table</span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="viewGridBtn" title="Grid View">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zM2.5 2a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zm6.5.5A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zM1 10.5A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zm6.5.5A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3z"/>
                        </svg>
                        <span class="ms-1 d-none d-sm-inline">Grid</span>
                    </button>
                </div>
            </div>

            <!-- 1. Table View Container -->
            <div id="tableViewContainer" class="p-3">
                <div class="table-responsive">
                    <table id="googleDriveDataTable" class="table gdrive-table align-middle w-100">
                        <thead>
                        <tr>
                            <th style="width: 40px;">#</th>
                            <th>Item Name</th>
                            <th>Category</th>
                            <th>Size</th>
                            <th>Created</th>
                            <th>Last Modified</th>
                            <th class="text-center" style="width: 140px;">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (files.Any())
                        {
                            var index = 1;
                            foreach (var file in files)
                            {
                                var badgeClass = file.IsFolder ? "gdrive-badge-folder" :
                                    file.FileType == "Spreadsheet" ? "gdrive-badge-sheet" :
                                    file.FileType == "Document" ? "gdrive-badge-doc" :
                                    file.FileType == "PDF Document" ? "gdrive-badge-pdf" :
                                    file.FileType == "Image" ? "gdrive-badge-image" :
                                    file.FileType == "Presentation" ? "gdrive-badge-slide" : "gdrive-badge-generic";

                                <tr>
                                    <td class="text-muted small">@(index++)</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="me-3 fs-4 d-flex align-items-center">
                                                @if (file.IsFolder)
                                                {
                                                    <svg width="24" height="24" fill="#fbbc04" viewBox="0 0 16 16">
                                                        <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31z"/>
                                                    </svg>
                                                }
                                                else if (file.FileType == "Spreadsheet")
                                                {
                                                    <svg width="24" height="24" fill="#0f9d58" viewBox="0 0 16 16">
                                                        <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h2v2H3zm3 0v-2h4v2H6zm5 0v-2h2v2h-2zM3 15v-2h2v2H3zm3 0v-2h4v2H6zm5 0v-2h2v2h-2z"/>
                                                    </svg>
                                                }
                                                else if (file.FileType == "Document")
                                                {
                                                    <svg width="24" height="24" fill="#4285f4" viewBox="0 0 16 16">
                                                        <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/>
                                                        <path d="M4.5 10.5a.5.5 0 0 1 .5-.5h6a.5.5 0 0 1 0 1h-6a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h6a.5.5 0 0 1 0 1h-6a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5z"/>
                                                    </svg>
                                                }
                                                else if (file.FileType == "PDF Document")
                                                {
                                                    <svg width="24" height="24" fill="#ea4335" viewBox="0 0 16 16">
                                                        <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/>
                                                        <path d="M4.603 14.087a.81.81 0 0 1-.438-.42c-.195-.388-.13-.776.08-1.144.204-.356.556-.632 1.05-.824.786-.307 1.848-.47 3.136-.484.773-.594 1.34-1.398 1.688-2.385.27-.768.428-1.583.473-2.428.18-.047.375-.078.586-.093 1.056-.076 1.838.258 2.344 1.002.327.48.337 1.034.028 1.662-.303.616-.867 1.096-1.691 1.442-.816.342-1.78.544-2.89.605-.443.83-1.01 1.606-1.696 2.32-.475.495-.99.914-1.54 1.253a4.7 4.7 0 0 1-1.15.492z"/>
                                                    </svg>
                                                }
                                                else if (file.FileType == "Image")
                                                {
                                                    <svg width="24" height="24" fill="#9334e6" viewBox="0 0 16 16">
                                                        <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
                                                        <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-12zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1h12z"/>
                                                    </svg>
                                                }
                                                else
                                                {
                                                    <svg width="24" height="24" fill="#64748b" viewBox="0 0 16 16">
                                                        <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/>
                                                    </svg>
                                                }
                                            </div>
                                            <div>
                                                @if (!string.IsNullOrEmpty(file.WebViewLink))
                                                {
                                                    <a href="@file.WebViewLink" target="_blank" rel="noopener noreferrer" class="text-decoration-none fw-semibold text-dark text-break">
                                                        @file.Name
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="fw-semibold text-dark text-break">@file.Name</span>
                                                }
                                                <div class="text-muted small font-monospace">ID: @file.Id</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="gdrive-badge-soft @badgeClass">@file.FileType</span>
                                    </td>
                                    <td data-order="@(file.Size ?? -1)">
                                        <span class="font-monospace small">@file.SizeFormatted</span>
                                    </td>
                                    <td data-order="@(file.CreatedTime?.ToString("o") ?? "")">
                                        <span class="text-muted small">@(file.CreatedTime?.ToLocalTime().ToString("MMM dd, yyyy HH:mm") ?? "-")</span>
                                    </td>
                                    <td data-order="@(file.ModifiedTime?.ToString("o") ?? "")">
                                        <span class="text-dark small fw-medium">@(file.ModifiedTime?.ToLocalTime().ToString("MMM dd, yyyy HH:mm") ?? "-")</span>
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(file.WebViewLink))
                                        {
                                            <div class="btn-group btn-group-sm">
                                                <a href="@file.WebViewLink" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary" title="Open in Google Drive">
                                                    Open
                                                </a>
                                                <button type="button" class="btn btn-outline-secondary btn-copy-link" data-link="@file.WebViewLink" title="Copy Link to Clipboard">
                                                    Copy
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 2. Grid / Cards View Container -->
            <div id="gridViewContainer" class="p-3 d-none">
                <div class="row g-3" id="fileCardsGrid">
                    @if (files.Any())
                    {
                        foreach (var file in files)
                        {
                            var badgeClass = file.IsFolder ? "gdrive-badge-folder" :
                                file.FileType == "Spreadsheet" ? "gdrive-badge-sheet" :
                                file.FileType == "Document" ? "gdrive-badge-doc" :
                                file.FileType == "PDF Document" ? "gdrive-badge-pdf" :
                                file.FileType == "Image" ? "gdrive-badge-image" :
                                file.FileType == "Presentation" ? "gdrive-badge-slide" : "gdrive-badge-generic";

                            <div class="col-12 col-sm-6 col-md-4 col-lg-3 grid-item" data-category="@file.FileType" data-name="@file.Name.ToLowerInvariant()" data-folder="@file.IsFolder.ToString().ToLowerInvariant()">
                                <div class="gdrive-grid-card">
                                    <div class="gdrive-grid-preview">
                                        @if (file.IsFolder)
                                        {
                                            <svg width="48" height="48" fill="#fbbc04" viewBox="0 0 16 16">
                                                <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31z"/>
                                            </svg>
                                        }
                                        else if (file.FileType == "Spreadsheet")
                                        {
                                            <svg width="48" height="48" fill="#0f9d58" viewBox="0 0 16 16">
                                                <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h2v2H3zm3 0v-2h4v2H6zm5 0v-2h2v2h-2z"/>
                                            </svg>
                                        }
                                        else if (file.FileType == "Document")
                                        {
                                            <svg width="48" height="48" fill="#4285f4" viewBox="0 0 16 16">
                                                <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/>
                                            </svg>
                                        }
                                        else if (file.FileType == "PDF Document")
                                        {
                                            <svg width="48" height="48" fill="#ea4335" viewBox="0 0 16 16">
                                                <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/>
                                            </svg>
                                        }
                                        else if (file.FileType == "Image")
                                        {
                                            <svg width="48" height="48" fill="#9334e6" viewBox="0 0 16 16">
                                                <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
                                                <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-12z"/>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg width="48" height="48" fill="#64748b" viewBox="0 0 16 16">
                                                <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5z"/>
                                            </svg>
                                        }
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <span class="gdrive-badge-soft @badgeClass">@file.FileType</span>
                                            <span class="text-muted small font-monospace">@file.SizeFormatted</span>
                                        </div>
                                        <h6 class="fw-bold text-dark text-truncate mb-1" title="@file.Name">@file.Name</h6>
                                        <div class="text-muted small mb-2">
                                            Modified: @(file.ModifiedTime?.ToLocalTime().ToString("MMM dd, yyyy") ?? "-")
                                        </div>
                                    </div>
                                    <div class="pt-2 border-top d-flex gap-2">
                                        @if (!string.IsNullOrEmpty(file.WebViewLink))
                                        {
                                            <a href="@file.WebViewLink" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary flex-grow-1 text-nowrap">
                                                Open
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-copy-link" data-link="@file.WebViewLink" title="Copy Link">
                                                Copy
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-light disabled w-100">Folder</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
    else if (!Model.HasQueried)
    {
        <!-- Thoughtful Welcome Empty State Before First Search -->
        <div class="gdrive-card p-4 p-md-5 text-center my-4">
            <div class="mx-auto mb-3 p-3 bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 72px; height: 72px;">
                <svg width="36" height="36" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31z"/>
                </svg>
            </div>
            <h4 class="fw-bold text-dark mb-2">Explore Any Public Google Drive Folder</h4>
            <p class="text-muted mx-auto mb-4" style="max-width: 580px;">
                Paste any shared Google Drive folder URL or ID into the search bar above to instantly list, filter, sort, and inspect its contents with live metadata.
            </p>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <button type="button" class="btn btn-primary px-4 rounded-pill fw-semibold" onclick="$('#btnPasteSample').click(); $('#btnSubmitExplore').click();">
                    Try Sample Public Folder &rarr;
                </button>
                <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-toggle="modal" data-bs-target="#apiKeyGuideModal">
                    View Setup Guide
                </button>
            </div>

            <div class="row g-3 mt-4 pt-3 border-top text-start">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <div class="fw-bold text-dark mb-1">&#128269; Instant Search &amp; Filter</div>
                        <small class="text-muted">Filter instantly by document, spreadsheet, PDF, images, or folder with real-time responsive DataTables.</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <div class="fw-bold text-dark mb-1">&#128202; Metrics &amp; File Sizes</div>
                        <small class="text-muted">Analyze total file counts, cumulative directory sizes, and file creation/modification timestamps.</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <div class="fw-bold text-dark mb-1">&#128279; 1-Click Open &amp; Copy</div>
                        <small class="text-muted">Quickly copy direct viewable links to your clipboard or open files immediately in Google Drive.</small>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Error State with Diagnostic Resolution Guidance -->
        <div class="gdrive-card p-4 p-md-5 my-4">
            <div class="text-center mb-4">
                <div class="mx-auto mb-3 p-3 bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                    <span class="fs-2">&#9888;</span>
                </div>
                <h4 class="fw-bold text-danger mb-1">Unable to Retrieve Folder Files</h4>
                <p class="text-muted mb-0">
                    @(Model.ErrorMessage ?? "Could not query file listing for the specified Google Drive folder.")
                </p>
            </div>

            <div class="p-4 bg-light rounded-3 border mb-4">
                <h6 class="fw-bold text-dark mb-3">&#128269; Common Reasons &amp; How to Fix:</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="p-3 bg-white rounded-3 border h-100">
                            <h6 class="fw-bold text-primary mb-2">1. Folder is "Restricted"</h6>
                            <p class="small text-muted mb-2">
                                If the folder is private or restricted to specific emails, the Google Drive API will reject requests with a 404 or 403 error.
                            </p>
                            <div class="small fw-semibold text-dark">
                                &rarr; <strong>Fix:</strong> In Google Drive, right-click folder &rarr; <strong>Share</strong> &rarr; change General access to <strong>"Anyone with the link"</strong> (Viewer).
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-white rounded-3 border h-100">
                            <h6 class="fw-bold text-success mb-2">2. Google Drive API Library</h6>
                            <p class="small text-muted mb-2">
                                If providing a custom API key, ensure the <em>Google Drive API</em> service is enabled in your Google Cloud Console project.
                            </p>
                            <div class="small fw-semibold text-dark">
                                &rarr; <strong>Fix:</strong> Go to Google Cloud Console &rarr; <strong>APIs &amp; Services &rarr; Library</strong> and enable <strong>Google Drive API</strong>.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-white rounded-3 border h-100">
                            <h6 class="fw-bold text-secondary mb-2">3. Verify Folder Link</h6>
                            <p class="small text-muted mb-2">
                                Ensure the link is copied completely and points to a folder rather than an individual document file.
                            </p>
                            <div class="small fw-semibold text-dark">
                                &rarr; <strong>Fix:</strong> Paste standard format <code>https://drive.google.com/drive/folders/&lt;ID&gt;</code>.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center">
                <button type="button" class="btn btn-primary px-4 rounded-pill me-2" onclick="document.getElementById('folderUrlInput').focus();">
                    Try Another Folder
                </button>
                <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-toggle="modal" data-bs-target="#apiKeyGuideModal">
                    Open Setup Guide
                </button>
            </div>
        </div>
    }
</div>

<!-- Step-by-Step API Key & Sharing Guide Modal -->
<div class="modal fade" id="apiKeyGuideModal" tabindex="-1" aria-labelledby="apiKeyGuideModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white py-3 px-4 rounded-top-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5">&#128273;</span>
                    <h5 class="modal-title fw-bold" id="apiKeyGuideModalLabel">Google Drive Setup &amp; API Key Guide</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted mb-4">
                    Follow these 6 simple steps to configure your public Google Drive folder and get a free Google Cloud API key in under 2 minutes.
                </p>

                <!-- Step 1 -->
                <div class="d-flex mb-4">
                    <div class="flex-shrink-0">
                        <span class="badge bg-primary rounded-circle fs-6 px-3 py-2">1</span>
                    </div>
                    <div class="ms-3">
                        <h6 class="fw-bold mb-1">Open Google Cloud Console</h6>
                        <p class="text-muted small mb-1">
                            Visit <a href="https://console.cloud.google.com/" target="_blank" rel="noopener noreferrer" class="fw-bold text-primary">console.cloud.google.com</a> and sign in with your regular Google account.
                        </p>
                        <small class="text-secondary">If prompted, accept the standard Terms of Service.</small>
                    </div>
                </div>

                <!-- Step 2 -->
                <div class="d-flex mb-4">
                    <div class="flex-shrink-0">
                        <span class="badge bg-primary rounded-circle fs-6 px-3 py-2">2</span>
                    </div>
                    <div class="ms-3">
                        <h6 class="fw-bold mb-1">Create a Project</h6>
                        <p class="text-muted small mb-1">
                            Click the <strong>Project dropdown</strong> in the top navigation bar, click <strong>"New Project"</strong>, name it (e.g. <code>PersonalFinance-Drive</code>), and click <strong>"Create"</strong>.
                        </p>
                    </div>
                </div>

                <!-- Step 3 -->
                <div class="d-flex mb-4">
                    <div class="flex-shrink-0">
                        <span class="badge bg-primary rounded-circle fs-6 px-3 py-2">3</span>
                    </div>
                    <div class="ms-3">
                        <h6 class="fw-bold mb-1">Enable "Google Drive API"</h6>
                        <p class="text-muted small mb-1">
                            Navigate to <strong>APIs &amp; Services &rarr; Library</strong> (or search for <em>"Google Drive API"</em> in the top search box).
                        </p>
                        <p class="text-muted small mb-1">
                            Select <strong>Google Drive API</strong> and click the blue <strong>"Enable"</strong> button.
                        </p>
                    </div>
                </div>

                <!-- Step 4 -->
                <div class="d-flex mb-4">
                    <div class="flex-shrink-0">
                        <span class="badge bg-primary rounded-circle fs-6 px-3 py-2">4</span>
                    </div>
                    <div class="ms-3">
                        <h6 class="fw-bold mb-1">Create an API Key</h6>
                        <p class="text-muted small mb-1">
                            In the left sidebar menu, select <strong>APIs &amp; Services &rarr; Credentials</strong>.
                        </p>
                        <p class="text-muted small mb-1">
                            Click <strong>"+ CREATE CREDENTIALS"</strong> and choose <strong>"API key"</strong> from the dropdown menu.
                        </p>
                    </div>
                </div>

                <!-- Step 5 -->
                <div class="d-flex mb-4">
                    <div class="flex-shrink-0">
                        <span class="badge bg-primary rounded-circle fs-6 px-3 py-2">5</span>
                    </div>
                    <div class="ms-3">
                        <h6 class="fw-bold mb-1">Copy Your Key</h6>
                        <p class="text-muted small mb-1">
                            Copy the generated key (beginning with <code>AIzaSy...</code>) and paste it into the <em>Optional API Key</em> input or save it in <code>appsettings.json</code>.
                        </p>
                    </div>
                </div>

                <!-- Step 6 -->
                <div class="d-flex mb-4">
                    <div class="flex-shrink-0">
                        <span class="badge bg-success rounded-circle fs-6 px-3 py-2">6</span>
                    </div>
                    <div class="ms-3">
                        <h6 class="fw-bold mb-1 text-success">Grant Public Folder Access ("Anyone with the link")</h6>
                        <p class="text-muted small mb-1">
                            Because API keys query Google Drive as an unauthenticated client, your folder must have public link viewing enabled:
                        </p>
                        <ol class="text-muted small ps-3 mb-1">
                            <li>Open <a href="https://drive.google.com" target="_blank" rel="noopener noreferrer">Google Drive</a> and locate your folder.</li>
                            <li>Right-click the folder &rarr; click <strong>Share</strong> &rarr; <strong>Share</strong>.</li>
                            <li>Under <strong>General access</strong>, change <em>"Restricted"</em> to <strong>"Anyone with the link"</strong> (Viewer).</li>
                            <li>Click <strong>"Done"</strong> and paste the link into the explorer search bar.</li>
                        </ol>
                        <small class="text-danger fw-semibold">&#9888; Restricted folders will return HTTP 404 or 403 errors.</small>
                    </div>
                </div>

                <hr />

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <h6 class="fw-bold text-success mb-1">&#128181; Free Tier Usage</h6>
                            <p class="small text-muted mb-0">
                                Google provides a generous free tier for Google Drive API queries every day, sufficient for personal and exploration usage.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <h6 class="fw-bold text-primary mb-1">&#128194; Public Folders Only</h6>
                            <p class="small text-muted mb-0">
                                API keys can only read folders whose sharing permission is set to "Anyone with the link can view".
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light py-3 px-4 rounded-bottom-4">
                <a href="https://console.cloud.google.com/apis/credentials" target="_blank" rel="noopener noreferrer" class="btn btn-primary rounded-pill">
                    Open Google Cloud Console &rarr;
                </a>
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Notification Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
    <div id="copyToast" class="toast align-items-center text-white bg-dark border-0 rounded-3 shadow" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2">
                <span class="text-success fs-5">&#10003;</span>
                <span id="toastMessage">Copied to clipboard!</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // 1. Toast helper
            function showToast(message) {
                $('#toastMessage').text(message);
                var toastEl = document.getElementById('copyToast');
                if (toastEl) {
                    var toast = new bootstrap.Toast(toastEl, { delay: 2500 });
                    toast.show();
                }
            }

            // 2. Paste Sample Link functionality
            $('#btnPasteSample').on('click', function () {
                $('#folderUrlInput').val('https://drive.google.com/drive/folders/127ViLEHTWIEsAN0x8gbRGTJiwOpbH3g_?usp=drive_link');
                $('#folderUrlInput').focus();
            });

            // 3. Form Submit Loading Indicator
            $('#driveExplorerForm').on('submit', function () {
                $('#submitSpinner').removeClass('d-none');
                $('#submitText').text('Loading...');
                $('#btnSubmitExplore').addClass('disabled').prop('disabled', true);
            });

            // 4. Initialize DataTables with sorting and responsive styling
            var dataTable = null;
            if ($('#googleDriveDataTable').length) {
                dataTable = $('#googleDriveDataTable').DataTable({
                    responsive: true,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                    order: [[5, 'desc']], // Default sort by Last Modified date descending
                    columnDefs: [
                        { orderable: false, targets: [0, 6] } // Disable ordering on # and Actions
                    ],
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search files by name, type, size...",
                        lengthMenu: "Show _MENU_ items",
                        info: "Showing _START_ to _END_ of _TOTAL_ files",
                        infoEmpty: "No files found",
                        emptyTable: "No files available in this Google Drive folder"
                    }
                });

                // Category Filter Chips Interaction
                $('#categoryFilterContainer .gdrive-filter-chip').on('click', function () {
                    $('#categoryFilterContainer .gdrive-filter-chip').removeClass('active');
                    $(this).addClass('active');

                    var filterVal = $(this).data('filter');
                    if (filterVal === "Other") {
                        // Custom regex to exclude known standard types
                        dataTable.column(2).search('^(?!.*(Folder|Spreadsheet|Document|PDF|Image|Presentation)).*$', true, false).draw();
                    } else if (filterVal) {
                        dataTable.column(2).search('^' + filterVal, true, false).draw();
                    } else {
                        dataTable.column(2).search('').draw();
                    }

                    // Also filter grid items
                    filterGridItems(filterVal);
                });
            }

            // 5. Grid View Category Filter Function
            function filterGridItems(category) {
                if (!category) {
                    $('#fileCardsGrid .grid-item').removeClass('d-none');
                } else if (category === "Folder") {
                    $('#fileCardsGrid .grid-item').each(function () {
                        var isFolder = $(this).data('folder') === true || $(this).data('folder') === "true";
                        $(this).toggleClass('d-none', !isFolder);
                    });
                } else if (category === "Other") {
                    var known = ["Folder", "Spreadsheet", "Document", "PDF Document", "Image", "Presentation"];
                    $('#fileCardsGrid .grid-item').each(function () {
                        var cat = $(this).data('category');
                        var isFolder = $(this).data('folder') === true || $(this).data('folder') === "true";
                        $(this).toggleClass('d-none', isFolder || known.includes(cat));
                    });
                } else {
                    $('#fileCardsGrid .grid-item').each(function () {
                        var cat = $(this).data('category');
                        $(this).toggleClass('d-none', cat !== category);
                    });
                }
            }

            // 6. View Switcher (Table vs Grid)
            $('#viewTableBtn').on('click', function () {
                $(this).addClass('active');
                $('#viewGridBtn').removeClass('active');
                $('#tableViewContainer').removeClass('d-none');
                $('#gridViewContainer').addClass('d-none');
            });

            $('#viewGridBtn').on('click', function () {
                $(this).addClass('active');
                $('#viewTableBtn').removeClass('active');
                $('#gridViewContainer').removeClass('d-none');
                $('#tableViewContainer').addClass('d-none');
            });

            // 7. Copy Link to clipboard button
            $(document).on('click', '.btn-copy-link', function () {
                var link = $(this).data('link');
                var $btn = $(this);
                if (link) {
                    navigator.clipboard.writeText(link).then(function () {
                        var orig = $btn.text();
                        $btn.text('Copied!').addClass('btn-success text-white').removeClass('btn-outline-secondary');
                        showToast('File link copied to clipboard!');
                        setTimeout(function () {
                            $btn.text(orig).removeClass('btn-success text-white').addClass('btn-outline-secondary');
                        }, 2000);
                    });
                }
            });

            // 8. Copy Folder ID button
            $(document).on('click', '.btn-copy-id', function () {
                var id = $(this).data('id');
                if (id) {
                    navigator.clipboard.writeText(id).then(function () {
                        showToast('Folder ID (' + id + ') copied!');
                    });
                }
            });
        });
    </script>
}
