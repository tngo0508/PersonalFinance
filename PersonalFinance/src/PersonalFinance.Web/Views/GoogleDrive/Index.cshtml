                <div class="gd-help-section">
                    <h6 class="gd-help-section__title" data-bs-toggle="collapse" data-bs-target="#helpApiKey" aria-expanded="false">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 8V8a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h1.374a1 1 0 0 1 .707.293l.854.854a1 1 0 0 0 .707.293h3.346a1 1 0 0 0 .707-.293l.854-.854A1 1 0 0 1 11.626 8z"/>
