                                <thead>
                                    <tr>
                                        <th scope="col">Date</th>
                                        <th scope="col">Description</th>
                                        <th scope="col">Category</th>
                                        <th scope="col">Type</th>
                                        <th scope="col" class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        <div class="bgt-filter-summary" id="txFilterSummary" aria-live="polite"></div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top justify-content-between">
                <div class="small text-muted" id="txSheetName"></div>
                <button type="button" class="btn btn-light border px-4 ms-auto" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- API Key Modal -->
<div class="modal fade" id="reauthModal" tabindex="-1" aria-labelledby="reauthModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="reauthModalLabel">API key for @(currentConn?.Name ?? "this drive")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Reauth" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@(currentConn?.Id ?? 0)" />
                <div class="modal-body">
                    @if (currentConn?.HasApiKey == true)
                    {
                        <p class="small text-muted">Current key: <code>@currentConn.MaskedApiKey</code></p>
                    }
                    <label for="reauthApiKey" class="form-label fw-semibold small">Google Cloud API key</label>
                    <input type="text" id="reauthApiKey" name="apiKey" class="form-control font-monospace" placeholder="AIzaSy..." />
                    <div class="form-text">
                        The key needs the Google Drive API enabled. It's stored encrypted and used to sync this folder.
                        <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-bs-toggle="modal" data-bs-target="#apiKeyGuideModal">How do I get one?</button>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-semibold">Save and sync</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Remove Drive Confirmation Modal -->
@if (currentConn != null)
{
    <div class="modal fade" id="deleteDriveModal" tabindex="-1" aria-labelledby="deleteDriveModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" id="deleteDriveModalLabel">Remove @currentConn.Name?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        This disconnects the folder and clears its @currentConn.CachedFilesCount saved items from this app.
                        Nothing is deleted from your Google Drive, and you can reconnect it anytime.
                    </p>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="Delete" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@currentConn.Id" />
                        <button type="submit" class="btn btn-danger fw-semibold">Remove drive</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- Help & Setup Modal -->
<div class="modal fade" id="apiKeyGuideModal" tabindex="-1" aria-labelledby="apiKeyGuideModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="apiKeyGuideModalLabel">Help &amp; setup</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="gd-help-section">
                    <h6 class="gd-help-section__title" data-bs-toggle="collapse" data-bs-target="#helpShare" aria-expanded="true">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31L.54 3.87A2 2 0 0 1 2.5 3h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3z"/>
                        </svg>
                        1. Share your folder
                    </h6>
                    <div class="accordion-collapse collapse show" id="helpShare">
                        <p class="text-muted small mb-0">
                            In Google Drive, right-click the folder, choose <strong>Share</strong>, and set General access to
                            <strong>Anyone with the link</strong> (Viewer). Private folders can't be read and show up as "not found".
                        </p>
                    </div>
                </div>

                <div class="gd-help-section">
                    <h6 class="gd-help-section__title" data-bs-toggle="collapse" data-bs-target="#helpNaming" aria-expanded="false">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h10v2H3zm0 1h10v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-1z"/>
                        </svg>
                        2. Name your budget spreadsheets
                    </h6>
                    <div class="accordion-collapse collapse" id="helpNaming">
                        <p class="text-muted small mb-0">
                            Spreadsheets whose name starts with <strong>Monthly budget</strong> get a budget report.
                            Any spreadsheet with a sheet that has <strong>Date</strong> and <strong>Amount</strong> columns can show its transactions.
                        </p>
                    </div>
                </div>

                <div class="gd-help-section">
                    <h6 class="gd-help-section__title" data-bs-toggle="collapse" data-bs-target="#helpNewBudget" aria-expanded="false">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2z"/>
                        </svg>
                        3. Start a new monthly budget
                    </h6>
                    <div class="accordion-collapse collapse" id="helpNewBudget">
                        <p class="text-muted small mb-0">
                            In <a href="https://docs.google.com/spreadsheets/" target="_blank" rel="noopener noreferrer">Google Sheets</a>, open the
                            <strong>Template gallery</strong> and choose <strong>Monthly budget</strong>. Move the new spreadsheet into your connected
                            folder, then click <strong>Sync now</strong>. See <strong>New budget sheet</strong> for step-by-step instructions.
                        </p>
                    </div>
                </div>

                <div class="gd-help-section">
                    <h6 class="gd-help-section__title" data-bs-toggle="collapse" data-bs-target="#helpApiKey" aria-expanded="false">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 8V8a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h1.374a1 1 0 0 1 .707.293l.854.854a1 1 0 0 0 .707.293h3.346a1 1 0 0 0 .707-.293l.854-.854A1 1 0 0 1 11.626 8z"/>
                        </svg>
                        4. Optional: add a Google API key
                    </h6>
                    <div class="accordion-collapse collapse" id="helpApiKey">
                        <ol class="text-muted small ps-3 mb-0">
                            <li class="mb-1">Open the <a href="https://console.cloud.google.com/" target="_blank" rel="noopener noreferrer">Google Cloud Console</a> and create or pick a project.</li>
                            <li class="mb-1">Enable the <strong>Google Drive API</strong> under APIs &amp; Services &gt; Library.</li>
                            <li class="mb-1">Under <strong>APIs &amp; Services &gt; Credentials</strong>, choose <strong>Create credentials &gt; API key</strong>.</li>
                            <li>Paste the key when connecting a folder, or from the drive's <strong>&#8943;</strong> menu.</li>
                        </ol>
                    </div>
                </div>

                <div class="gd-help-section">
                    <h6 class="gd-help-section__title" data-bs-toggle="collapse" data-bs-target="#helpSync" aria-expanded="false">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                            <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                        </svg>
                        How syncing works
                    </h6>
                    <div class="accordion-collapse collapse" id="helpSync">
                        <p class="text-muted small mb-0">
                            The file list is saved after each sync, so the page loads quickly without contacting Google.
                            Use <strong>Sync now</strong> to pick up changes. The first load after a quiet period can take a few extra seconds.
                        </p>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Got it</button>
            </div>
        </div>
    </div>
</div>

<!-- New Monthly Budget Sheet Instructions Modal -->
<div class="modal fade" id="newBudgetSheetModal" tabindex="-1" aria-labelledby="newBudgetSheetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="newBudgetSheetModalLabel">New budget sheet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small">Use Google's free Monthly budget template to start a new month.</p>

                <h6 class="fw-bold mb-1">1. Create it from Google's template</h6>
                <p class="text-muted small">
                    Open <a href="https://docs.google.com/spreadsheets/" target="_blank" rel="noopener noreferrer">Google Sheets</a>
                    (signed in to the account that owns <strong>@(currentConn?.Name ?? "your connected folder")</strong>).
                    At the top, click <strong>Template gallery</strong>, then choose <strong>Monthly budget</strong>.
                </p>

                <h6 class="fw-bold mb-1 mt-3">2. Keep the name starting with "Monthly budget"</h6>
                <p class="text-muted small">
                    The new spreadsheet is called <em>Monthly budget</em>. You can add the month, for example
                    <em>Monthly budget - @DateTime.UtcNow.ToString("MMMM yyyy")</em>, but keep "Monthly budget" at the start.
                    That's how this app knows to show a budget report for it.
                </p>

                <h6 class="fw-bold mb-1 mt-3">3. Fill it in</h6>
                <p class="text-muted small">
                    On the <strong>Summary</strong> tab, enter your starting balance and planned income and expenses.
                    Record what you actually earn and spend on the <strong>Transactions</strong> tab.
                </p>

                <h6 class="fw-bold mb-1 mt-3">4. Move it into your connected folder</h6>
                <p class="text-muted small">
                    In the spreadsheet, choose <em>File &rarr; Move</em> and pick
                    @if (!string.IsNullOrWhiteSpace(currentConn?.FolderUrl))
                    {
                        <a href="@currentConn.FolderUrl" target="_blank" rel="noopener noreferrer"><strong>@currentConn.Name</strong></a>
                    }
                    else
                    {
                        <strong>@(currentConn?.Name ?? "your connected folder")</strong>
                    }.
                    New spreadsheets are saved to My Drive, and this app only sees files inside the connected folder.
                </p>

                <h6 class="fw-bold mb-1 mt-3">5. Sync</h6>
                <p class="text-muted small mb-0">
                    Come back here and click <strong>Sync now</strong>. The sheet appears under <strong>Spreadsheets</strong>.
                    Not there? Check that it's in the folder, its name starts with "Monthly budget", and the folder is still shared as
                    <strong>Anyone with the link</strong>.
                </p>
            </div>
            <div class="modal-footer border-top">
                <a href="https://docs.google.com/spreadsheets/" target="_blank" rel="noopener noreferrer" class="btn btn-success">Open Google Sheets &nearr;</a>
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Feedback -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
    <div id="pageToast" class="toast align-items-center border rounded-3" role="status" aria-live="polite"
         aria-atomic="true"
         style="background-color: var(--app-surface); color: var(--app-text); border-color: var(--app-border); box-shadow: var(--app-shadow-8);">
        <div class="d-flex">
            <div class="toast-body small" id="pageToastMessage"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables-bs5/dataTables.bootstrap5.min.css"/>
    <style>
        /* DataTables footer layout */
        .dt-layout-row {
            display: flex !important;
            flex-wrap: wrap;
            gap: 0.5rem;
            align-items: center;
            padding: 0.5rem 0;
        }
        .dt-layout-row .dataTables_info {
            color: #6c757d;
            font-size: 0.85rem;
            white-space: nowrap;
            line-height: 1.5;
        }
        .dt-layout-row .dataTables_length {
            color: #6c757d;
            font-size: 0.85rem;
            line-height: 1.5;
        }
        .dt-layout-row .dataTables_length label {
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }
        /* DataTables length dropdown - match DataTables' actual DOM structure */
        div.dt-container div.dt-length select {
            width: auto;
            display: inline-block;
            margin-right: 0.5em;
            font-size: 0.85rem;
            padding: 0.25rem 1.75rem 0.25rem 0.5rem;
            border: 1px solid #ced4da;
            border-radius: 0.25rem;
            background-color: #fff;
            color: #495057;
            min-width: 65px;
            height: auto;
            line-height: 1.5;
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 0.5rem center;
            background-size: 16px 12px;
            overflow: visible;
            white-space: nowrap;
        }
        .dt-layout-row .dataTables_paginate {
            margin: 0;
        }
        .dt-layout-row .dataTables_paginate .pagination {
            margin: 0;
            gap: 0.125rem;
        }
        .dt-layout-row .dataTables_paginate .pagination .page-item {
            margin: 0;
        }
        .dt-layout-row .dataTables_paginate .pagination .page-item .page-link {
            font-size: 0.85rem;
            padding: 0.35rem 0.6rem;
            line-height: 1.5;
            min-width: 2rem;
            text-align: center;
            color: #6c757d;
            border-color: #dee2e6;
            background-color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            overflow: visible;
        }
        .dt-layout-row .dataTables_paginate .pagination .page-item .page-link svg,
        .dt-layout-row .dataTables_paginate .pagination .page-item .page-link span {
            vertical-align: middle;
            line-height: 1.5;
        }
        .dt-layout-row .dataTables_paginate .pagination .page-item.active .page-link {
            color: #fff;
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        .dt-layout-row .dataTables_paginate .pagination .page-item.disabled .page-link {
            color: #adb5bd;
            background-color: #fff;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
