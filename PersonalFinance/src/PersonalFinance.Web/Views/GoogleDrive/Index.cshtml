    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="apiKeyGuideModalLabel">@L["GoogleDrive.Help.Title"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
            </div>
            <div class="modal-body p-4">
                <div class="gd-help-section">
                    <h6 class="gd-help-section__title" data-bs-toggle="collapse" data-bs-target="#helpShare" aria-expanded="true">
