@model PersonalFinance.Web.Models.GoogleDriveViewModel

@{
    ViewData["Title"] = "Google Drive Folder Explorer";
    var response = Model.Response;
    var files = response?.Files ?? new List<PersonalFinance.Shared.DTOs.GoogleDriveFileDto>();
    var folderCount = files.Count(f => f.IsFolder);
    var docCount = files.Count(f => !f.IsFolder);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Google Drive Folder Explorer</h2>
            <p class="text-muted mb-0">Inspect and browse all files within any public Google Drive folder using interactive DataTables.</p>
        </div>
        <div>
            <span class="badge bg-primary fs-6">Google Drive v3 API + DataTables</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <strong>Error:</strong> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (response != null && !string.IsNullOrEmpty(response.WarningMessage))
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-2 fs-5">&#9888;</span>
                <div>
                    <strong>Notice:</strong> @response.WarningMessage
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Input Form Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Enter Google Drive Folder Link</h5>
            <span class="badge bg-light text-dark">URL / ID Resolver</span>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="post" id="driveExplorerForm">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="FolderUrl" class="form-label fw-bold">Google Drive Folder Link or Folder ID:</label>
                    <div class="input-group">
                        <input asp-for="FolderUrl" id="folderUrlInput" class="form-control form-control-lg font-monospace"
                               placeholder="e.g. https://drive.google.com/drive/folders/127ViLEHTWIEsAN0x8gbRGTJiwOpbH3g_?usp=drive_link" required />
                        <button type="button" class="btn btn-outline-secondary" id="btnPasteSample">
                            Paste Sample Link
                        </button>
                    </div>
                    <span asp-validation-for="FolderUrl" class="text-danger small"></span>
                    <div class="form-text">
                        Supports standard folder URLs (<code>https://drive.google.com/drive/folders/&lt;ID&gt;</code>) or raw folder IDs.
                    </div>
                    <div class="alert alert-info d-flex align-items-center mt-2 mb-0 py-2 small" role="alert">
                        <span class="me-2 fs-6">&#9432;</span>
                        <div>
                            <strong>Access Requirement:</strong> To allow the Google Drive API to list files, your folder's General access must be set to <strong>"Anyone with the link"</strong> (Viewer). Private or <em>"Restricted"</em> folders cannot be read by an API key.
                        </div>
                    </div>
                </div>

                <!-- Advanced Settings: Optional API Key -->
                <div class="accordion mb-3" id="advancedSettingsAccordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingAdvanced">
                            <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAdvanced" aria-expanded="false" aria-controls="collapseAdvanced">
                                <small class="text-muted">&#9881; Optional: Google Cloud API Key (for Live Google Drive Queries)</small>
                            </button>
                        </h2>
                        <div id="collapseAdvanced" class="accordion-collapse collapse" aria-labelledby="headingAdvanced" data-bs-parent="#advancedSettingsAccordion">
                            <div class="accordion-body bg-light">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label asp-for="ApiKey" class="form-label fw-semibold mb-0">Google API Key:</label>
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#apiKeyGuideModal">
                                        &#10067; How to get an API Key? (Easy Guide)
                                    </button>
                                </div>
                                <input asp-for="ApiKey" class="form-control font-monospace" placeholder="AIzaSy..." />
                                <div class="form-text small">
                                    Leave blank to use preview mode or the key configured in <code>appsettings.json</code>. A standard Google Cloud API key with <em>Google Drive API</em> enabled can read any public/shared folder.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <button type="submit" class="btn btn-success btn-lg px-4" id="btnSubmitExplore">
                        <span>Explore Folder &amp; List Files</span>
                    </button>
                    @if (response != null && !string.IsNullOrEmpty(response.FolderId))
                    {
                        <a href="https://drive.google.com/drive/folders/@response.FolderId" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary">
                            Open in Google Drive &rarr;
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Results Section -->
    @if (Model.HasQueried && response != null && response.Success)
    {
        @if (response.IsDemoData)
        {
            <div class="alert alert-secondary border-warning border-2 shadow-sm mb-4" role="alert">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <strong class="text-dark">&#9888; Displaying Preview Demo Data</strong>
                        <div class="small text-muted">
                            @(response.WarningMessage ?? "To retrieve live files from your folder, provide a valid Google Cloud API key and ensure folder access is set to 'Anyone with the link'.")
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#apiKeyGuideModal">
                        View Sharing &amp; API Key Guide
                    </button>
                </div>
            </div>
        }

        <!-- Summary Analytics Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-sm-6">
                <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase fw-bold">Total Items</div>
                        <div class="fs-3 fw-bold text-primary">@response.TotalFilesCount</div>
                        <div class="small text-muted">@docCount files, @folderCount subfolders</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase fw-bold">Total File Size</div>
                        <div class="fs-3 fw-bold text-success">@response.TotalSizeFormatted</div>
                        <div class="small text-muted">Cumulative data volume</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card shadow-sm border-0 border-start border-info border-4 h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase fw-bold">Folder ID</div>
                        <div class="font-monospace small text-truncate fw-bold text-info" title="@response.FolderId">
                            @response.FolderId
                        </div>
                        <div class="small text-muted">Google Drive Identifier</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card shadow-sm border-0 border-start border-secondary border-4 h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase fw-bold">Data Source</div>
                        <div class="fs-5 fw-bold @(response.IsDemoData ? "text-warning" : "text-success")">
                            @(response.IsDemoData ? "Preview Mode" : "Live Google API")
                        </div>
                        <div class="small text-muted">@(response.IsDemoData ? "Simulated sample payload" : "Live Google Drive v3")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Files Data Table Card -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    Files in Folder: <span class="badge bg-light text-dark font-monospace">@(response.FolderName ?? response.FolderId)</span>
                </h5>
                <span class="badge bg-primary">Interactive DataTable</span>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="googleDriveDataTable" class="table table-striped table-hover align-middle w-100">
                        <thead class="table-light">
                        <tr>
                            <th style="width: 40px;">#</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Size</th>
                            <th>Created</th>
                            <th>Last Modified</th>
                            <th class="text-center" style="width: 140px;">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (files.Any())
                        {
                            var index = 1;
                            foreach (var file in files)
                            {
                                <tr>
                                    <td class="text-muted small">@(index++)</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="badge @file.IconBadgeClass me-2">
                                                @(file.IsFolder ? "\uD83D\uDCC1" : "\uD83D\uDCC4")
                                            </span>
                                            <div>
                                                @if (!string.IsNullOrEmpty(file.WebViewLink))
                                                {
                                                    <a href="@file.WebViewLink" target="_blank" rel="noopener noreferrer" class="text-decoration-none fw-bold text-dark">
                                                        @file.Name
                                                    </a>
                                                }
                                                else
                                                {
                                                    <strong class="text-dark">@file.Name</strong>
                                                }
                                                <div class="text-muted small font-monospace">ID: @file.Id</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @file.IconBadgeClass">@file.FileType</span>
                                    </td>
                                    <td data-order="@(file.Size ?? -1)">
                                        <span class="font-monospace">@file.SizeFormatted</span>
                                    </td>
                                    <td data-order="@(file.CreatedTime?.ToString("o") ?? "")">
                                        @(file.CreatedTime?.ToLocalTime().ToString("g") ?? "-")
                                    </td>
                                    <td data-order="@(file.ModifiedTime?.ToString("o") ?? "")">
                                        @(file.ModifiedTime?.ToLocalTime().ToString("g") ?? "-")
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(file.WebViewLink))
                                        {
                                            <a href="@file.WebViewLink" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary me-1" title="Open in Google Drive">
                                                Open
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-copy-link" data-link="@file.WebViewLink" title="Copy Link">
                                                Copy
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (Model.HasQueried && (response == null || !response.Success))
    {
        <div class="card shadow-sm border-0 p-4 bg-light mb-4">
            <div class="card-body">
                <div class="text-center mb-4">
                    <div class="display-6 text-danger mb-2">&#9888;</div>
                    <h4 class="text-danger fw-bold">Unable to Load Google Drive Files</h4>
                    <p class="text-muted mb-0">
                        @(Model.ErrorMessage ?? "Could not retrieve the file listing for the specified Google Drive link.")
                    </p>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom fw-bold text-dark">
                        &#128269; Why did this happen &amp; How to resolve it:
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="p-3 border rounded bg-white h-100">
                                    <h6 class="fw-bold text-primary mb-2">1. Folder Sharing is "Restricted"</h6>
                                    <p class="small text-muted mb-2">
                                        Google Drive API keys only access public resources. If your folder is restricted to specific users, Google will block access with a 404 or 403 error.
                                    </p>
                                    <div class="small fw-semibold text-dark">
                                        &rarr; <strong>Fix:</strong> In Google Drive, right-click folder &rarr; <strong>Share</strong> &rarr; change General access to <strong>"Anyone with the link"</strong> (Viewer).
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 border rounded bg-white h-100">
                                    <h6 class="fw-bold text-success mb-2">2. Google Drive API Disabled</h6>
                                    <p class="small text-muted mb-2">
                                        The API key must belong to a Google Cloud project with the <strong>Google Drive API</strong> library enabled.
                                    </p>
                                    <div class="small fw-semibold text-dark">
                                        &rarr; <strong>Fix:</strong> In Google Cloud Console, go to <strong>APIs &amp; Services &rarr; Library</strong> and enable <strong>Google Drive API</strong>.
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 border rounded bg-white h-100">
                                    <h6 class="fw-bold text-secondary mb-2">3. Verify Link or Folder ID</h6>
                                    <p class="small text-muted mb-2">
                                        Ensure the URL or raw folder ID was copied completely without truncated characters.
                                    </p>
                                    <div class="small fw-semibold text-dark">
                                        &rarr; <strong>Fix:</strong> Paste the full URL (e.g. <code>https://drive.google.com/drive/folders/...</code>).
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="text-center">
                    <button type="button" class="btn btn-primary px-4 me-2" onclick="document.getElementById('folderUrlInput').focus();">
                        Try Another Link
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#apiKeyGuideModal">
                        Open Step-by-Step Setup Guide
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- Step-by-Step API Key Guide Modal for Non-Technical Users -->
<div class="modal fade" id="apiKeyGuideModal" tabindex="-1" aria-labelledby="apiKeyGuideModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="apiKeyGuideModalLabel">&#128273; How to Set Up Google Drive &amp; API Key (Easy 6-Step Guide)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="lead fs-6 text-muted">
                    Follow these 6 simple steps to configure your Google Drive folder and get your free Google API Key in under 2 minutes.
                </p>

                <!-- Step 1 -->
                <div class="d-flex mb-4">
                    <div class="flex-shrink-0">
                        <span class="badge bg-primary rounded-circle fs-5 px-3 py-2">1</span>
                    </div>
                    <div class="ms-3">
                        <h6 class="fw-bold mb-1">Open Google Cloud Console</h6>
                        <p class="text-muted mb-1">
                            Go to <a href="https://console.cloud.google.com/" target="_blank" rel="noopener noreferrer" class="fw-bold">console.cloud.google.com</a> and sign in with your regular Google / Gmail account.
                        </p>
                        <small class="text-secondary">If this is your first time, simply agree to the Terms of Service.</small>
                    </div>
                </div>

                <!-- Step 2 -->
                <div class="d-flex mb-4">
                    <div class="flex-shrink-0">
                        <span class="badge bg-primary rounded-circle fs-5 px-3 py-2">2</span>
                    </div>
                    <div class="ms-3">
                        <h6 class="fw-bold mb-1">Create a New Project</h6>
                        <p class="text-muted mb-1">
                            Click on the <strong>project dropdown</strong> in the top-left navigation bar (next to the Google Cloud logo), click <strong>"New Project"</strong>, enter a name (e.g. <code>Drive Explorer</code>), and click <strong>"Create"</strong>.
                        </p>
                        <small class="text-secondary">Wait a few seconds for the project to finish creating.</small>
                    </div>
                </div>

                <!-- Step 3 -->
                <div class="d-flex mb-4">
                    <div class="flex-shrink-0">
                        <span class="badge bg-primary rounded-circle fs-5 px-3 py-2">3</span>
                    </div>
                    <div class="ms-3">
                        <h6 class="fw-bold mb-1">Enable the "Google Drive API"</h6>
                        <p class="text-muted mb-1">
                            In the left sidebar menu, go to <strong>APIs &amp; Services &rarr; Library</strong> (or search for <em>"Google Drive API"</em> in the top search bar).
                        </p>
                        <p class="text-muted mb-1">
                            Click on <strong>Google Drive API</strong> and then click the blue <strong>"Enable"</strong> button.
                        </p>
                    </div>
                </div>

                <!-- Step 4 -->
                <div class="d-flex mb-4">
                    <div class="flex-shrink-0">
                        <span class="badge bg-primary rounded-circle fs-5 px-3 py-2">4</span>
                    </div>
                    <div class="ms-3">
                        <h6 class="fw-bold mb-1">Generate Your API Key</h6>
                        <p class="text-muted mb-1">
                            In the left sidebar, navigate to <strong>APIs &amp; Services &rarr; Credentials</strong>.
                        </p>
                        <p class="text-muted mb-1">
                            Click <strong>"+ CREATE CREDENTIALS"</strong> at the top of the screen and choose <strong>"API key"</strong> from the dropdown.
                        </p>
                    </div>
                </div>

                <!-- Step 5 -->
                <div class="d-flex mb-4">
                    <div class="flex-shrink-0">
                        <span class="badge bg-primary rounded-circle fs-5 px-3 py-2">5</span>
                    </div>
                    <div class="ms-3">
                        <h6 class="fw-bold mb-1">Copy and Paste Your Key</h6>
                        <p class="text-muted mb-1">
                            A pop-up box will display your new key (starting with <code>AIzaSy...</code>). Click the <strong>Copy</strong> icon and paste it into the <em>Google API Key</em> box on this page or save it in <code>appsettings.json</code>.
                        </p>
                    </div>
                </div>

                <!-- Step 6 -->
                <div class="d-flex mb-4">
                    <div class="flex-shrink-0">
                        <span class="badge bg-success rounded-circle fs-5 px-3 py-2">6</span>
                    </div>
                    <div class="ms-3">
                        <h6 class="fw-bold mb-1 text-success">Grant Folder Access: Set to "Anyone with the link" (Crucial)</h6>
                        <p class="text-muted mb-1">
                            Because API keys query Google Drive as an unauthenticated public client, you must grant public view permissions to the folder:
                        </p>
                        <ol class="text-muted small ps-3 mb-1">
                            <li>Open <a href="https://drive.google.com" target="_blank" rel="noopener noreferrer">Google Drive</a> and locate your folder.</li>
                            <li>Right-click the folder &rarr; click <strong>Share</strong> &rarr; <strong>Share</strong>.</li>
                            <li>Under <strong>General access</strong>, change <em>"Restricted"</em> to <strong>"Anyone with the link"</strong> (Role: <em>Viewer</em>).</li>
                            <li>Click <strong>"Done"</strong> and copy the link into the explorer form above.</li>
                        </ol>
                        <small class="text-danger fw-semibold">&#9888; If the folder remains "Restricted", Google Drive will reject the query with a 404 or 403 error.</small>
                    </div>
                </div>

                <hr />

                <!-- Important Notes & FAQ -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded border h-100">
                            <h6 class="fw-bold text-success mb-1">&#128181; Is it really free?</h6>
                            <p class="small text-muted mb-0">
                                Yes! Google provides a generous free tier of thousands of Google Drive API requests every day, which is more than enough for personal and exploration usage.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded border h-100">
                            <h6 class="fw-bold text-primary mb-1">&#128194; Folder Sharing Requirement</h6>
                            <p class="small text-muted mb-0">
                                The folder you want to explore must have its link sharing set to <strong>"Anyone with the link can view"</strong> in Google Drive so the API key can read its file list.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <a href="https://console.cloud.google.com/apis/credentials" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary">
                    Open Google Cloud Console &rarr;
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // 1. Paste Sample Link functionality
            $('#btnPasteSample').on('click', function () {
                $('#folderUrlInput').val('https://drive.google.com/drive/folders/127ViLEHTWIEsAN0x8gbRGTJiwOpbH3g_?usp=drive_link');
                $('#folderUrlInput').focus();
            });

            // 2. Initialize DataTables with Bootstrap 5 styling
            if ($('#googleDriveDataTable').length) {
                $('#googleDriveDataTable').DataTable({
                    responsive: true,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                    order: [[1, 'asc']], // Default sort by file name ascending
                    columnDefs: [
                        { orderable: false, targets: [0, 6] } // Disable ordering on # and Actions
                    ],
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search files by name, type, or date...",
                        lengthMenu: "Show _MENU_ entries",
                        info: "Showing _START_ to _END_ of _TOTAL_ items",
                        infoEmpty: "No files found in folder",
                        emptyTable: "No files available in this Google Drive folder"
                    }
                });
            }

            // 3. Copy Link to clipboard button
            $(document).on('click', '.btn-copy-link', function () {
                var link = $(this).data('link');
                if (link) {
                    navigator.clipboard.writeText(link).then(() => {
                        var originalText = $(this).text();
                        $(this).text('Copied!').addClass('btn-success').removeClass('btn-outline-secondary');
                        setTimeout(() => {
                            $(this).text(originalText).removeClass('btn-success').addClass('btn-outline-secondary');
                        }, 2000);
                    });
                }
            });
        });
    </script>
}
