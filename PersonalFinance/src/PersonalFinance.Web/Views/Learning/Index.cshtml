@using PersonalFinance.Shared.Enums
@using PersonalFinance.Web.Models.Learning
@model LearningIndexViewModel
@{
    ViewData["Title"] = L["Learning.Title"];
}

@section Head {
    <meta name="description" content="@L["Learning.Meta.Description"]"/>
    <link rel="canonical" href="@Url.Action("Index", "Learning", null, Context.Request.Scheme)"/>
}

@section Styles {
    <link rel="stylesheet" href="~/css/learning.css" asp-append-version="true"/>
}

<div class="atelier" data-test-id="atelier-library">
    <header class="atelier-header">
        <h1 class="atelier-title">@L["Learning.Atelier.Heading"]</h1>
        <p class="atelier-lede">@L["Learning.Atelier.Lede"]</p>
    </header>

    @if (Model.Road.Count > 0)
    {
        <section class="atelier-journey" id="journey" aria-labelledby="journeyHeading" data-test-id="atelier-road">
            <h2 class="atelier-section-title" id="journeyHeading">@L["Learning.Road.Heading"]</h2>
            <p class="atelier-lede">@L["Learning.Road.Lede"]</p>
            @if (!Model.IsSignedIn)
            {
                <p class="atelier-road-start">
                    @L["Learning.Road.GuestLede"]
                    <a class="atelier-button" asp-area="Identity" asp-page="/Account/Login"
                       asp-route-returnUrl="@Url.Action("Index", "Learning")" data-test-id="atelier-start">@L["Learning.Road.Start"]</a>
                </p>
            }

            <div class="atelier-road">
                <ol class="atelier-stops" aria-label="@L["Learning.Road.Label"]">
                    @foreach (var stop in Model.Road)
                    {
                        var state = stop.Status switch
                        {
                            LessonStatus.Finished => "finished",
                            LessonStatus.Open => "open",
                            LessonStatus.Locked => "locked",
                            _ => "outline",
                        };
                        <li class="atelier-stop atelier-stop--@state" data-test-id="stop-@stop.Slug" data-state="@state"
                            aria-current="@(stop.Status == LessonStatus.Open ? "step" : null)">
                            <span class="atelier-stop-marker" aria-hidden="true">@(stop.Status == LessonStatus.Finished ? stop.Keepsake.Symbol : stop.Day.ToString(System.Globalization.CultureInfo.CurrentCulture))</span>
                            <span class="atelier-stop-day">@L.Named("Learning.Road.LessonDay", ("day", stop.Day))</span>
                            @if (stop.Status == LessonStatus.Locked)
                            {
                                <span class="atelier-stop-title">@stop.Title</span>
                            }
                            else
                            {
                                <a class="atelier-stop-title" asp-action="Lesson" asp-route-slug="@stop.Slug">@stop.Title</a>
                            }
                            @if (stop.Status is { } status)
                            {
                                <span class="atelier-stop-status" data-test-id="stop-status-@stop.Slug">
                                    @(status switch
                                    {
                                        LessonStatus.Finished => L["Learning.Road.Status.Finished"],
                                        LessonStatus.Open => L["Learning.Road.Status.Open"],
                                        _ when stop.OpensTomorrow => L["Learning.Road.Status.OpensTomorrow"],
                                        _ => L["Learning.Road.Status.Locked"],
                                    })
                                </span>
                            }
                        </li>
                    }
                </ol>
            </div>

            @if (Model.Keepsakes.Any())
            {
                <div class="atelier-desk" data-test-id="atelier-desk">
                    <h3 class="atelier-desk-title">@L["Learning.Desk.Heading"]</h3>
                    <ul class="atelier-keepsakes">
                        @foreach (var keepsake in Model.Keepsakes)
                        {
                            <li class="atelier-keepsake"><span aria-hidden="true">@keepsake.Symbol</span> @keepsake.Name</li>
                        }
                    </ul>
                </div>
            }

            @if (Model.IsSignedIn)
            {
                @* Turns the quiet Dashboard card on or off (#523); the card's own Hide button turns it off too. *@
                <form class="atelier-dashboard-switch" method="post" asp-action="ShowOnDashboard">
                    <input type="hidden" name="show" value="@(Model.ShowOnDashboard ? "false" : "true")"/>
                    <input type="hidden" name="returnUrl" value="@(Url.Action("Index", "Learning") + "#journey")"/>
                    <button type="submit" class="atelier-switch" role="switch"
                            aria-checked="@(Model.ShowOnDashboard ? "true" : "false")"
                            aria-describedby="dashboardSwitchHint" data-test-id="atelier-dashboard-switch">
                        <span class="atelier-switch-track" aria-hidden="true"><span class="atelier-switch-thumb"></span></span>
                        <span class="atelier-switch-label">@L["Learning.Dashboard.Switch"]</span>
                    </button>
                    <p class="atelier-switch-hint" id="dashboardSwitchHint">@L["Learning.Dashboard.SwitchHint"]</p>
                </form>
            }
        </section>
    }

    <h2 class="atelier-section-title">@L["Learning.Library.Heading"]</h2>
    <p class="atelier-lede">@L["Learning.Library.Lede"]</p>

    @if (Model.IsEmpty)
    {
        <p class="atelier-empty" data-test-id="atelier-empty">@L["Learning.Library.BeingWritten"]</p>
    }
    else
    {
        <div class="atelier-filter">
            <label class="atelier-filter-label" for="atelierFilter">@L["Learning.Filter.Label"]</label>
            <input type="search" id="atelierFilter" class="atelier-filter-input" autocomplete="off"
                   placeholder="@L["Learning.Filter.Placeholder"]" aria-describedby="atelierFilterStatus"
                   data-test-id="atelier-filter"/>
            <p id="atelierFilterStatus" class="atelier-filter-status" role="status" aria-live="polite"></p>
            <p id="atelierFilterNone" class="atelier-filter-none" hidden>@L["Learning.Filter.NoMatch"]</p>
        </div>

        @foreach (var topic in Model.Topics.Where(t => t.Terms.Count > 0))
        {
            <section class="atelier-shelf" aria-labelledby="shelf-@topic.Slug" data-shelf>
                <h3 class="atelier-shelf-title" id="shelf-@topic.Slug">@L[LearningTopicNames.KeyFor(topic.Slug)]</h3>
                <ul class="atelier-spines">
                    @foreach (var term in topic.Terms)
                    {
                        <li class="atelier-spine-item" data-spine
                            data-search="@string.Join("|", new[] { term.Term, term.EnglishTerm, term.VietnameseName }.Concat(term.AlsoKnownAs))">
                            <a class="atelier-spine" asp-action="Term" asp-route-slug="@term.Slug" data-test-id="spine-@term.Slug">
                                <span class="atelier-spine-term">@term.Term</span>
                                @if (term.AlsoKnownAs.Count > 0)
                                {
                                    <span class="atelier-spine-aka">@string.Join(", ", term.AlsoKnownAs)</span>
                                }
                                <span class="atelier-spine-vi" lang="vi">@term.VietnameseName</span>
                            </a>
                        </li>
                    }
                </ul>
            </section>
        }
    }
</div>

@section Scripts {
    @if (!Model.IsEmpty)
    {
        <js-strings prefix="Learning.Js." />
        <script src="~/js/learning/library-filter.js" asp-append-version="true"></script>
    }
}
