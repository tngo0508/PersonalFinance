@model PersonalFinance.Web.Features.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="py-3">
    <header class="mb-4">
        <p class="text-muted text-uppercase small mb-1">Admin</p>
        <h1 class="h3 mb-1">Admin Dashboard</h1>
        <p class="text-muted mb-0">System-level numbers only. No personal financial data is shown here.</p>
        <a asp-action="Feedback" class="btn btn-outline-primary btn-sm mt-3">Feedback inbox</a>
    </header>

    @if (TempData["AdminMessage"] is string adminMessage)
    {
        <div class="alert alert-success" role="status">@adminMessage</div>
    }
    @if (TempData["AdminError"] is string adminError)
    {
        <div class="alert alert-danger" role="alert">@adminError</div>
    }
    @if (Model.LoadFailed)
    {
        <div class="alert alert-warning" role="alert">The system summary could not be loaded. Try again later.</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Total accounts</div>
                <div class="fs-3 fw-semibold">@Model.Summary.TotalAccounts</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Confirmed</div>
                <div class="fs-3 fw-semibold">@Model.Summary.ConfirmedAccounts</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Unconfirmed</div>
                <div class="fs-3 fw-semibold">@Model.Summary.UnconfirmedAccounts</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">App version</div>
                <div class="fs-3 fw-semibold">@Model.AppVersion</div>
            </div></div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Accounts per role</div>
        @if (Model.Summary.AccountsPerRole.Count == 0)
        {
            <div class="card-body text-muted">No roles assigned yet.</div>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var entry in Model.Summary.AccountsPerRole.OrderBy(e => e.Key))
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@entry.Key</span>
                        <span class="fw-semibold">@entry.Value</span>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="card mt-4">
        <div class="card-header">Roles</div>
        <ul class="list-group list-group-flush">
            @foreach (var role in Model.Roles)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>
                        @role.Name
                        @if (role.IsBuiltIn)
                        {
                            <span class="badge text-bg-secondary ms-1">Built-in</span>
                        }
                        <span class="text-muted small ms-2">@role.UserCount account(s)</span>
                    </span>
                    @if (!role.IsBuiltIn)
                    {
                        <form asp-action="DeleteRole" method="post" class="m-0">
                            <input type="hidden" name="roleName" value="@role.Name" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" disabled="@(role.UserCount > 0)">Delete</button>
                        </form>
                    }
                </li>
            }
        </ul>
        <div class="card-body border-top">
            <form asp-action="CreateRole" method="post" class="row g-2 align-items-end">
                <div class="col-12 col-md-6">
                    <label for="newRoleName" class="form-label small mb-1">New role name</label>
                    <input id="newRoleName" name="roleName" class="form-control" maxlength="50" required
                           pattern="[A-Za-z0-9_\-]+" placeholder="e.g. ReadOnly" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Add role</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">Accounts and roles</div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Email</th><th>Roles</th><th>Assign role</th></tr>
                </thead>
                <tbody>
                    @foreach (var account in Model.Users)
                    {
                        var available = Model.Roles.Where(r => !account.Roles.Contains(r.Name)).ToList();
                        <tr>
                            <td>
                                @account.Email
                                @if (!account.EmailConfirmed)
                                {
                                    <span class="badge text-bg-warning ms-1">Unconfirmed</span>
                                }
                            </td>
                            <td>
                                @foreach (var roleName in account.Roles)
                                {
                                    <form asp-action="RemoveRole" method="post" class="d-inline">
                                        <input type="hidden" name="userId" value="@account.Id" />
                                        <input type="hidden" name="roleName" value="@roleName" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary me-1"
                                                title="Remove @roleName">@roleName &times;</button>
                                    </form>
                                }
                                @if (account.Roles.Count == 0)
                                {
                                    <span class="text-muted small">No roles</span>
                                }
                            </td>
                            <td>
                                @if (available.Count > 0)
                                {
                                    <form asp-action="AssignRole" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="userId" value="@account.Id" />
                                        <select name="roleName" class="form-select form-select-sm" aria-label="Role to assign">
                                            @foreach (var role in available)
                                            {
                                                <option value="@role.Name">@role.Name</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-primary">Assign</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
