@model PersonalFinance.Web.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="py-3">
    <header class="mb-4">
        <p class="text-muted text-uppercase small mb-1">Admin</p>
        <h1 class="h3 mb-1">Admin Dashboard</h1>
        <p class="text-muted mb-0">System-level numbers only. No personal financial data is shown here.</p>
    </header>

    @if (Model.LoadFailed)
    {
        <div class="alert alert-warning" role="alert">The system summary could not be loaded. Try again later.</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Total accounts</div>
                <div class="fs-3 fw-semibold">@Model.Summary.TotalAccounts</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Confirmed</div>
                <div class="fs-3 fw-semibold">@Model.Summary.ConfirmedAccounts</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Unconfirmed</div>
                <div class="fs-3 fw-semibold">@Model.Summary.UnconfirmedAccounts</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">App version</div>
                <div class="fs-3 fw-semibold">@Model.AppVersion</div>
            </div></div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Accounts per role</div>
        @if (Model.Summary.AccountsPerRole.Count == 0)
        {
            <div class="card-body text-muted">No roles assigned yet.</div>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var entry in Model.Summary.AccountsPerRole.OrderBy(e => e.Key))
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@entry.Key</span>
                        <span class="fw-semibold">@entry.Value</span>
                    </li>
                }
            </ul>
        }
    </div>
</div>
