@using Microsoft.AspNetCore.Mvc.Razor
@using PersonalFinance.Shared.Constants
@using PersonalFinance.Web.Infrastructure
@{
    ViewData["Title"] = L["About.Title"].Value;
    string appName = AppVersion.ApplicationName;
}

<div class="legal-page">
    <h1 class="legal-page__title">@L.Named("About.Heading", ("appName", appName))</h1>

    <section class="legal-section">
        <h2>@L["About.WhatItIs.Title"]</h2>
        <p>@L.Named("About.WhatItIs.Text", ("appName", appName))</p>
    </section>

    <section class="legal-section">
        <h2>@L["About.Why.Title"]</h2>
        <p>@L.Named("About.Why.Text", ("appName", appName))</p>
    </section>

    <section class="legal-section">
        <h2>@L["About.Who.Title"]</h2>
        <p>@L.Named("About.Who.Text", ("appName", appName))</p>
    </section>

    <section class="legal-section">
        <h2>@L["About.Features.Title"]</h2>
        <ul>
            <li><strong>@L["About.Features.NetWorth.Name"]</strong>: @L["About.Features.NetWorth.Text"]</li>
            <li><strong>@L["About.Features.BudgetPlanner.Name"]</strong>: @L["About.Features.BudgetPlanner.Text"]</li>
            <li><strong>@L["About.Features.BudgetTracker.Name"]</strong>: @L["About.Features.BudgetTracker.Text"]</li>
            <li><strong>@L["About.Features.SavingsGoals.Name"]</strong>: @L["About.Features.SavingsGoals.Text"]</li>
            <li><strong>@L["About.Features.Analysis.Name"]</strong>: @L["About.Features.Analysis.Text"]</li>
            <li><strong>@L["About.Features.Community.Name"]</strong>: @L["About.Features.Community.Text"]</li>
        </ul>
    </section>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <section class="legal-section">
            <h2>@L["About.Feedback.Title"]</h2>
            @{
                Func<object?, HelperResult> feedbackLink =
                    @<a asp-area="" asp-controller="Feedback" asp-action="Index" asp-route-from="@FeedbackSourcePage.From(Context.Request)">@L["About.Feedback.Link"]</a>;
            }
            <p>@L.NamedHtml("About.Feedback.Prompt", null, ("link", feedbackLink(null)))</p>
        </section>
    }

    <section class="legal-section">
        <h2>@L["About.NotAdvice.Title"]</h2>
        @{
            Func<object?, HelperResult> disclaimerLink =
                @<a asp-area="" asp-controller="Legal" asp-action="Disclaimer">@L["About.NotAdvice.DisclaimerLink"]</a>;
        }
        <p>
            @L.Named("About.NotAdvice.Text", ("appName", appName))
            @L.NamedHtml("About.NotAdvice.ReadDisclaimer", null, ("link", disclaimerLink(null)))
        </p>
    </section>
</div>
