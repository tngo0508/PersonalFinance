@using PersonalFinance.Shared.Constants
@model LandingPageViewModel
@{
    string appName = AppVersion.ApplicationName;
    ViewData["DocumentTitle"] = L.Named("Landing.DocumentTitle", ("appName", appName));

    // The sample plan is in US dollars until the money formatter (spec L2) formats amounts for the culture.
    const string spending = "$40,000";
    const string target = "$1,000,000";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true"/>
}

@section Scripts {
    <script src="~/js/landing/skyline.js" asp-append-version="true"></script>
}

<div class="lp-page">
    @* ---------- Hero ---------- *@
    <section class="lp-hero" aria-labelledby="lp-hero-title">
        @* The Skyline: Headquarters in 3D, at 992px and wider only (ADR 0013). skyline.js loads MapLibre after the
           page has loaded; until then, or when it does not run, landing.css shows the poster. *@
        <div class="lp-skyline" data-skyline
             data-skyline-script="@Url.Content("~/lib/maplibre-gl/dist/maplibre-gl.js")"
             data-skyline-css="@Url.Content("~/lib/maplibre-gl/dist/maplibre-gl.css")"
             data-skyline-data="@Url.Content("~/data/stanton-skyline.json")">
            <div class="lp-skyline__map" data-skyline-map aria-hidden="true"></div>
            <p class="lp-skyline__credit">
                Stanton, California ·
                <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">© OpenStreetMap contributors</a>
            </p>
        </div>

        <div class="lp-hero__copy">
            <h1 id="lp-hero-title" class="lp-hero__title">@L["Landing.Hero.Title"]</h1>
            <p class="lp-hero__lead">@L.Named("Landing.Hero.Lead", ("appName", appName))</p>
            <div class="lp-cta-row">
                <a class="lp-btn lp-btn--primary" asp-area="Identity" asp-page="/Account/Register">@L["Landing.Cta.Register"]</a>
                <a class="lp-btn lp-btn--secondary" asp-area="Identity" asp-page="/Account/Login">@L["Landing.Cta.SignIn"]</a>
            </div>
            <p class="lp-hero__note">
                @L["Landing.Hero.Note"]
                <a asp-area="" asp-controller="Home" asp-action="About">@L.Named("Landing.Hero.About", ("appName", appName))</a>
            </p>
        </div>

        @* Illustrative projection. The figures follow the app's own FI rule (25 × annual spending). *@
        <figure class="lp-plan">
            <div class="lp-plan__head">
                <div>
                    <p class="lp-plan__label">@L["Landing.Plan.Label"]</p>
                    <p class="lp-plan__figure">$1,041,000 <span>@L.Named("Landing.Plan.AtAge", ("age", 52))</span></p>
                </div>
                <p class="lp-plan__tag">@L["Landing.Plan.Tag"]</p>
            </div>

            <div class="lp-plan__chart" aria-hidden="true">
                <svg viewBox="0 0 600 240" preserveAspectRatio="none" focusable="false">
                    <line class="lp-plan__grid" x1="0" y1="0" x2="600" y2="0"/>
                    <line class="lp-plan__grid" x1="0" y1="240" x2="600" y2="240"/>
                    <path class="lp-plan__area" d="M0 235.2 L20 232.1 L40 228.8 L60 225.4 L80 221.8 L100 218 L120 214 L140 209.8 L160 205.4 L180 200.8 L200 196 L220 190.9 L240 185.5 L260 179.9 L280 174.1 L300 167.9 L320 161.4 L340 154.6 L360 147.4 L380 139.9 L400 132 L420 123.8 L440 115.1 L460 105.9 L480 96.4 L500 86.3 L520 75.7 L540 64.6 L560 53 L580 40.8 L600 27.9 L600 240 L0 240 Z"/>
                    <line class="lp-plan__target" x1="0" y1="120" x2="600" y2="120"/>
                    <path class="lp-plan__line" d="M0 235.2 L20 232.1 L40 228.8 L60 225.4 L80 221.8 L100 218 L120 214 L140 209.8 L160 205.4 L180 200.8 L200 196 L220 190.9 L240 185.5 L260 179.9 L280 174.1 L300 167.9 L320 161.4 L340 154.6 L360 147.4 L380 139.9 L400 132 L420 123.8 L440 115.1 L460 105.9 L480 96.4 L500 86.3 L520 75.7 L540 64.6 L560 53 L580 40.8 L600 27.9"/>
                    <line class="lp-plan__drop" x1="440" y1="115.1" x2="440" y2="240"/>
                </svg>
                <span class="lp-plan__marker" style="left: 73.33%; top: 47.96%"></span>
                <span class="lp-plan__callout" style="left: 73.33%; top: 47.96%">@L.Named("Landing.Plan.Callout", ("age", 52))</span>
                <span class="lp-plan__target-label">@L.Named("Landing.Plan.TargetLabel", ("amount", target))</span>
                <span class="lp-plan__ages">
                    <span>@L.Named("Landing.Plan.AxisAge", ("age", 30))</span><span>40</span><span>50</span><span>60</span>
                </span>
            </div>

            <figcaption class="lp-plan__caption">
                @L.Named("Landing.Plan.Caption", ("spending", spending), ("target", target), ("start", "$40,000"),
                    ("monthly", "$2,000"), ("rate", 5), ("age", 52))
            </figcaption>
        </figure>
    </section>

    @* ---------- Mission: how the plan works ---------- *@
    <section class="lp-section lp-mission" aria-labelledby="lp-mission-title">
        <div class="lp-section__head">
            <h2 id="lp-mission-title" class="lp-section__title">@L["Landing.Mission.Title"]</h2>
            <p class="lp-section__lead">@L["Landing.Mission.Lead"]</p>
        </div>

        <dl class="lp-rules">
            <div class="lp-rule">
                <dt class="lp-rule__term">@L["Landing.Rule.Target.Term"]</dt>
                <dd class="lp-rule__sum">@L["Landing.Rule.Target.Sum"]</dd>
                <dd class="lp-rule__text">
                    @L.Named("Landing.Rule.Target.Text", ("spending", spending), ("target", target))
                </dd>
            </div>
            <div class="lp-rule">
                <dt class="lp-rule__term">@L["Landing.Rule.Growth.Term"]</dt>
                <dd class="lp-rule__sum">@L["Landing.Rule.Growth.Sum"]</dd>
                <dd class="lp-rule__text">@L["Landing.Rule.Growth.Text"]</dd>
            </div>
            <div class="lp-rule">
                <dt class="lp-rule__term">@L["Landing.Rule.Age.Term"]</dt>
                <dd class="lp-rule__sum">@L["Landing.Rule.Age.Sum"]</dd>
                <dd class="lp-rule__text">@L["Landing.Rule.Age.Text"]</dd>
            </div>
        </dl>
    </section>

    @* ---------- Tools ---------- *@
    <section class="lp-section" aria-labelledby="lp-tools-title">
        <div class="lp-section__head">
            <h2 id="lp-tools-title" class="lp-section__title">@L["Landing.Tools.Title"]</h2>
        </div>
        <ul class="lp-tools">
            @foreach (var feature in Model.CoreFeatures)
            {
                <li class="lp-tool">
                    <h3 class="lp-tool__title">@L[feature.TitleKey]</h3>
                    <p class="lp-tool__text">@L[feature.DescriptionKey]</p>
                </li>
            }
        </ul>

        <h3 class="lp-more__title">@L["Landing.Tools.MoreTitle"]</h3>
        <ul class="lp-more">
            @foreach (var feature in Model.MoreFeatures)
            {
                <li class="lp-more__item">
                    <span class="lp-more__name">@L[feature.TitleKey]</span>
                    <span class="lp-more__text">@L[feature.DescriptionKey]</span>
                </li>
            }
        </ul>
    </section>

    @* ---------- Getting started ---------- *@
    <section class="lp-section lp-section--tinted" aria-labelledby="lp-steps-title">
        <div class="lp-section__head">
            <h2 id="lp-steps-title" class="lp-section__title">@L["Landing.Steps.Title"]</h2>
        </div>
        <ol class="lp-steps">
            <li class="lp-step">
                <h3 class="lp-step__title">@L["Landing.Steps.Account.Title"]</h3>
                <p class="lp-step__text">@L["Landing.Steps.Account.Text"]</p>
            </li>
            <li class="lp-step">
                <h3 class="lp-step__title">@L["Landing.Steps.Numbers.Title"]</h3>
                <p class="lp-step__text">@L["Landing.Steps.Numbers.Text"]</p>
            </li>
            <li class="lp-step">
                <h3 class="lp-step__title">@L["Landing.Steps.Follow.Title"]</h3>
                <p class="lp-step__text">@L["Landing.Steps.Follow.Text"]</p>
            </li>
        </ol>
    </section>

    @* ---------- Privacy ---------- *@
    <section class="lp-section" aria-labelledby="lp-privacy-title">
        <div class="lp-privacy">
            <h2 id="lp-privacy-title" class="lp-privacy__title">@L["Landing.Privacy.Title"]</h2>
            <ul class="lp-privacy__list">
                <li>@L["Landing.Privacy.OnlyYou"]</li>
                <li>@L["Landing.Privacy.Https"]</li>
                <li>@L["Landing.Privacy.Drive"]</li>
                <li>@L["Landing.Privacy.NoBankLogins"]</li>
            </ul>
        </div>
    </section>

    @* ---------- Closing call to action ---------- *@
    <section class="lp-closing" aria-labelledby="lp-closing-title">
        <h2 id="lp-closing-title" class="lp-closing__title">@L["Landing.Closing.Title"]</h2>
        <p class="lp-closing__lead">@L["Landing.Closing.Lead"]</p>
        <div class="lp-cta-row lp-cta-row--center">
            <a class="lp-btn lp-btn--light" asp-area="Identity" asp-page="/Account/Register">@L["Landing.Cta.Register"]</a>
            <a class="lp-btn lp-btn--ghost" asp-area="Identity" asp-page="/Account/Login">@L["Landing.Cta.SignIn"]</a>
        </div>
    </section>
</div>
