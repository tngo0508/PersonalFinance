@using Microsoft.AspNetCore.Html
@using PersonalFinance.Shared.DTOs.SavingsGoals
@using PersonalFinance.Shared.Enums
@using PersonalFinance.Web.Models.SavingsGoals
@{
    ViewData["Title"] = L["SavingsGoals.Title"].Value;
    var goals = ViewData["Goals"] as List<SavingsGoalDto> ?? new List<SavingsGoalDto>();
    var today = ViewData["Today"] as DateOnly? ?? DateOnly.FromDateTime(DateTime.UtcNow);
    // <input type="date"> takes ISO yyyy-MM-dd whatever the page culture; no Contribution is dated after today.
    var todayIso = today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var summary = ViewData["Summary"] as SavingsGoalsSummaryViewModel ?? SavingsGoalsSummaryViewModel.From(goals, today);
    var culture = System.Globalization.CultureInfo.CurrentCulture;
    string Money(decimal amount) => MoneyFormatter.FormatWhole(amount, SupportedCurrencies.Default.Code);
    string Month(DateOnly date) => date.ToString("Y", culture);
}

@section Styles {
    <link rel="stylesheet" href="~/css/savings-goals.css" asp-append-version="true"/>
}

<div class="savings-page">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show savings-alert" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                <path d="M20 6 9 17l-5-5"/>
            </svg>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Common.Close"]"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show savings-alert" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Common.Close"]"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    }

    <!-- Page Header -->
    <div class="savings-header mb-4">
        <div class="savings-header__content">
            <div>
                <h1 class="savings-title">
                    <span class="savings-title__icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path
                                    d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8.6 3.7 2 5"/><path
                                    d="M5 9a3 3 0 0 0 3 3 3 3 0 0 0 3-3"/><circle cx="12" cy="12" r="10"/></svg>
                    </span>
                    @L["SavingsGoals.Title"]
                </h1>
                <p class="savings-subtitle">@L["SavingsGoals.Subtitle"]</p>
            </div>
            <button type="button" class="btn btn-primary savings-add-btn" id="addGoalBtn" data-bs-toggle="modal"
                    data-bs-target="#addGoalModal">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                @L["SavingsGoals.AddGoal"]
            </button>
        </div>
    </div>

    <!-- Goals Grid -->
    @if (goals.Any())
    {
        @* Summary header: worked out by Web from the goal list (spec #395). *@
        <section class="savings-summary" aria-label="@L["SavingsGoals.Summary.Label"]">
            <div class="savings-summary__tile">
                <span class="savings-summary__label">@L["SavingsGoals.Summary.TotalSaved"]</span>
                <span class="savings-summary__value" data-summary="total-saved">@Money(summary.TotalSavedActive)</span>
            </div>
            <div class="savings-summary__tile">
                <span class="savings-summary__label">@L["SavingsGoals.Summary.SavedThisMonth"]</span>
                <span class="savings-summary__value" data-summary="saved-this-month">@Money(summary.SavedThisMonth)</span>
            </div>
            <div class="savings-summary__tile">
                <span class="savings-summary__label">@L["SavingsGoals.Summary.OnTrack"]</span>
                @if (summary.DatedCount > 0)
                {
                    <span class="savings-summary__value" data-summary="on-track">@L.Named("SavingsGoals.Summary.OnTrackValue", ("count", summary.OnTrackCount), ("total", summary.DatedCount))</span>
                }
                else
                {
                    <span class="savings-summary__note" data-summary="on-track">@L["SavingsGoals.Summary.NoDatedGoals"]</span>
                }
            </div>
            <div class="savings-summary__tile">
                <span class="savings-summary__label">@L["SavingsGoals.Summary.NextTarget"]</span>
                @if (summary.NextTargetDate is { } nextDate)
                {
                    <span class="savings-summary__value" data-summary="next-target">@nextDate.ToString("d", culture)</span>
                    <span class="savings-summary__note">@summary.NextTargetGoalName</span>
                }
                else
                {
                    <span class="savings-summary__note" data-summary="next-target">@L["SavingsGoals.Summary.NoNextTarget"]</span>
                }
            </div>
        </section>

        <div class="savings-goals-grid">
            @foreach (var goal in goals)
            {
                var progress = goal.TargetAmount > 0 ? Math.Min(100, (goal.CurrentAmount / goal.TargetAmount) * 100) : 0;
                var isComplete = goal.IsCompleted || progress >= 100;
                var remaining = Math.Max(0, goal.TargetAmount - goal.CurrentAmount);

                <div class="card savings-goal-card @(isComplete ? "savings-goal-card--completed" : "")">
                    <div class="card-body">
                        <!-- Header: Name + Delete -->
                        <div class="savings-goal-header">
                            <div class="savings-goal-header__info">
                                <div class="savings-goal-header__icon @(isComplete ? "savings-goal-header__icon--complete" : "")">
                                    @if (isComplete)
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20 6 9 17l-5-5"/>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10"/>
                                            <path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8.6 3.7 2 5"/>
                                        </svg>
                                    }
                                </div>
                                <div>
                                    <h3 class="savings-goal-name">@goal.Name</h3>
                                    @if (!string.IsNullOrEmpty(goal.Description))
                                    {
                                        <p class="savings-goal-description">@goal.Description</p>
                                    }
                                </div>
                            </div>
                            @* js/savingsgoals/savings-goals.js asks for confirmation, naming the goal. *@
                            <form asp-action="Delete" asp-controller="SavingsGoals" method="post"
                                  class="savings-goal-delete-form" data-goal-name="@goal.Name">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@goal.Id"/>
                                <button type="submit" class="savings-goal-delete-btn" title="@L["SavingsGoals.Card.DeleteTitle"]"
                                        aria-label="@L.Named("SavingsGoals.Card.DeleteAria", ("name", goal.Name))">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <polyline points="3 6 5 6 21 6"/>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                    </svg>
                                </button>
                            </form>
                        </div>

                        <!-- Amounts Display -->
                        @* The template is split on its placeholders, so each amount keeps its own span wherever the
                           translation puts it. *@
                        <div class="savings-goal-amounts">
                            @L.NamedHtml("SavingsGoals.Card.Progress", "savings-goal-separator",
                                ("current", new HtmlString($"<span class=\"savings-goal-current\">{MoneyFormatter.FormatWhole(goal.CurrentAmount, SupportedCurrencies.Default.Code)}</span>")),
                                ("target", new HtmlString($"<span class=\"savings-goal-target\">{MoneyFormatter.FormatWhole(goal.TargetAmount, SupportedCurrencies.Default.Code)}</span>")))
                        </div>

                        <!-- Progress Bar; the percentage sits beside the track so a narrow fill never clips it -->
                        <div class="savings-goal-progress">
                            <div class="savings-goal-progress-track" role="progressbar"
                                 aria-valuenow="@progress.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 aria-valuemin="0" aria-valuemax="100" aria-label="@L.Named("SavingsGoals.Card.PercentComplete", ("percent", Math.Round(progress)))">
                                <div class="savings-goal-progress-fill @(isComplete ? "savings-goal-progress-fill--complete" : "")"
                                     style="width:@progress.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            </div>
                            <span class="savings-goal-progress-label" aria-hidden="true">@Math.Round(progress)%</span>
                        </div>

                        <!-- Remaining + Metadata -->
                        <div class="savings-goal-footer-info">
                            @if (isComplete)
                            {
                                <span class="savings-goal-remaining savings-goal-remaining--complete">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                         stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                                    @L["SavingsGoals.Card.GoalReached"]
                                </span>
                            }
                            else
                            {
                                <span class="savings-goal-remaining">
                                    @L.Named("SavingsGoals.Card.Remaining", ("amount", MoneyFormatter.FormatWhole(remaining, SupportedCurrencies.Default.Code)))
                                </span>
                            }
                            @if (goal.TargetDate.HasValue)
                            {
                                <span class="savings-goal-target-date">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                         stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"
                                                                       ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line
                                                x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10"
                                                                                   y2="10"/></svg>
                                    @goal.TargetDate.Value.ToString("MMM dd, yyyy")
                                </span>
                            }
                        </div>

                        <!-- Pace: descriptive, never advice; status as text, not colour alone -->
                        @if (goal.Pace is { } pace)
                        {
                        <div class="savings-goal-pace savings-goal-pace--@pace.Status.ToString().ToLowerInvariant()"
                             data-pace-status="@pace.Status">
                            <p class="savings-goal-pace__status">
                                <span class="savings-goal-pace__label">@L[$"SavingsGoals.Pace.Status.{pace.Status}"]</span>
                                @if (pace.Status == PaceStatus.PastDue)
                                {
                                    @L.Named("SavingsGoals.Pace.Sentence.PastDue", ("amount", Money(remaining)))
                                }
                                else
                                {
                                    @L[$"SavingsGoals.Pace.Sentence.{pace.Status}"]
                                }
                            </p>
                            @if (pace.NeededPerMonth is { } needed && goal.TargetDate is { } dueDate)
                            {
                                <p class="savings-goal-pace__needed">@L.Named("SavingsGoals.Pace.NeededPerMonth", ("amount", MoneyFormatter.Format(needed, SupportedCurrencies.Default.Code)), ("month", Month(DateOnly.FromDateTime(dueDate))))</p>
                            }
                            @if (pace.Status != PaceStatus.Reached)
                            {
                                <p class="savings-goal-pace__projection">
                                    @if (pace.ProjectedFinish is { } finish)
                                    {
                                        @L.Named("SavingsGoals.Pace.Projection", ("month", Month(finish)))
                                    }
                                    else if (pace.RateState == PaceRateState.Stalled)
                                    {
                                        @L["SavingsGoals.Pace.NoRecent"]
                                    }
                                    else if (pace.RateState == PaceRateState.Unknown)
                                    {
                                        @L["SavingsGoals.Pace.NotEnoughHistory"]
                                    }
                                </p>
                            }
                            <p class="savings-goal-pace__month">@L.Named("SavingsGoals.Card.SavedThisMonth", ("amount", MoneyFormatter.Format(goal.SavedThisMonth, SupportedCurrencies.Default.Code)))</p>
                        </div>
                        }

                        @if (goal.Contributions.Count == 0 && goal.CurrentAmount == 0)
                        {
                            <p class="savings-goal-empty-prompt">@L["SavingsGoals.Card.EmptyPrompt"]</p>
                        }

                        <!-- Add Contribution: the amount is positive, the toggle gives its direction -->
                        <form asp-action="AddContribution" asp-controller="SavingsGoals" method="post"
                              class="savings-contribution-form" aria-label="@L["SavingsGoals.Contribution.Heading"]">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="goalId" value="@goal.Id"/>
                            <div class="savings-contribution-row">
                                <div class="btn-group savings-contribution-direction" role="group"
                                     aria-label="@L["SavingsGoals.Contribution.Direction"]">
                                    <input type="radio" class="btn-check" name="direction" value="deposit"
                                           id="deposit-@goal.Id" checked/>
                                    <label class="btn btn-sm btn-outline-success" for="deposit-@goal.Id">@L["SavingsGoals.Contribution.Deposit"]</label>
                                    <input type="radio" class="btn-check" name="direction" value="withdrawal"
                                           id="withdrawal-@goal.Id"/>
                                    <label class="btn btn-sm btn-outline-secondary" for="withdrawal-@goal.Id">@L["SavingsGoals.Contribution.Withdrawal"]</label>
                                </div>
                                <div class="savings-contribution-input-wrapper">
                                    <span class="savings-contribution-prefix" aria-hidden="true">$</span>
                                    <input type="text" inputmode="decimal" data-money-input data-currency="@SupportedCurrencies.Default.Code"
                                           name="amount" required
                                           class="form-control savings-contribution-input"
                                           placeholder="@L["SavingsGoals.Contribution.Amount"]"
                                           aria-label="@L.Named("SavingsGoals.Contribution.AmountAria", ("name", goal.Name))"/>
                                </div>
                                <button type="submit" class="btn savings-contribution-btn">
                                    @L["SavingsGoals.Contribution.Add"]
                                </button>
                            </div>
                            <div class="savings-contribution-row savings-contribution-row--details">
                                <label class="savings-contribution-field">
                                    <span class="form-label">@L["SavingsGoals.Contribution.Date"]</span>
                                    <input type="date" name="date" class="form-control form-control-sm" min="2000-01-01" max="@todayIso"/>
                                </label>
                                <label class="savings-contribution-field">
                                    <span class="form-label">@L["SavingsGoals.Contribution.Note"]</span>
                                    <input type="text" name="note" class="form-control form-control-sm" maxlength="200"
                                           placeholder="@L["SavingsGoals.Contribution.NotePlaceholder"]"/>
                                </label>
                            </div>
                        </form>

                        <!-- Contribution history, newest first; collapsed until opened -->
                        @if (goal.Contributions.Count > 0)
                        {
                            <details class="savings-goal-history">
                                <summary>@L.Named("SavingsGoals.History.Summary", ("count", goal.Contributions.Count))</summary>
                                <ul class="savings-history-list">
                                    @foreach (var contribution in goal.Contributions)
                                    {
                                        var amountText = MoneyFormatter.Format(Math.Abs(contribution.Amount), SupportedCurrencies.Default.Code);
                                        var signedText = (contribution.Amount < 0 ? "−" : "+") + amountText;
                                        var dateText = contribution.Date.ToString("d", System.Globalization.CultureInfo.CurrentCulture);
                                        <li class="savings-history-item" data-contribution-id="@contribution.Id">
                                            <div class="savings-history-item__main">
                                                <span class="savings-history-item__date">@dateText</span>
                                                <span class="savings-history-item__amount @(contribution.Amount < 0 ? "savings-history-item__amount--out" : "")">@signedText</span>
                                                @if (contribution.Kind == ContributionKind.Opening)
                                                {
                                                    <span class="savings-history-item__kind">@L["SavingsGoals.History.Opening"]</span>
                                                }
                                                else if (contribution.Kind == ContributionKind.Adjustment)
                                                {
                                                    <span class="savings-history-item__kind">@L["SavingsGoals.History.Adjustment"]</span>
                                                }
                                                @if (!string.IsNullOrEmpty(contribution.Note))
                                                {
                                                    <span class="savings-history-item__note">@contribution.Note</span>
                                                }
                                            </div>
                                            <div class="savings-history-item__actions">
                                                @if (contribution.Kind != ContributionKind.Adjustment)
                                                {
                                                    <details class="savings-history-edit">
                                                        <summary aria-label="@L.Named("SavingsGoals.History.EditAria", ("amount", signedText), ("date", dateText))">@L["SavingsGoals.History.Edit"]</summary>
                                                        <form asp-action="EditContribution" asp-controller="SavingsGoals" method="post"
                                                              class="savings-history-edit-form">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="goalId" value="@goal.Id"/>
                                                            <input type="hidden" name="contributionId" value="@contribution.Id"/>
                                                            <div class="btn-group savings-contribution-direction" role="group"
                                                                 aria-label="@L["SavingsGoals.Contribution.Direction"]">
                                                                <input type="radio" class="btn-check" name="direction" value="deposit"
                                                                       id="deposit-@goal.Id-@contribution.Id" checked="@(contribution.Amount > 0)"/>
                                                                <label class="btn btn-sm btn-outline-success" for="deposit-@goal.Id-@contribution.Id">@L["SavingsGoals.Contribution.Deposit"]</label>
                                                                <input type="radio" class="btn-check" name="direction" value="withdrawal"
                                                                       id="withdrawal-@goal.Id-@contribution.Id" checked="@(contribution.Amount < 0)"/>
                                                                <label class="btn btn-sm btn-outline-secondary" for="withdrawal-@goal.Id-@contribution.Id">@L["SavingsGoals.Contribution.Withdrawal"]</label>
                                                            </div>
                                                            <input type="text" inputmode="decimal" data-money-input data-currency="@SupportedCurrencies.Default.Code"
                                                                   name="amount" required class="form-control form-control-sm"
                                                                   value="@MoneyFormatter.FormatAmount(Math.Abs(contribution.Amount), SupportedCurrencies.Default.Code)"
                                                                   aria-label="@L["SavingsGoals.Contribution.Amount"]"/>
                                                            <input type="date" name="date" class="form-control form-control-sm" required
                                                                   min="2000-01-01" max="@todayIso"
                                                                   value="@contribution.Date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)"
                                                                   aria-label="@L["SavingsGoals.Contribution.Date"]"/>
                                                            <input type="text" name="note" class="form-control form-control-sm" maxlength="200"
                                                                   value="@contribution.Note" aria-label="@L["SavingsGoals.Contribution.Note"]"/>
                                                            <button type="submit" class="btn btn-sm btn-primary">@L["SavingsGoals.Contribution.Save"]</button>
                                                        </form>
                                                    </details>
                                                }
                                                @* js/savingsgoals/savings-goals.js asks for confirmation. *@
                                                <form asp-action="DeleteContribution" asp-controller="SavingsGoals" method="post"
                                                      class="savings-history-delete-form">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="goalId" value="@goal.Id"/>
                                                    <input type="hidden" name="contributionId" value="@contribution.Id"/>
                                                    <button type="submit" class="btn btn-sm btn-link savings-history-delete-btn"
                                                            aria-label="@L.Named("SavingsGoals.History.DeleteAria", ("amount", signedText), ("date", dateText))">@L["SavingsGoals.History.Delete"]</button>
                                                </form>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </details>
                        }

                        <!-- Correct balance: the difference is recorded as an Adjustment -->
                        <details class="savings-goal-correct">
                            <summary>@L["SavingsGoals.Balance.Summary"]</summary>
                            <form asp-action="CorrectBalance" asp-controller="SavingsGoals" method="post"
                                  class="savings-goal-correct-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="goalId" value="@goal.Id"/>
                                <label class="savings-contribution-field" for="balance-@goal.Id">
                                    <span class="form-label">@L.Named("SavingsGoals.Balance.Label", ("symbol", "$"))</span>
                                </label>
                                <div class="savings-contribution-row">
                                    <input type="text" inputmode="decimal" data-money-input data-currency="@SupportedCurrencies.Default.Code"
                                           name="balance" id="balance-@goal.Id" required class="form-control form-control-sm"
                                           value="@MoneyFormatter.FormatAmount(goal.CurrentAmount, SupportedCurrencies.Default.Code)"/>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">@L["SavingsGoals.Balance.Submit"]</button>
                                </div>
                                <p class="savings-goal-correct-help">@L["SavingsGoals.Balance.Help"]</p>
                            </form>
                        </details>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="savings-empty">
            <div class="savings-empty__icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8.6 3.7 2 5"/>
                    <circle cx="12" cy="12" r="10"/>
                </svg>
            </div>
            <h3 class="savings-empty__title">@L["SavingsGoals.Empty.Title"]</h3>
            <p class="savings-empty__text">@L["SavingsGoals.Empty.Text"]</p>
            <button type="button" class="btn btn-primary savings-empty__btn" data-bs-toggle="modal"
                    data-bs-target="#addGoalModal">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                @L["SavingsGoals.Empty.AddFirst"]
            </button>
        </div>
    }
</div>

<!-- Add Goal Modal -->
<div class="modal fade" id="addGoalModal" tabindex="-1" aria-labelledby="addGoalModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content savings-modal-content">
            <form asp-action="Create" asp-controller="SavingsGoals" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header savings-modal-header">
                    <div class="savings-modal-header__content">
                        <div class="savings-modal-header__icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8.6 3.7 2 5"/>
                                <path d="M5 9a3 3 0 0 0 3 3 3 3 0 0 0 3-3"/>
                                <circle cx="12" cy="12" r="10"/>
                            </svg>
                        </div>
                        <h5 class="modal-title" id="addGoalModalLabel">@L["SavingsGoals.Modal.Title"]</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
                </div>
                <div class="modal-body savings-modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="goalName" class="form-label">@L["SavingsGoals.Modal.Name"]</label>
                            <input type="text" name="name" class="form-control" id="goalName"
                                   placeholder="@L["SavingsGoals.Modal.NamePlaceholder"]" required/>
                        </div>
                        <div class="col-md-6">
                            <label for="goalTarget" class="form-label">@L.Named("SavingsGoals.Modal.TargetAmount", ("symbol", "$"))</label>
                            <input type="text" inputmode="decimal" data-money-input data-currency="@SupportedCurrencies.Default.Code"
                                   name="targetAmount" class="form-control" id="goalTarget"
                                   value="@MoneyFormatter.FormatAmount(10000m, SupportedCurrencies.Default.Code)" required/>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label for="goalCurrent" class="form-label">@L.Named("SavingsGoals.Modal.CurrentAmount", ("symbol", "$"))</label>
                            <input type="text" inputmode="decimal" data-money-input data-currency="@SupportedCurrencies.Default.Code"
                                   name="currentAmount" class="form-control" id="goalCurrent"
                                   value="@MoneyFormatter.FormatAmount(0m, SupportedCurrencies.Default.Code)"/>
                        </div>
                        <div class="col-md-6">
                            <label for="goalTargetDate" class="form-label">@L["SavingsGoals.Modal.TargetDate"]</label>
                            <input type="date" name="targetDate" class="form-control" id="goalTargetDate"/>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label for="goalDescription" class="form-label">@L["SavingsGoals.Modal.Description"]</label>
                        <textarea name="description" class="form-control" id="goalDescription" rows="2"
                                  placeholder="@L["SavingsGoals.Modal.DescriptionPlaceholder"]"></textarea>
                    </div>
                </div>
                <div class="modal-footer savings-modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Common.Cancel"]</button>
                    <button type="submit" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             class="me-1">
                            <path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8.6 3.7 2 5"/>
                            <circle cx="12" cy="12" r="10"/>
                        </svg>
                        @L["SavingsGoals.Modal.Create"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <js-strings prefix="SavingsGoals.Js." />
    <script src="~/js/savingsgoals/savings-goals.js" asp-append-version="true"></script>
}
