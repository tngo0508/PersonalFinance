@using System.Globalization
@using System.Linq.Expressions
@model BudgetViewModel

@{
    ViewData["Title"] = L["BudgetPlanner.Title"].Value;
    // The budget is one document in one currency (ADR 0016): the selector beside the income sets it for every amount.
    // Each amount input carries its bound in that currency (data-max) and in dollars (data-max-usd), which the
    // selector rescales from the option's data-bound-scale (#444).
    string budgetCurrency = SupportedCurrencies.CodeOrDefault(Model.CurrencyCode);
    string symbol = SupportedCurrencies.Find(budgetCurrency)!.Symbol;
    string maxInCurrency = MoneyBounds.MaxInvariant(BudgetPlannerLimits.MaxAmount, budgetCurrency);
    string zeroPercent = 0m.ToString("N1", CultureInfo.CurrentCulture) + "%";

    // The ten categories in ledger order. The index is the category's colour token in site.css
    // (--app-budget-category-1 to -10), which the Month Strip's segments and the rows' swatches share (#487).
    (string Name, Expression<Func<BudgetViewModel, decimal>> Amount, decimal Value)[] categories =
    {
        ("Housing", m => m.Housing, Model.Housing),
        ("Food", m => m.Food, Model.Food),
        ("Transportation", m => m.Transportation, Model.Transportation),
        ("Utilities", m => m.Utilities, Model.Utilities),
        ("Insurance", m => m.Insurance, Model.Insurance),
        ("Healthcare", m => m.Healthcare, Model.Healthcare),
        ("Savings", m => m.Savings, Model.Savings),
        ("DebtRepayment", m => m.DebtRepayment, Model.DebtRepayment),
        ("Entertainment", m => m.Entertainment, Model.Entertainment),
        ("Miscellaneous", m => m.Miscellaneous, Model.Miscellaneous)
    };
    decimal shareBasis = Math.Max(Model.MonthlyIncome, Model.TotalAllocated);

    string ShareWidth(decimal amount)
    {
        decimal percent = shareBasis <= 0 ? 0m : amount * 100m / shareBasis;
        return percent.ToString("0.##", CultureInfo.InvariantCulture);
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/budget.css" asp-append-version="true"/>
}

<div class="budget-page">
    @if (TempData["SaveSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show budget-alert" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                <path d="M20 6 9 17l-5-5"/>
            </svg>
            @TempData["SaveSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Common.Close"]"></button>
        </div>
    }

    @if (TempData["SaveWarning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show budget-alert" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            @TempData["SaveWarning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Common.Close"]"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    }

    <header class="budget-header">
        <h1 class="budget-title">@L["BudgetPlanner.Title"]</h1>
        <p class="budget-subtitle">@L["BudgetPlanner.Subtitle"]</p>
    </header>

    <form asp-action="Save" method="post" id="budgetForm">
        @Html.AntiForgeryToken()

        <!-- The month: income on the left, what is still unassigned on the right, and the Month Strip beneath both -->
        <section class="budget-hero" aria-labelledby="budgetIncomeLabel">
            <div class="budget-income">
                <label asp-for="MonthlyIncome" class="budget-income__label" id="budgetIncomeLabel"></label>
                <div class="budget-income__entry">
                    <span class="budget-income__symbol" data-budget-currency-symbol aria-hidden="true">@symbol</span>
                    <input asp-for="MonthlyIncome" type="text" inputmode="decimal" data-money-input
                           data-currency="@budgetCurrency" data-max-usd="@BudgetPlannerLimits.MaxAmount"
                           data-max="@maxInCurrency" class="form-control budget-income-input"
                           aria-describedby="incomeHelp"/>
                    <span class="budget-income__per" id="incomeHelp">@L["BudgetPlanner.Income.PerMonth"]</span>
                </div>
                <span asp-validation-for="MonthlyIncome" class="invalid-feedback"></span>
                <div class="budget-income__currency">
                    <label asp-for="CurrencyCode" class="budget-income__currency-label"></label>
                    <select asp-for="CurrencyCode" class="form-select form-select-sm" data-currency-selector
                            data-currency-targets=".budget-income-input, .budget-amount-input"
                            data-currency-symbols="[data-budget-currency-symbol]"
                            data-currency-bounds=".budget-income-input, .budget-amount-input">
                        @foreach (var currency in SupportedCurrencies.All)
                        {
                            <option value="@currency.Code" data-bound-scale="@currency.BoundScale"
                                    selected="@(currency.Code == budgetCurrency)">@currency.Code (@currency.DisplayName)</option>
                        }
                    </select>
                </div>
            </div>

            <div class="budget-remaining" id="budgetRemaining">
                <span class="budget-remaining__label">@L["BudgetPlanner.Js.RemainingLabel"]</span>
                <span class="budget-remaining__value" id="budgetRemainingValue">@MoneyFormatter.FormatWhole(0, budgetCurrency) (@zeroPercent)</span>
            </div>

            <div class="budget-strip" id="budgetStrip" role="img" aria-label="@L["BudgetPlanner.Strip.Aria"]">
                @for (int i = 0; i < categories.Length; i++)
                {
                    <span class="budget-strip__segment" data-category="@categories[i].Name"
                          style="--cat: var(--app-budget-category-@(i + 1)); width: @ShareWidth(categories[i].Value)%">
                        <span class="budget-strip__label"><span class="budget-strip__name">@L["BudgetPlanner.Category." + categories[i].Name]</span><span class="budget-strip__pct"></span></span>
                    </span>
                }
                <span class="budget-strip__segment budget-strip__segment--unallocated" id="budgetStripUnallocated"
                      style="width: @ShareWidth(Math.Max(0m, Model.RemainingAmount))%">
                    <span class="budget-strip__label"><span class="budget-strip__name">@L["BudgetPlanner.Js.Unallocated"]</span><span class="budget-strip__pct"></span></span>
                </span>
                <span class="budget-strip__overflow" id="budgetStripOverflow" hidden></span>
            </div>
        </section>

        <!-- The ledger: one row per category, closed by the total under a double rule -->
        <section class="budget-ledger" id="budgetLedger" aria-labelledby="budgetLedgerTitle">
            <div class="budget-ledger__top">
                <h2 class="budget-ledger__title" id="budgetLedgerTitle">@L["BudgetPlanner.Allocations.Title"]</h2>
                <p class="budget-ledger__hint" id="budgetNoIncomeHint" hidden>@L["BudgetPlanner.Ledger.NoIncomeHint"]</p>
            </div>

            <div class="budget-ledger__head" aria-hidden="true">
                <span></span>
                <span>@L["BudgetPlanner.Ledger.Category"]</span>
                <span class="budget-ledger__head-share">@L["BudgetPlanner.Ledger.Share"]</span>
                <span class="budget-ledger__head-num">%</span>
                <span class="budget-ledger__head-num">@L["BudgetPlanner.Ledger.Amount"]</span>
            </div>

            @for (int i = 0; i < categories.Length; i++)
            {
                string name = categories[i].Name;
                string label = L["BudgetPlanner.Category." + name].Value;
                
                <div class="budget-row" data-category="@name" style="--cat: var(--app-budget-category-@(i + 1))">
                    <span class="budget-row__swatch" aria-hidden="true"></span>
                    <label class="budget-category__label" for="@name">@label</label>
                    <div class="budget-row__share">
                        <input type="range" class="budget-slider" id="slider-@name" min="0" max="100" step="any"
                               data-category="@name" value="@Model.PercentFor(categories[i].Value).ToString(CultureInfo.InvariantCulture)"
                               aria-label="@L.Named("BudgetPlanner.Category.SliderAria", ("category", label))"/>
                    </div>
                    <div class="budget-row__percent">
                        <input type="number" class="form-control budget-percent-input" min="0" max="100" step="any"
                               data-category="@name"
                               aria-label="@L.Named("BudgetPlanner.Category.PercentAria", ("category", label))"/>
                        <span class="budget-percent-input__suffix" aria-hidden="true">%</span>
                    </div>
                    <div class="budget-row__amount">
                        <span class="budget-amount-input__prefix" data-budget-currency-symbol aria-hidden="true">@symbol</span>
                        @Html.TextBoxFor(categories[i].Amount, null, new
                        {
                            @class = "form-control budget-amount-input",
                            inputmode = "decimal",
                            data_money_input = "",
                            data_currency = budgetCurrency,
                            data_max_usd = BudgetPlannerLimits.MaxAmount,
                            data_max = maxInCurrency,
                            data_category = name,
                            aria_label = L.Named("BudgetPlanner.Category.AmountAria", ("category", label))
                        })
                        @Html.ValidationMessageFor(categories[i].Amount, null, new { @class = "invalid-feedback" })
                    </div>
                </div>
            }

            <div class="budget-total" id="budgetSummaryTotal">
                <span></span>
                <span class="budget-total__label">@L["BudgetPlanner.Breakdown.Total"]</span>
                <span></span>
                <span class="budget-total__value" id="budgetSummaryTotalPercent">@zeroPercent</span>
                <span class="budget-total__value" id="budgetSummaryTotalAmount">@MoneyFormatter.FormatWhole(0, budgetCurrency)</span>
            </div>

            <div class="budget-actions">
                <button type="submit" class="btn btn-primary budget-save-btn" id="budgetSaveBtn">@L["BudgetPlanner.Save"]</button>
            </div>
        </section>
    </form>
</div>

@section Scripts {
    <js-strings prefix="BudgetPlanner.Js." />
    <script src="~/js/budget/budget.js" asp-append-version="true"></script>
    <script>
        (function () {
            'use strict';
            window.budgetInitialData = {
                monthlyIncome: @Model.MonthlyIncome.ToString(CultureInfo.InvariantCulture),
                housing: @Model.Housing.ToString(CultureInfo.InvariantCulture),
                food: @Model.Food.ToString(CultureInfo.InvariantCulture),
                transportation: @Model.Transportation.ToString(CultureInfo.InvariantCulture),
                utilities: @Model.Utilities.ToString(CultureInfo.InvariantCulture),
                insurance: @Model.Insurance.ToString(CultureInfo.InvariantCulture),
                healthcare: @Model.Healthcare.ToString(CultureInfo.InvariantCulture),
                savings: @Model.Savings.ToString(CultureInfo.InvariantCulture),
                debtRepayment: @Model.DebtRepayment.ToString(CultureInfo.InvariantCulture),
                entertainment: @Model.Entertainment.ToString(CultureInfo.InvariantCulture),
                miscellaneous: @Model.Miscellaneous.ToString(CultureInfo.InvariantCulture)
            };
        })();
    </script>
}
