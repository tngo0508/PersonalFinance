@model BudgetViewModel

@{
    ViewData["Title"] = "Budget Planner";
}

@section Styles {
    <link rel="stylesheet" href="~/css/budget.css" asp-append-version="true"/>
}

<div class="budget-page">
    @if (TempData["SaveSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show budget-alert" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                <path d="M20 6 9 17l-5-5"/>
            </svg>
            @TempData["SaveSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <validation-summary asp-validation-summary="ModelOnly" class="alert alert-danger"/>
    }

    <!-- Page Header -->
    <div class="budget-header mb-4">
        <div class="budget-header__content">
            <div>
                <h1 class="budget-title">
                    <span class="budget-title__icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path
                                d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
                    </span>
                    Budget Planner
                </h1>
                <p class="budget-subtitle">Allocate your monthly income across spending categories. Amounts must add
                    up to your monthly income exactly.</p>
            </div>
        </div>
    </div>

    <form asp-action="Save" method="post" id="budgetForm">
        @Html.AntiForgeryToken()

        <!-- Income Hero Card -->
        <div class="card budget-income-card mb-4">
            <div class="card-body">
                <div class="budget-income-hero">
                    <div class="budget-income-hero__icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 1v22"/>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                        </svg>
                    </div>
                    <div class="budget-income-hero__content">
                        <label asp-for="MonthlyIncome" class="budget-income-hero__label"></label>
                        <div class="budget-income-hero__input-wrapper">
                            <span class="budget-income-hero__prefix">$</span>
                            <input asp-for="MonthlyIncome" type="number" step="0.01" min="0"
                                   class="form-control budget-income-input" aria-describedby="incomeHelp"/>
                            <span class="budget-income-hero__suffix" id="incomeHelp">/month</span>
                        </div>
                        <span asp-validation-for="MonthlyIncome" class="invalid-feedback"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Two-Column Layout: Categories + Chart Sidebar -->
        <div class="row g-3">
            <!-- Left Column: Category Allocations -->
            <div class="col-lg-8">
                <div class="card budget-card">
                    <div class="budget-card__header">
                        <div class="budget-card__header-left">
                            <div class="budget-card__icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <rect width="7" height="7" x="3" y="3" rx="1"/>
                                    <rect width="7" height="7" x="14" y="3" rx="1"/>
                                    <rect width="7" height="7" x="14" y="14" rx="1"/>
                                    <rect width="7" height="7" x="3" y="14" rx="1"/>
                                </svg>
                            </div>
                            <h2 class="budget-card__title">Category Allocations</h2>
                        </div>
                        <span class="budget-total-badge" id="budgetTotalBadge">
                            <span id="budgetTotalAmount">$0</span> / <span id="budgetIncomeAmount">$0</span>
                        </span>
                    </div>
                    <div class="budget-card__body">
                        <div class="budget-categories">
                            <!-- Housing -->
                            <div class="budget-category-card">
                                <div class="budget-category-card__header">
                                    <div class="budget-category-card__info">
                                        <span class="budget-category-card__icon" aria-hidden="true">
                                            <i class="bi bi-house"></i>
                                        </span>
                                        <span class="budget-category-color-box" data-color-index="0"
                                              aria-hidden="true"></span>
                                        <label class="budget-category__label" for="Housing">Housing</label>
                                    </div>
                                    <div class="budget-category__amount" data-amount-for="Housing">
                                        $<span>0</span>
                                    </div>
                                </div>
                                <div class="budget-category-card__controls">
                                    <input type="range" class="form-range budget-slider"
                                           id="slider-Housing" min="0" max="100" step="any"
                                           data-category="Housing" value="@Model.PercentFor(Model.Housing)"
                                           aria-label="Housing allocation percentage"/>
                                    <div class="budget-category__input-group">
                                        <input type="number" class="form-control budget-percent-input"
                                               min="0" max="100" step="any" data-category="Housing"
                                               aria-label="Housing percentage"/>
                                        <span class="budget-percent-input__suffix">%</span>
                                    </div>
                                    <div class="budget-category__input-group budget-amount-input-group">
                                        <span class="budget-amount-input__prefix">$</span>
                                        <input asp-for="Housing" type="number" class="form-control budget-amount-input"
                                               min="0" step="0.01" data-category="Housing"
                                               aria-label="Housing dollar amount"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Food -->
                            <div class="budget-category-card">
                                <div class="budget-category-card__header">
                                    <div class="budget-category-card__info">
                                        <span class="budget-category-card__icon" aria-hidden="true">
                                            <i class="bi bi-egg-fried"></i>
                                        </span>
                                        <span class="budget-category-color-box" data-color-index="1"
                                              aria-hidden="true"></span>
                                        <label class="budget-category__label" for="Food">Food</label>
                                    </div>
                                    <div class="budget-category__amount" data-amount-for="Food">
                                        $<span>0</span>
                                    </div>
                                </div>
                                <div class="budget-category-card__controls">
                                    <input type="range" class="form-range budget-slider"
                                           id="slider-Food" min="0" max="100" step="any"
                                           data-category="Food" value="@Model.PercentFor(Model.Food)"
                                           aria-label="Food allocation percentage"/>
                                    <div class="budget-category__input-group">
                                        <input type="number" class="form-control budget-percent-input"
                                               min="0" max="100" step="any" data-category="Food"
                                               aria-label="Food percentage"/>
                                        <span class="budget-percent-input__suffix">%</span>
                                    </div>
                                    <div class="budget-category__input-group budget-amount-input-group">
                                        <span class="budget-amount-input__prefix">$</span>
                                        <input asp-for="Food" type="number" class="form-control budget-amount-input"
                                               min="0" step="0.01" data-category="Food"
                                               aria-label="Food dollar amount"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Transportation -->
                            <div class="budget-category-card">
                                <div class="budget-category-card__header">
                                    <div class="budget-category-card__info">
                                        <span class="budget-category-card__icon" aria-hidden="true">
                                            <i class="bi bi-car-front"></i>
                                        </span>
                                        <span class="budget-category-color-box" data-color-index="2"
                                              aria-hidden="true"></span>
                                        <label class="budget-category__label"
                                               for="Transportation">Transportation</label>
                                    </div>
                                    <div class="budget-category__amount" data-amount-for="Transportation">
                                        $<span>0</span>
                                    </div>
                                </div>
                                <div class="budget-category-card__controls">
                                    <input type="range" class="form-range budget-slider"
                                           id="slider-Transportation" min="0" max="100" step="any"
                                           data-category="Transportation" value="@Model.PercentFor(Model.Transportation)"
                                           aria-label="Transportation allocation percentage"/>
                                    <div class="budget-category__input-group">
                                        <input type="number" class="form-control budget-percent-input"
                                               min="0" max="100" step="any" data-category="Transportation"
                                               aria-label="Transportation percentage"/>
                                        <span class="budget-percent-input__suffix">%</span>
                                    </div>
                                    <div class="budget-category__input-group budget-amount-input-group">
                                        <span class="budget-amount-input__prefix">$</span>
                                        <input type="number" class="form-control budget-amount-input"
                                               min="0" step="0.01" data-category="Transportation"
                                               aria-label="Transportation dollar amount"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Utilities -->
                            <div class="budget-category-card">
                                <div class="budget-category-card__header">
                                    <div class="budget-category-card__info">
                                        <span class="budget-category-card__icon" aria-hidden="true">
                                            <i class="bi bi-lightning"></i>
                                        </span>
                                        <span class="budget-category-color-box" data-color-index="3"
                                              aria-hidden="true"></span>
                                        <label class="budget-category__label" for="Utilities">Utilities</label>
                                    </div>
                                    <div class="budget-category__amount" data-amount-for="Utilities">
                                        $<span>0</span>
                                    </div>
                                </div>
                                <div class="budget-category-card__controls">
                                    <input type="range" class="form-range budget-slider"
                                           id="slider-Utilities" min="0" max="100" step="any"
                                           data-category="Utilities" value="@Model.PercentFor(Model.Utilities)"
                                           aria-label="Utilities allocation percentage"/>
                                    <div class="budget-category__input-group">
                                        <input type="number"
                                               class="form-control budget-percent-input"
                                               min="0" max="100" step="any" data-category="Utilities"
                                               aria-label="Utilities percentage"/>
                                        <span class="budget-percent-input__suffix">%</span>
                                    </div>
                                    <div class="budget-category__input-group budget-amount-input-group">
                                        <span class="budget-amount-input__prefix">$</span>
                                        <input asp-for="Utilities" type="number" class="form-control budget-amount-input"
                                               min="0" step="0.01" data-category="Utilities"
                                               aria-label="Utilities dollar amount"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Insurance -->
                            <div class="budget-category-card">
                                <div class="budget-category-card__header">
                                    <div class="budget-category-card__info">
                                        <span class="budget-category-card__icon" aria-hidden="true">
                                            <i class="bi bi-shield-check"></i>
                                        </span>
                                        <span class="budget-category-color-box" data-color-index="4"
                                              aria-hidden="true"></span>
                                        <label class="budget-category__label" for="Insurance">Insurance</label>
                                    </div>
                                    <div class="budget-category__amount" data-amount-for="Insurance">
                                        $<span>0</span>
                                    </div>
                                </div>
                                <div class="budget-category-card__controls">
                                    <input type="range" class="form-range budget-slider"
                                           id="slider-Insurance" min="0" max="100" step="any"
                                           data-category="Insurance" value="@Model.PercentFor(Model.Insurance)"
                                           aria-label="Insurance allocation percentage"/>
                                    <div class="budget-category__input-group">
                                        <input type="number"
                                               class="form-control budget-percent-input"
                                               min="0" max="100" step="any" data-category="Insurance"
                                               aria-label="Insurance percentage"/>
                                        <span class="budget-percent-input__suffix">%</span>
                                    </div>
                                    <div class="budget-category__input-group budget-amount-input-group">
                                        <span class="budget-amount-input__prefix">$</span>
                                        <input asp-for="Insurance" type="number" class="form-control budget-amount-input"
                                               min="0" step="0.01" data-category="Insurance"
                                               aria-label="Insurance dollar amount"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Healthcare -->
                            <div class="budget-category-card">
                                <div class="budget-category-card__header">
                                    <div class="budget-category-card__info">
                                        <span class="budget-category-card__icon" aria-hidden="true">
                                            <i class="bi bi-heart-pulse"></i>
                                        </span>
                                        <span class="budget-category-color-box" data-color-index="5"
                                              aria-hidden="true"></span>
                                        <label class="budget-category__label" for="Healthcare">Healthcare</label>
                                    </div>
                                    <div class="budget-category__amount" data-amount-for="Healthcare">
                                        $<span>0</span>
                                    </div>
                                </div>
                                <div class="budget-category-card__controls">
                                    <input type="range" class="form-range budget-slider"
                                           id="slider-Healthcare" min="0" max="100" step="any"
                                           data-category="Healthcare" value="@Model.PercentFor(Model.Healthcare)"
                                           aria-label="Healthcare allocation percentage"/>
                                    <div class="budget-category__input-group">
                                        <input type="number"
                                               class="form-control budget-percent-input"
                                               min="0" max="100" step="any" data-category="Healthcare"
                                               aria-label="Healthcare percentage"/>
                                        <span class="budget-percent-input__suffix">%</span>
                                    </div>
                                    <div class="budget-category__input-group budget-amount-input-group">
                                        <span class="budget-amount-input__prefix">$</span>
                                        <input asp-for="Healthcare" type="number" class="form-control budget-amount-input"
                                               min="0" step="0.01" data-category="Healthcare"
                                               aria-label="Healthcare dollar amount"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Savings -->
                            <div class="budget-category-card">
                                <div class="budget-category-card__header">
                                    <div class="budget-category-card__info">
                                        <span class="budget-category-card__icon" aria-hidden="true">
                                            <i class="bi bi-piggy-bank"></i>
                                        </span>
                                        <span class="budget-category-color-box" data-color-index="6"
                                              aria-hidden="true"></span>
                                        <label class="budget-category__label" for="Savings">Savings</label>
                                    </div>
                                    <div class="budget-category__amount" data-amount-for="Savings">
                                        $<span>0</span>
                                    </div>
                                </div>
                                <div class="budget-category-card__controls">
                                    <input type="range" class="form-range budget-slider"
                                           id="slider-Savings" min="0" max="100" step="any"
                                           data-category="Savings" value="@Model.PercentFor(Model.Savings)"
                                           aria-label="Savings allocation percentage"/>
                                    <div class="budget-category__input-group">
                                        <input type="number" class="form-control budget-percent-input"
                                               min="0" max="100" step="any" data-category="Savings"
                                               aria-label="Savings percentage"/>
                                        <span class="budget-percent-input__suffix">%</span>
                                    </div>
                                    <div class="budget-category__input-group budget-amount-input-group">
                                        <span class="budget-amount-input__prefix">$</span>
                                        <input asp-for="Savings" type="number" class="form-control budget-amount-input"
                                               min="0" step="0.01" data-category="Savings"
                                               aria-label="Savings dollar amount"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Debt Repayment -->
                            <div class="budget-category-card">
                                <div class="budget-category-card__header">
                                    <div class="budget-category-card__info">
                                        <span class="budget-category-card__icon" aria-hidden="true">
                                            <i class="bi bi-credit-card"></i>
                                        </span>
                                        <span class="budget-category-color-box" data-color-index="7"
                                              aria-hidden="true"></span>
                                        <label class="budget-category__label" for="DebtRepayment">Debt Repayment</label>
                                    </div>
                                    <div class="budget-category__amount" data-amount-for="DebtRepayment">
                                        $<span>0</span>
                                    </div>
                                </div>
                                <div class="budget-category-card__controls">
                                    <input type="range" class="form-range budget-slider"
                                           id="slider-DebtRepayment" min="0" max="100" step="any"
                                           data-category="DebtRepayment" value="@Model.PercentFor(Model.DebtRepayment)"
                                           aria-label="Debt Repayment allocation percentage"/>
                                    <div class="budget-category__input-group">
                                        <input type="number"
                                               class="form-control budget-percent-input"
                                               min="0" max="100" step="any" data-category="DebtRepayment"
                                               aria-label="Debt Repayment percentage"/>
                                        <span class="budget-percent-input__suffix">%</span>
                                    </div>
                                    <div class="budget-category__input-group budget-amount-input-group">
                                        <span class="budget-amount-input__prefix">$</span>
                                        <input asp-for="DebtRepayment" type="number" class="form-control budget-amount-input"
                                               min="0" step="0.01" data-category="DebtRepayment"
                                               aria-label="Debt Repayment dollar amount"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Entertainment -->
                            <div class="budget-category-card">
                                <div class="budget-category-card__header">
                                    <div class="budget-category-card__info">
                                        <span class="budget-category-card__icon" aria-hidden="true">
                                            <i class="bi bi-controller"></i>
                                        </span>
                                        <span class="budget-category-color-box" data-color-index="8"
                                              aria-hidden="true"></span>
                                        <label class="budget-category__label" for="Entertainment">Entertainment</label>
                                    </div>
                                    <div class="budget-category__amount" data-amount-for="Entertainment">
                                        $<span>0</span>
                                    </div>
                                </div>
                                <div class="budget-category-card__controls">
                                    <input type="range" class="form-range budget-slider"
                                           id="slider-Entertainment" min="0" max="100" step="any"
                                           data-category="Entertainment" value="@Model.PercentFor(Model.Entertainment)"
                                           aria-label="Entertainment allocation percentage"/>
                                    <div class="budget-category__input-group">
                                        <input type="number"
                                               class="form-control budget-percent-input"
                                               min="0" max="100" step="any" data-category="Entertainment"
                                               aria-label="Entertainment percentage"/>
                                        <span class="budget-percent-input__suffix">%</span>
                                    </div>
                                    <div class="budget-category__input-group budget-amount-input-group">
                                        <span class="budget-amount-input__prefix">$</span>
                                        <input asp-for="Entertainment" type="number" class="form-control budget-amount-input"
                                               min="0" step="0.01" data-category="Entertainment"
                                               aria-label="Entertainment dollar amount"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Miscellaneous -->
                            <div class="budget-category-card">
                                <div class="budget-category-card__header">
                                    <div class="budget-category-card__info">
                                        <span class="budget-category-card__icon" aria-hidden="true">
                                            <i class="bi bi-three-dots"></i>
                                        </span>
                                        <span class="budget-category-color-box" data-color-index="9"
                                              aria-hidden="true"></span>
                                        <label class="budget-category__label" for="Miscellaneous">Miscellaneous</label>
                                    </div>
                                    <div class="budget-category__amount" data-amount-for="Miscellaneous">
                                        $<span>0</span>
                                    </div>
                                </div>
                                <div class="budget-category-card__controls">
                                    <input type="range" class="form-range budget-slider"
                                           id="slider-Miscellaneous" min="0" max="100" step="any"
                                           data-category="Miscellaneous" value="@Model.PercentFor(Model.Miscellaneous)"
                                           aria-label="Miscellaneous allocation percentage"/>
                                    <div class="budget-category__input-group">
                                        <input type="number"
                                               class="form-control budget-percent-input"
                                               min="0" max="100" step="any" data-category="Miscellaneous"
                                               aria-label="Miscellaneous percentage"/>
                                        <span class="budget-percent-input__suffix">%</span>
                                    </div>
                                    <div class="budget-category__input-group budget-amount-input-group">
                                        <span class="budget-amount-input__prefix">$</span>
                                        <input asp-for="Miscellaneous" type="number" class="form-control budget-amount-input"
                                               min="0" step="0.01" data-category="Miscellaneous"
                                               aria-label="Miscellaneous dollar amount"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Remaining Allocation Indicator -->
                        <div class="budget-remaining" id="budgetRemaining">
                            <span class="budget-remaining__label">Remaining to allocate:</span>
                            <span class="budget-remaining__value" id="budgetRemainingValue">$0 (0%)</span>
                        </div>
                    </div>
                    <div class="budget-card__footer">
                        <button type="submit" class="btn btn-primary budget-save-btn" id="budgetSaveBtn">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" class="me-2">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                                <polyline points="17 21 17 13 7 13 7 21"/>
                                <polyline points="7 3 7 8 15 8"/>
                            </svg>
                            Save Budget
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right Column: Chart and Summary Sidebar -->
            <div class="col-lg-4">
                <div class="card budget-card budget-card--sticky">
                    <div class="budget-card__header">
                        <div class="budget-card__header-left">
                            <div class="budget-card__icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M21.21 15.89A10 10 0 1 1 8 2.83"/>
                                    <path d="M22 12A10 10 0 0 0 12 2v10z"/>
                                </svg>
                            </div>
                            <h2 class="budget-card__title">Budget Breakdown</h2>
                        </div>
                    </div>
                    <div class="budget-card__body">
                        <div class="budget-chart-container">
                            <canvas id="budgetPieChart" aria-label="Budget allocation pie chart" role="img"></canvas>
                        </div>
                        <div class="budget-summary-list-container">
                            <div class="budget-summary-list" id="budgetSummaryList">
                                <!-- Populated by JS -->
                            </div>
                            <div class="budget-summary-total" id="budgetSummaryTotal">
                                <div class="budget-summary-total__label">Total</div>
                                <div class="budget-summary-total__values">
                                    <span id="budgetSummaryTotalPercent">0%</span>
                                    <span id="budgetSummaryTotalAmount">$0.00</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/budget/budget.js" asp-append-version="true"></script>
    <script>
        (function () {
            'use strict';
            window.budgetInitialData = {
                monthlyIncome: @Model.MonthlyIncome.ToString(System.Globalization.CultureInfo.InvariantCulture),
                housing: @Model.Housing.ToString(System.Globalization.CultureInfo.InvariantCulture),
                food: @Model.Food.ToString(System.Globalization.CultureInfo.InvariantCulture),
                transportation: @Model.Transportation.ToString(System.Globalization.CultureInfo.InvariantCulture),
                utilities: @Model.Utilities.ToString(System.Globalization.CultureInfo.InvariantCulture),
                insurance: @Model.Insurance.ToString(System.Globalization.CultureInfo.InvariantCulture),
                healthcare: @Model.Healthcare.ToString(System.Globalization.CultureInfo.InvariantCulture),
                savings: @Model.Savings.ToString(System.Globalization.CultureInfo.InvariantCulture),
                debtRepayment: @Model.DebtRepayment.ToString(System.Globalization.CultureInfo.InvariantCulture),
                entertainment: @Model.Entertainment.ToString(System.Globalization.CultureInfo.InvariantCulture),
                miscellaneous: @Model.Miscellaneous.ToString(System.Globalization.CultureInfo.InvariantCulture)
            };
        })();
    </script>
}
