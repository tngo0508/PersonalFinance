@using System.Globalization
@using Microsoft.AspNetCore.Html
@using PersonalFinance.Shared.Constants
@using PersonalFinance.Shared.Enums
@using PersonalFinance.Web.Controllers
@model FeedbackViewModel
@{
    ViewData["Title"] = L["Feedback.Title"].Value;
    // Links and code sit inside sentences; NamedHtml puts them wherever the translation places the placeholder.
    Func<object?, IHtmlContent> pageCode = @<code>@item</code>;
    Func<object?, IHtmlContent> contactLink = @<a asp-controller="Legal" asp-action="Contact">@L["Feedback.ContactLink"]</a>;
}

<div class="py-3">
    <header class="mb-4">
        <h1 class="h3 mb-1">@L["Feedback.Title"]</h1>
        <p class="text-muted mb-0">
            @L.NamedHtml("Feedback.Intro", null, ("contactLink", contactLink(null)))
        </p>
    </header>

    @if (TempData[FeedbackController.SentKey] is string sentMessage)
    {
        <div class="alert alert-success" role="status">@sentMessage</div>
    }

    <div class="card col-lg-8 px-0">
        <div class="card-body">
            <form asp-action="Send" method="post" novalidate>
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                }
                <input type="hidden" asp-for="PageUrl" />

                <fieldset class="mb-3">
                    <legend class="form-label fs-6">@L["Feedback.Form.Category"]</legend>
                    @foreach (var category in Enum.GetValues<FeedbackCategory>())
                    {
                        var id = $"category-{category}";
                        var label = category switch
                        {
                            FeedbackCategory.Bug => L["Feedback.Category.Bug"].Value,
                            FeedbackCategory.Idea => L["Feedback.Category.Idea"].Value,
                            FeedbackCategory.Other => L["Feedback.Category.Other"].Value,
                            _ => category.ToString()
                        };
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="Category" id="@id" value="@category" />
                            <label class="form-check-label" for="@id">@label</label>
                        </div>
                    }
                    <span asp-validation-for="Category" class="text-danger d-block"></span>
                </fieldset>

                <div class="mb-3">
                    <label asp-for="Message" class="form-label"></label>
                    <textarea asp-for="Message" class="form-control" rows="6" maxlength="@FeedbackLimits.MessageMaxLength"
                              aria-describedby="messageHelp"></textarea>
                    <div id="messageHelp" class="form-text">@L.Named("Feedback.Form.MessageHelp", ("max", FeedbackLimits.MessageMaxLength.ToString("N0", CultureInfo.CurrentCulture)))</div>
                    <span asp-validation-for="Message" class="text-danger"></span>
                </div>

                @if (!string.IsNullOrEmpty(Model.PageUrl))
                {
                    <p class="small text-muted">@L.NamedHtml("Feedback.Form.SentFrom", null, ("page", pageCode(Model.PageUrl)))</p>
                }

                <button type="submit" class="btn btn-primary">@L["Feedback.Form.Submit"]</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
