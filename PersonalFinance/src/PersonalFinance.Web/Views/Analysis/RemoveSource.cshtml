@model RemoveSourceViewModel

@{
    ViewData["Title"] = $"Remove {Model.SourceName} data";
}

<div class="analysis-page">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h1 class="h4 fw-bold mb-3">Remove your @Model.SourceName data?</h1>

                    <p>This permanently removes from this app:</p>
                    <ul>
                        <li><strong>@Model.MonthCount</strong> month(s) of budget data</li>
                        <li><strong>@Model.TransactionCount</strong> transaction(s)</li>
                        @if (Model.RequiresTypedConfirmation)
                        {
                            <li>your categories, which return to the defaults</li>
                        }
                    </ul>

                    @if (Model.RequiresTypedConfirmation)
                    {
                        <p class="text-danger fw-semibold">
                            These entries exist only in this app. They cannot be recovered.
                        </p>
                    }
                    else
                    {
                        <p class="text-muted">
                            Your spreadsheet and your Google Drive connection are not touched, so you can sync again
                            anytime.
                        </p>
                    }

                    <p class="text-muted small">
                        Analysis, the Dashboard and search then show your other data source, if it has data.
                    </p>

                    <form asp-action="RemoveSource" method="post">
                        <input type="hidden" asp-for="Source"/>
                        @if (Model.RequiresTypedConfirmation)
                        {
                            <div class="mb-3">
                                <label asp-for="Confirmation" class="form-label">
                                    Type <strong>@RemoveSourceViewModel.ConfirmationWord</strong> to confirm
                                </label>
                                <input asp-for="Confirmation" class="form-control" autocomplete="off"
                                       aria-describedby="confirmationError"/>
                                <span asp-validation-for="Confirmation" id="confirmationError"
                                      class="text-danger small"></span>
                            </div>
                        }

                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Index" class="btn btn-light border">Cancel</a>
                            <button type="submit" class="btn btn-danger fw-semibold">
                                Remove @Model.SourceName data
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
