@using Microsoft.AspNetCore.Html
@using System.Text.Encodings.Web
@model RemoveSourceViewModel

@{
    var sourceName = AnalysisText.SourceName(L, Model.Source);
    ViewData["Title"] = L.Named("Analysis.RemoveSource.PageTitle", ("source", sourceName));
    IHtmlContent Strong(object value) =>
        new HtmlString($"<strong>{HtmlEncoder.Default.Encode(Convert.ToString(value, System.Globalization.CultureInfo.CurrentCulture) ?? string.Empty)}</strong>");
}

<div class="analysis-page">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h1 class="h4 fw-bold mb-3">@L.Named("Analysis.RemoveSource.Heading", ("source", sourceName))</h1>

                    <p>@L["Analysis.RemoveSource.Intro"]</p>
                    <ul>
                        <li>@L.NamedHtml("Analysis.RemoveSource.Months", null, ("count", Strong(Model.MonthCount)))</li>
                        <li>@L.NamedHtml("Analysis.RemoveSource.Transactions", null, ("count", Strong(Model.TransactionCount)))</li>
                        @if (Model.RequiresTypedConfirmation)
                        {
                            <li>@L["Analysis.RemoveSource.Categories"]</li>
                        }
                    </ul>

                    @if (Model.RequiresTypedConfirmation)
                    {
                        <p class="text-danger fw-semibold">
                            @L["Analysis.RemoveSource.Unrecoverable"]
                        </p>
                    }
                    else
                    {
                        <p class="text-muted">
                            @L["Analysis.RemoveSource.SheetUntouched"]
                        </p>
                    }

                    <p class="text-muted small">
                        @L["Analysis.RemoveSource.OtherSource"]
                    </p>

                    <form asp-action="RemoveSource" method="post">
                        <input type="hidden" asp-for="Source"/>
                        @if (Model.RequiresTypedConfirmation)
                        {
                            <div class="mb-3">
                                <label asp-for="Confirmation" class="form-label">
                                    @L.NamedHtml("Analysis.RemoveSource.TypeToConfirm", null,
                                        ("word", Strong(RemoveSourceViewModel.ConfirmationWord)))
                                </label>
                                <input asp-for="Confirmation" class="form-control" autocomplete="off"
                                       aria-describedby="confirmationError"/>
                                <span asp-validation-for="Confirmation" id="confirmationError"
                                      class="text-danger small"></span>
                            </div>
                        }

                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Index" class="btn btn-light border">@L["Common.Cancel"]</a>
                            <button type="submit" class="btn btn-danger fw-semibold">
                                @L.Named("Analysis.RemoveSource.Submit", ("source", sourceName))
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
