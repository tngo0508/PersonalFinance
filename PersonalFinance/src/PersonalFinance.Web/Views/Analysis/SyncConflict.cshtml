@using Microsoft.AspNetCore.Html
@using System.Text.Encodings.Web
@model SyncConfirmationViewModel

@{
    ViewData["Title"] = L["Analysis.SyncConflict.Title"].Value;
    var fileName = new HtmlString($"<strong>{HtmlEncoder.Default.Encode(Model.FileName)}</strong>");
}

<div class="modal fade show" id="syncConflictModal" tabindex="-1" style="display: block; background: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold">@L["Analysis.SyncConflict.Heading"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">
                    @L.NamedHtml("Analysis.SyncConflict.Intro", null, ("fileName", fileName))
                </p>
                <ul class="list-group mb-3">
                    @foreach (var conflict in Model.Conflicts)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@AnalysisText.MonthYear(conflict.Year, conflict.MonthNumber)</span>
                            <small class="text-muted">@L.Named("Analysis.SyncConflict.SyncedOn", ("date", conflict.SyncedAtUtc.ToString("d")))</small>
                        </li>
                    }
                </ul>
                <p class="small text-muted mb-0">
                    @L["Analysis.SyncConflict.Replace"]
                </p>
            </div>
            <div class="modal-footer border-top">
                <a asp-controller="Analysis" asp-action="Index" class="btn btn-light border">@L["Common.Cancel"]</a>
                <form asp-action="ConfirmOverwrite" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="connectionId" value="@Model.ConnectionId"/>
                    <input type="hidden" name="fileId" value="@Model.FileId"/>
                    <input type="hidden" name="fileName" value="@Model.FileName"/>
                    <button type="submit" class="btn btn-warning fw-semibold">@L["Analysis.SyncConflict.Confirm"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var modal = new bootstrap.Modal(document.getElementById('syncConflictModal'));
        modal.show();
    });
</script>
