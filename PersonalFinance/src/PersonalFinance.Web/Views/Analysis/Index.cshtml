@using System.Text.Json
@using PersonalFinance.Shared.Enums
@model AnalysisDashboardViewModel

@{
    ViewData["Title"] = "Analysis";
}

<div class="analysis-page">
    <!-- Page header -->
    <header class="analysis-page-header mb-4">
        <div class="analysis-page-header__content d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="analysis-page-header__text">
                <h1 class="analysis-page-header__title">
                    <span class="analysis-page-header__icon" aria-hidden="true">
                        <svg width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                            <path
                                d="M4 11H2v3h2v-3zm5-4H7v7h2V7zm5-5h-2v12h2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1h-2zM7 6a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H7zm-5 4a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1H2z"/>
                        </svg>
                    </span>
                    Spreadsheet Analysis
                </h1>
                <p class="analysis-page-header__subtitle">Analyze your budget data, track spending trends, and
                    understand your financial patterns.</p>
            </div>
            <div class="analysis-page-header__controls">
                <partial name="_DataSourceToggle" model="Model.ActiveSource"/>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.AvailableYears.Any() || Model.SelectedYear > 0)
    {
        <!-- Period selector -->
        <div class="analysis-period-selector mb-4">
            <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center gap-2">
                <label for="yearSelect" class="visually-hidden">Select year</label>
                <select name="year" id="yearSelect" class="form-select form-select-sm w-auto"
                        onchange="this.form.submit()">
                    @if (Model.SelectedYear > 0 && !Model.AvailableYears.Contains(Model.SelectedYear))
                    {
                        <option value="@Model.SelectedYear" selected="selected">@Model.SelectedYear</option>
                    }
                    @foreach (var year in Model.AvailableYears)
                    {
                        <option value="@year"
                                selected="@(year == Model.SelectedYear ? "selected" : null)">@year</option>
                    }
                </select>

                @if (Model.AvailableMonths.Count > 1 || (Model.SelectedMonth.HasValue && !Model.AvailableMonths.Contains(Model.SelectedMonth.Value)))
                {
                    <label for="monthSelect" class="visually-hidden">Select month</label>
                    <select name="month" id="monthSelect" class="form-select form-select-sm w-auto"
                            onchange="this.form.submit()">
                        <option value="">All months</option>
                        @if (Model.SelectedMonth.HasValue && !Model.AvailableMonths.Contains(Model.SelectedMonth.Value))
                        {
                            var selectedMonthName = Model.SelectedMonth.Value switch
                            {
                                    1 => "January", 2 => "February", 3 => "March", 4 => "April",
                                    5 => "May", 6 => "June", 7 => "July", 8 => "August",
                                    9 => "September", 10 => "October", 11 => "November", 12 => "December",
                                    _ => ""
                            };
                            <option value="@Model.SelectedMonth.Value" selected="selected">@selectedMonthName</option>
                        }
                        @foreach (var month in Model.AvailableMonths)
                        {
                            var monthName = month switch
                            {
                                1 => "January", 2 => "February", 3 => "March", 4 => "April",
                                5 => "May", 6 => "June", 7 => "July", 8 => "August",
                                9 => "September", 10 => "October", 11 => "November", 12 => "December",
                                _ => ""
                            };
                            <option value="@month"
                                    selected="@(Model.SelectedMonth == month ? "selected" : null)">@monthName</option>
                        }
                    </select>
                }
            </form>
        </div>
    }

    @if (!Model.HasData)
    {
        <!-- Empty state -->
        <div class="analysis-empty-state text-center py-5">
            <div class="analysis-empty-state__icon mb-3" aria-hidden="true">
                <svg width="64" height="64" fill="#adb5bd" viewBox="0 0 16 16">
                    <path
                            d="M4 11H2v3h2v-3zm5-4H7v7h2V7zm5-5h-2v12h2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1h-2zM7 6a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H7zm-5 4a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1H2z"/>
                </svg>
            </div>
            <h2 class="analysis-empty-state__title">No data found
                for @(Model.ActiveSource == BudgetDataSource.GoogleSheet ? "Google Sheet" : "Budget Tracker")</h2>
            @if (Model.ActiveSource == BudgetDataSource.GoogleSheet)
            {
                <p class="analysis-empty-state__text mb-4">
                    There is no synced Google Sheet budget data for @Model.PeriodLabel.
                    Sync your Google Drive spreadsheets or switch to Budget Tracker to view your financial analysis.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="GoogleDrive" asp-action="Index" class="btn btn-primary px-4">
                        Go to Google Drive
                    </a>
                    <a asp-controller="BudgetTracker" asp-action="Index" class="btn btn-outline-secondary px-4">
                        Open Budget Tracker
                    </a>
                </div>
            }
            else
            {
                <p class="analysis-empty-state__text mb-4">
                    There are no Budget Tracker entries for @Model.PeriodLabel.
                    Add your monthly budget and transactions in the Budget Tracker or switch to Google Sheet.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="BudgetTracker" asp-action="Index" class="btn btn-primary px-4">
                        Open Budget Tracker
                    </a>
                    <a asp-controller="GoogleDrive" asp-action="Index" class="btn btn-outline-secondary px-4">
                        Go to Google Drive
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Summary cards -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="analysis-card analysis-card--income h-100">
                    <div class="analysis-card__label">Income</div>
                    <div class="analysis-card__value">$@Model.TotalIncome.ToString("N0")</div>
                    <div class="analysis-card__sub">Total
                        for @(Model.MonthName)@(Model.SelectedMonth.HasValue ? "" : $" {Model.SelectedYear}")</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="analysis-card analysis-card--expenses h-100">
                    <div class="analysis-card__label">Expenses</div>
                    <div class="analysis-card__value">$@Model.TotalExpenses.ToString("N0")</div>
                    <div class="analysis-card__sub">Total
                        for @(Model.MonthName)@(Model.SelectedMonth.HasValue ? "" : $" {Model.SelectedYear}")</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="analysis-card analysis-card--savings h-100">
                    <div class="analysis-card__label">Net Savings</div>
                    <div class="analysis-card__value" style="color: @(Model.NetSavings >= 0 ? "#198754" : "#dc3545")">
                        $@Model.NetSavings.ToString("N0")</div>
                    <div class="analysis-card__sub">Income minus expenses</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="analysis-card analysis-card--rate h-100">
                    <div class="analysis-card__label">Savings Rate</div>
                    <div class="analysis-card__value">@Model.SavingsRate.ToString("F1")%</div>
                    <div class="analysis-card__sub">Of total income</div>
                </div>
            </div>
        </div>

        <!-- Spending Velocity section -->
        @if (Model.DailyBurnRate > 0)
        {
            <div class="analysis-section mb-4">
                <div class="analysis-section__header">
                    <h2 class="analysis-section__title">Spending Velocity</h2>
                    <span
                        class="analysis-section__badge @(Model.VelocityStatus == "On Track" ? "bg-success" : Model.VelocityStatus == "Over Budget" ? "bg-danger" : "bg-warning")">
                        @Model.VelocityStatus
                    </span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <div class="analysis-velocity-card">
                            <div class="analysis-velocity-card__label">Daily Burn Rate</div>
                            <div class="analysis-velocity-card__value">$@Model.DailyBurnRate.ToString("N2")</div>
                            <div class="analysis-velocity-card__sub">Average daily spending</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="analysis-velocity-card">
                            <div class="analysis-velocity-card__label">Projected Monthly</div>
                            <div class="analysis-velocity-card__value">
                                $@Model.ProjectedMonthlySpend.ToString("N0")</div>
                            <div class="analysis-velocity-card__sub">At current rate</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="analysis-velocity-card">
                            <div class="analysis-velocity-card__label">Budget</div>
                            <div class="analysis-velocity-card__value">$@Model.BudgetedExpenses.ToString("N0")</div>
                            <div class="analysis-velocity-card__sub">Planned spending</div>
                        </div>
                    </div>
                </div>

                <!-- Budget consumption bar -->
                <div class="analysis-progress-bar mb-3">
                    <div class="analysis-progress-bar__labels">
                        <span>Budget Used: @Model.BudgetConsumptionPercent.ToString("F1")%</span>
                        <span>Time Elapsed: @Model.TimeElapsedPercent.ToString("F1")%</span>
                    </div>
                    <div class="analysis-progress-bar__track">
                        <div class="analysis-progress-bar__fill analysis-progress-bar__fill--budget"
                             style="width: @(Math.Min(Model.BudgetConsumptionPercent, 100))%"
                             title="Budget consumption: @Model.BudgetConsumptionPercent.ToString("F1")%"></div>
                        <div class="analysis-progress-bar__marker"
                             style="left: @(Math.Min(Model.TimeElapsedPercent, 100))%"
                             title="Time elapsed: @Model.TimeElapsedPercent.ToString("F1")%"></div>
                    </div>
                </div>

                <!-- Weekly trend chart -->
                @if (Model.WeeklyTrend.Any())
                {
                    <div class="analysis-chart-card">
                        <h3 class="analysis-chart-card__title">Weekly Spending Trend</h3>
                        <div class="analysis-chart-card__canvas">
                            <canvas id="weeklyTrendChart" height="200"></canvas>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Trend chart -->
        @if (Model.TrendPoints.Count > 1)
        {
            <div class="analysis-section mb-4">
                <h2 class="analysis-section__title">Monthly Trends</h2>
                <div class="analysis-chart-card">
                    <div class="analysis-chart-card__canvas">
                        <canvas id="trendChart" height="250"></canvas>
                    </div>
                </div>
            </div>
        }

        <!-- Category insights -->
        @if (Model.Categories.Any())
        {
            <div class="analysis-section mb-4">
                <h2 class="analysis-section__title">Spending by Category</h2>
                <div class="row g-3">
                    <div class="col-lg-6">
                        <div class="analysis-chart-card">
                            <div class="analysis-chart-card__canvas">
                                <canvas id="categoryPieChart" height="300"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="analysis-chart-card">
                            <div class="analysis-chart-card__canvas">
                                <canvas id="categoryBarChart" height="300"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Category table -->
                <div class="table-responsive mt-3">
                    <table class="table table-hover align-middle analysis-table">
                        <thead>
                        <tr>
                            <th scope="col">Category</th>
                            <th scope="col" class="text-end">Budgeted</th>
                            <th scope="col" class="text-end">Actual</th>
                            <th scope="col" class="text-end">Variance</th>
                            <th scope="col" class="text-end">% Used</th>
                            <th scope="col" class="text-end">Status</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var category in Model.Categories)
                        {
                            <tr>
                                <td class="fw-semibold">@category.CategoryName</td>
                                <td class="text-end">$@category.BudgetedAmount.ToString("N0")</td>
                                <td class="text-end">$@category.ActualAmount.ToString("N0")</td>
                                <td class="text-end" style="color: @(category.Variance >= 0 ? "#198754" : "#dc3545")">
                                    @(category.Variance >= 0 ? "+" : "")$@category.Variance.ToString("N0")
                                </td>
                                <td class="text-end">@category.PercentageUsed.ToString("F1")%</td>
                                <td class="text-end">
                                        <span
                                            class="badge @(category.Status == "Within Budget" ? "bg-success" : category.Status == "Near Limit" ? "bg-warning" : "bg-danger")">
                                            @category.Status
                                        </span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Variance rankings -->
        @if (Model.VarianceRankings.Any())
        {
            <div class="analysis-section mb-4">
                <h2 class="analysis-section__title">Budget Variance Rankings</h2>
                <p class="text-muted small mb-3">Categories ranked by how much they deviated from budget (most overspent
                    first).</p>
                <div class="table-responsive">
                    <table class="table table-hover align-middle analysis-table">
                        <thead>
                        <tr>
                            <th scope="col" style="width: 60px;">#</th>
                            <th scope="col">Category</th>
                            <th scope="col" class="text-end">Budgeted</th>
                            <th scope="col" class="text-end">Actual</th>
                            <th scope="col" class="text-end">Variance</th>
                            <th scope="col" class="text-end">Status</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var ranking in Model.VarianceRankings)
                        {
                            <tr>
                                <td>@ranking.Rank</td>
                                <td class="fw-semibold">@ranking.CategoryName</td>
                                <td class="text-end">$@ranking.BudgetedAmount.ToString("N0")</td>
                                <td class="text-end">$@ranking.ActualAmount.ToString("N0")</td>
                                <td class="text-end" style="color: @(ranking.Variance >= 0 ? "#198754" : "#dc3545")">
                                    @(ranking.Variance >= 0 ? "+" : "")$@ranking.Variance.ToString("N0")
                                </td>
                                <td class="text-end">
                                        <span
                                            class="badge @(ranking.Status == "Under Budget" ? "bg-success" : "bg-danger")">
                                            @ranking.Status
                                        </span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@section Styles {
    <style>
        /* Fix dropdown arrow overlap: restore Bootstrap's default right padding for form-select */
        .analysis-period-selector .form-select {
            padding-right: 2.25rem;
        }

        /* Chart container needs explicit height for maintainAspectRatio: false */
        .analysis-chart-card__canvas {
            position: relative;
            height: 300px;
        }

        /* Canvas fills the container */
        .analysis-chart-card__canvas canvas {
            width: 100%;
        }

        .analysis-page-header {
            border-bottom: 1px solid #e9ecef;
            padding-bottom: 1rem;
        }

        .analysis-page-header__title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .analysis-page-header__icon {
            color: #0d6efd;
        }

        .analysis-page-header__subtitle {
            color: #6c757d;
            margin: 0.25rem 0 0;
        }

        .analysis-card {
            background: #fff;
            border: 1px solid #e9ecef;
            border-radius: 0.5rem;
            padding: 1rem;
        }

        .analysis-card__label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6c757d;
            font-weight: 600;
        }

        .analysis-card__value {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0.25rem 0;
        }

        .analysis-card__sub {
            font-size: 0.8rem;
            color: #6c757d;
        }

        .analysis-section__title {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .analysis-section__header {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .analysis-section__badge {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
        }

        .analysis-velocity-card {
            background: #f8f9fa;
            border-radius: 0.5rem;
            padding: 1rem;
            text-align: center;
        }

        .analysis-velocity-card__label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6c757d;
            font-weight: 600;
        }

        .analysis-velocity-card__value {
            font-size: 1.25rem;
            font-weight: 700;
            margin: 0.25rem 0;
        }

        .analysis-velocity-card__sub {
            font-size: 0.8rem;
            color: #6c757d;
        }

        .analysis-progress-bar__labels {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            color: #6c757d;
            margin-bottom: 0.5rem;
        }

        .analysis-progress-bar__track {
            position: relative;
            height: 8px;
            background: #e9ecef;
            border-radius: 4px;
            overflow: visible;
        }

        .analysis-progress-bar__fill {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            border-radius: 4px;
            background: #0d6efd;
            transition: width 0.3s ease;
        }

        .analysis-progress-bar__fill--budget {
            background: linear-gradient(90deg, #198754, #0d6efd);
        }

        .analysis-progress-bar__marker {
            position: absolute;
            top: -4px;
            width: 2px;
            height: 16px;
            background: #dc3545;
            transform: translateX(-50%);
        }

        .analysis-chart-card {
            background: #fff;
            border: 1px solid #e9ecef;
            border-radius: 0.5rem;
            padding: 1rem;
        }

        .analysis-chart-card__title {
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .analysis-table th {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6c757d;
            font-weight: 600;
            border-top: none;
        }

        .analysis-empty-state__icon {
            color: #adb5bd;
        }

        .analysis-empty-state__title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .analysis-empty-state__text {
            color: #6c757d;
            max-width: 400px;
            margin: 0 auto;
        }
    </style>
}

@section Scripts {
    @{
        var jsonOptions = new JsonSerializerOptions
        {
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        };
    }
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        // Pass data to JavaScript for chart rendering — must be set before dashboard.js loads
        // Use camelCase naming policy to match JavaScript property access in dashboard.js
        window.__analysisData = {
            weeklyTrend: @Html.Raw(JsonSerializer.Serialize(Model.WeeklyTrend, jsonOptions)),
            trendPoints: @Html.Raw(JsonSerializer.Serialize(Model.TrendPoints, jsonOptions)),
            categories: @Html.Raw(JsonSerializer.Serialize(Model.Categories, jsonOptions))
        };
    </script>
    <script src="~/js/analysis/dashboard.js" asp-append-version="true"></script>
}
