@using System.Text.Json
@using System.Text.Json.Serialization
@using PersonalFinance.Shared.Enums
@model AnalysisDashboardViewModel

@{
    ViewData["Title"] = L["Analysis.Title"].Value;
    var activeSourceName = AnalysisText.SourceName(L, Model.ActiveSource);
    var periodLabel = Model.PeriodLabel ?? L["Analysis.Period.ThisPeriod"].Value;
    // The summary cards total one month, or the whole year when no month is selected.
    var totalForLabel = L.Named("Analysis.Summary.TotalFor",
        ("period", Model.SelectedMonth.HasValue ? Model.MonthName : Model.SelectedYear.ToString(System.Globalization.CultureInfo.InvariantCulture)));
}

<div class="analysis-page" data-currency="@Model.ReportingCurrency">
    <!-- Page header -->
    <header class="analysis-page-header mb-4">
        <div class="analysis-page-header__content d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="analysis-page-header__text">
                <h1 class="analysis-page-header__title">
                    <span class="analysis-page-header__icon" aria-hidden="true">
                        <svg width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                            <path
                                d="M4 11H2v3h2v-3zm5-4H7v7h2V7zm5-5h-2v12h2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1h-2zM7 6a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H7zm-5 4a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1H2z"/>
                        </svg>
                    </span>
                    @L["Analysis.Header.Title"]
                </h1>
                <p class="analysis-page-header__subtitle">@L["Analysis.Header.Subtitle"]</p>
            </div>
            <div class="analysis-page-header__controls">
                <partial name="_DataSourceToggle" model="Model.ActiveSource"/>
                @if (Model.RemovableSources.Any())
                {
                    <div class="analysis-source-removal mt-1 small">
                        @foreach (BudgetDataSource source in Model.RemovableSources)
                        {
                            <a asp-action="RemoveSource" asp-route-source="@source"
                               class="link-danger me-3">@L.Named("Analysis.Header.RemoveSourceLink", ("source", AnalysisText.SourceName(L, source)))</a>
                        }
                    </div>
                }
            </div>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Common.Close"]"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Common.Close"]"></button>
        </div>
    }

    @if (Model.AvailableYears.Any() || Model.SelectedYear > 0)
    {
        <!-- Period selector -->
        <div class="analysis-period-selector mb-4">
            <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center gap-2">
                <label for="yearSelect" class="visually-hidden">@L["Analysis.Period.SelectYear"]</label>
                <select name="year" id="yearSelect" class="form-select form-select-sm w-auto"
                        onchange="this.form.submit()">
                    @if (Model.SelectedYear > 0 && !Model.AvailableYears.Contains(Model.SelectedYear))
                    {
                        <option value="@Model.SelectedYear" selected="selected">@Model.SelectedYear</option>
                    }
                    @foreach (var year in Model.AvailableYears)
                    {
                        <option value="@year"
                                selected="@(year == Model.SelectedYear ? "selected" : null)">@year</option>
                    }
                </select>

                @if (Model.AvailableMonths.Count > 1 || (Model.SelectedMonth.HasValue && !Model.AvailableMonths.Contains(Model.SelectedMonth.Value)))
                {
                    <label for="monthSelect" class="visually-hidden">@L["Analysis.Period.SelectMonth"]</label>
                    <select name="month" id="monthSelect" class="form-select form-select-sm w-auto"
                            onchange="this.form.submit()">
                        <option value="">@L["Analysis.Period.AllMonths"]</option>
                        @if (Model.SelectedMonth.HasValue && !Model.AvailableMonths.Contains(Model.SelectedMonth.Value))
                        {
                            <option value="@Model.SelectedMonth.Value" selected="selected">@AnalysisText.MonthName(Model.SelectedMonth.Value)</option>
                        }
                        @foreach (var month in Model.AvailableMonths)
                        {
                            <option value="@month"
                                    selected="@(Model.SelectedMonth == month ? "selected" : null)">@AnalysisText.MonthName(month)</option>
                        }
                    </select>
                }
            </form>
        </div>
    }

    @if (!Model.HasData)
    {
        <!-- Empty state -->
        <div class="analysis-empty-state text-center py-5">
            <div class="analysis-empty-state__icon mb-3" aria-hidden="true">
                <svg width="64" height="64" fill="#adb5bd" viewBox="0 0 16 16">
                    <path
                            d="M4 11H2v3h2v-3zm5-4H7v7h2V7zm5-5h-2v12h2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1h-2zM7 6a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H7zm-5 4a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1H2z"/>
                </svg>
            </div>
            <h2 class="analysis-empty-state__title">@L.Named("Analysis.Empty.Title", ("source", activeSourceName))</h2>
            @if (Model.ActiveSource == BudgetDataSource.GoogleSheet)
            {
                <p class="analysis-empty-state__text mb-4">
                    @L.Named("Analysis.Empty.SheetText", ("period", periodLabel))
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="GoogleDrive" asp-action="Index" class="btn btn-primary px-4">
                        @L["Analysis.Empty.GoToDrive"]
                    </a>
                    <a asp-controller="BudgetTracker" asp-action="Index" class="btn btn-outline-secondary px-4">
                        @L["Analysis.Empty.OpenTracker"]
                    </a>
                </div>
            }
            else
            {
                <p class="analysis-empty-state__text mb-4">
                    @L.Named("Analysis.Empty.TrackerText", ("period", periodLabel))
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="BudgetTracker" asp-action="Index" class="btn btn-primary px-4">
                        @L["Analysis.Empty.OpenTracker"]
                    </a>
                    <a asp-controller="GoogleDrive" asp-action="Index" class="btn btn-outline-secondary px-4">
                        @L["Analysis.Empty.GoToDrive"]
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Summary cards -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="analysis-card analysis-card--income h-100">
                    <div class="analysis-card__label">@L["Analysis.Summary.Income"]</div>
                    <div class="analysis-card__value">@MoneyFormatter.FormatWhole(Model.TotalIncome, Model.ReportingCurrency)</div>
                    <div class="analysis-card__sub">@totalForLabel</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="analysis-card analysis-card--expenses h-100">
                    <div class="analysis-card__label">@L["Analysis.Summary.Expenses"]</div>
                    <div class="analysis-card__value">@MoneyFormatter.FormatWhole(Model.TotalExpenses, Model.ReportingCurrency)</div>
                    <div class="analysis-card__sub">@totalForLabel</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="analysis-card analysis-card--savings h-100">
                    <div class="analysis-card__label">@L["Analysis.Summary.NetSavings"]</div>
                    <div class="analysis-card__value" style="color: @(Model.NetSavings >= 0 ? "#198754" : "#dc3545")">
                        @MoneyFormatter.FormatWhole(Model.NetSavings, Model.ReportingCurrency)</div>
                    <div class="analysis-card__sub">@L["Analysis.Summary.IncomeMinusExpenses"]</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="analysis-card analysis-card--rate h-100">
                    <div class="analysis-card__label">@L["Analysis.Summary.SavingsRate"]</div>
                    <div class="analysis-card__value">@Model.SavingsRate.ToString("F1")%</div>
                    <div class="analysis-card__sub">@L["Analysis.Summary.OfTotalIncome"]</div>
                </div>
            </div>
        </div>
        <partial name="_ConversionCaption" model="Model.Conversion"/>

        <!-- Spending Velocity section -->
        @if (Model.DailyBurnRate > 0)
        {
            var budgetUsed = Model.BudgetConsumptionPercent.ToString("F1");
            var timeElapsed = Model.TimeElapsedPercent.ToString("F1");
            <div class="analysis-section mb-4">
                <div class="analysis-section__header">
                    <h2 class="analysis-section__title">@L["Analysis.Velocity.Title"]</h2>
                    <span
                        class="analysis-section__badge @(Model.VelocityStatus == "On Track" ? "bg-success" : Model.VelocityStatus == "Over Budget" ? "bg-danger" : "bg-warning")">
                        @Model.VelocityStatusLabel
                    </span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <div class="analysis-velocity-card">
                            <div class="analysis-velocity-card__label">@L["Analysis.Velocity.DailyBurnRate"]</div>
                            <div class="analysis-velocity-card__value">@MoneyFormatter.Format(Model.DailyBurnRate, Model.ReportingCurrency)</div>
                            <div class="analysis-velocity-card__sub">@L["Analysis.Velocity.DailyBurnRateSub"]</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="analysis-velocity-card">
                            <div class="analysis-velocity-card__label">@L["Analysis.Velocity.Projected"]</div>
                            <div class="analysis-velocity-card__value">
                                @MoneyFormatter.FormatWhole(Model.ProjectedMonthlySpend, Model.ReportingCurrency)</div>
                            <div class="analysis-velocity-card__sub">@L["Analysis.Velocity.ProjectedSub"]</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="analysis-velocity-card">
                            <div class="analysis-velocity-card__label">@L["Analysis.Velocity.Budget"]</div>
                            <div class="analysis-velocity-card__value">@MoneyFormatter.FormatWhole(Model.BudgetedExpenses, Model.ReportingCurrency)</div>
                            <div class="analysis-velocity-card__sub">@L["Analysis.Velocity.BudgetSub"]</div>
                        </div>
                    </div>
                </div>

                <!-- Budget consumption bar -->
                <div class="analysis-progress-bar mb-3">
                    <div class="analysis-progress-bar__labels">
                        <span>@L.Named("Analysis.Velocity.BudgetUsed", ("percent", budgetUsed))</span>
                        <span>@L.Named("Analysis.Velocity.TimeElapsed", ("percent", timeElapsed))</span>
                    </div>
                    <div class="analysis-progress-bar__track">
                        <div class="analysis-progress-bar__fill analysis-progress-bar__fill--budget"
                             style="width: @(Math.Min(Model.BudgetConsumptionPercent, 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"
                             title="@L.Named("Analysis.Velocity.BudgetUsed", ("percent", budgetUsed))"></div>
                        <div class="analysis-progress-bar__marker"
                             style="left: @(Math.Min(Model.TimeElapsedPercent, 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"
                             title="@L.Named("Analysis.Velocity.TimeElapsed", ("percent", timeElapsed))"></div>
                    </div>
                </div>

                <!-- Weekly trend chart -->
                @if (Model.WeeklyTrend.Any())
                {
                    <div class="analysis-chart-card">
                        <h3 class="analysis-chart-card__title">@L["Analysis.Velocity.WeeklyTrend"]</h3>
                        <div class="analysis-chart-card__canvas">
                            <canvas id="weeklyTrendChart" height="200"></canvas>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Trend chart -->
        @if (Model.TrendPoints.Count > 1)
        {
            <div class="analysis-section mb-4">
                <h2 class="analysis-section__title">@L["Analysis.Trends.Title"]</h2>
                <div class="analysis-chart-card">
                    <div class="analysis-chart-card__canvas">
                        <canvas id="trendChart" height="250"></canvas>
                    </div>
                </div>
            </div>
        }

        <!-- Money Flow: where this month's income went -->
        @if (Model.MoneyFlow is { } flow)
        {
            var shareHeading = flow.HasShortfall ? L["Analysis.MoneyFlow.ShareOfSpending"] : L["Analysis.MoneyFlow.ShareOfIncome"];
            var shortfallAmount = new Microsoft.AspNetCore.Html.HtmlString(
                $"<strong>{System.Text.Encodings.Web.HtmlEncoder.Default.Encode(MoneyFormatter.FormatWhole(flow.Shortfall, Model.ReportingCurrency))}</strong>");
            <section class="analysis-section money-flow mb-4" aria-labelledby="moneyFlowTitle">
                <h2 class="analysis-section__title" id="moneyFlowTitle">@L["Analysis.MoneyFlow.Title"]</h2>
                <p class="text-muted small mb-3">@L.Named("Analysis.MoneyFlow.FromSource", ("month", flow.MonthLabel), ("source", activeSourceName))</p>
                @if (flow.HasShortfall)
                {
                    <p class="money-flow__note mb-3">
                        @L.NamedHtml("Analysis.MoneyFlow.ShortfallNote", null,
                            ("amount", shortfallAmount),
                            ("month", new Microsoft.AspNetCore.Html.HtmlString(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(flow.MonthName))))
                    </p>
                }
                <div class="d-flex flex-column gap-3">
                    <div class="analysis-chart-card order-2 order-sm-1">
                        <div class="money-flow__canvas">
                            <canvas id="moneyFlowChart" aria-hidden="true"></canvas>
                        </div>
                    </div>
                    <div class="table-responsive order-1 order-sm-2">
                        <table class="table align-middle analysis-table money-flow__table mb-0">
                            <caption class="visually-hidden">@L.Named("Analysis.MoneyFlow.Caption", ("month", flow.MonthLabel))</caption>
                            <thead>
                            <tr>
                                <th scope="col">@L["Analysis.Table.Category"]</th>
                                <th scope="col" class="text-end">@L["Analysis.Table.Amount"]</th>
                                <th scope="col" class="text-end">@shareHeading</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var row in flow.TableRows)
                            {
                                var swatchClass = row.ColorSlot is { } slot
                                    ? $"money-flow__swatch--slot-{slot}"
                                    : $"money-flow__swatch--{row.Kind.ToString().ToLowerInvariant()}";
                                <tr>
                                    <th scope="row" class="fw-normal">
                                        <span class="money-flow__swatch @(row.InOther ? "money-flow__swatch--other" : swatchClass)" aria-hidden="true"></span>
                                        @row.Name
                                        @if (row.InOther)
                                        {
                                            <span class="text-muted small">@L["Analysis.MoneyFlow.InOther"]</span>
                                        }
                                    </th>
                                    <td class="text-end">@MoneyFormatter.FormatWhole(row.Amount, Model.ReportingCurrency)</td>
                                    <td class="text-end">@row.SharePercent.ToString("F1")%</td>
                                </tr>
                            }
                            </tbody>
                            <tfoot>
                            <tr>
                                <th scope="row">@L["Analysis.MoneyFlow.Income"]</th>
                                <td class="text-end fw-semibold">@MoneyFormatter.FormatWhole(flow.Income, Model.ReportingCurrency)</td>
                                <td></td>
                            </tr>
                            @if (flow.HasShortfall)
                            {
                                <tr class="money-flow__shortfall-row">
                                    <th scope="row">@L["Analysis.MoneyFlow.Shortfall"]</th>
                                    <td class="text-end fw-semibold">@MoneyFormatter.FormatWhole(flow.Shortfall, Model.ReportingCurrency)</td>
                                    <td></td>
                                </tr>
                            }
                            </tfoot>
                        </table>
                    </div>
                </div>
            </section>
        }

        <!-- Category insights -->
        @if (Model.Categories.Any())
        {
            <div class="analysis-section mb-4">
                <h2 class="analysis-section__title">@L["Analysis.Categories.Title"]</h2>
                <div class="row g-3">
                    <div class="col-lg-6">
                        <div class="analysis-chart-card">
                            <div class="analysis-chart-card__canvas">
                                <canvas id="categoryPieChart" height="300"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="analysis-chart-card">
                            <div class="analysis-chart-card__canvas">
                                <canvas id="categoryBarChart" height="300"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Category table -->
                <div class="table-responsive mt-3">
                    <table class="table table-hover align-middle analysis-table">
                        <thead>
                        <tr>
                            <th scope="col">@L["Analysis.Table.Category"]</th>
                            <th scope="col" class="text-end">@L["Analysis.Table.Budgeted"]</th>
                            <th scope="col" class="text-end">@L["Analysis.Table.Actual"]</th>
                            <th scope="col" class="text-end">@L["Analysis.Table.Variance"]</th>
                            <th scope="col" class="text-end">@L["Analysis.Table.PercentUsed"]</th>
                            <th scope="col" class="text-end">@L["Analysis.Table.Status"]</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var category in Model.Categories)
                        {
                            <tr>
                                <td class="fw-semibold">@category.CategoryName</td>
                                <td class="text-end">@MoneyFormatter.FormatWhole(category.BudgetedAmount, Model.ReportingCurrency)</td>
                                <td class="text-end">@MoneyFormatter.FormatWhole(category.ActualAmount, Model.ReportingCurrency)</td>
                                <td class="text-end" style="color: @(category.Variance >= 0 ? "#198754" : "#dc3545")">
                                    @(category.Variance >= 0 ? "+" : "")@MoneyFormatter.FormatWhole(category.Variance, Model.ReportingCurrency)
                                </td>
                                <td class="text-end">@category.PercentageUsed.ToString("F1")%</td>
                                <td class="text-end">
                                        <span
                                            class="badge @(category.Status == "Within Budget" ? "bg-success" : category.Status == "Near Limit" ? "bg-warning" : "bg-danger")">
                                            @category.StatusLabel
                                        </span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Variance rankings -->
        @if (Model.VarianceRankings.Any())
        {
            <div class="analysis-section mb-4">
                <h2 class="analysis-section__title">@L["Analysis.Variance.Title"]</h2>
                <p class="text-muted small mb-3">@L["Analysis.Variance.Description"]</p>
                <div class="table-responsive">
                    <table class="table table-hover align-middle analysis-table">
                        <thead>
                        <tr>
                            <th scope="col" style="width: 60px;">#</th>
                            <th scope="col">@L["Analysis.Table.Category"]</th>
                            <th scope="col" class="text-end">@L["Analysis.Table.Budgeted"]</th>
                            <th scope="col" class="text-end">@L["Analysis.Table.Actual"]</th>
                            <th scope="col" class="text-end">@L["Analysis.Table.Variance"]</th>
                            <th scope="col" class="text-end">@L["Analysis.Table.Status"]</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var ranking in Model.VarianceRankings)
                        {
                            <tr>
                                <td>@ranking.Rank</td>
                                <td class="fw-semibold">@ranking.CategoryName</td>
                                <td class="text-end">@MoneyFormatter.FormatWhole(ranking.BudgetedAmount, Model.ReportingCurrency)</td>
                                <td class="text-end">@MoneyFormatter.FormatWhole(ranking.ActualAmount, Model.ReportingCurrency)</td>
                                <td class="text-end" style="color: @(ranking.Variance >= 0 ? "#198754" : "#dc3545")">
                                    @(ranking.Variance >= 0 ? "+" : "")@MoneyFormatter.FormatWhole(ranking.Variance, Model.ReportingCurrency)
                                </td>
                                <td class="text-end">
                                        <span
                                            class="badge @(ranking.Status == "Under Budget" ? "bg-success" : "bg-danger")">
                                            @ranking.StatusLabel
                                        </span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@section Styles {
    <style>
        /* Fix dropdown arrow overlap: restore Bootstrap's default right padding for form-select */
        .analysis-period-selector .form-select {
            padding-right: 2.25rem;
        }

        /* Chart container needs explicit height for maintainAspectRatio: false */
        .analysis-chart-card__canvas {
            position: relative;
            height: 300px;
        }

        /*
         * Money Flow colours, read by money-flow.js. Categories take slots 0-4 in display order: this order of the
         * categorical palette passes the colour-blind and normal-vision checks for neighbouring bands, and slot 4
         * (magenta) is also safe beside Saved. Income and Spending stay neutral so the categories carry the colour;
         * Shortfall and Saved keep their negative/positive meaning.
         */
        .money-flow {
            --money-flow-slot-0: #2a78d6;
            --money-flow-slot-1: #eb6834;
            --money-flow-slot-2: #6250d6;
            --money-flow-slot-3: #eda100;
            --money-flow-slot-4: #e87ba4;
            --money-flow-income: #475569;
            --money-flow-spending: #6B7280;
            --money-flow-shortfall: var(--app-accent-negative, #DC2626);
            --money-flow-saved: var(--app-accent-positive, #059669);
            --money-flow-uncategorized: #78716C;
            --money-flow-other: #9CA3AF;
        }

        .money-flow__swatch {
            display: inline-block;
            width: 0.75rem;
            height: 0.75rem;
            border-radius: 3px;
            margin-right: 0.375rem;
            vertical-align: -0.05em;
        }

        .money-flow__swatch--slot-0 { background: var(--money-flow-slot-0); }
        .money-flow__swatch--slot-1 { background: var(--money-flow-slot-1); }
        .money-flow__swatch--slot-2 { background: var(--money-flow-slot-2); }
        .money-flow__swatch--slot-3 { background: var(--money-flow-slot-3); }
        .money-flow__swatch--slot-4 { background: var(--money-flow-slot-4); }
        .money-flow__swatch--uncategorized { background: var(--money-flow-uncategorized); }
        .money-flow__swatch--other { background: var(--money-flow-other); }
        .money-flow__swatch--saved { background: var(--money-flow-saved); }

        /* Money Flow: a taller canvas so small bands keep readable labels */
        .money-flow__canvas {
            position: relative;
            height: 360px;
        }

        .money-flow__note {
            border-left: 4px solid var(--app-accent-negative, #DC2626);
            background: var(--app-accent-negative-soft, #FEE2E2);
            border-radius: 0.375rem;
            padding: 0.625rem 0.875rem;
        }

        /* Row headers name a category; keep them as body text, not the uppercase column-header style */
        .money-flow__table tbody th,
        .money-flow__table tfoot th {
            font-size: inherit;
            text-transform: none;
            letter-spacing: normal;
            color: inherit;
        }

        /* Match site.css body-cell padding so footer amounts line up with the rows above */
        .money-flow__table tbody th,
        .money-flow__table tfoot th,
        .money-flow__table tfoot td {
            padding: var(--app-spacing-s) var(--app-spacing-m);
        }

        .money-flow__shortfall-row th,
        .money-flow__shortfall-row td {
            color: var(--app-accent-negative, #DC2626);
        }

        /* Canvas fills the container */
        .analysis-chart-card__canvas canvas {
            width: 100%;
        }

        .analysis-page-header {
            border-bottom: 1px solid #e9ecef;
            padding-bottom: 1rem;
        }

        .analysis-page-header__title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .analysis-page-header__icon {
            color: #0d6efd;
        }

        .analysis-page-header__subtitle {
            color: #6c757d;
            margin: 0.25rem 0 0;
        }

        .analysis-card {
            background: #fff;
            border: 1px solid #e9ecef;
            border-radius: 0.5rem;
            padding: 1rem;
        }

        .analysis-card__label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6c757d;
            font-weight: 600;
        }

        .analysis-card__value {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0.25rem 0;
        }

        .analysis-card__sub {
            font-size: 0.8rem;
            color: #6c757d;
        }

        .analysis-section__title {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .analysis-section__header {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .analysis-section__badge {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
        }

        .analysis-velocity-card {
            background: #f8f9fa;
            border-radius: 0.5rem;
            padding: 1rem;
            text-align: center;
        }

        .analysis-velocity-card__label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6c757d;
            font-weight: 600;
        }

        .analysis-velocity-card__value {
            font-size: 1.25rem;
            font-weight: 700;
            margin: 0.25rem 0;
        }

        .analysis-velocity-card__sub {
            font-size: 0.8rem;
            color: #6c757d;
        }

        .analysis-progress-bar__labels {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            color: #6c757d;
            margin-bottom: 0.5rem;
        }

        .analysis-progress-bar__track {
            position: relative;
            height: 8px;
            background: #e9ecef;
            border-radius: 4px;
            overflow: visible;
        }

        .analysis-progress-bar__fill {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            border-radius: 4px;
            background: #0d6efd;
            transition: width 0.3s ease;
        }

        .analysis-progress-bar__fill--budget {
            background: linear-gradient(90deg, #198754, #0d6efd);
        }

        .analysis-progress-bar__marker {
            position: absolute;
            top: -4px;
            width: 2px;
            height: 16px;
            background: #dc3545;
            transform: translateX(-50%);
        }

        .analysis-chart-card {
            background: #fff;
            border: 1px solid #e9ecef;
            border-radius: 0.5rem;
            padding: 1rem;
        }

        .analysis-chart-card__title {
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .analysis-table th {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6c757d;
            font-weight: 600;
            border-top: none;
        }

        .analysis-empty-state__icon {
            color: #adb5bd;
        }

        .analysis-empty-state__title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .analysis-empty-state__text {
            color: #6c757d;
            max-width: 400px;
            margin: 0 auto;
        }
    </style>
}

@section Scripts {
    @{
        var jsonOptions = new JsonSerializerOptions
        {
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
                Converters = { new JsonStringEnumConverter(JsonNamingPolicy.CamelCase) }
        };
    }
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/lib/chartjs-chart-sankey/dist/chartjs-chart-sankey.min.js"></script>
    <script>
        // Pass data to JavaScript for chart rendering — must be set before dashboard.js loads
        // Use camelCase naming policy to match JavaScript property access in dashboard.js
        window.__analysisData = {
            weeklyTrend: @Html.Raw(JsonSerializer.Serialize(Model.WeeklyTrend, jsonOptions)),
            trendPoints: @Html.Raw(JsonSerializer.Serialize(Model.TrendPoints, jsonOptions)),
            categories: @Html.Raw(JsonSerializer.Serialize(Model.Categories, jsonOptions)),
            moneyFlow: @Html.Raw(JsonSerializer.Serialize(Model.MoneyFlow, jsonOptions))
        };
    </script>
    <js-strings prefix="Analysis.Js." />
    <script src="~/js/analysis/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/analysis/money-flow.js" asp-append-version="true"></script>
}
