@using PersonalFinance.Shared.Enums
@model CommunityViewModel

@{
    ViewData["Title"] = L["Community.Title"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/community.css" asp-append-version="true"/>
}

<div class="community-page">
    <!-- Header: the plaque, with who the viewer is in the hall -->
    <header class="community-plaque">
        <div class="community-plaque-text">
            <p class="community-eyebrow">@L["Community.Header.Eyebrow"]</p>
            <h1 class="community-title">@L["Community.Header.Title"]</h1>
            <p class="community-subtitle">@L["Community.Header.Subtitle"]</p>
        </div>
        <div class="community-pseudonym-badge">
            <span class="community-pseudonym-label">@L["Community.Pseudonym.YouAppearAs"]</span>
            <strong class="community-pseudonym-name" data-pseudonym-self>@Model.Pseudonym</strong>
            <button type="button" class="community-link-btn" id="rerollPseudonymBtn" aria-describedby="rerollPseudonymHelp">@L["Community.Pseudonym.Reroll"]</button>
            <span class="visually-hidden" id="rerollPseudonymHelp">@L["Community.Pseudonym.RerollHelp"]</span>
        </div>
    </header>

    <!-- Polls Section -->
    <section class="community-section" aria-labelledby="polls-heading">
        <h2 class="community-section-title" id="polls-heading">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
            </svg>
            @L["Community.Polls.Heading"]
        </h2>
        <div class="community-polls-grid">
            @foreach (var poll in Model.ActivePolls)
            {
                <div class="community-poll-card" data-poll-id="@poll.Id">
                    <div class="community-poll-header">
                        <span class="community-poll-category">@CommunityText.Category(L, poll.Category)</span>
                        <span class="community-poll-votes">@L.Plural("Community.Js.Votes", poll.TotalVotes)</span>
                    </div>
                    <h3 class="community-poll-question">@poll.Question</h3>
                    <p class="community-poll-description">@poll.Description</p>
                    <div class="community-poll-options">
                        @foreach (var option in poll.Options)
                        {
                            var isVoted = poll.HasVoted && poll.VotedOptionId == option.Id;
                            <div class="community-poll-option" data-option="@option.Text">
                                <button type="button" class="community-poll-option-btn@(poll.HasVoted ? " voted" : "")"
                                        data-poll-code="@poll.Id"
                                        data-option-id="@option.Id"
                                        data-option-text="@option.Text"
                                        @(poll.HasVoted ? "disabled" : null)
                                        aria-label="@L.Named("Community.Polls.VoteFor", ("option", option.Text))">
                                    <span class="community-poll-option-text">@option.Text</span>
                                    <span class="community-poll-option-result" style="display:@(poll.HasVoted ? "flex" : "none");">
                                        <span class="community-poll-option-bar" style="width: @(poll.HasVoted ? option.Percentage.ToString(System.Globalization.CultureInfo.InvariantCulture) + "%" : "0%");" data-percentage="@option.Percentage.ToString(System.Globalization.CultureInfo.InvariantCulture)"></span>
                                        <span class="community-poll-option-percentage">@option.Percentage%</span>
                                    </span>
                                    @if (isVoted)
                                    {
                                        <span class="community-poll-option-checked" aria-hidden="true">✓</span>
                                    }
                                </button>
                                <span class="community-poll-option-votes" style="display:@(poll.HasVoted ? "inline" : "none");">@L.Plural("Community.Js.Votes", option.Votes)</span>
                            </div>
                        }
                    </div>
                    <div class="community-poll-comment-section">
                        <button type="button" class="community-poll-comment-toggle" aria-expanded="false">
                            💬 @L["Community.Polls.ShareThoughts"]
                        </button>
                        <div class="community-poll-comment-form" style="display:none;">
                            <textarea class="form-control community-poll-comment-input"
                                      placeholder="@L["Community.Polls.CommentPlaceholder"]"
                                      rows="2"
                                      aria-label="@L["Community.Polls.CommentAria"]"></textarea>
                            <div class="community-poll-comment-actions">
                                <button type="button" class="btn community-poll-comment-submit">@L["Community.PostComment"]</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- The hall: the corkboard of Strategies, and the rail with the pin form -->
    <div class="community-hall">
        <section class="community-section community-board-section" id="strategies" aria-labelledby="strategies-heading">
            <div class="community-section-header">
                <h2 class="community-section-title" id="strategies-heading">@L["Community.Strategies.Heading"]</h2>
                <nav aria-label="@L["Community.Strategies.FilterAria"]">
                    <ul class="community-chips">
                        <li>
                            <a class="community-chip@(Model.Category is null ? " is-active" : "")"
                               aria-current="@(Model.Category is null ? "page" : null)"
                               href="@(Url.Action("Index", "Community"))#strategies">@L["Community.Strategies.AllCategories"]</a>
                        </li>
                        @foreach (string category in CommunityText.StrategyCategories)
                        {
                            bool active = category == Model.Category;
                            <li>
                                <a class="community-chip@(active ? " is-active" : "")"
                                   aria-current="@(active ? "page" : null)"
                                   href="@(Url.Action("Index", "Community", new { category }))#strategies">@CommunityText.Category(L, category)</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
            <div class="community-board" id="communityBoard">
                @if (Model.Strategies.Count == 0)
                {
                    <p class="community-board-empty" data-board-empty>
                        @(Model.Category is null
                            ? L["Community.Strategies.Empty"]
                            : L.Named("Community.Strategies.EmptyCategory", ("category", CommunityText.Category(L, Model.Category))))
                    </p>
                }
                @foreach (var strategy in Model.Strategies)
                {
                    string strategyAuthor = CommunityText.Author(L, strategy.AuthorPseudonym);
                    string statusClass = strategy.Status switch
                    {
                        CommunityStrategyStatus.Pending => " community-note--pending",
                        CommunityStrategyStatus.Rejected => " community-note--rejected",
                        _ => "",
                    };
                    <article class="community-note@(statusClass)" data-strategy-id="@strategy.Id" aria-labelledby="strategy-title-@strategy.Id">
                        <span class="community-pin" aria-hidden="true"></span>
                        @if (strategy.Status == CommunityStrategyStatus.Pending)
                        {
                            <p class="community-note-status">@L["Community.Strategies.Pending"]</p>
                        }
                        else if (strategy.Status == CommunityStrategyStatus.Rejected)
                        {
                            <p class="community-note-status">@L["Community.Strategies.Rejected"]</p>
                        }
                        <p class="community-note-tag">@CommunityText.Category(L, strategy.Category)</p>
                        <h3 class="community-note-title" id="strategy-title-@strategy.Id">@strategy.Title</h3>
                        <dl class="community-note-steps">
                            <dt>@L["Community.Strategies.Tried"]</dt>
                            <dd>@strategy.Tried</dd>
                            <dt>@L["Community.Strategies.Happened"]</dt>
                            <dd>@strategy.Happened</dd>
                            <dt>@L["Community.Strategies.Keeping"]</dt>
                            <dd>@strategy.Keeping</dd>
                        </dl>
                        <p class="community-note-byline">
                            <strong data-pseudonym-self="@(strategy.IsOwn ? "" : null)">@strategyAuthor</strong>
                            · <time datetime="@strategy.CreatedAt.ToString("o")">@CommunityText.TimeAgo(L, strategy.CreatedAt, DateTime.UtcNow)</time>
                        </p>
                    </article>
                }
            </div>
        </section>

        <aside class="community-rail" aria-label="@L["Community.Rail.Aria"]">
            <section class="community-rail-card" aria-labelledby="pin-heading">
                <p class="community-eyebrow">@L["Community.Pin.Eyebrow"]</p>
                <h2 class="community-rail-title" id="pin-heading">@L["Community.Pin.Heading"]</h2>
                <form class="community-pin-form" id="pinStrategyForm" novalidate data-amount-pattern="@MoneyAmountRule.Pattern">
                    <div>
                        <label for="strategyCategory" class="form-label">@L["Community.Pin.Category"]</label>
                        <select class="form-select" id="strategyCategory" name="category" required>
                            <option value="">@L["Community.Pin.CategoryPlaceholder"]</option>
                            @foreach (string category in CommunityText.StrategyCategories)
                            {
                                <option value="@category" selected="@(category == Model.Category)">@CommunityText.Category(L, category)</option>
                            }
                        </select>
                        <div class="invalid-feedback">@L["Community.Pin.CategoryRequired"]</div>
                    </div>
                    <div>
                        <label for="strategyTitle" class="form-label">@L["Community.Pin.Title"]</label>
                        <input type="text" class="form-control" id="strategyTitle" name="title" required
                               maxlength="@CommunityStrategyLimits.TitleMaxLength" data-amount-watch
                               placeholder="@L["Community.Pin.TitlePlaceholder"]" />
                        <div class="invalid-feedback">@L["Community.Pin.Required"]</div>
                    </div>
                    <div>
                        <label for="strategyTried" class="form-label">@L["Community.Pin.Tried"]</label>
                        <textarea class="form-control" id="strategyTried" name="tried" rows="2" required
                                  maxlength="@CommunityStrategyLimits.TextMaxLength" data-amount-watch
                                  placeholder="@L["Community.Pin.TriedPlaceholder"]"></textarea>
                        <div class="invalid-feedback">@L["Community.Pin.Required"]</div>
                    </div>
                    <div>
                        <label for="strategyHappened" class="form-label">@L["Community.Pin.Happened"]</label>
                        <textarea class="form-control" id="strategyHappened" name="happened" rows="2" required
                                  maxlength="@CommunityStrategyLimits.TextMaxLength" data-amount-watch
                                  placeholder="@L["Community.Pin.HappenedPlaceholder"]"></textarea>
                        <div class="invalid-feedback">@L["Community.Pin.Required"]</div>
                    </div>
                    <div>
                        <label for="strategyKeeping" class="form-label">@L["Community.Pin.Keeping"]</label>
                        <textarea class="form-control" id="strategyKeeping" name="keeping" rows="2" required
                                  maxlength="@CommunityStrategyLimits.TextMaxLength" data-amount-watch
                                  placeholder="@L["Community.Pin.KeepingPlaceholder"]"></textarea>
                        <div class="invalid-feedback">@L["Community.Pin.Required"]</div>
                    </div>
                    <p class="community-nudge" id="strategyAmountNudge" role="status" hidden>@L["Community.Pin.AmountNudge"]</p>
                    <p class="community-pin-guidance">@L["Community.Pin.Guidance"]</p>
                    <button type="submit" class="community-btn" id="pinStrategyBtn">
                        <span class="community-pin-label">@L["Community.Js.SendForReview"]</span>
                    </button>
                </form>
            </section>
        </aside>
    </div>

    <!-- The viewer's own note, pinned at once when a Strategy is sent for review -->
    <template id="pendingNoteTemplate">
        <article class="community-note community-note--pending">
            <span class="community-pin" aria-hidden="true"></span>
            <p class="community-note-status">@L["Community.Strategies.Pending"]</p>
            <p class="community-note-tag" data-note="category"></p>
            <h3 class="community-note-title" data-note="title"></h3>
            <dl class="community-note-steps">
                <dt>@L["Community.Strategies.Tried"]</dt>
                <dd data-note="tried"></dd>
                <dt>@L["Community.Strategies.Happened"]</dt>
                <dd data-note="happened"></dd>
                <dt>@L["Community.Strategies.Keeping"]</dt>
                <dd data-note="keeping"></dd>
            </dl>
            <p class="community-note-byline">
                <strong data-pseudonym-self data-note="author"></strong>
                · <time>@L["Community.Js.JustNow"]</time>
            </p>
        </article>
    </template>

    <!-- Recent Comments Section -->
    <section class="community-section" aria-labelledby="comments-heading">
        <h2 class="community-section-title" id="comments-heading">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            @L["Community.Activity.Heading"]
        </h2>
        <div class="community-comments-list" id="communityCommentsList">
            @if (Model.RecentComments.Count == 0)
            {
                <div class="community-no-comments">
                    <p>@L["Community.Activity.Empty"]</p>
                </div>
            }
            @foreach (var comment in Model.RecentComments)
            {
                string commentAuthor = CommunityText.Author(L, comment.AuthorPseudonym);
                <div class="community-comment-card" data-comment-id="@comment.Id">
                    <div class="community-comment-header">
                        <div class="community-comment-avatar" aria-hidden="true" data-pseudonym-self-initials="@(comment.IsOwn ? "1" : null)">
                            @CommunityText.Initials(commentAuthor, 1)
                        </div>
                        <div class="community-comment-info">
                            <strong class="community-comment-author" data-pseudonym-self="@(comment.IsOwn ? "" : null)">@commentAuthor</strong>
                            <time class="community-comment-time" datetime="@comment.CreatedAt.ToString("o")">
                                @CommunityText.TimeAgo(L, comment.CreatedAt, DateTime.UtcNow)
                            </time>
                        </div>
                        <button type="button" class="community-comment-like@(comment.IsLikedByUser ? " liked" : "")"
                                data-comment-id="@comment.Id"
                                aria-label="@L["Community.Js.LikeComment"]">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                            </svg>
                            <span class="community-comment-like-count">@comment.Likes</span>
                        </button>
                    </div>
                    <p class="community-comment-text">@comment.Text</p>
                </div>
            }
        </div>
    </section>

</div>

@section Scripts {
    <js-strings prefix="Community.Js." />
    <script src="~/js/community.js" asp-append-version="true"></script>
}
