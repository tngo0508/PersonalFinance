@model ResearchCompanyPanelViewModel

@* The company lookup: look up a company registered with the SEC and see its Company Profile (GLOSSARY.md), for
   information only. js/research/research-companies.js fetches suggestions, the profile and its press releases from
   this controller's Suggest, CompanyProfile and Releases actions and fills the profile region below; nothing is
   stored. Without JavaScript the form still submits as a plain GET. On the Company page the ticker is kept in the path
   (data-company-page); in the tabbed page's Companies tab, in the query, and the panel is hidden until its tab is
   chosen. A tracked fund's ticker opens that fund's page (data-fund-url). *@
<section class="research-deck" id="research-panel-companies"
         role="@(Model.InTab ? "tabpanel" : null)" aria-labelledby="@(Model.InTab ? "research-tab-companies" : null)"
         hidden="@Model.Hidden"
         data-research-companies
         data-suggest-url="@Url.Action("Suggest", "Research")"
         data-company-url="@Url.Action("CompanyProfile", "Research")"
         data-releases-url="@Url.Action("Releases", "Research")"
         data-company-page="@(Model.InTab ? null : Url.Content("~/Research/Company"))"
         data-fund-url="@Url.Content("~/Research/Fund/")"
         data-funds-url="@Url.Action("Funds", "Research")"
         data-research-ticker="@Model.Ticker"
         data-research-query="@Model.Query">
    <div class="research-card">
        <h2 class="research-card__title">@L["Research.Companies.Title"]</h2>
        <p class="research-card__subtitle">@L["Research.Companies.Subtitle"]</p>

        <form class="research-companies__search" method="get"
              action="@(Model.InTab ? Url.Action("Index", "Research") : Url.Content("~/Research/Company"))"
              role="search" data-research-company-form>
            @if (Model.InTab)
            {
                <input type="hidden" name="tab" value="companies"/>
            }
            <label class="research-companies__label" for="research-company-input">@L["Research.Companies.InputLabel"]</label>
            <div class="research-companies__row">
                <div class="research-companies__combo">
                    <input type="text" id="research-company-input" name="ticker" class="research-companies__input"
                           role="combobox" aria-autocomplete="list" aria-expanded="false"
                           aria-controls="research-company-suggestions" autocomplete="off" autocapitalize="characters"
                           spellcheck="false" maxlength="40" placeholder="@L["Research.Companies.InputPlaceholder"]"
                           value="@(Model.Ticker ?? Model.Query)"/>
                    <ul class="research-companies__suggestions" id="research-company-suggestions" role="listbox"
                        aria-label="@L["Research.Companies.SuggestionsLabel"]" hidden></ul>
                </div>
                <button type="submit" class="research-chip research-companies__submit">@L["Research.Companies.Submit"]</button>
            </div>
        </form>

        @* A message in place of a profile: a fund, a ticker SEC does not list, too many lookups, or SEC unreachable. *@
        <div class="research-companies__message" data-research-company-message hidden></div>
        <p class="research-companies__loading" data-research-company-loading role="status" hidden>@L["Research.Companies.Loading"]</p>

        <div class="research-companies__profile" data-research-company-profile hidden>
            <header class="research-companies__identity">
                <h3 class="research-companies__name" data-field="name" tabindex="-1"></h3>
                <dl class="research-companies__facts">
                    <div><dt>@L["Research.Companies.Fact.Ticker"]</dt><dd data-field="ticker"></dd></div>
                    <div><dt>@L["Research.Companies.Fact.Exchange"]</dt><dd data-field="exchange"></dd></div>
                    <div><dt>@L["Research.Companies.Fact.Cik"]</dt><dd data-field="cik"></dd></div>
                    <div><dt>@L["Research.Js.Sectors.Industry"]</dt><dd data-field="industry"></dd></div>
                    <div><dt>@L["Research.Js.Sectors.Office"]</dt><dd data-field="office"></dd></div>
                    <div><dt>@L["Research.Companies.Fact.Incorporated"]</dt><dd data-field="incorporated"></dd></div>
                    <div><dt>@L["Research.Companies.Fact.FiscalYearEnd"]</dt><dd data-field="fiscal-year-end"></dd></div>
                </dl>
            </header>

            <p class="research-companies__notice" data-field="ifrs-note" hidden>@L["Research.Companies.IfrsNote"]</p>

            <h3 class="research-companies__section">@L["Research.Companies.AnnualFigures"]</h3>
            <p class="research-companies__hint" data-field="years-note"></p>
            @* The charts repeat the table below, which is their accessible equivalent. *@
            <div class="research-companies__charts" data-research-company-charts aria-hidden="true"></div>
            <div class="research-tooltip" id="research-company-tooltip" aria-hidden="true" hidden></div>
            <div class="research-table-wrap research-companies__table" data-research-company-table tabindex="0"
                 role="region" aria-label="@L["Research.Companies.AnnualFigures"]"></div>

            @* Filled after the profile, from this controller's Releases action: a slow or failed read never delays the
               profile. Hidden unless the lookup says the profile's press releases are available (ApiService's
               Research:PressReleases:Enabled). Loading, the list, the empty line and the Unavailable State are each
               toggled with hidden. *@
            <section class="research-companies__releases" data-research-company-releases
                     aria-labelledby="research-company-releases-title" hidden>
                <h3 class="research-companies__section" id="research-company-releases-title">@L["Research.Companies.Releases.Title"]</h3>
                <p class="research-companies__hint">@L["Research.Companies.Releases.Hint"]</p>
                <p class="research-companies__releases-loading" data-research-releases-loading hidden>@L["Research.Companies.Releases.Loading"]</p>
                <ol class="research-companies__release-list" data-research-releases-list hidden></ol>
                <p class="research-companies__releases-empty" data-research-releases-empty hidden>@L["Research.Companies.Releases.Empty"]</p>
                <section class="unavailable-state research-companies__releases-unavailable"
                         data-research-releases-unavailable hidden>
                    <div class="unavailable-state__body">
                        <h4 class="unavailable-state__title">@L["Research.Companies.Releases.Unavailable"]</h4>
                        <p class="unavailable-state__text">@L["Research.Companies.Releases.UnavailableText"]</p>
                    </div>
                    <button type="button" class="btn btn-primary btn-sm" data-research-releases-retry>@L["Shell.Unavailable.Retry"]</button>
                </section>
            </section>

            <h3 class="research-companies__section">@L["Research.Companies.RecentFilings"]</h3>
            <ol class="research-companies__filings" data-research-company-filings></ol>
            <p class="research-companies__all-filings">
                <a data-field="all-filings" href="https://www.sec.gov/edgar/search/" target="_blank" rel="noopener noreferrer">
                    @L["Research.Companies.AllFilings"]<span class="visually-hidden"> @L["Research.Common.OpensInNewTab"]</span>
                </a>
            </p>
        </div>

        <p class="research-card__source">@L["Research.Source.Edgar"]</p>
    </div>

    <aside class="research-panel" aria-label="@L["Research.Companies.PanelLabel"]">
        <h2 class="research-panel__title">@L["Research.Common.AboutThisData"]</h2>
        <p>@L["Research.Companies.About1"]</p>
        <p>@L["Research.Companies.About2"]</p>
        <p>@L["Research.Companies.About3"]</p>
        <p>@L["Research.Companies.About4"]</p>
        <h2 class="research-panel__title">@L["Research.Common.DataAsOf"]</h2>
        <p class="research-panel__as-of" data-field="as-of">@L["Research.Js.Companies.AsOfPrompt"]</p>
    </aside>
</section>
