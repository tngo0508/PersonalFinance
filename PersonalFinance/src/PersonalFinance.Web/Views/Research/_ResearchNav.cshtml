@model string
@*
    The Research sub-navigation: Home, Sectors, World, Funds and Your basket (with how many funds it holds), and the
    compact search box (_ResearchSearch) on every page but Home, which has its own large one. The model is the active page: home,
    sectors, world, funds or basket. Links carry data-research-link so research-basket.js adds the Fund Basket to them;
    the page loads research-basket.js and research-search.js, with <js-strings prefix="Research.Js." />.
*@
@{
    string activePage = Model ?? string.Empty;
    (string Page, string Href, string LabelKey)[] links =
    [
        ("home", Url.Content("~/Research"), "Research.Nav.Home"),
        ("sectors", Url.Content("~/Research/Sectors"), "Research.Nav.Sectors"),
        ("world", Url.Content("~/Research/World"), "Research.Nav.World"),
        ("funds", Url.Content("~/Research/Funds"), "Research.Nav.Funds"),
        ("basket", Url.Content("~/Research/Basket"), "Research.Nav.Basket")
    ];
}
<nav class="research-nav" aria-label="@L["Research.Nav.Label"]">
    <ul class="research-nav__links">
        @foreach ((string page, string href, string labelKey) in links)
        {
            <li>
                <a class="research-nav__link" href="@href" data-research-link
                   aria-current="@(page == activePage ? "page" : null)">
                    @L[labelKey]
                    @if (page == "basket")
                    {
                        <span class="research-nav__count" data-research-basket-count>0</span>
                    }
                </a>
            </li>
        }
    </ul>
    @if (activePage != "home")
    {
        <partial name="_ResearchSearch" model="@(new ResearchSearchViewModel("research-nav-search", Large: false, CssClass: "research-nav__search"))"/>
    }
</nav>
