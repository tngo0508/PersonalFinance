@model ResearchWorldPanelViewModel
@using System.Globalization
@using PersonalFinance.Shared.DTOs.Research

@{
    WorldSnapshotDto? world = Model.World.Unavailable ? null : Model.World.Snapshot;
    // The basket view needs the funds data (for the basket) and the exposure, not the World data.
    FundExposureSnapshotDto? exposure = Model.BasketView ? Model.Exposure : null;
    bool showBasketView = exposure is not null;
    CultureInfo culture = CultureInfo.CurrentCulture;
    string exposureDates = exposure is null
        ? string.Empty
        : exposure.Funds.Min(f => f.ReportDate) == exposure.AsOf
            ? L.Named("Research.Common.AsOf", ("date", exposure.AsOf.ToString(ResearchFormats.LongDate, culture)))
            : L.Named("Research.Common.AsOfRange", ("from", exposure.Funds.Min(f => f.ReportDate).ToString(ResearchFormats.LongDate, culture)),
                ("to", exposure.AsOf.ToString(ResearchFormats.LongDate, culture)));
    // Razor keeps a data-* attribute whose value is null (as an empty one), so the optional ones are written only when
    // they apply: an empty data-research-country or data-research-world-view would read as "asked for nothing".
    System.Text.Encodings.Web.HtmlEncoder encoder = System.Text.Encodings.Web.HtmlEncoder.Default;
    string optionalAttributes = string.Concat(
        world is not null && Model.Country is not null ? $" data-research-country=\"{encoder.Encode(Model.Country)}\"" : string.Empty,
        showBasketView && Model.View is not null ? $" data-research-world-view=\"{encoder.Encode(Model.View)}\"" : string.Empty,
        showBasketView && Model.BasketOnly ? " data-research-world-basket-only" : string.Empty);
    // On the Basket page only the basket view is drawn: no switch, scrubber or market map.
    bool showMarket = !Model.BasketOnly;
    if (!showMarket)
    {
        world = null;
    }
}

@* The World panel, on the World page and (basket view only) the Basket page. research-page.js wires its scrubber and
   table by the id research-panel-world, and research-world.js and
   research-world-basket.js find their parts. The market map is stock-market capitalisation by country (World Bank WDI),
   drawn by js/research/research-world.js as a choropleth from the data island below and the vendored world-atlas
   borders. data-research-country is the country it opens with selected; data-research-world-view the view it opens on.
   *@
<section class="research-deck" id="research-panel-world"
         @Html.Raw(optionalAttributes)>
    @if (showBasketView)
    {
        @* World market (the existing choropleth) or Your basket (its funds' issuer countries, weighted). It opens on Your
           basket only when a Fund Basket is set; js/research/research-world-basket.js wires it. *@
        <div class="research-world__views" id="research-world-views" hidden="@(!showMarket)">
            <div class="research-view-toggle" role="group" aria-label="@L["Research.World.ViewLabel"]">
                <button type="button" class="research-view-toggle__button" data-world-view="market" aria-pressed="true">@L["Research.World.Market"]</button>
                <button type="button" class="research-view-toggle__button" data-world-view="basket" aria-pressed="false">@L["Research.Js.Common.YourBasket"]</button>
            </div>
        </div>
    }
    @if (world is not null)
    {
        <div class="research-scrubber" data-research-scrubber data-world-view-part="market">
            <button type="button" class="research-scrubber__play" data-research-play data-state="paused"
                    aria-label="@L["Research.Js.Page.PlayYears"]">
                <svg class="research-scrubber__icon research-scrubber__icon--play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 4v16l13-8z"/></svg>
                <svg class="research-scrubber__icon research-scrubber__icon--pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 4h4v16H6zM14 4h4v16h-4z"/></svg>
            </button>
            <div class="research-scrubber__track">
                <label class="visually-hidden" for="research-world-year">@L["Research.Common.Year"]</label>
                <input type="range" class="research-scrubber__range" id="research-world-year" data-research-range
                       min="0" max="@(world.Periods.Count - 1)" step="1" value="@(world.Periods.Count - 1)"
                       aria-valuetext="@world.Periods[^1]"/>
                <div class="research-scrubber__ends" aria-hidden="true">
                    <span>@world.Periods[0]</span>
                    <span>@world.Periods[^1]</span>
                </div>
            </div>
            <p class="research-scrubber__period" data-research-period aria-hidden="true">@world.Periods[^1]</p>
        </div>
    }
    @if (showMarket)
    {
        <div class="research-card" data-world-view-part="market">
            <h2 class="research-card__title">@L["Research.World.Title"]</h2>
            @if (Model.BasketUnavailableState is not null)
            {
                @* The basket view was asked for, but the funds or fund exposure data could not be read: only that view is
                   unavailable, and the map still shows below. *@
                <partial name="_UnavailableState" model="Model.BasketUnavailableState"/>
            }
            @if (world is null)
            {
                <partial name="_UnavailableState" model="Model.World.UnavailableState"/>
            }
            else
            {
                <p class="research-card__subtitle" id="research-world-subtitle">
                    @L.Named("Research.World.Subtitle", ("period", world.Periods[^1]))
                </p>
                <div class="research-world" id="research-world-map"
                     data-atlas-url="@Url.Content("~/lib/world-atlas/countries-110m.json")"></div>
                <div class="research-tooltip" id="research-world-tooltip" aria-hidden="true" hidden></div>
                <div class="research-card__actions">
                    <button type="button" class="research-chip" data-research-table-toggle aria-pressed="false"
                            aria-controls="research-world-table">@L["Research.Js.Common.ShowTable"]</button>
                </div>
                <div class="research-table-host" id="research-world-table" data-research-table hidden></div>
            }
            <p class="research-card__source">@L["Research.Source.World"]</p>
        </div>

        <aside class="research-panel" aria-label="@L["Research.World.PanelLabel"]" data-world-view-part="market">
            @if (world is not null)
            {
                @* The country detail: the chosen country's figures for the scrubber's year. A country is chosen here (the
                   keyboard path) or by clicking it on the map; research-world.js fills the detail. *@
                <h2 class="research-panel__title">@L["Research.World.CountryTitle"]</h2>
                <label class="visually-hidden" for="research-world-country">@L["Research.World.CountryLabel"]</label>
                <select class="form-select form-select-sm research-world__country-select" id="research-world-country">
                    <option value="">@L["Research.World.CountryNone"]</option>
                    @foreach (string name in world.Countries.Select(c => c.Name).Distinct(StringComparer.Ordinal).Order(StringComparer.Create(culture, ignoreCase: true)))
                    {
                        <option value="@name">@name</option>
                    }
                </select>
                <p class="research-panel__note" id="research-world-detail-hint">@L["Research.World.CountryHint"]</p>
                <div class="research-world__detail" id="research-world-detail" hidden></div>
                <h2 class="research-panel__title">@L["Research.World.ColourBy"]</h2>
                <div class="research-world__metrics" role="group" aria-label="@L["Research.World.MetricLabel"]">
                    <button type="button" class="research-chip" data-research-world-metric="marketCap"
                            aria-pressed="true">@L["Research.Js.World.MarketCap"]</button>
                    <button type="button" class="research-chip" data-research-world-metric="percentOfGdp"
                            aria-pressed="false">@L["Research.Js.World.PercentOfGdp"]</button>
                </div>
                <h2 class="research-panel__title">@L["Research.World.Legend"]</h2>
                <ol class="research-legend" id="research-world-legend"></ol>
            }
            <h2 class="research-panel__title">@L["Research.Common.AboutThisData"]</h2>
            <p>@L["Research.World.About1"]</p>
            <p>@L["Research.World.About2"]</p>
            <h2 class="research-panel__title">@L["Research.Common.DataAsOf"]</h2>
            <p class="research-panel__as-of">
                @(Model.World.AsOf is { } asOf && world is not null ? asOf.ToString(ResearchFormats.LongDate, culture) : L["Research.Common.NotLoadedYet"].Value)
            </p>
        </aside>
    }

    @if (showBasketView)
    {
        <div class="research-card research-world-basket" id="research-world-basket" data-world-view-part="basket" hidden="@showMarket">
            <h2 class="research-card__title">@L["Research.WorldBasket.Title"]</h2>
            <p class="research-card__subtitle">@L.Named("Research.WorldBasket.Subtitle", ("dates", exposureDates))</p>
            <p class="research-overlap__prompt" id="research-world-basket-prompt">@L["Research.WorldBasket.Prompt"]</p>
            <div class="research-overlap__view" id="research-world-basket-view" hidden>
                <ul class="research-overlap__callouts" id="research-world-basket-callouts" aria-label="@L["Research.WorldBasket.CalloutsLabel"]"></ul>
                @* Two home-bias meters: US issuers against the rest of the world, US dollars against other currencies. *@
                <div class="research-world-basket__meters" id="research-world-basket-meters"></div>
                <div class="research-world-basket__layout">
                    <div class="research-world-basket__main">
                        @* Scroll or pinch to zoom, drag to pan; countries and the small places drawn as dots are focusable. *@
                        <div class="research-world research-world-basket__map" id="research-world-basket-map" role="group"
                             data-atlas-url="@Url.Content("~/lib/world-atlas/countries-110m.json")"></div>
                        <div class="research-world-basket__map-actions">
                            <button type="button" class="research-chip" id="research-world-basket-reset">@L["Research.WorldBasket.ResetZoom"]</button>
                        </div>
                        <ol class="research-legend" id="research-world-basket-legend" aria-label="@L["Research.WorldBasket.ScaleLabel"]"></ol>
                    </div>
                    <div class="research-world-basket__bars">
                        @* Each region lights its countries on the map while pointed at or focused; choosing it keeps them lit. *@
                        <h3 class="research-world-basket__bars-title" id="research-world-basket-regions-title">@L["Research.WorldBasket.Regions"]</h3>
                        <ul class="research-world-basket__list" id="research-world-basket-regions" aria-labelledby="research-world-basket-regions-title"></ul>
                        <h3 class="research-world-basket__bars-title" id="research-world-basket-currencies-title">@L["Research.WorldBasket.PricedIn"]</h3>
                        <ul class="research-world-basket__list" id="research-world-basket-currencies" aria-labelledby="research-world-basket-currencies-title"></ul>
                    </div>
                </div>
                <p class="research-overlap__note" id="research-world-basket-note"></p>
            </div>
            <div class="research-tooltip" id="research-world-basket-tooltip" aria-hidden="true" hidden></div>
            <p class="research-card__source">@L["Research.Source.WorldBasket"]</p>
        </div>

        <aside class="research-panel" data-world-view-part="basket" aria-label="@L["Research.WorldBasket.PanelLabel"]" hidden="@showMarket">
            <h2 class="research-panel__title">@L["Research.Common.HowToRead"]</h2>
            <p>@L["Research.WorldBasket.HowToRead"]</p>
            <h2 class="research-panel__title">@L["Research.Common.AboutThisData"]</h2>
            <p>@L["Research.WorldBasket.About"]</p>
            <h2 class="research-panel__title">@L["Research.Common.DataAsOf"]</h2>
            <p class="research-panel__as-of">@exposureDates</p>
        </aside>
    }

    @if (world is not null)
    {
        @* The World snapshot as a JSON data island (camelCase, HTML-safe encoding), read by research-world.js. *@
        <script type="application/json" id="research-world-data">@Json.Serialize(world)</script>
    }
    @if (showBasketView)
    {
        @* The fund exposure snapshot (country and currency shares per fund), read by research-world-basket.js. *@
        <script type="application/json" id="research-fund-exposure-data">@Json.Serialize(exposure)</script>
    }
</section>
