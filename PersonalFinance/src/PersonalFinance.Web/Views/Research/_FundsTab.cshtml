@model ResearchViewModel
@using System.Globalization
@using PersonalFinance.Shared.DTOs.Research

@{
    FundsPeriodDto? latest = Model.Funds.LatestPeriod;
    bool showFunds = !Model.Funds.Unavailable && latest is not null;
    CultureInfo culture = CultureInfo.CurrentCulture;
    FundOverlapSnapshotDto? overlap = Model.FundOverlap;
    FundReturnsSnapshotDto? returns = Model.FundReturns;
    string overlapDates = overlap is null || overlap.Funds.Count == 0
        ? string.Empty
        : overlap.Funds.Min(f => f.ReportDate) == overlap.Funds.Max(f => f.ReportDate)
            ? L.Named("Research.Common.AsOf", ("date", overlap.AsOf.ToString(ResearchViewModel.LongDate, culture)))
            : L.Named("Research.Common.AsOfRange", ("from", overlap.Funds.Min(f => f.ReportDate).ToString(ResearchViewModel.LongDate, culture)),
                ("to", overlap.AsOf.ToString(ResearchViewModel.LongDate, culture)));
}

@* The Funds tab: the overlap of the Fund Basket's funds (js/research/research-overlap.js, from each fund's latest
   report) and how closely their returns move together (js/research/research-correlation.js), then the list of what
   the Tracked Funds hold in the latest quarter (_FundHoldingsList, shared with the Funds page: fund, then N-PORT asset
   category, then holdings). Hidden until its tab is chosen. *@
<section class="research-deck research-deck--stacked" id="research-panel-funds" data-research-basket role="tabpanel" aria-labelledby="research-tab-funds"
         hidden="@(!Model.IsSelected(ResearchViewModel.FundsTab))">
    @if (showFunds)
    {
        <div class="research-card research-overlap" id="research-overlap">
            <h2 class="research-card__title">@L["Research.Funds.Overlap.Title"]</h2>
            @if (overlap is null)
            {
                <partial name="_UnavailableState" model="Model.FundOverlapUnavailableState"/>
            }
            else
            {
                <p class="research-card__subtitle">@L.Named("Research.Funds.Overlap.Subtitle", ("dates", overlapDates))</p>
                <p class="research-overlap__prompt" id="research-overlap-prompt">@L["Research.Funds.Overlap.Prompt"]</p>
                <div class="research-overlap__view" id="research-overlap-view" hidden>
                    <ul class="research-overlap__callouts" id="research-overlap-callouts" aria-label="@L["Research.Funds.Overlap.CalloutsLabel"]"></ul>
                    <div class="research-overlap__body">
                        <div class="research-overlap__matrix" id="research-overlap-matrix"></div>
                        <div class="research-overlap__duplicates">
                            <div class="research-overlap__filter" id="research-overlap-filter" hidden>
                                <span id="research-overlap-filter-text"></span>
                                <button type="button" class="research-chip" id="research-overlap-filter-clear">@L["Research.Funds.Overlap.ShowAll"]</button>
                            </div>
                            <div class="research-overlap__table" id="research-overlap-table"></div>
                        </div>
                    </div>
                    <p class="research-overlap__note">@L["Research.Funds.Overlap.Note"]</p>
                </div>
                <div class="research-tooltip" id="research-overlap-tooltip" aria-hidden="true" hidden></div>
            }
            <p class="research-card__source">@L["Research.Source.Nport"]</p>
        </div>
        <div class="research-card research-correlation" id="research-correlation">
            <h2 class="research-card__title">@L["Research.Funds.Correlation.Title"]</h2>
            @if (returns is null)
            {
                <partial name="_UnavailableState" model="Model.FundReturnsUnavailableState"/>
            }
            else
            {
                <p class="research-card__subtitle">
                    @L.Named("Research.Funds.Correlation.Subtitle", ("month", returns.AsOf.ToString(ResearchViewModel.MonthYear, culture)))
                </p>
                <div class="research-correlation__controls">
                    <div class="research-view-toggle" role="group" aria-label="@L["Research.Common.Window"]">
                        <button type="button" class="research-view-toggle__button" data-correlation-years="1" aria-pressed="false">@L["Research.Common.OneYear"]</button>
                        <button type="button" class="research-view-toggle__button" data-correlation-years="3" aria-pressed="true">@L["Research.Common.ThreeYears"]</button>
                        <button type="button" class="research-view-toggle__button" data-correlation-years="5" aria-pressed="false">@L["Research.Common.FiveYears"]</button>
                    </div>
                    <button type="button" class="research-chip" id="research-correlation-all" aria-pressed="false">@L["Research.Funds.Correlation.All"]</button>
                </div>
                <p class="research-overlap__prompt" id="research-correlation-prompt">@L["Research.Funds.Correlation.Prompt"]</p>
                <div class="research-overlap__view" id="research-correlation-view" hidden>
                    <ul class="research-overlap__callouts" id="research-correlation-callouts" aria-label="@L["Research.Funds.Correlation.CalloutsLabel"]"></ul>
                    <div class="research-overlap__matrix" id="research-correlation-matrix"></div>
                    <p class="research-overlap__note">@L["Research.Funds.Correlation.Note"]</p>
                </div>
                <div class="research-tooltip" id="research-correlation-tooltip" aria-hidden="true" hidden></div>
            }
            <p class="research-card__source">@L["Research.Source.NportReturns"]</p>
        </div>
    }
    <div class="research-card" id="research-holdings">
        <h2 class="research-card__title">@L["Research.Funds.Holdings.Title"]</h2>
        @if (!showFunds)
        {
            <partial name="_UnavailableState" model="Model.Funds.UnavailableState"/>
        }
        else
        {
            <p class="research-card__subtitle">@L.Named("Research.Funds.Holdings.Subtitle", ("period", latest!.Period))</p>
            <partial name="_FundHoldingsList" model="@(new FundHoldingsListViewModel { Period = latest, Funds = Model.Funds.Snapshot!.Funds })"/>
        }
        <p class="research-card__source">@L["Research.Source.Nport"]</p>
    </div>

    <aside class="research-panel" aria-label="@L["Research.Funds.PanelLabel"]">
        @if (showFunds)
        {
            <h2 class="research-panel__title">@L["Research.Funds.HowToRead"]</h2>
            <p>@L["Research.Funds.HowToReadText"]</p>
        }
        <h2 class="research-panel__title">@L["Research.Common.AboutThisData"]</h2>
        <p>@L["Research.Funds.About1"]</p>
        <p>@L["Research.Funds.About2"]</p>
        <h2 class="research-panel__title">@L["Research.Common.DataAsOf"]</h2>
        <p class="research-panel__as-of">
            @(Model.Funds.AsOf is { } asOf ? asOf.ToString(ResearchViewModel.LongDate, culture) : L["Research.Common.NotLoadedYet"].Value)
        </p>
    </aside>
</section>

@if (showFunds)
{
    @* The funds snapshot as a JSON data island (camelCase, HTML-safe encoding): the Tracked Funds, read by research-basket.js, research-performance.js and research-risk.js. *@
    <script type="application/json" id="research-funds-data">@Json.Serialize(Model.Funds.Snapshot)</script>
    if (overlap is not null)
    {
        @* The fund overlap snapshot (pair percentages and named shared holdings, never an identifier), read by
           research-overlap.js. *@
        <script type="application/json" id="research-fund-overlap-data">@Json.Serialize(overlap)</script>
    }
}
