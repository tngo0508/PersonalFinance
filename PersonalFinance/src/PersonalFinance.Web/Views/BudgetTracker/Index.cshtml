@using Microsoft.AspNetCore.Html
@using System.Text.Json
@model BudgetTrackerViewModel

@{
    ViewData["Title"] = L["BudgetTracker.Title"].Value;
    // Rows and totals are in the Account's Reporting Currency (ADR 0016); each line and transaction keeps its own.
    string reportingCurrency = SupportedCurrencies.CodeOrDefault(Model.Sheet?.ReportingCurrency);
    string zero = MoneyFormatter.Format(0m, reportingCurrency);
    string currencySymbol = SupportedCurrencies.Find(reportingCurrency)!.Symbol;

    // The masthead: the month is the title, its neighbours are the page-turn buttons, and one sentence per section
    // says where the month stands. budget-tracker.js rewrites all of these in the page culture on every load.
    var firstOfMonth = new DateTime(Model.Year, Model.Month, 1);
    string monthTitle = firstOfMonth.ToString("MMMM yyyy");
    string previousMonthName = firstOfMonth.AddMonths(-1).ToString("MMM");
    string nextMonthName = firstOfMonth.AddMonths(1).ToString("MMM");
    string Money(decimal? amount) => MoneyFormatter.Format(amount ?? 0m, reportingCurrency);
    string spentLine = L.Named("BudgetTracker.Js.SpentLine",
        ("actual", Money(Model.Sheet?.Expenses?.TotalActual)), ("planned", Money(Model.Sheet?.Expenses?.TotalPlanned)));
    string earnedLine = L.Named("BudgetTracker.Js.EarnedLine",
        ("actual", Money(Model.Sheet?.Income?.TotalActual)), ("planned", Money(Model.Sheet?.Income?.TotalPlanned)));
}

@section Styles {
    <link rel="stylesheet" href="~/css/budget-tracker.css" asp-append-version="true"/>
}

<div class="bt-page bt-relative" id="budgetTrackerContainer" data-year="@Model.Year" data-month="@Model.Month" data-reporting-currency="@reportingCurrency">
    @Html.AntiForgeryToken()

    <!-- Loading Overlay -->
    <div id="btGlobalLoading" class="bt-loading-overlay d-none">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["BudgetTracker.Loading"]</span>
        </div>
    </div>

    <!-- Masthead: the month as the title, flanked by its neighbours; the jump selects at the right -->
    <header class="bt-masthead">
        <div class="bt-masthead__row">
            <nav class="bt-month-turn" aria-label="@L["BudgetTracker.MonthNav.Label"]">
                <button type="button" class="bt-month-step bt-month-step--prev" id="btnPrevMonth"
                        title="@L["BudgetTracker.MonthNav.Previous"]" aria-label="@L["BudgetTracker.MonthNav.Previous"]">
                    <svg class="bt-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"/></svg>
                    <span class="bt-month-step__label" id="btnPrevMonthText" aria-hidden="true">@previousMonthName</span>
                </button>
                <h1 class="bt-page-header__title" id="btMonthTitle">@monthTitle</h1>
                <button type="button" class="bt-month-step bt-month-step--next" id="btnNextMonth"
                        title="@L["BudgetTracker.MonthNav.Next"]" aria-label="@L["BudgetTracker.MonthNav.Next"]">
                    <span class="bt-month-step__label" id="btnNextMonthText" aria-hidden="true">@nextMonthName</span>
                    <svg class="bt-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg>
                </button>
            </nav>

            <div class="bt-month-jump">
                <label for="selectMonth" class="visually-hidden">@L["BudgetTracker.MonthNav.Month"]</label>
                <select id="selectMonth" class="form-select form-select-sm bt-month-jump__select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        var mName = new DateTime(2026, m, 1).ToString("MMMM");
                        <option value="@m" selected="@(m == Model.Month ? "selected" : null)">@mName</option>
                    }
                </select>

                <label for="selectYear" class="visually-hidden">@L["BudgetTracker.MonthNav.Year"]</label>
                <select id="selectYear" class="form-select form-select-sm bt-month-jump__select">
                    @for (int y = Model.Year - 3; y <= Model.Year + 3; y++)
                    {
                        <option value="@y" selected="@(y == Model.Year ? "selected" : null)">@y</option>
                    }
                </select>
            </div>
        </div>

        <p class="bt-page-header__subtitle" id="btMonthLine">
            <span id="btSpentLine">@spentLine</span>
            <span id="btEarnedLine">@earnedLine</span>
        </p>
    </header>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning mb-3" role="alert">
            @Model.ErrorMessage
        </div>
    }

    <!-- Global Alert / Status Box -->
    <div id="btAlert" class="alert alert-danger alert-dismissible fade bt-alert" role="alert">
        <span id="btAlertMessage"></span>
        <button type="button" class="btn-close" id="btnDismissAlert" aria-label="@L["Common.Close"]"></button>
    </div>

    <!-- New Month Prompt (the month has no plan yet) -->
    <div id="btInitPrompt" class="bt-init-prompt d-none">
        <div class="bt-init-prompt__text">
            <h2 class="bt-init-prompt__title" id="initPromptHeading">@L["BudgetTracker.InitPrompt.Heading"]</h2>
            <p class="bt-init-prompt__desc" id="initPromptDesc">
                @L["BudgetTracker.InitPrompt.Description"]
            </p>
        </div>
        <div class="bt-init-prompt__actions">
            <button type="button" class="btn btn-primary btn-sm d-none" id="btnCopyPrevious">
                <span id="btnCopyPreviousText">@L["BudgetTracker.InitPrompt.CopyPrevious"]</span>
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnStartBlank">
                @L["BudgetTracker.InitPrompt.StartBlank"]
            </button>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs bt-tabs" id="btTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tabSummary-btn" data-bs-toggle="tab" data-bs-target="#tabSummary"
                    type="button" role="tab" aria-controls="tabSummary" aria-selected="true">
                @L["BudgetTracker.Tabs.Summary"]
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tabTransactions-btn" data-bs-toggle="tab" data-bs-target="#tabTransactions"
                    type="button" role="tab" aria-controls="tabTransactions" aria-selected="false">
                @L["BudgetTracker.Tabs.Transactions"]
                <span class="bt-tabs__count" id="txCountBadge">@(Model.Sheet?.Transactions?.Count ?? 0)</span>
            </button>
        </li>
    </ul>

    <!-- Tab Panels -->
    <div class="tab-content" id="btTabContent">
        <!-- TAB 1: SUMMARY, one ledger sheet: Expenses then Income -->
        <div class="tab-pane fade show active" id="tabSummary" role="tabpanel" aria-labelledby="tabSummary-btn"
             tabindex="0">
            @* Filled by budget-tracker.js: which rate converted lines and transactions in other currencies. *@
            <p class="conversion-caption" id="btConversionCaption" hidden></p>

            <section class="bt-section" aria-labelledby="btExpensesTitle">
                <div class="bt-section__head">
                    <h2 class="bt-section__title bt-section__title--expense" id="btExpensesTitle">@L["BudgetTracker.Js.Expenses"]</h2>
                    <button type="button" class="bt-add" id="btnAddExpenseCategory"
                            title="@L["BudgetTracker.Summary.AddExpenseCategory"]">
                        <svg class="bt-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>
                        @L["BudgetTracker.Summary.AddCategory"]
                    </button>
                </div>

                <div class="bt-ledger-scroll">
                    <table class="bt-ledger" id="tableExpenses" aria-label="@L["BudgetTracker.Summary.ExpensesTable"]">
                        <thead>
                        <tr>
                            <th scope="col" class="bt-ledger__name">@L["BudgetTracker.Column.Category"]</th>
                            <th scope="col" class="bt-ledger__num">@L["BudgetTracker.Column.Planned"]</th>
                            <th scope="col" class="bt-ledger__num">@L["BudgetTracker.Column.Actual"]</th>
                            <th scope="col" class="bt-ledger__num">@L["BudgetTracker.Column.Diff"]</th>
                            <th scope="col" class="bt-ledger__variance">@L["BudgetTracker.Column.Variance"]</th>
                            <th scope="col" class="bt-ledger__actions"><span class="visually-hidden">@L["BudgetTracker.Column.Actions"]</span></th>
                        </tr>
                        </thead>
                        <tbody id="tbodyExpenses">
                        <!-- Rendered by budget-tracker.js -->
                        </tbody>
                        <tfoot>
                        <tr>
                            <th scope="row" class="bt-ledger__name">@L["BudgetTracker.Summary.TotalExpenses"]</th>
                            <td class="bt-ledger__num" id="totalExpensePlanned">@zero</td>
                            <td class="bt-ledger__num" id="totalExpenseActual">@zero</td>
                            <td class="bt-ledger__num" id="totalExpenseDiff">@zero</td>
                            <td class="bt-ledger__variance" id="totalExpenseVariance"></td>
                            <td class="bt-ledger__actions"></td>
                        </tr>
                        </tfoot>
                    </table>
                </div>
            </section>

            <section class="bt-section" aria-labelledby="btIncomeTitle">
                <div class="bt-section__head">
                    <h2 class="bt-section__title bt-section__title--income" id="btIncomeTitle">@L["BudgetTracker.Js.Income"]</h2>
                    <button type="button" class="bt-add" id="btnAddIncomeCategory"
                            title="@L["BudgetTracker.Summary.AddIncomeCategory"]">
                        <svg class="bt-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>
                        @L["BudgetTracker.Summary.AddCategory"]
                    </button>
                </div>

                <div class="bt-ledger-scroll">
                    <table class="bt-ledger" id="tableIncome" aria-label="@L["BudgetTracker.Summary.IncomeTable"]">
                        <thead>
                        <tr>
                            <th scope="col" class="bt-ledger__name">@L["BudgetTracker.Column.Category"]</th>
                            <th scope="col" class="bt-ledger__num">@L["BudgetTracker.Column.Planned"]</th>
                            <th scope="col" class="bt-ledger__num">@L["BudgetTracker.Column.Actual"]</th>
                            <th scope="col" class="bt-ledger__num">@L["BudgetTracker.Column.Diff"]</th>
                            <th scope="col" class="bt-ledger__variance">@L["BudgetTracker.Column.Variance"]</th>
                            <th scope="col" class="bt-ledger__actions"><span class="visually-hidden">@L["BudgetTracker.Column.Actions"]</span></th>
                        </tr>
                        </thead>
                        <tbody id="tbodyIncome">
                        <!-- Rendered by budget-tracker.js -->
                        </tbody>
                        <tfoot>
                        <tr>
                            <th scope="row" class="bt-ledger__name">@L["BudgetTracker.Summary.TotalIncome"]</th>
                            <td class="bt-ledger__num" id="totalIncomePlanned">@zero</td>
                            <td class="bt-ledger__num" id="totalIncomeActual">@zero</td>
                            <td class="bt-ledger__num" id="totalIncomeDiff">@zero</td>
                            <td class="bt-ledger__variance" id="totalIncomeVariance"></td>
                            <td class="bt-ledger__actions"></td>
                        </tr>
                        </tfoot>
                    </table>
                </div>
            </section>
        </div>

        <!-- TAB 2: TRANSACTIONS, one dated journal for the month -->
        <div class="tab-pane fade" id="tabTransactions" role="tabpanel" aria-labelledby="tabTransactions-btn"
             tabindex="0">
            <section class="bt-section" aria-label="@L["BudgetTracker.Tabs.Transactions"]">
                <div class="bt-section__head">
                    <p class="bt-section__intro">@L["BudgetTracker.Transactions.Intro"]</p>
                    <button type="button" class="btn btn-primary btn-sm bt-add-tx" id="btnAddTransaction">
                        <svg class="bt-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>
                        @L["BudgetTracker.Js.AddTransaction"]
                    </button>
                </div>

                <div class="bt-ledger-scroll">
                    <table class="bt-ledger bt-journal" id="tableJournal" aria-label="@L["BudgetTracker.Tabs.Transactions"]">
                        <thead>
                        <tr>
                            <th scope="col" class="bt-journal__date">@L["BudgetTracker.Column.Date"]</th>
                            <th scope="col" class="bt-journal__desc">@L["BudgetTracker.Column.Description"]</th>
                            <th scope="col" class="bt-journal__cat">@L["BudgetTracker.Column.Category"]</th>
                            <th scope="col" class="bt-ledger__num">@L["BudgetTracker.Column.Amount"]</th>
                            <th scope="col" class="bt-ledger__actions"><span class="visually-hidden">@L["BudgetTracker.Column.Actions"]</span></th>
                        </tr>
                        </thead>
                        <tbody id="tbodyJournal">
                        <!-- Rendered by budget-tracker.js -->
                        </tbody>
                    </table>
                </div>
                <div id="emptyJournal" class="bt-empty" hidden>
                    <p class="bt-empty__text">@L["BudgetTracker.Transactions.Empty"]</p>
                </div>
            </section>
        </div>
    </div>

    <!-- MODAL 1: ADD CATEGORY -->
    <div class="modal fade" id="modalAddCategory" tabindex="-1" aria-labelledby="modalAddCategoryTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="formAddCategory">
                    <div class="modal-header">
                        <h3 class="modal-title fs-5" id="modalAddCategoryTitle">@L["BudgetTracker.AddCategory.Title"]</h3>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger d-none modal-error-alert mb-3" id="alertAddCategory"
                             role="alert"></div>
                        <div class="mb-3">
                            <label for="inputCategoryName" class="form-label">@L["BudgetTracker.Category.Name"]</label>
                            <input type="text" class="form-control" id="inputCategoryName" maxlength="100" required
                                   placeholder="@L["BudgetTracker.AddCategory.NamePlaceholder"]"/>
                        </div>
                        <div class="mb-3">
                            <label for="selectCategoryKind" class="form-label">@L["BudgetTracker.Category.Type"]</label>
                            <select class="form-select" id="selectCategoryKind" required>
                                <option value="1">@L["BudgetTracker.Category.Expense"]</option>
                                <option value="2">@L["BudgetTracker.Category.Income"]</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Common.Cancel"]</button>
                        <button type="submit" class="btn btn-primary" id="btnSubmitCategory">@L["BudgetTracker.Summary.AddCategory"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 2: EDIT / RENAME CATEGORY -->
    <div class="modal fade" id="modalEditCategory" tabindex="-1" aria-labelledby="modalEditCategoryTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="formEditCategory">
                    <input type="hidden" id="editCategoryId"/>
                    <input type="hidden" id="editCategorySortOrder"/>
                    <input type="hidden" id="editCategoryKind"/>
                    <div class="modal-header">
                        <h3 class="modal-title fs-5" id="modalEditCategoryTitle">@L["BudgetTracker.EditCategory.Title"]</h3>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger d-none modal-error-alert mb-3" id="alertEditCategory"
                             role="alert"></div>
                        <div class="mb-3">
                            <label for="inputEditCategoryName" class="form-label">@L["BudgetTracker.Category.Name"]</label>
                            <input type="text" class="form-control" id="inputEditCategoryName" maxlength="100" required
                                   placeholder="@L["BudgetTracker.EditCategory.NamePlaceholder"]"/>
                        </div>
                        <div class="mb-3">
                            <label for="selectEditCategoryKind" class="form-label">@L["BudgetTracker.Category.Type"]</label>
                            <select class="form-select" id="selectEditCategoryKind" disabled>
                                <option value="1">@L["BudgetTracker.Category.Expense"]</option>
                                <option value="2">@L["BudgetTracker.Category.Income"]</option>
                            </select>
                            <div class="form-text">@L["BudgetTracker.EditCategory.TypeLocked"]</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Common.Cancel"]</button>
                        <button type="submit" class="btn btn-primary" id="btnSubmitEditCategory">@L["BudgetTracker.EditCategory.Save"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 3: ACTUAL OVERRIDE -->
    <div class="modal fade" id="modalActualOverride" tabindex="-1" aria-labelledby="modalOverrideTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="formActualOverride">
                    <input type="hidden" id="overrideCategoryId"/>
                    <div class="modal-header">
                        <h3 class="modal-title fs-5" id="modalOverrideTitle">@L["BudgetTracker.Override.Title"]</h3>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger d-none modal-error-alert mb-3" id="alertActualOverride"
                             role="alert"></div>
                        <p class="text-muted small">
                            @L.NamedHtml("BudgetTracker.Override.Description", null,
                                ("category", new HtmlString("<strong id=\"overrideCategoryName\"></strong>")))
                        </p>
                        <div class="mb-3">
                            <label for="inputOverrideAmount" class="form-label">@L.NamedHtml("BudgetTracker.Override.Amount", null, ("symbol", new HtmlString($"<span id=\"overrideCurrencySymbol\">{currencySymbol}</span>")))</label>
                            <input type="number" step="0.01" min="0" max="9999999999999999.99" class="form-control"
                                   id="inputOverrideAmount" required placeholder="0.00"/>
                        </div>
                        <div class="mb-3">
                            <label for="selectOverrideCurrency" class="form-label">@L["BudgetTracker.Override.Currency"]</label>
                            <select class="form-select" id="selectOverrideCurrency" data-currency-selector data-currency-symbols="#overrideCurrencySymbol">
                                @foreach (var currency in SupportedCurrencies.All)
                                {
                                    <option value="@currency.Code" selected="@(currency.Code == reportingCurrency)">@currency.Code · @currency.DisplayName</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-danger me-auto d-none" id="btnModalRevertOverride">
                            @L["BudgetTracker.Override.Revert"]
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Common.Cancel"]</button>
                        <button type="submit" class="btn btn-primary" id="btnSubmitOverride">@L["BudgetTracker.Override.Save"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 4: ADD / EDIT TRANSACTION -->
    <div class="modal fade" id="modalTransaction" tabindex="-1" aria-labelledby="modalTransactionTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="formTransaction">
                    <input type="hidden" id="inputTxId"/>
                    <div class="modal-header">
                        <h3 class="modal-title fs-5" id="modalTransactionTitle">@L["BudgetTracker.Js.AddTransaction"]</h3>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger d-none modal-error-alert mb-3" id="alertTransaction"
                             role="alert"></div>
                        <div class="mb-3">
                            <label for="selectTxCategory" class="form-label">@L["BudgetTracker.Column.Category"]</label>
                            <select class="form-select" id="selectTxCategory" required>
                                <option value="">@L["BudgetTracker.Js.SelectCategory"]</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="inputTxDate" class="form-label">@L["BudgetTracker.Column.Date"]</label>
                            <input type="date" class="form-control" id="inputTxDate" required/>
                        </div>
                        <div class="mb-3">
                            <label for="inputTxAmount" class="form-label">@L.NamedHtml("BudgetTracker.Transaction.Amount", null, ("symbol", new HtmlString($"<span id=\"txCurrencySymbol\">{currencySymbol}</span>")))</label>
                            <input type="number" step="0.01" min="0.01" max="9999999999999999.99" class="form-control"
                                   id="inputTxAmount" required placeholder="0.00"/>
                        </div>
                        <div class="mb-3">
                            <label for="selectTxCurrency" class="form-label">@L["BudgetTracker.Transaction.Currency"]</label>
                            <select class="form-select" id="selectTxCurrency" data-currency-selector data-currency-symbols="#txCurrencySymbol">
                                @foreach (var currency in SupportedCurrencies.All)
                                {
                                    <option value="@currency.Code" selected="@(currency.Code == reportingCurrency)">@currency.Code · @currency.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="inputTxDescription" class="form-label">@L["BudgetTracker.Transaction.Description"]</label>
                            <input type="text" class="form-control" id="inputTxDescription" maxlength="200"
                                   placeholder="@L["BudgetTracker.Transaction.DescriptionPlaceholder"]"/>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Common.Cancel"]</button>
                        <button type="submit" class="btn btn-primary" id="btnSubmitTransaction">@L["BudgetTracker.Transaction.Save"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 5: DELETE CONFIRMATION -->
    <div class="modal fade" id="modalDeleteConfirm" tabindex="-1" aria-labelledby="modalDeleteConfirmTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 class="modal-title fs-5" id="modalDeleteConfirmTitle">@L["BudgetTracker.Delete.Title"]</h3>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger d-none modal-error-alert mb-3" id="alertDeleteConfirm"
                         role="alert"></div>
                    <p id="deleteConfirmMessage">@L["BudgetTracker.Delete.Message"]</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Common.Cancel"]</button>
                    <button type="button" class="btn btn-danger" id="btnConfirmDelete">@L["BudgetTracker.Js.Delete"]</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <js-strings prefix="BudgetTracker.Js." />
    <script>
        window.__initialSheetData = @Html.Raw(JsonSerializer.Serialize(Model.Sheet, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));
    </script>
    <script src="~/js/budget-tracker/budget-tracker.js" asp-append-version="true"></script>
}
