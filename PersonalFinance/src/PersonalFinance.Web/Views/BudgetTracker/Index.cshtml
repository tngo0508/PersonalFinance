@using PersonalFinance.Web.Features.BudgetTracker
@using System.Text.Json
@model BudgetTrackerViewModel

@{
    ViewData["Title"] = "Budget Tracker";
}

@section Styles {
    <link rel="stylesheet" href="~/css/budget-tracker.css" asp-append-version="true"/>
}

<div class="bt-page bt-relative" id="budgetTrackerContainer" data-year="@Model.Year" data-month="@Model.Month">
    @Html.AntiForgeryToken()

    <!-- Loading Overlay -->
    <div id="btGlobalLoading" class="bt-loading-overlay d-none">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <!-- Page Header & Month Selector -->
    <header class="bt-page-header">
        <div class="bt-page-header__text">
            <h1 class="bt-page-header__title">
                <i data-lucide="receipt" class="text-primary" style="width:28px;height:28px;"></i>
                Budget Tracker
            </h1>
            <p class="bt-page-header__subtitle">Manage your monthly planned budget, actual spending, and itemized
                transactions.</p>
        </div>

        <div class="bt-month-nav" aria-label="Month navigation">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnPrevMonth" title="Previous Month"
                    aria-label="Previous Month">
                <i data-lucide="chevron-left" style="width:18px;height:18px;"></i>
            </button>

            <label for="selectMonth" class="visually-hidden">Month</label>
            <select id="selectMonth" class="form-select form-select-sm w-auto">
                @for (int m = 1; m <= 12; m++)
                {
                    var mName = new DateTime(2026, m, 1).ToString("MMMM");
                    <option value="@m" selected="@(m == Model.Month ? "selected" : null)">@mName</option>
                }
            </select>

            <label for="selectYear" class="visually-hidden">Year</label>
            <select id="selectYear" class="form-select form-select-sm w-auto">
                @for (int y = Model.Year - 3; y <= Model.Year + 3; y++)
                {
                    <option value="@y" selected="@(y == Model.Year ? "selected" : null)">@y</option>
                }
            </select>

            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnNextMonth" title="Next Month"
                    aria-label="Next Month">
                <i data-lucide="chevron-right" style="width:18px;height:18px;"></i>
            </button>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning mb-3" role="alert">
            @Model.ErrorMessage
        </div>
    }

    <!-- Global Alert / Status Box -->
    <div id="btAlert" class="alert alert-danger alert-dismissible fade bt-alert" role="alert">
        <span id="btAlertMessage"></span>
        <button type="button" class="btn-close" id="btnDismissAlert" aria-label="Close"></button>
    </div>

    <!-- New Month Prompt Banner (if month not initialized) -->
    <div id="btInitPrompt" class="bt-init-prompt d-none">
        <div class="bt-init-prompt__text">
            <h2 class="bt-init-prompt__title">
                <i data-lucide="calendar-plus" style="width:18px;height:18px;vertical-align:-2px;"></i>
                <span id="initPromptHeading">New Month Budget Plan</span>
            </h2>
            <p class="bt-init-prompt__desc" id="initPromptDesc">
                This month has no budget plan yet. You can copy planned amounts from an earlier month or start blank.
            </p>
        </div>
        <div class="bt-init-prompt__actions">
            <button type="button" class="btn btn-primary btn-sm d-none" id="btnCopyPrevious">
                <i data-lucide="copy" style="width:16px;height:16px;vertical-align:-2px;"></i>
                <span id="btnCopyPreviousText">Copy from Previous Month</span>
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnStartBlank">
                Start Blank
            </button>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs bt-tabs" id="btTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tabSummary-btn" data-bs-toggle="tab" data-bs-target="#tabSummary"
                    type="button" role="tab" aria-controls="tabSummary" aria-selected="true">
                <i data-lucide="bar-chart-2" style="width:18px;height:18px;"></i>
                Summary
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tabTransactions-btn" data-bs-toggle="tab" data-bs-target="#tabTransactions"
                    type="button" role="tab" aria-controls="tabTransactions" aria-selected="false">
                <i data-lucide="list" style="width:18px;height:18px;"></i>
                Transactions
                <span class="badge bg-secondary rounded-pill ms-1" id="txCountBadge">0</span>
            </button>
        </li>
    </ul>

    <!-- Tab Panels -->
    <div class="tab-content" id="btTabContent">
        <!-- TAB 1: SUMMARY -->
        <div class="tab-pane fade show active" id="tabSummary" role="tabpanel" aria-labelledby="tabSummary-btn"
             tabindex="0">
            <!-- Planned vs Actual Progress Bars -->
            <div class="bt-bars-card">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="bt-bar-group">
                            <div class="bt-bar-header">
                                <span class="bt-bar-title">Expenses Comparison</span>
                                <span class="bt-bar-numbers"
                                      id="expensesBarNumbers">Planned: $0.00 | Actual: $0.00</span>
                            </div>
                            <div class="bt-bar-track" title="Expenses Planned vs Actual">
                                <div id="expensePlannedBar" class="bt-bar-fill bt-bar-fill--planned" style="width: 0%;"
                                     aria-label="Planned Expenses"></div>
                                <div id="expenseActualBar" class="bt-bar-fill bt-bar-fill--actual-expense"
                                     style="width: 0%;" aria-label="Actual Expenses"></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="bt-bar-group">
                            <div class="bt-bar-header">
                                <span class="bt-bar-title">Income Comparison</span>
                                <span class="bt-bar-numbers" id="incomeBarNumbers">Planned: $0.00 | Actual: $0.00</span>
                            </div>
                            <div class="bt-bar-track" title="Income Planned vs Actual">
                                <div id="incomePlannedBar" class="bt-bar-fill bt-bar-fill--planned" style="width: 0%;"
                                     aria-label="Planned Income"></div>
                                <div id="incomeActualBar" class="bt-bar-fill bt-bar-fill--actual-income"
                                     style="width: 0%;" aria-label="Actual Income"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Side-by-Side Category Tables -->
            <div class="row g-4">
                <!-- Expenses Table -->
                <div class="col-lg-6">
                    <div class="bt-card">
                        <div class="bt-card-header">
                            <h2 class="bt-card-title text-danger">
                                <i data-lucide="arrow-down-circle" style="width:20px;height:20px;"></i>
                                Expenses
                            </h2>
                            <button type="button" class="btn btn-sm btn-outline-danger" id="btnAddExpenseCategory"
                                    title="Add Custom Expense Category">
                                <i data-lucide="plus" style="width:16px;height:16px;vertical-align:-2px;"></i>
                                Add Category
                            </button>
                        </div>

                        <div class="bt-table-responsive">
                            <table class="bt-table" id="tableExpenses" aria-label="Expenses Summary Table">
                                <thead>
                                <tr>
                                    <th scope="col" style="min-width: 140px;">Category</th>
                                    <th scope="col" class="text-end" style="min-width: 90px;">Planned</th>
                                    <th scope="col" class="text-end" style="min-width: 110px;">Actual</th>
                                    <th scope="col" class="text-end" style="min-width: 90px;">Diff</th>
                                    <th scope="col" style="min-width: 110px;" class="text-end"><span
                                                class="visually-hidden">Actions</span></th>
                                </tr>
                                </thead>
                                <tbody id="tbodyExpenses">
                                <!-- Rendered dynamically -->
                                </tbody>
                                <tfoot>
                                <tr>
                                    <th scope="row">Total Expenses</th>
                                    <td class="text-end" id="totalExpensePlanned">$0.00</td>
                                    <td class="text-end" id="totalExpenseActual">$0.00</td>
                                    <td class="text-end" id="totalExpenseDiff">$0.00</td>
                                    <td></td>
                                </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Income Table -->
                <div class="col-lg-6">
                    <div class="bt-card">
                        <div class="bt-card-header">
                            <h2 class="bt-card-title text-success">
                                <i data-lucide="arrow-up-circle" style="width:20px;height:20px;"></i>
                                Income
                            </h2>
                            <button type="button" class="btn btn-sm btn-outline-success" id="btnAddIncomeCategory"
                                    title="Add Custom Income Category">
                                <i data-lucide="plus" style="width:16px;height:16px;vertical-align:-2px;"></i>
                                Add Category
                            </button>
                        </div>

                        <div class="bt-table-responsive">
                            <table class="bt-table" id="tableIncome" aria-label="Income Summary Table">
                                <thead>
                                <tr>
                                    <th scope="col" style="min-width: 140px;">Category</th>
                                    <th scope="col" class="text-end" style="min-width: 90px;">Planned</th>
                                    <th scope="col" class="text-end" style="min-width: 110px;">Actual</th>
                                    <th scope="col" class="text-end" style="min-width: 90px;">Diff</th>
                                    <th scope="col" style="min-width: 110px;" class="text-end"><span
                                                class="visually-hidden">Actions</span></th>
                                </tr>
                                </thead>
                                <tbody id="tbodyIncome">
                                <!-- Rendered dynamically -->
                                </tbody>
                                <tfoot>
                                <tr>
                                    <th scope="row">Total Income</th>
                                    <td class="text-end" id="totalIncomePlanned">$0.00</td>
                                    <td class="text-end" id="totalIncomeActual">$0.00</td>
                                    <td class="text-end" id="totalIncomeDiff">$0.00</td>
                                    <td></td>
                                </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: TRANSACTIONS -->
        <div class="tab-pane fade" id="tabTransactions" role="tabpanel" aria-labelledby="tabTransactions-btn"
             tabindex="0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="text-muted mb-0">Record and itemize spending and income for this month.</p>
                <button type="button" class="btn btn-primary btn-sm" id="btnAddTransaction">
                    <i data-lucide="plus-circle" style="width:16px;height:16px;vertical-align:-2px;"></i>
                    Add Transaction
                </button>
            </div>

            <div class="row g-4">
                <!-- Expense Transactions List -->
                <div class="col-lg-6">
                    <div class="bt-card">
                        <div class="bt-card-header">
                            <h2 class="bt-card-title text-danger">
                                <i data-lucide="shopping-cart" style="width:20px;height:20px;"></i>
                                Expenses
                            </h2>
                            <span class="badge bg-danger rounded-pill" id="expenseTxCountBadge">0</span>
                        </div>

                        <div class="bt-table-responsive">
                            <table class="bt-table bt-tx-table" id="tableExpenseTx"
                                   aria-label="Expense Transactions Table">
                                <thead>
                                <tr>
                                    <th scope="col" style="width: 95px;">Date</th>
                                    <th scope="col" class="text-end" style="width: 85px;">Amount</th>
                                    <th scope="col">Description</th>
                                    <th scope="col" style="width: 120px;">Category</th>
                                    <th scope="col" style="width: 70px;" class="text-end"><span class="visually-hidden">Actions</span>
                                    </th>
                                </tr>
                                </thead>
                                <tbody id="tbodyExpenseTx">
                                <!-- Dynamic -->
                                </tbody>
                            </table>
                        </div>
                        <div id="emptyExpenseTx" class="bt-empty-state d-none">
                            <i data-lucide="inbox" class="bt-empty-state__icon"></i>
                            <p class="bt-empty-state__text">No expense transactions recorded for this month.</p>
                        </div>
                    </div>
                </div>

                <!-- Income Transactions List -->
                <div class="col-lg-6">
                    <div class="bt-card">
                        <div class="bt-card-header">
                            <h2 class="bt-card-title text-success">
                                <i data-lucide="wallet" style="width:20px;height:20px;"></i>
                                Income
                            </h2>
                            <span class="badge bg-success rounded-pill" id="incomeTxCountBadge">0</span>
                        </div>

                        <div class="bt-table-responsive">
                            <table class="bt-table bt-tx-table" id="tableIncomeTx"
                                   aria-label="Income Transactions Table">
                                <thead>
                                <tr>
                                    <th scope="col" style="width: 95px;">Date</th>
                                    <th scope="col" class="text-end" style="width: 85px;">Amount</th>
                                    <th scope="col">Description</th>
                                    <th scope="col" style="width: 120px;">Category</th>
                                    <th scope="col" style="width: 70px;" class="text-end"><span class="visually-hidden">Actions</span>
                                    </th>
                                </tr>
                                </thead>
                                <tbody id="tbodyIncomeTx">
                                <!-- Dynamic -->
                                </tbody>
                            </table>
                        </div>
                        <div id="emptyIncomeTx" class="bt-empty-state d-none">
                            <i data-lucide="inbox" class="bt-empty-state__icon"></i>
                            <p class="bt-empty-state__text">No income transactions recorded for this month.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL 1: ADD CATEGORY -->
    <div class="modal fade" id="modalAddCategory" tabindex="-1" aria-labelledby="modalAddCategoryTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="formAddCategory">
                    <div class="modal-header">
                        <h3 class="modal-title fs-5" id="modalAddCategoryTitle">Add Budget Category</h3>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger d-none modal-error-alert mb-3" id="alertAddCategory"
                             role="alert"></div>
                        <div class="mb-3">
                            <label for="inputCategoryName" class="form-label">Category Name</label>
                            <input type="text" class="form-control" id="inputCategoryName" maxlength="100" required
                                   placeholder="e.g. Subscriptions"/>
                        </div>
                        <div class="mb-3">
                            <label for="selectCategoryKind" class="form-label">Category Type</label>
                            <select class="form-select" id="selectCategoryKind" required>
                                <option value="1">Expense</option>
                                <option value="2">Income</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" id="btnSubmitCategory">Add Category</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 2: EDIT / RENAME CATEGORY -->
    <div class="modal fade" id="modalEditCategory" tabindex="-1" aria-labelledby="modalEditCategoryTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="formEditCategory">
                    <input type="hidden" id="editCategoryId"/>
                    <input type="hidden" id="editCategorySortOrder"/>
                    <input type="hidden" id="editCategoryKind"/>
                    <div class="modal-header">
                        <h3 class="modal-title fs-5" id="modalEditCategoryTitle">Rename Category</h3>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger d-none modal-error-alert mb-3" id="alertEditCategory"
                             role="alert"></div>
                        <div class="mb-3">
                            <label for="inputEditCategoryName" class="form-label">Category Name</label>
                            <input type="text" class="form-control" id="inputEditCategoryName" maxlength="100" required
                                   placeholder="e.g. Groceries"/>
                        </div>
                        <div class="mb-3">
                            <label for="selectEditCategoryKind" class="form-label">Category Type</label>
                            <select class="form-select" id="selectEditCategoryKind" disabled>
                                <option value="1">Expense</option>
                                <option value="2">Income</option>
                            </select>
                            <div class="form-text">Category type cannot be changed after creation.</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" id="btnSubmitEditCategory">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 3: ACTUAL OVERRIDE -->
    <div class="modal fade" id="modalActualOverride" tabindex="-1" aria-labelledby="modalOverrideTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="formActualOverride">
                    <input type="hidden" id="overrideCategoryId"/>
                    <div class="modal-header">
                        <h3 class="modal-title fs-5" id="modalOverrideTitle">Actual Override</h3>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger d-none modal-error-alert mb-3" id="alertActualOverride"
                             role="alert"></div>
                        <p class="text-muted small">
                            Set a manual Actual amount for <strong id="overrideCategoryName"></strong> for this month.
                            This overrides the sum of transactions.
                        </p>
                        <div class="mb-3">
                            <label for="inputOverrideAmount" class="form-label">Manual Actual Amount ($)</label>
                            <input type="number" step="0.01" min="0" max="9999999999999999.99" class="form-control"
                                   id="inputOverrideAmount" required placeholder="0.00"/>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-danger me-auto d-none" id="btnModalRevertOverride">
                            Revert to Transactions
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" id="btnSubmitOverride">Save Override</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 4: ADD / EDIT TRANSACTION -->
    <div class="modal fade" id="modalTransaction" tabindex="-1" aria-labelledby="modalTransactionTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="formTransaction">
                    <input type="hidden" id="inputTxId"/>
                    <div class="modal-header">
                        <h3 class="modal-title fs-5" id="modalTransactionTitle">Add Transaction</h3>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger d-none modal-error-alert mb-3" id="alertTransaction"
                             role="alert"></div>
                        <div class="mb-3">
                            <label for="selectTxCategory" class="form-label">Category</label>
                            <select class="form-select" id="selectTxCategory" required>
                                <option value="">Select a category...</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="inputTxDate" class="form-label">Date</label>
                            <input type="date" class="form-control" id="inputTxDate" required/>
                        </div>
                        <div class="mb-3">
                            <label for="inputTxAmount" class="form-label">Amount ($)</label>
                            <input type="number" step="0.01" min="0.01" max="9999999999999999.99" class="form-control"
                                   id="inputTxAmount" required placeholder="0.00"/>
                        </div>
                        <div class="mb-3">
                            <label for="inputTxDescription" class="form-label">Description (Optional)</label>
                            <input type="text" class="form-control" id="inputTxDescription" maxlength="200"
                                   placeholder="e.g. Grocery shopping"/>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" id="btnSubmitTransaction">Save Transaction
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 5: DELETE CONFIRMATION -->
    <div class="modal fade" id="modalDeleteConfirm" tabindex="-1" aria-labelledby="modalDeleteConfirmTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 class="modal-title fs-5" id="modalDeleteConfirmTitle">Confirm Deletion</h3>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger d-none modal-error-alert mb-3" id="alertDeleteConfirm"
                         role="alert"></div>
                    <p id="deleteConfirmMessage">Are you sure you want to delete this item?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="btnConfirmDelete">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.__initialSheetData = @Html.Raw(JsonSerializer.Serialize(Model.Sheet, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));
    </script>
    <script src="~/js/budget-tracker/budget-tracker.js" asp-append-version="true"></script>
}
