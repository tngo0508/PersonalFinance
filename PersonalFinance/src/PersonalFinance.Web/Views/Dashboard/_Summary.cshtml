@using System.Globalization
@model PersonalFinance.Shared.DTOs.Dashboard.DashboardSummaryDto
@* Summary card: headline Net Worth, FI Target, and Progress to FI (all calculated by the Dashboard service).
   The bar is capped at 100% for display; the percentage label shows the uncapped value. *@
@{
    var netWorth = Model.NetWorth;
    var progress = netWorth?.ProgressToFiPercent;
    var barPercent = progress is null ? 0m : Math.Clamp(progress.Value, 0m, 100m);
    // Floored (like the goal tiles) so the label only reads 100% once the FI Target is actually reached.
    var progressLabel = progress is null ? null : Math.Floor(progress.Value).ToString("0");
}
<section class="dash-card dash-summary" aria-labelledby="dash-summary-title">
    <div class="dash-card__header">
        <h2 id="dash-summary-title" class="dash-card__title">@L["Shell.Nav.NetWorth"]</h2>
        <a asp-controller="Networth" asp-action="Index" class="dash-link">@L["Dashboard.Summary.EditSettings"]<span class="visually-hidden"> @L["Dashboard.Summary.EditSettingsHidden"]</span></a>
    </div>
    @if (netWorth is not null)
    {
        <div class="dash-summary__body">
            <div class="dash-summary__headline">
                <p class="dash-summary__value dash-money">@MoneyFormatter.FormatWhole(netWorth.CurrentNetWorth, SupportedCurrencies.Default.Code)</p>
                <p class="dash-note">@L["Dashboard.Summary.FromSettings"]</p>
            </div>

            <div class="dash-summary__fi">
                @if (progress is not null)
                {
                    <div class="dash-summary__fi-row">
                        <span class="dash-summary__fi-label">@L["Dashboard.Summary.ProgressToFi"]</span>
                        @if (netWorth.FiTargetReached)
                        {
                            <span class="dash-badge dash-badge--positive">
                                <i data-lucide="badge-check" aria-hidden="true"></i>
                                @L["Dashboard.Summary.FiTargetReached"]
                            </span>
                        }
                        <span class="dash-summary__fi-percent dash-money">@(progressLabel)%</span>
                    </div>
                    <div class="dash-progress dash-progress--fi @(netWorth.FiTargetReached ? "dash-progress--reached" : null)"
                         role="progressbar" aria-label="@L["Dashboard.Summary.ProgressToFi"]"
                         aria-valuenow="@Math.Floor(barPercent).ToString("0", CultureInfo.InvariantCulture)"
                         aria-valuemin="0" aria-valuemax="100"
                         aria-valuetext="@L.Named("Dashboard.Summary.ProgressValueText", ("percent", progressLabel))">
                        <div class="dash-progress__bar" style="width: @barPercent.ToString("F1", CultureInfo.InvariantCulture)%"></div>
                    </div>
                    <p class="dash-summary__fi-target">
                        @L["Dashboard.FiTarget"] <span class="dash-money">@MoneyFormatter.FormatWhole(netWorth.FiTarget, SupportedCurrencies.Default.Code)</span>
                        <span class="dash-summary__fi-hint">@L["Dashboard.Summary.FiTargetHint"]</span>
                    </p>
                    @if (netWorth.FiReachedAge is not null)
                    {
                        <p class="dash-note dash-summary__fi-age">
                            @L.Named("Dashboard.Summary.FiReachedAge", ("age", netWorth.FiReachedAge))
                        </p>
                    }
                }
                else
                {
                    <p class="dash-summary__fi-label">@L["Dashboard.Summary.ProgressToFi"]</p>
                    <p class="dash-note">@L["Dashboard.Summary.AddSpendingPrompt"]</p>
                    <a asp-controller="Networth" asp-action="Index" class="dash-link">@L["Dashboard.Summary.AddSpending"]</a>
                }
            </div>
        </div>
    }
    else
    {
        <p class="dash-empty">@L["Dashboard.Summary.Empty"]</p>
    }
</section>
