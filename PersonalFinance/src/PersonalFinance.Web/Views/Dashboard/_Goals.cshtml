@using Microsoft.AspNetCore.Mvc.Razor
@model PersonalFinance.Shared.DTOs.Dashboard.DashboardSummaryDto
@* Savings goals section (ticket 07): the five most recent goals, completed goals marked with a check badge. *@
<section class="dash-card dash-goals" aria-labelledby="dash-goals-title">
    <div class="dash-card__header">
        <h2 id="dash-goals-title" class="dash-card__title">@L["Dashboard.Goals.Title"]</h2>
        <a asp-controller="SavingsGoals" asp-action="Index" class="dash-link">@L["Dashboard.Goals.ViewAll"]<span class="visually-hidden"> @L["Dashboard.Goals.ViewAllHidden"]</span></a>
    </div>
    @if (Model.SavingsGoals.Count > 0)
    {
        <ul class="dash-list">
            @foreach (var goal in Model.SavingsGoals)
            {
                // Floored so a goal only reads 100% once it is fully funded.
                var progress = (int)Math.Floor(Math.Clamp(goal.ProgressPercent, 0, 100));
                <li class="dash-goal @(goal.IsCompleted ? "dash-goal--completed" : null)">
                    <div class="dash-goal__row">
                        <span class="dash-goal__title">
                            <span class="dash-goal__name">@goal.Name</span>
                            @if (goal.IsCompleted)
                            {
                                <span class="dash-goal__badge">
                                    <i data-lucide="check" aria-hidden="true"></i>
                                    @L["Dashboard.Goals.Complete"]
                                </span>
                            }
                        </span>
                        <span class="dash-money dash-goal__percent">@progress%</span>
                    </div>
                    <div class="dash-progress" role="progressbar" aria-label="@L.Named("Dashboard.Goals.ProgressLabel", ("name", goal.Name))"
                         aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"
                         aria-valuetext="@L.Named("Dashboard.Goals.Funded", ("percent", progress))">
                        <div class="dash-progress__bar" style="width: @progress%"></div>
                    </div>
                    @{
                        Func<object?, HelperResult> current =
                            @<span class="dash-money">@MoneyFormatter.FormatWhole(goal.CurrentAmount, SupportedCurrencies.CodeOrDefault(goal.CurrencyCode))</span>;
                        Func<object?, HelperResult> target =
                            @<span class="dash-money">@MoneyFormatter.FormatWhole(goal.TargetAmount, SupportedCurrencies.CodeOrDefault(goal.CurrencyCode))</span>;
                    }
                    <span class="dash-goal__amounts">
                        @L.NamedHtml("Dashboard.Goals.Amounts", null, ("current", current(null)), ("target", target(null)))
                    </span>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="dash-empty">@L["Dashboard.Goals.Empty"]</p>
    }
</section>
