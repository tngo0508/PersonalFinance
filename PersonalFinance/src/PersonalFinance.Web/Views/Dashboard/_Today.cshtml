@* Today: the user's clock and the current month, drawn by js/dashboard/dashboard-today.js in the browser's time zone
   (the server cannot know it). Hidden until the script fills it, so it never shows the server's day instead. *@
<section class="dash-today" aria-labelledby="dash-today-title" data-dash-today hidden>
    <h2 id="dash-today-title" class="visually-hidden">@L["Dashboard.Today.Title"]</h2>
    <div class="dash-today__now">
        <time class="dash-today__clock" data-dash-today-clock></time>
        <p class="dash-today__date" data-dash-today-date></p>
        <p class="dash-today__left" data-dash-today-left></p>
    </div>
    <div class="dash-today__calendar">
        <table class="dash-today__month">
            <caption class="visually-hidden" data-dash-today-caption></caption>
            <thead>
                <tr data-dash-today-weekdays></tr>
            </thead>
            <tbody data-dash-today-days></tbody>
        </table>
        <p class="dash-today__legend" data-dash-today-legend hidden></p>
    </div>
</section>
