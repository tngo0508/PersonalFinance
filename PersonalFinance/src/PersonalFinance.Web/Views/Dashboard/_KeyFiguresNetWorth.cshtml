@model PersonalFinance.Shared.DTOs.Dashboard.DashboardSummaryDto
@* Net Worth-derived tiles: Net Worth and Savings Rate, both linking to Net Worth settings. *@
@{
    var netWorth = Model.NetWorth;
    var savingsRate = netWorth?.SavingsRatePercent;
    string savingsRateCaption = netWorth is null
        ? L["Dashboard.AddNetWorthSettings"]
        : savingsRate is null ? L["Dashboard.KeyFigures.AddAnnualIncome"] : L["Dashboard.KeyFigures.SavingsRateCaption"];
}
<partial name="_KeyFigureTile" model="@(new DashboardKeyFigureViewModel
{
    Label = L["Shell.Nav.NetWorth"],
    Value = netWorth is null ? null : MoneyFormatter.FormatWhole(netWorth.CurrentNetWorth, SupportedCurrencies.Default.Code),
    Caption = netWorth is null ? L["Dashboard.AddNetWorthSettings"] : L["Dashboard.KeyFigures.NetWorthCaption"],
    UnavailableText = L["Dashboard.KeyFigures.NotSetUp"],
    Icon = "wallet",
    Controller = "Networth"
})"/>
<partial name="_KeyFigureTile" model="@(new DashboardKeyFigureViewModel
{
    Label = L["Dashboard.KeyFigures.SavingsRate"],
    Value = savingsRate is null ? null : $"{savingsRate.Value:F0}%",
    Caption = savingsRateCaption,
    UnavailableText = netWorth is null ? L["Dashboard.KeyFigures.NotSetUp"] : L["Dashboard.KeyFigures.Unavailable"],
    Icon = "piggy-bank",
    Controller = "Networth"
})"/>
