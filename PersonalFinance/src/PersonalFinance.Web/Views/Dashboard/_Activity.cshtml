@using System.Globalization
@using PersonalFinance.Shared.Enums
@model PersonalFinance.Shared.DTOs.Dashboard.DashboardSummaryDto
@* Recent activity section: type icon, title, description and date, newest first. Displays active budget data source. *@
@{
    static (string Icon, string Modifier, string Label) ActivityStyle(string type) => type switch
    {
        "Income" => ("arrow-down-left", "income", "Income"),
        "Expense" => ("arrow-up-right", "expense", "Expense"),
        "SavingsGoal" => ("target", "goal", "Savings goal"),
        _ => ("circle", "other", "Activity")
    };

    var items = Model.RecentActivity;
    var sourceName = Model.ActiveSource == BudgetDataSource.BudgetTracker ? "Budget Tracker" : "Google Sheet";
}
<section class="dash-card dash-activity" aria-labelledby="dash-activity-title">
    <div class="dash-card__header flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <h2 id="dash-activity-title" class="dash-card__title mb-0">Recent activity</h2>
            <partial name="_DataSourceToggle" model="Model.ActiveSource"/>
        </div>
        <span class="badge bg-light text-secondary border">Source: @sourceName</span>
    </div>
    @if (items.Count > 0)
    {
        <ul class="dash-list">
            @foreach (var activity in items)
            {
                var style = ActivityStyle(activity.Type);
                <li class="dash-activity__item">
                    <span class="dash-activity__icon dash-activity__icon--@style.Modifier">
                        <i data-lucide="@style.Icon" aria-hidden="true"></i>
                        <span class="visually-hidden">@style.Label</span>
                    </span>
                    <div class="dash-activity__body">
                        <div class="dash-activity__row">
                            <span class="dash-activity__title">@activity.Title</span>
                            <time class="dash-activity__date" datetime="@activity.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@activity.Date.ToString("MMM d, yyyy")</time>
                        </div>
                        <span class="dash-activity__description">@activity.Description</span>
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        @if (Model.ActiveSource == BudgetDataSource.GoogleSheet)
        {
            <p class="dash-empty">
                No recent activity from Google Sheet.
                <a asp-controller="GoogleDrive" asp-action="Index">Sync your spreadsheet</a> or switch to Budget Tracker
                above.
            </p>
        }
        else
        {
            <p class="dash-empty">
                No recent activity in Budget Tracker.
                <a asp-controller="BudgetTracker" asp-action="Index">Add transactions</a> or switch to Google Sheet
                above.
            </p>
        }
    }
</section>
