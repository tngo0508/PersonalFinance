@model PersonalFinance.Shared.DTOs.Dashboard.DashboardSummaryDto
@* Setup section: one card per incomplete setup step, hidden entirely when every step is complete.
   Each step is a separate block so steps can be added (e.g. Google Drive, ticket 08) without touching the others. *@
@{
    var cards = new List<DashboardSetupCardViewModel>();

    if (Model.NetWorth is null)
    {
        cards.Add(new DashboardSetupCardViewModel
        {
            Title = L["Dashboard.Setup.NetWorth"],
            Description = L["Dashboard.Setup.NetWorthDescription"],
            ActionText = L["Dashboard.Setup.NetWorth"],
            Icon = "wallet",
            Controller = "Networth"
        });
    }

    if (Model.Budget is null)
    {
        cards.Add(new DashboardSetupCardViewModel
        {
            Title = L["Dashboard.CreateBudget"],
            Description = L["Dashboard.Setup.BudgetDescription"],
            ActionText = L["Dashboard.CreateBudget"],
            Icon = "pie-chart",
            Controller = "Budget"
        });
    }

    if (Model.SavingsGoals.Count == 0)
    {
        cards.Add(new DashboardSetupCardViewModel
        {
            Title = L["Dashboard.Setup.Goal"],
            Description = L["Dashboard.Setup.GoalDescription"],
            ActionText = L["Dashboard.Setup.Goal"],
            Icon = "target",
            Controller = "SavingsGoals"
        });
    }

    if (!Model.HasGoogleDriveConnection)
    {
        cards.Add(new DashboardSetupCardViewModel
        {
            Title = L["Dashboard.Setup.GoogleDrive"],
            Description = L["Dashboard.Setup.GoogleDriveDescription"],
            ActionText = L["Dashboard.Setup.GoogleDrive"],
            Icon = "hard-drive",
            Controller = "GoogleDrive"
        });
    }
}
@if (cards.Count > 0)
{
    <section class="dash-setup" aria-labelledby="dash-setup-title">
        <h2 id="dash-setup-title" class="dash-section-title">@L["Dashboard.Setup.Title"]</h2>
        <div class="dash-setup__grid">
            @foreach (var card in cards)
            {
                <partial name="_SetupCard" model="card"/>
            }
        </div>
    </section>
}
