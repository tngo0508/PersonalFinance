@model PersonalFinance.Shared.DTOs.Dashboard.DashboardSummaryDto
@* Quick actions: one keyboard-focusable link per common task (icon, label, one-line hint). Mobile only
   (css/dashboard.css): the bottom navigation cannot reach Budget, Savings goals or Analysis within two taps,
   and from 769px up the sidebar shows every one of these links. *@
@{
    var actions = new[]
    {
        (Controller: "Networth", Icon: "wallet", Label: L["Shell.Nav.NetWorth"].Value, Hint: L["Dashboard.QuickActions.NetWorthHint"].Value),
        (Controller: "Budget", Icon: "pie-chart", Label: L["Dashboard.QuickActions.Budget"].Value, Hint: L["Dashboard.QuickActions.BudgetHint"].Value),
        (Controller: "SavingsGoals", Icon: "target", Label: L["Shell.Nav.SavingsGoals"].Value, Hint: L["Dashboard.QuickActions.SavingsGoalsHint"].Value),
        (Controller: "Analysis", Icon: "bar-chart-3", Label: L["Shell.Nav.Analysis"].Value, Hint: L["Dashboard.QuickActions.AnalysisHint"].Value),
        (Controller: "InvestmentCalculator", Icon: "calculator", Label: L["Shell.Nav.InvestmentCalculator"].Value, Hint: L["Dashboard.QuickActions.InvestmentCalculatorHint"].Value)
    };
}
<section class="dash-card dash-actions dash-actions--mobile" aria-labelledby="dash-actions-title">
    <div class="dash-card__header">
        <h2 id="dash-actions-title" class="dash-card__title">@L["Dashboard.QuickActions.Title"]</h2>
    </div>
    <ul class="dash-actions__list">
        @foreach (var action in actions)
        {
            <li>
                <a asp-controller="@action.Controller" asp-action="Index" class="dash-action">
                    <span class="dash-action__icon" aria-hidden="true"><i data-lucide="@action.Icon"></i></span>
                    <span class="dash-action__body">
                        <span class="dash-action__label">@action.Label</span>
                        <span class="dash-action__hint">@action.Hint</span>
                    </span>
                    <span class="dash-action__chevron" aria-hidden="true"><i data-lucide="chevron-right"></i></span>
                </a>
            </li>
        }
    </ul>
</section>
