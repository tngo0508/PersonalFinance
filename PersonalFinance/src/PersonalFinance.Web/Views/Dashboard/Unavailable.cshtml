@using System.Security.Claims
@using PersonalFinance.Web.Infrastructure
@{
    ViewData["Title"] = L["Shell.Nav.Dashboard"].Value;
    var email = User.FindFirst(ClaimTypes.Email)?.Value ?? User.Identity?.Name ?? string.Empty;
    var displayName = User.FindFirst(ClaimTypes.GivenName)?.Value
                      ?? (email.Contains('@') ? email[..email.IndexOf('@')] : email);
    var unavailable = new UnavailableStateViewModel
    {
        Heading = L["Dashboard.Unavailable.Heading"],
        RetryController = "Dashboard"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true"/>
}

@* Unavailable State: the summary could not be loaded. Never fall back to empty sections or setup cards here,
   because those tell a returning user their data is gone. *@
<div class="dash">
    <header class="dash-header">
        <p class="dash-header__eyebrow">@L["Shell.Nav.Dashboard"]</p>
        <h1 class="dash-header__title">
            @(string.IsNullOrWhiteSpace(displayName) ? L["Dashboard.Header.Welcome"] : L.Named("Dashboard.Header.WelcomeNamed", ("name", displayName)))
        </h1>
    </header>

    <partial name="_UnavailableState" model="unavailable"/>
</div>
