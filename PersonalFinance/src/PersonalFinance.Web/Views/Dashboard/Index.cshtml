@using System.Security.Claims
@using PersonalFinance.Shared.DTOs.Dashboard
@model PersonalFinance.Shared.DTOs.Dashboard.DashboardSummaryDto
@{
    ViewData["Title"] = L["Shell.Nav.Dashboard"].Value;
    var summary = Model ?? new DashboardSummaryDto();
    var email = User.FindFirst(ClaimTypes.Email)?.Value ?? User.Identity?.Name ?? string.Empty;
    var displayName = User.FindFirst(ClaimTypes.GivenName)?.Value
                      ?? (email.Contains('@') ? email[..email.IndexOf('@')] : email);
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/apexcharts@3.45.2/dist/apexcharts.css"/>
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true"/>
}

@* Section order is agreed in the spec; each section lives in its own partial so it can evolve independently. *@
<div class="dash">
    <header class="dash-header">
        <div class="dash-header__intro">
            <p class="dash-header__eyebrow">@L["Shell.Nav.Dashboard"]</p>
            <h1 class="dash-header__title">
                @(string.IsNullOrWhiteSpace(displayName) ? L["Dashboard.Header.Welcome"] : L.Named("Dashboard.Header.WelcomeNamed", ("name", displayName)))
            </h1>
            <p class="dash-header__lede">@L["Dashboard.Header.Lede"]</p>
            <partial name="_DayLedger"/>
        </div>
        <partial name="_Today"/>
    </header>

    <partial name="_Summary" model="summary"/>

    <partial name="_Atelier" model="summary"/>

    <partial name="_KeyFigures" model="summary"/>

    <div class="dash-row dash-row--wide">
        <partial name="_Projection" model="summary"/>
        <div class="dash-budget-column">
            <partial name="_MonthlyBudget" model="summary"/>
            <partial name="_Budget" model="summary"/>
        </div>
    </div>

    <div class="dash-row">
        <partial name="_Goals" model="summary"/>
        <partial name="_Activity" model="summary"/>
    </div>

    <partial name="_QuickActions" model="summary"/>

    <partial name="_SetupCards" model="summary"/>
</div>

@* Single JSON data island read by js/dashboard/dashboard-core.js (camelCase, HTML-safe encoding). *@
<script type="application/json" id="dashboard-data">@Json.Serialize(summary)</script>
<js-strings prefix="Dashboard.Js." />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.45.2/dist/apexcharts.min.js"></script>
    <script src="~/js/dashboard/dashboard-core.js" asp-append-version="true"></script>
    <script src="~/js/dashboard/dashboard-budget-chart.js" asp-append-version="true"></script>
    <script src="~/js/dashboard/dashboard-projection-chart.js" asp-append-version="true"></script>
    <script src="~/js/dashboard/dashboard-today.js" asp-append-version="true"></script>
}
