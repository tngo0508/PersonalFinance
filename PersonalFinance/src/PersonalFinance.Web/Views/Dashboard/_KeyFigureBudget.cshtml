@model PersonalFinance.Shared.DTOs.Dashboard.DashboardSummaryDto
@* Budgeted income tile: Budget Planner only. Active-source monthly figures live on the Monthly budget card. *@
@{
    var plannerBudget = Model.Budget;
    decimal? income = plannerBudget?.MonthlyIncome;
    var periodLabel = DashboardBudgetFormat.PeriodLabel(plannerBudget?.Period);
    string caption = plannerBudget is not null
            ? (string.IsNullOrEmpty(periodLabel)
                ? L["Dashboard.KeyFigures.BudgetedIncomeCaption"]
                : L.Named("Dashboard.KeyFigures.BudgetedIncomeCaptionPeriod", ("period", periodLabel)))
            : L["Dashboard.CreateBudget"];
}
<partial name="_KeyFigureTile" model="@(new DashboardKeyFigureViewModel
{
    Label = L["Dashboard.KeyFigures.BudgetedIncome"],
    Value = income is { } amount ? MoneyFormatter.FormatWhole(amount, SupportedCurrencies.CodeOrDefault(plannerBudget?.CurrencyCode)) : null,
    Caption = caption,
    UnavailableText = L["Dashboard.KeyFigures.NotSetUp"],
    Icon = "pie-chart",
    Controller = "Budget",
    Action = "Index"
})"/>
