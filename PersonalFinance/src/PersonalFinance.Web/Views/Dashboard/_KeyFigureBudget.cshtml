@model PersonalFinance.Shared.Contracts.DashboardSummaryDto
@* Monthly budgeted income tile (owned by ticket 06). *@
<partial name="_KeyFigureTile" model="@(new DashboardKeyFigureViewModel
{
    Label = "Monthly income",
    Value = Model.Budget?.MonthlyIncome.ToString("C0"),
    Caption = Model.Budget is null ? "Create a budget" : $"Budgeted for {Model.Budget.Period}",
    Icon = "pie-chart",
    Controller = "Budget"
})"/>
