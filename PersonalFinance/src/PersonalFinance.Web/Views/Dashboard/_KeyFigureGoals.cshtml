@model PersonalFinance.Shared.DTOs.Dashboard.DashboardSummaryDto
@* Goals funded tile (ticket 07): total saved ÷ total target across ALL of the user's goals, capped at 100%
   by the Dashboard service. Percent is floored so "100%" only appears once everything is funded. *@
@{
    var overview = Model.GoalsOverview;
    var hasGoals = overview.TotalCount > 0;
    string? value = null;
    if (hasGoals)
    {
        value = overview.FundedPercent is { } funded ? $"{Math.Floor(funded):0}%" : "—";
    }
}
<partial name="_KeyFigureTile" model="@(new DashboardKeyFigureViewModel
{
    Label = L["Dashboard.KeyFigures.GoalsFunded"],
    Value = value,
    Caption = hasGoals
        ? L.Named("Dashboard.KeyFigures.GoalsComplete", ("completed", overview.CompletedCount), ("total", overview.TotalCount))
        : L["Dashboard.AddSavingsGoal"],
    UnavailableText = L["Dashboard.KeyFigures.NotSetUp"],
    Icon = "target",
    Controller = "SavingsGoals"
})"/>
