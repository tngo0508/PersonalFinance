@model PersonalFinance.Shared.DTOs.Dashboard.DashboardSummaryDto
@* Net worth projection section. Points come from the Net Worth projection calculation (Dashboard service), so this
   chart always matches the Net Worth page. The chart is drawn by js/dashboard/dashboard-projection-chart.js from the
   data island; the sentence below is its text alternative. No historical data is stored, so none is plotted.
   No header link: the Summary card's "Edit settings" already opens the Net Worth page. *@
@{
    var netWorth = Model.NetWorth;
    var points = netWorth?.ProjectionPoints ?? new List<PersonalFinance.Shared.DTOs.Dashboard.ProjectionPointDto>();
    var last = points.Count > 0 ? points[^1] : null;
    string? summarySentence = null;
    if (netWorth is not null && last is not null)
    {
        string currency = SupportedCurrencies.CodeOrDefault(netWorth.CurrencyCode);
        string baseAmount = MoneyFormatter.FormatWhole(last.Base, currency);
        string fiTarget = MoneyFormatter.FormatWhole(netWorth.FiTarget, currency);
        string baseSentence = netWorth.FiTarget <= 0m
            ? L.Named("Dashboard.Projection.SummaryBase", ("amount", baseAmount), ("age", last.Age))
            : netWorth.FiReachedAge is { } fiAge
                ? L.Named("Dashboard.Projection.SummaryFiReached", ("amount", baseAmount), ("age", last.Age),
                    ("target", fiTarget), ("fiAge", fiAge))
                : L.Named("Dashboard.Projection.SummaryFiNotReached", ("amount", baseAmount), ("age", last.Age),
                    ("target", fiTarget));
        string scenarios = L.Named("Dashboard.Projection.SummaryScenarios",
            ("conservative", MoneyFormatter.FormatWhole(last.Conservative, currency)),
            ("aggressive", MoneyFormatter.FormatWhole(last.Aggressive, currency)));
        summarySentence = $"{baseSentence} {scenarios}";
    }
}
<section class="dash-card dash-projection" aria-labelledby="dash-projection-title">
    <div class="dash-card__header">
        <h2 id="dash-projection-title" class="dash-card__title">@L["Dashboard.Projection.Title"]</h2>
    </div>
    @if (netWorth is null)
    {
        <p class="dash-empty">@L["Dashboard.Projection.Empty"]</p>
    }
    else if (last is null)
    {
        <div class="dash-empty dash-projection__prompt">
            <p class="dash-projection__prompt-text">@L["Dashboard.Projection.RetirementPrompt"]</p>
            <a asp-controller="Networth" asp-action="Index" class="dash-link">@L["Dashboard.Projection.SetRetirementAge"]</a>
        </div>
    }
    else
    {
        <p class="dash-note">
            @L.Named("Dashboard.Projection.AgeRange", ("currentAge", netWorth.CurrentAge), ("retirementAge", netWorth.RetirementAge))
        </p>
        <p id="dash-projection-summary" class="visually-hidden">@summarySentence</p>
        <div id="dash-projection-chart" class="dash-chart dash-projection__chart" aria-hidden="true"></div>
        <dl class="dash-stats">
            <div class="dash-stats__item">
                <dt>@L.Named("Dashboard.Projection.BaseAt", ("age", last.Age))</dt>
                <dd class="dash-money">@MoneyFormatter.FormatWhole(last.Base, SupportedCurrencies.CodeOrDefault(netWorth.CurrencyCode))</dd>
            </div>
            <div class="dash-stats__item">
                <dt>@L["Dashboard.FiTarget"]</dt>
                <dd class="dash-money">@(netWorth.FiTarget > 0m ? MoneyFormatter.FormatWhole(netWorth.FiTarget, SupportedCurrencies.CodeOrDefault(netWorth.CurrencyCode)) : "—")</dd>
            </div>
        </dl>
    }
</section>
