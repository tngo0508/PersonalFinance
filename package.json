{
  "name": "personalfinanceapp",
  "version": "1.0.0",
  "description": "[![Build, Test, and Deploy to Azure Container Apps](https://github.com/tngo0508/PersonalFinance/actions/workflows/deploy-azure.yml/badge.svg)](https://github.com/tngo0508/PersonalFinance/actions/workflows/deploy-azure.yml)\r [![.NET 10](https://img.shields.io/badge/.NET-10.0-blue.svg)](https://dotnet.microsoft.com/download/dotnet/10.0)\r [![License](https://img.shields.io/badge/License-MIT-green.svg)](LICENSE)",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "lint": "npx eslint@8 --no-eslintrc -c PersonalFinance/src/PersonalFinance.Web/wwwroot/.eslintrc.js PersonalFinance/src/PersonalFinance.Web/wwwroot/js/ PersonalFinance/src/PersonalFinance.Web/tools/",
    "lint:fix": "npx eslint@8 --no-eslintrc -c PersonalFinance/src/PersonalFinance.Web/wwwroot/.eslintrc.js --fix PersonalFinance/src/PersonalFinance.Web/wwwroot/js/ PersonalFinance/src/PersonalFinance.Web/tools/",
    "i18n:translate": "node PersonalFinance/src/PersonalFinance.Web/tools/i18n-translate.js",
    "i18n:report": "node PersonalFinance/src/PersonalFinance.Web/tools/i18n-report.js",
    "test:i18n": "node --test PersonalFinance/src/PersonalFinance.Web/tools/i18n-translate.test.js PersonalFinance/src/PersonalFinance.Web/tools/i18n-content.test.js PersonalFinance/src/PersonalFinance.Web/tools/i18n-report.test.js PersonalFinance/src/PersonalFinance.Web/tools/i18n-client.test.js PersonalFinance/src/PersonalFinance.Web/tools/i18n-money.test.js PersonalFinance/src/PersonalFinance.Web/tools/networth-inputs.test.js PersonalFinance/src/PersonalFinance.Web/tools/investment-math.test.js PersonalFinance/src/PersonalFinance.Web/tools/dashboard-today.test.js PersonalFinance/src/PersonalFinance.Web/tools/theme.test.js PersonalFinance/src/PersonalFinance.Web/tools/raw-colours.test.js PersonalFinance/src/PersonalFinance.Web/tools/theme-tokens.test.js PersonalFinance/src/PersonalFinance.Web/tools/chart-palette.test.js PersonalFinance/src/PersonalFinance.Web/tools/atelier-recheck.test.js PersonalFinance/src/PersonalFinance.Web/tools/atelier-excerpts.test.js PersonalFinance/src/PersonalFinance.Web/tools/lesson-check.test.js PersonalFinance/src/PersonalFinance.Web/tools/review-cards.test.js PersonalFinance/src/PersonalFinance.Web/tools/research-search.test.js PersonalFinance/src/PersonalFinance.Web/tools/research-basket.test.js PersonalFinance/src/PersonalFinance.Web/tools/research-basket-math.test.js PersonalFinance/src/PersonalFinance.Web/tools/research-similar.test.js PersonalFinance/src/PersonalFinance.Web/tools/research-fund.test.js",
    "atelier:recheck": "node PersonalFinance/src/PersonalFinance.Web/tools/atelier-recheck.js",
    "css:raw-colours": "node PersonalFinance/src/PersonalFinance.Web/tools/raw-colours.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "test": "echo \"Error: no test specified\" && exit 1",
    "e2e:preflight": "node e2e-tests/preflight.js",
    "test:e2e": "node e2e-tests/ui-test.js",
    "test:api": "node e2e-tests/api-test.js",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2"
  }
}
